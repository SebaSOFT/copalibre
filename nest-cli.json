{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "sourceRoot": "apps/api/src",
      "entryFile": "main"
    },
    "events": {
      "type": "application",
      "root": "apps/events",
      "sourceRoot": "apps/events/src",
      "entryFile": "main"
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "sourceRoot": "apps/worker/src",
      "entryFile": "main"
    },
    "scheduler": {
      "type": "application",
      "root": "apps/scheduler",
      "sourceRoot": "apps/scheduler/src",
      "entryFile": "main"
    },
    "migrate": {
      "type": "application",
      "root": "apps/migrate",
      "sourceRoot": "apps/migrate/src",
      "entryFile": "main"
    },
    "doctor": {
      "type": "application",
      "root": "apps/doctor",
      "sourceRoot": "apps/doctor/src",
      "entryFile": "main"
    }
  }
}
