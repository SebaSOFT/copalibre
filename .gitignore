# CopaLibre: Node.js 24 + TypeScript + Yarn 4 (node_modules linker)
node_modules/
.yarn/*
!.yarn/releases/
!.yarn/plugins/
!.yarn/patches/
!.yarn/sdks/
!.yarn/versions/
.pnp.*

# Build output: NestJS roles, Astro public/control application, and Vite.
dist/
build/
.astro/
.vite/
*.tsbuildinfo

# Test, coverage, diagnostics, and tool caches
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.artifacts/
artifacts/
.cache/
.eslintcache
.stylelintcache
.turbo/

# Runtime data: never commit local persistent state, uploads, backups, or secrets.
.copalibre/
var/
storage/
uploads/
backups/
data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs and process files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.pid.lock
*.seed

# Environment and local configuration
.env
.env.*
!.env.example
!.env.*.example
!.env.test.example
*.local

# Local TLS keys, certificates, and encrypted secret files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.kdbx
*.age

# Docker Compose local overrides
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Editor and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local agent and temporary work directories
.hermes/
.worktrees/
.tmp/
tmp/

# Local AI-assistant tooling and OpenSpec planning artifacts stay out of the repo
.claude/
openspec/changes/
packages/design-tokens/generated/
