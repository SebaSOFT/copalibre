  "info": {
    "title": "CopaLibre API",
    "description": "Self-hosted tournament management API.\n\nAuthentication is JWT Bearer, validated against the operator-selected\nidentity provider’s JWKS. Browsers use Authorization Code + PKCE and\nhold the access token in memory only — never localStorage. A token\npassed as a query parameter is ignored, because URLs leak into proxy\nlogs, browser history, metrics, traces and screenshots.\n\nEvery route declares one security plane: public-read,\nauthenticated-interaction, admin-control, or integration.\nauthenticated-interaction and admin-control share this same bearer\ntransport and differ only in authorization policy.",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Short-lived access token. Strict stateless mode is the default: no refresh credential is persisted, so a reload reauthenticates."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "api",
              "events",
              "worker",
              "scheduler",
              "migrate",
              "doctor"
            ],
            "description": "Process role this instance is running as"
          },
          "version": {
            "type": "string",
            "example": "0.0.0"
          }
        },
        "required": [
          "role",
          "version"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "api",
              "events",
              "worker",
              "scheduler",
              "migrate",
              "doctor"
            ],
            "description": "Process role this instance is running as"
          },
          "version": {
            "type": "string",
            "example": "0.0.0"
          },
          "schemaVersion": {
            "type": "string",
            "example": "0001-initial-schema",
            "description": "Applied database schema version this release requires"
          }
        },
        "required": [
          "role",
          "version",
          "schemaVersion"
        ]
      },
      "OrganizationResponse": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UUIDv7 identifier"
          },
          "alias": {
            "type": "string",
            "description": "Human-readable, URL-safe alias; globally unique per installation",
            "example": "liga-orbital"
          },
          "name": {
            "type": "string",
            "example": "Liga Orbital"
          }
        },
        "required": [
          "organizationId",
          "alias",
          "name"
        ]
      },
      "CreateOrganizationRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "description": "Lowercase kebab-case alias, unique per installation",
            "example": "liga-orbital"
          },
          "name": {
            "type": "string",
            "example": "Liga Orbital"
          }
        },
        "required": [
          "alias",
          "name"
        ]
      },
      "ProblemResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 403
          },
          "message": {
            "type": "string",
            "example": "subject may only act on their own records"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "TournamentResponse": {
        "type": "object",
        "properties": {
          "tournamentId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "alias": {
            "type": "string",
            "description": "Alias, unique within its organization",
            "example": "copa-verano"
          },
          "name": {
            "type": "string",
            "example": "Copa Verano"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "started",
              "finished"
            ],
            "description": "Once started, the tournament's discipline and profile versions are frozen and its results are materialised."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the first match began, marking the module freeze."
          },
          "rulesetId": {
            "type": "string",
            "format": "uuid",
            "description": "Active ruleset version, when one exists"
          }
        },
        "required": [
          "tournamentId",
          "organizationId",
          "alias",
          "name",
          "status"
        ]
      },
      "CreateTournamentRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "example": "copa-verano"
          },
          "name": {
            "type": "string",
            "example": "Copa Verano"
          },
          "descriptorId": {
            "type": "string",
            "format": "uuid",
            "description": "DisciplineDescriptor identifier"
          },
          "descriptorVersion": {
            "type": "string",
            "description": "Pinned descriptor version (semver). Rulesets never track \"latest\": the version a tournament starts on is frozen.",
            "example": "1.2.0"
          }
        },
        "required": [
          "alias",
          "name",
          "descriptorId",
          "descriptorVersion"
        ]
      },
      "TimeWindowDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "number",
            "description": "Start of the reserved window, epoch milliseconds",
            "example": 1785333600000
          },
          "durationMinutes": {
            "type": "number",
            "description": "How long the resource is reserved — not how long the match takes",
            "example": 90
          }
        },
        "required": [
          "startsAt",
          "durationMinutes"
        ]
      },
      "ScheduleAssignmentDto": {
        "type": "object",
        "properties": {
          "fixtureId": {
            "type": "string",
            "format": "uuid"
          },
          "window": {
            "$ref": "#/components/schemas/TimeWindowDto"
          },
          "venueId": {
            "type": "string",
            "format": "uuid",
            "description": "Venue hosting the fixture"
          },
          "officialIds": {
            "description": "Officials assigned to the fixture",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "fixtureId",
          "window"
        ]
      },
      "ScheduleResponse": {
        "type": "object",
        "properties": {
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleAssignmentDto"
            }
          }
        },
        "required": [
          "assignments"
        ]
      },
      "RestRuleDto": {
        "type": "object",
        "properties": {
          "minimumMinutes": {
            "type": "number",
            "description": "Minimum minutes between an entrant's consecutive fixtures",
            "example": 45
          }
        },
        "required": [
          "minimumMinutes"
        ]
      },
      "ScheduleRequest": {
        "type": "object",
        "properties": {
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleAssignmentDto"
            }
          },
          "restRule": {
            "$ref": "#/components/schemas/RestRuleDto"
          }
        },
        "required": [
          "assignments"
        ]
      },
      "ScheduleConflictDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "venue-double-booked",
              "official-double-booked",
              "rest-rule"
            ],
            "description": "Which rule the schedule breaks"
          },
          "fixtureId": {
            "type": "string",
            "format": "uuid"
          },
          "conflictsWithFixtureId": {
            "type": "string",
            "format": "uuid",
            "description": "The fixture it clashes with"
          },
          "resourceId": {
            "type": "string",
            "description": "Venue, official or entrant the clash is about"
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation an operator can act on"
          }
        },
        "required": [
          "kind",
          "fixtureId",
          "conflictsWithFixtureId",
          "resourceId",
          "detail"
        ]
      },
      "SchedulePreviewResponse": {
        "type": "object",
        "properties": {
          "committable": {
            "type": "boolean",
            "description": "Whether the batch would publish as it stands"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleConflictDto"
            }
          },
          "affectedPublishedFixtures": {
            "description": "Already-published fixtures this batch would move",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "committable",
          "conflicts",
          "affectedPublishedFixtures"
        ]
      },
      "MatchStateResponse": {
        "type": "object",
        "properties": {
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "in-progress",
              "finalized"
            ]
          },
          "clockRunning": {
            "type": "boolean",
            "description": "Whether the active segment’s clock is running"
          },
          "runningTimers": {
            "description": "Timers still running, by event id",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "matchId",
          "status",
          "clockRunning",
          "runningTimers"
        ]
      },
      "FinalizeRequest": {
        "type": "object",
        "properties": {
          "sides": {
            "description": "One entry per side: entrant id, its declared statistics, and placement for a heat",
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "winnerEntrantId": {
            "type": "string",
            "format": "uuid",
            "description": "Duel matches only"
          }
        },
        "required": [
          "sides"
        ]
      },
      "RecordEventRequest": {
        "type": "object",
        "properties": {
          "definitionCode": {
            "type": "string",
            "description": "Event definition code the discipline declares",
            "example": "goal"
          },
          "segmentId": {
            "type": "string",
            "format": "uuid",
            "description": "Segment the event happened in"
          },
          "occurredAt": {
            "type": "number",
            "description": "When it happened, epoch milliseconds"
          },
          "side": {
            "type": "string",
            "format": "uuid",
            "description": "The entrant it belongs to — an id, never \"home\"/\"away\""
          },
          "participantId": {
            "type": "string",
            "format": "uuid",
            "description": "The person, when the discipline needs one"
          },
          "payload": {
            "type": "object",
            "description": "Payload validated against the definition"
          }
        },
        "required": [
          "definitionCode",
          "segmentId",
          "occurredAt"
        ]
      },
      "RecordedEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "definitionCode": {
            "type": "string"
          },
          "sequence": {
            "type": "number",
            "description": "Monotonic per-match ordering assigned by the log"
          },
          "side": {
            "type": "string",
            "format": "uuid"
          },
          "participantId": {
            "type": "string",
            "format": "uuid"
          },
          "notifications": {
            "description": "Identity keys of notifications this event declared, deduplicated on delivery",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "eventId",
          "definitionCode",
          "sequence",
          "notifications"
        ]
      }
    }
  }
}
