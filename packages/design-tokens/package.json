{
  "name": "@copalibre/design-tokens",
  "version": "1.0.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "build:tokens": "tsc --build && node dist/bin/build.js",
    "build:css": "tsc --build && node dist/bin/build.js",
    "build:tailwind": "tsc --build && node dist/bin/build.js",
    "scan:forbidden": "tsc --build && node dist/bin/build.js && node dist/bin/scan.js",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs --coverage"
  },
  "type": "module",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
