{
  "name": "@copalibre/design-tokens",
  "version": "1.2.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "refresh:design": "tsc --build && node dist/bin/refresh-design-document.js",
    "build:tokens": "tsc --build && node dist/bin/build.js",
    "build:css": "tsc --build && node dist/bin/build.js",
    "build:tailwind": "tsc --build && node dist/bin/build.js",
    "scan:forbidden": "tsc --build && node dist/bin/build.js && node dist/bin/scan.js",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs --coverage",
    "check:integrity": "tsc --build && node dist/bin/build.js && node dist/bin/check-integrity.js"
  },
  "type": "module",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0"
  }
}
