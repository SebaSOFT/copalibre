          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "tiebreak-entered",
      "label": { "en": "Tiebreak entered", "es": "Ingreso a desempate" },
