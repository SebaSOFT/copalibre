            "en": "ML",
            "es": "PP",
            "fr": "MP",
            "de": "MV",
            "it": "PP",
            "pt": "PP",
            "ru": "МП",
            "zh": "负场"
          },
          "source": { "kind": "collector", "code": "matches-lost" },
