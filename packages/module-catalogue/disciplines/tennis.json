        "it": "Set persi",
        "pt": "Sets perdidos",
        "ru": "Проигранные сеты",
        "zh": "负盘"
      },
      "aggregation": "sum"
    },
    {
      "code": "games-won",
      "label": {
        "en": "Games won",
        "es": "Juegos ganados",
        "fr": "Jeux gagnés",
        "de": "Gewonnene Spiele",
        "it": "Game vinti",
        "pt": "Games vencidos",
        "ru": "Выигранные геймы",
        "zh": "胜局"
      },
      "aggregation": "sum"
    },
    {
      "code": "games-lost",
      "label": {
        "en": "Games lost",
        "es": "Juegos perdidos",
        "fr": "Jeux perdus",
        "de": "Verlorene Spiele",
        "it": "Game persi",
        "pt": "Games perdidos",
        "ru": "Проигранные геймы",
        "zh": "负局"
      },
      "aggregation": "sum"
    },
    {
      "code": "played",
      "label": {
        "en": "Played",
        "es": "Jugados",
        "fr": "Joués",
        "de": "Gespielt",
        "it": "Giocate",
        "pt": "Jogos",
        "ru": "Игры",
        "zh": "已赛"
      },
      "aggregation": "count"
    }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": {
        "en": "Group Standings",
        "es": "Tabla de Posiciones",
