        },
        {
          "code": "sl",
          "header": {
            "en": "SL",
            "es": "SP",
            "fr": "SP",
            "de": "SV",
            "it": "SP",
            "pt": "SP",
            "ru": "СП",
            "zh": "负盘"
          },
          "source": { "kind": "collector", "code": "sets-lost" },
          "format": "number"
        },
        {
          "code": "sets-diff",
          "header": {
            "en": "Diff",
            "es": "Dif",
            "fr": "Diff",
            "de": "Diff",
            "it": "Diff",
            "pt": "Dif",
            "ru": "Разн.",
            "zh": "净胜盘"
          },
          "source": { "kind": "computed", "expression": "sw - sl" },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    { "code": "games", "label": { "en": "Games", "es": "Juegos" }, "source": "event-derived" },
    { "code": "sets", "label": { "en": "Sets", "es": "Sets" }, "source": "event-derived" }
