{
  "alias": "tennis",
  "version": "1.0.0",
  "name": { "en": "Tennis", "es": "Tenis" },
  "attribution": {
    "author": "CopaLibre",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre"
  },
  "participantTypes": ["individual", "team"],
  "rosterConstraints": { "minPlayers": 1, "maxPlayers": 2 },
  "segmentTypes": [
    { "name": "set", "label": { "en": "Set", "es": "Set" }, "timed": false },
    { "name": "tiebreak", "label": { "en": "Tiebreak", "es": "Desempate" }, "timed": false }
  ],
  "eventDefinitions": [
    {
      "code": "point",
      "label": { "en": "Point", "es": "Punto" },
      "category": "positive",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": { "ace": { "type": "boolean" }, "doubleFault": { "type": "boolean" } }
      },
      "effects": [{ "kind": "score", "awardTo": "actor", "delta": 1 }]
    },
    {
      "code": "game-won",
      "label": { "en": "Game won", "es": "Juego ganado" },
      "category": "positive",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": { "toLove": { "type": "boolean" } } },
      "effects": [{ "kind": "statistic", "statisticCode": "games-won", "delta": 1 }]
    },
    {
      "code": "segment-point",
      "label": { "en": "Segment point", "es": "Punto de parcial" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "match-point",
      "label": { "en": "Match point", "es": "Punto de partido" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "margin-required",
      "label": { "en": "Margin required", "es": "Margen requerido" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "tiebreak-entered",
      "label": { "en": "Tiebreak entered", "es": "Ingreso a desempate" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    }
  ],
  "statistics": [
    {
      "code": "matches-won",
      "label": { "en": "Matches won", "es": "Partidos ganados" },
      "aggregation": "sum"
    },
    {
      "code": "matches-lost",
      "label": { "en": "Matches lost", "es": "Partidos perdidos" },
      "aggregation": "sum"
    },
    {
      "code": "sets-won",
      "label": { "en": "Sets won", "es": "Sets ganados" },
      "aggregation": "sum"
    },
    {
      "code": "sets-lost",
      "label": { "en": "Sets lost", "es": "Sets perdidos" },
      "aggregation": "sum"
    },
    {
      "code": "games-won",
      "label": { "en": "Games won", "es": "Juegos ganados" },
      "aggregation": "sum"
    },
    {
      "code": "games-lost",
      "label": { "en": "Games lost", "es": "Juegos perdidos" },
      "aggregation": "sum"
    },
    { "code": "played", "label": { "en": "Played", "es": "Jugados" }, "aggregation": "count" }
  ],
  "tableLayouts": [
    {
      "code": "group-standings-default",
      "target": "group-phase",
      "label": { "en": "Group Standings", "es": "Tabla de Posiciones" },
      "entityGranularity": "team",
      "defaultSort": [
        { "columnCode": "matches-won", "direction": "desc" },
        { "columnCode": "sets-diff", "direction": "desc" }
      ],
      "columns": [
        {
          "code": "rank",
          "header": { "en": "Pos", "es": "#" },
          "source": { "kind": "rank" },
          "format": "number"
        },
        {
          "code": "name",
          "header": { "en": "Player", "es": "Jugador" },
          "source": { "kind": "entrant-name" },
          "format": "text"
        },
        {
          "code": "played",
          "header": { "en": "P", "es": "PJ" },
          "source": { "kind": "collector", "code": "played" },
          "format": "number"
        },
        {
          "code": "matches-won",
          "header": { "en": "MW", "es": "PG" },
          "source": { "kind": "collector", "code": "matches-won" },
          "format": "number"
        },
        {
          "code": "matches-lost",
          "header": { "en": "ML", "es": "PP" },
          "source": { "kind": "collector", "code": "matches-lost" },
          "format": "number"
        },
        {
          "code": "sw",
          "header": { "en": "SW", "es": "SG" },
          "source": { "kind": "collector", "code": "sets-won" },
          "format": "number"
        },
        {
          "code": "sl",
          "header": { "en": "SL", "es": "SP" },
          "source": { "kind": "collector", "code": "sets-lost" },
          "format": "number"
        },
        {
          "code": "sets-diff",
          "header": { "en": "Diff", "es": "Dif" },
          "source": { "kind": "computed", "expression": "sw - sl" },
          "format": "number"
        }
      ]
    }
  ],
  "scoringInputs": [
    { "code": "games", "label": { "en": "Games", "es": "Juegos" }, "source": "event-derived" },
    { "code": "sets", "label": { "en": "Sets", "es": "Sets" }, "source": "event-derived" }
  ],
  "availableFormats": [
    "single-elimination",
    "double-elimination",
    "round-robin",
    "round-robin-single-leg",
    "round-robin-home-away"
  ],
  "notificationRuleCapabilities": ["threshold-count"],
  "winCondition": {
    "id": "tennis-best-of-three",
    "rules": [
      {
        "id": "close-set-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "require-set-margin",
            "type": "requireMargin",
            "options": {},
            "params": [
              {
                "id": "margin",
                "name": "margin",
                "type": "simple_number",
                "value": 2,
                "options": {}
              }
            ]
          },
          {
            "id": "close-set",
            "type": "winSegment",
            "options": {},
            "params": [
              {
                "id": "segment",
                "name": "segment",
                "type": "simple_string",
                "value": "set",
                "options": {}
              },
              {
                "id": "target",
                "name": "target",
                "type": "simple_number",
                "value": 6,
                "options": {}
              },
              {
                "id": "tiebreakAt",
                "name": "tiebreakAt",
                "type": "simple_number",
                "value": 6,
                "options": {}
              },
              {
                "id": "tiebreakTarget",
                "name": "tiebreakTarget",
                "type": "simple_number",
                "value": 7,
                "options": {}
              },
              {
                "id": "tiebreakMargin",
                "name": "tiebreakMargin",
                "type": "simple_number",
                "value": 2,
                "options": {}
              }
            ]
          }
        ]
      },
      {
        "id": "close-match-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "close-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "set",
                "options": {}
              },
              {
                "id": "target",
                "name": "target",
                "type": "simple_number",
                "value": "{{ 1 + 1 }}",
                "options": { "expression": true }
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "round-robin",
    "registration": { "publicOpen": false, "requiresCheckIn": false },
    "scoring": { "pointsPerWin": 2, "pointsPerDraw": 0, "pointsPerLoss": 0 },
    "tiebreakers": ["matches-won", "sets-won", "games-won"],
    "segments": { "bestOf": 3, "tiebreakInFinalSet": true }
  },
  "fieldPolicies": {
    "tableLayouts": { "permission": { "kind": "replaced" }, "mutationClass": "safe" },
    "format": { "permission": { "kind": "replaced" }, "mutationClass": "blocked_after_results" },
    "registration.publicOpen": { "permission": { "kind": "replaced" }, "mutationClass": "safe" },
    "registration.requiresCheckIn": {
      "permission": { "kind": "replaced" },
      "mutationClass": "requires_rebuild"
    },
    "registration.checkInClosesAt": {
      "permission": { "kind": "replaced" },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": { "kind": "replaced" },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": { "kind": "merged", "strategy": "union-list" },
      "mutationClass": "requires_rebuild"
    },
    "winCondition": { "permission": { "kind": "replaced" }, "mutationClass": "requires_rebuild" },
    "segments": {
      "permission": { "kind": "merged", "strategy": "shallow-object" },
      "mutationClass": "requires_rebuild"
    }
  }
}
