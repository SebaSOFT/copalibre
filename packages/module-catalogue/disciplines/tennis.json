{
  "alias": "tennis",
  "version": "1.3.0",
  "name": { "en": "Tennis", "es": "Tenis" },
  "description": {
    "en": "Individual or team racket discipline with sets, games, points, tiebreaks, and match statistics."
  },
  "images": [{ "key": "modules/tennis/1.3.0/tennis-01.jpg" }],
  "attribution": {
    "author": "CopaLibre",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre"
  },
  "participantTypes": ["individual", "team"],
  "rosterConstraints": { "minPlayers": 1, "maxPlayers": 2 },
  "segmentTypes": [
    { "name": "set", "label": { "en": "Set", "es": "Set" }, "timed": false },
    { "name": "tiebreak", "label": { "en": "Tiebreak", "es": "Desempate" }, "timed": false }
  ],
  "eventDefinitions": [
    {
      "code": "point",
      "label": { "en": "Point", "es": "Punto" },
      "category": "positive",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": { "ace": { "type": "boolean" }, "doubleFault": { "type": "boolean" } }
      },
      "effects": [{ "kind": "score", "awardTo": "actor", "delta": 1 }]
    },
    {
      "code": "game-won",
      "label": { "en": "Game won", "es": "Juego ganado" },
      "category": "positive",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": { "toLove": { "type": "boolean" } } },
      "effects": [{ "kind": "statistic", "statisticCode": "games-won", "delta": 1 }]
    },
    {
      "code": "segment-point",
      "label": { "en": "Segment point", "es": "Punto de parcial" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "match-point",
      "label": { "en": "Match point", "es": "Punto de partido" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "margin-required",
      "label": { "en": "Margin required", "es": "Margen requerido" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    },
    {
      "code": "tiebreak-entered",
      "label": { "en": "Tiebreak entered", "es": "Ingreso a desempate" },
      "category": "neutral",
      "permittedSegmentTypes": ["set", "tiebreak"],
      "actorRequirement": "none",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "segmentType": { "type": "string" },
          "segmentIndex": { "type": ["number", "null"] },
          "entrantId": { "type": ["string", "null"] },
          "threshold": { "type": "number" },
          "values": { "type": "object" }
        },
        "required": ["segmentType", "threshold"]
      }
    }
  ],
  "statistics": [
    {
      "code": "matches-won",
      "label": {
        "en": "Matches won",
        "es": "Partidos ganados",
        "fr": "Matchs gagnés",
        "de": "Gewonnene Matches",
        "it": "Partite vinte",
        "pt": "Partidas vencidas",
        "ru": "Выигранные матчи",
        "zh": "胜场"
      },
      "aggregation": "sum"
    },
    {
      "code": "matches-lost",
      "label": {
        "en": "Matches lost",
        "es": "Partidos perdidos",
        "fr": "Matchs perdus",
        "de": "Verlorene Matches",
        "it": "Partite perse",
        "pt": "Partidas perdidas",
        "ru": "Проигранные матчи",
        "zh": "负场"
      },
