:80 {
	# Realtime SSE stream
	@events path /events /events/*
	handle @events {
		reverse_proxy events:3002 {
			flush_interval -1
		}
	}

	# Microservice API endpoints (incluye rutas base y subrutas)
	@api path /api /api/* /auth /auth/* /organizations /organizations/* /objects /objects/* /admin /admin/* /installation /installation/* /.well-known /.well-known/* /disciplines /disciplines/* /tournament-profiles /tournament-profiles/*
	handle @api {
		reverse_proxy api:3001
	}

	# Web frontend
	handle {
		reverse_proxy web:4321
	}
}
