:80 {
	# Microservice API endpoints
	handle /api/* {
		reverse_proxy api:3001
	}
	handle /auth/* {
		reverse_proxy api:3001
	}
	handle /organizations/* {
		reverse_proxy api:3001
	}
	handle /admin/* {
		reverse_proxy api:3001
	}
	handle /installation/* {
		reverse_proxy api:3001
	}
	handle /.well-known/* {
		reverse_proxy api:3001
	}

	# Realtime SSE stream with unbuffered flushing
	handle /events/* {
		reverse_proxy events:3002 {
			flush_interval -1
		}
	}

	# Web frontend (SPA shell, SSR public pages, TV kiosks, assets)
	handle {
		reverse_proxy web:4321
	}
}
