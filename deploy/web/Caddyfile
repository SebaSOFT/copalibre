# COPALIBRE_WEB_SSR_UPSTREAM addresses the on-demand renderer. Its default is
# docker-compose.yml's own service name, so Compose needs no variable at all;
# Kubernetes overrides it, because the chart's Service is release-scoped
# ({release}-web-ssr) and no hostname baked into this image could name it.
# COPALIBRE_WEB_API_UPSTREAM follows the same pattern for the API.
:4321 {
	root * /srv

	# What the web role's own health probe targets: answered here, by this
	# server, so an unavailable renderer degrades the dynamic routes below
	# without also marking every static surface unready. A dedicated /healthz
	# would have to be added to @ssrOrg's exclusion list to avoid being
	# swallowed by it; this path is already excluded and already answered.
	handle /runtime-config.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond "{\"oidcIssuer\":\"{$COPALIBRE_JWT_ISSUER}\",\"oidcClientId\":\"{$COPALIBRE_OIDC_CLIENT_ID}\"}" 200
	}

	# Runtime half of the Content Security Policy; the build writes the other
	# half into each page as a <meta> policy with the hash of every inline
	# script and style. A browser enforces both, so the loose script-src and
	# style-src below only keep the hashed inline elements from falling back
	# to default-src: in the intersection, the hashes govern. This half owns
	# what only the running installation knows or a <meta> cannot carry:
	# connections, frames and forms (the application, plus an external
	# identity provider's origin when one is configured) and frame-ancestors.
	# blob: in connect-src lets a page read back image data it created itself.
	# The application frames its own pages (overlay preview, silent sign-in
	# renewal); no other site may. /api keeps the API's own deny-all policy.
	# Appended (+), never replacing: on-demand pages arrive from the renderer
	# with Astro's hashed policy as a header rather than a <meta>, and a browser
	# enforces both. Deferred so the other headers replace the renderer's.
	# The background-removal worker alone may evaluate generated code: its
	# image library (onnxruntime's ndarray) builds accessors with Function().
	# A worker has no DOM and no access to sessionStorage, so it cannot reach
	# the access token, and its connections stay on this origin. blob: lets the
	# library load onnxruntime's module and data from object URLs it creates.
	@removalWorker path /_astro/background-removal.worker-*.js
	header @removalWorker {
		defer
		Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
		X-Content-Type-Options nosniff
	}

	@page {
		not path /api /api/*
		not path /_astro/background-removal.worker-*.js
	}
	header @page {
		defer
		+Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: {$COPALIBRE_CSP_IDENTITY_ORIGIN:}; frame-src 'self' {$COPALIBRE_CSP_IDENTITY_ORIGIN:}; form-action 'self' {$COPALIBRE_CSP_IDENTITY_ORIGIN:}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# Font files are bundled into the build and served from this origin.
	# Declared here rather than left to the base image's /etc/mime.types,
	# which a different base may lack: without it they go out as
	# application/octet-stream. file_server keeps a type already set.
	@woff2 {
		path *.woff2
		file
	}
	header @woff2 Content-Type font/woff2
	@woff {
		path *.woff
		file
	}
	header @woff Content-Type font/woff

	# First, because /api/tournaments would otherwise look like an organization's tournaments.
	@api path /api /api/*
	handle @api {
		reverse_proxy {$COPALIBRE_WEB_API_UPSTREAM:api:3001}
	}

	# The event streams, on the same hostname as Control, so the browser
	# sends the HttpOnly session cookie to them as it does to /api. Never
	# buffered: a buffered stream arrives after the match ended.
	@events path /events /events/*
	handle @events {
		reverse_proxy {$COPALIBRE_WEB_EVENTS_UPSTREAM:events:3002} {
			flush_interval -1
		}
	}

	# RFC 8615 files stay public at the root. No fallback here: a missing
	# file answers 404, not the home page with 200.
	@wellKnown path /.well-known /.well-known/*
	handle @wellKnown {
		file_server
	}

	@ssr path_regexp ^(?:/(?:es|fr|pt|it|de|ru|zh))?/[^/]+/tournaments(?:/.*)?$
	handle @ssr {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# The organization landing page — same on-demand renderer as
	# @ssr above, matched separately because it has no /tournaments/
	# segment to anchor on: just an optional locale prefix plus one alias
	# segment. That shape would otherwise also swallow every reserved
	# top-level path (/control, /help, /tv, /api, /events, /.well-known,
	# /runtime-config.json), so those are excluded explicitly rather than
	# relied upon to lose priority by file order.
	@ssrOrg {
		path_regexp ^(?:/(?:es|fr|pt|it|de|ru|zh))?/[^/]+/?$
		not path /control /control/* /help /help/* /tv /tv/* /api /api/* /events /events/* /.well-known /.well-known/* /runtime-config.json
	}
	handle @ssrOrg {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# Dynamic root and sitemap routes rendered on demand by web-ssr
	@ssrRoot {
		path / /sitemap.xml
	}
	handle @ssrRoot {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	@ssrTv {
		path /tv /tv/*
	}
	handle @ssrTv {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	@ssrInvitations {
		path /invitations /invitations/*
	}
	handle @ssrInvitations {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# Every authenticated control-panel screen beyond the login page shares
	# one client-routed shell — real files (the login page at
	# /control/, its own static assets, and /control/callback once the login flow
	# builds it) are served as-is by try_files finding them first; any other
	# /control/** path (no matching file, since those eight screens no
	# longer have their own built pages) falls back to the shell instead of
	# the public site's own index, so a direct visit or hard refresh still
	# renders the right screen.
	@control path /control /control/*
	handle @control {
		try_files {path} {path}/index.html /control/app/index.html
		file_server
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
