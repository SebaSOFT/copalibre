# COPALIBRE_WEB_SSR_UPSTREAM addresses the on-demand renderer. Its default is
# docker-compose.yml's own service name, so Compose needs no variable at all;
# Kubernetes overrides it, because the chart's Service is release-scoped
# ({release}-web-ssr) and no hostname baked into this image could name it.
# COPALIBRE_WEB_API_UPSTREAM follows the same pattern for the API.
:4321 {
	root * /srv

	# What the web role's own health probe targets: answered here, by this
	# server, so an unavailable renderer degrades the dynamic routes below
	# without also marking every static surface unready. A dedicated /healthz
	# would have to be added to @ssrOrg's exclusion list to avoid being
	# swallowed by it; this path is already excluded and already answered.
	handle /runtime-config.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond "{\"oidcIssuer\":\"{$COPALIBRE_JWT_ISSUER}\",\"oidcClientId\":\"{$COPALIBRE_OIDC_CLIENT_ID}\"}" 200
	}

	# First, because /api/tournaments would otherwise look like an organization's tournaments.
	@api path /api /api/*
	handle @api {
		reverse_proxy {$COPALIBRE_WEB_API_UPSTREAM:api:3001}
	}

	# RFC 8615 files stay public at the root. No fallback here: a missing
	# file answers 404, not the home page with 200.
	@wellKnown path /.well-known /.well-known/*
	handle @wellKnown {
		file_server
	}

	@ssr path_regexp ^(?:/(?:es|fr|pt|it|de|ru|zh))?/[^/]+/tournaments(?:/.*)?$
	handle @ssr {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# The organization landing page — same on-demand renderer as
	# @ssr above, matched separately because it has no /tournaments/
	# segment to anchor on: just an optional locale prefix plus one alias
	# segment. That shape would otherwise also swallow every reserved
	# top-level path (/control, /help, /tv, /api, /.well-known,
	# /runtime-config.json), so those are excluded explicitly rather than
	# relied upon to lose priority by file order.
	@ssrOrg {
		path_regexp ^(?:/(?:es|fr|pt|it|de|ru|zh))?/[^/]+/?$
		not path /control /control/* /help /help/* /tv /tv/* /api /api/* /.well-known /.well-known/* /runtime-config.json
	}
	handle @ssrOrg {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# Dynamic root and sitemap routes rendered on demand by web-ssr
	@ssrRoot {
		path / /sitemap.xml
	}
	handle @ssrRoot {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	@ssrTv {
		path /tv /tv/*
	}
	handle @ssrTv {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	@ssrInvitations {
		path /invitations /invitations/*
	}
	handle @ssrInvitations {
		reverse_proxy {$COPALIBRE_WEB_SSR_UPSTREAM:web-ssr:3005}
	}

	# Every authenticated control-panel screen beyond the login page shares
	# one client-routed shell — real files (the login page at
	# /control/, its own static assets, and /control/callback once the login flow
	# builds it) are served as-is by try_files finding them first; any other
	# /control/** path (no matching file, since those eight screens no
	# longer have their own built pages) falls back to the shell instead of
	# the public site's own index, so a direct visit or hard refresh still
	# renders the right screen.
	@control path /control /control/*
	handle @control {
		try_files {path} {path}/index.html /control/app/index.html
		file_server
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
