---
import '@copalibre/design-tokens/generated/copalibre.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso de control — CopaLibre</title>
  </head>
  <body>
    <main class="login-shell">
      <header class="brand">
        <span class="brand-mark" aria-hidden="true">CL</span>
        <div>
          <strong>CopaLibre</strong>
          <span>Control de torneos</span>
        </div>
      </header>

      <section class="login-panel" aria-labelledby="login-title">
        <p class="context">Consola de organización</p>
        <h1 id="login-title">Ingresá para operar</h1>
        <p class="summary">
          Usá la identidad configurada por tu instalación. CopaLibre no administra contraseñas.
        </p>
        <button id="oidc-login" type="button">Continuar con proveedor de identidad</button>
        <p id="login-error" class="error" role="alert" hidden></p>
      </section>
    </main>

    <script>
      import { beginOidcLogin } from '../../control/session/oidc-login.js';

      const button = document.querySelector<HTMLButtonElement>('#oidc-login');
      const error = document.querySelector<HTMLParagraphElement>('#login-error');
      button?.addEventListener('click', async () => {
        button.disabled = true;
        if (error) error.hidden = true;
        try {
          await beginOidcLogin();
        } catch (cause) {
          if (error) {
            error.textContent =
              cause instanceof Error ? cause.message : 'No se pudo iniciar la autorización';
            error.hidden = false;
          }
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: var(--cl-surface-base);
    color: var(--cl-text-primary);
    font-family: var(--cl-font-body);
  }

  .login-shell {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: clamp(24px, 5vw, 64px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--cl-space-3);
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cl-state-live);
    color: var(--cl-state-live);
    font-family: var(--cl-font-mono);
    font-weight: 700;
  }

  .brand div {
    display: grid;
    gap: 2px;
  }

  .brand strong {
    font-family: var(--cl-font-display);
    font-size: 1.125rem;
  }

  .brand span:last-child,
  .context {
    color: var(--cl-text-muted);
    font-family: var(--cl-font-mono);
    font-size: 0.75rem;
  }

  .login-panel {
    width: min(100%, 560px);
    align-self: center;
    margin-block: var(--cl-space-8);
    border-left: 4px solid var(--cl-state-live);
    padding: var(--cl-space-6) 0 var(--cl-space-6) var(--cl-space-6);
  }

  .context {
    margin: 0 0 var(--cl-space-3);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: var(--cl-font-display);
    font-size: 4.5rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .summary {
    max-width: 48ch;
    margin: var(--cl-space-4) 0 var(--cl-space-6);
    color: var(--cl-text-secondary);
    line-height: 1.6;
  }

  button {
    min-height: 48px;
    border: 1px solid var(--cl-state-live);
    border-radius: 4px;
    padding: var(--cl-space-3) var(--cl-space-5);
    background: var(--cl-state-live);
    color: var(--cl-surface-base);
    font: 700 0.875rem var(--cl-font-body);
    cursor: pointer;
  }

  button:hover {
    filter: brightness(1.08);
  }

  button:focus-visible {
    outline: 2px solid var(--cl-surface-base);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--cl-state-live);
  }

  button:disabled {
    cursor: progress;
    opacity: 0.65;
  }

  .error {
    margin: var(--cl-space-4) 0 0;
    color: var(--cl-state-destructive);
    line-height: 1.5;
  }

  @media (max-width: 540px) {
    .login-shell {
      padding: var(--cl-space-5);
    }

    .login-panel {
      padding-left: var(--cl-space-4);
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
