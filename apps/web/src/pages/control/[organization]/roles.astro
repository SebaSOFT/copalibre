---
import { RolesPermissionsControlRoute } from '../../../control/components/ControlRoutes.tsx';
import '@copalibre/design-tokens/generated/copalibre.css';

export function getStaticPaths() {
  return [{ params: { organization: 'liga-mendocina' } }];
}

const { organization } = Astro.params;
const alias = organization ?? 'liga-mendocina';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Roles y permisos - {alias}</title>
  </head>
  <body>
    <RolesPermissionsControlRoute client:only="react" organizationAlias={alias} />
  </body>
</html>
