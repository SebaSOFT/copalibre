---
import { Dashboard } from '../../../control/components/Dashboard.tsx';
import { buildDashboard } from '../../../control/lib/dashboard.ts';
import { sampleDashboardData } from '../../../control/lib/sample.ts';
import '@copalibre/design-tokens/generated/copalibre.css';

/**
 * A1, the organization dashboard (0022).
 *
 * `client:only` rather than a server render: this screen is behind
 * authentication, its token lives in memory, and rendering it on the server
 * would mean the server holding a session — the opposite of what the in-memory
 * token buys.
 */
export function getStaticPaths() {
  return [{ params: { organization: 'liga-mendocina' } }];
}

const { organization } = Astro.params;
const alias = organization ?? 'liga-mendocina';
const model = buildDashboard(sampleDashboardData());
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel — {alias}</title>
  </head>
  <body>
    <Dashboard client:only="react" model={model} organizationAlias={alias} />
    <noscript>El panel de control necesita JavaScript. Las páginas públicas no.</noscript>
  </body>
</html>
