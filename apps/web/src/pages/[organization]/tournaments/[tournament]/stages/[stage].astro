---
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import BracketView from '../../../../../components/BracketView.astro';
import ResultLegend from '../../../../../components/ResultLegend.astro';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import { sampleOverview } from '../../../../../lib/sample-data.ts';
import { sampleBracket } from '../../../../../lib/bracket-sample.ts';

/** B3, the public bracket. Double elimination is the shape it must survive. */
export function getStaticPaths() {
  return [{ params: { organization: 'liga-mendocina', tournament: 'apertura-2026', stage: '1' } }];
}

const { organization, tournament, stage } = Astro.params;
const model = buildOverview({
  ...sampleOverview(organization ?? 'liga-mendocina', tournament ?? 'apertura-2026'),
  stageNumber: Number(stage ?? 1),
});
---

<PublicLayout title={`Llave — ${displayName(model)}`} canonicalPath={model.canonicalPath}>
  <h1>Llave</h1>
  <BracketView matches={sampleBracket()} />
  <ResultLegend />
</PublicLayout>
