const params = Astro.url.searchParams;
const langParam = params.get('lang');
const language: SupportedLanguage = isSupportedLanguage(langParam) ? langParam : 'en';
const t = messages[language];
let organizationsResponse;
try {
  organizationsResponse = await fetchOrganizations();
} catch {
  organizationsResponse = undefined;
}
const organizations = organizationsResponse ?? [];
const requestedOrganization = params.get('organization');
const selectedOrganization =
  organizations.find((item) => item.alias === requestedOrganization) ?? organizations[0];
let tournaments: NonNullable<
  Awaited<ReturnType<typeof fetchOrganizationTournaments>>
>['tournaments'] = [];
let loadFailed = false;
if (organizationsResponse === undefined) loadFailed = true;
if (selectedOrganization) {
  try {
    const response = await fetchOrganizationTournaments(selectedOrganization.alias);
    if (!response) loadFailed = true;
    tournaments = response?.tournaments ?? [];
  } catch {
    loadFailed = true;
  }
}
const requestedTournament = params.get('tournament');
const selectedTournament =
  tournaments.find((item) => item.alias === requestedTournament) ?? tournaments[0];
let matchChoices: { stage: number; match: number; label: string }[] = [];
let selectedDisciplineBackground: ReturnType<typeof selectDisciplineBackground>;
if (selectedOrganization && selectedTournament) {
  try {
    const [overview, matchesView] = await Promise.all([
      fetchOverview(selectedOrganization.alias, selectedTournament.alias),
      fetchMatchesView(selectedOrganization.alias, selectedTournament.alias),
    ]);
    if (!overview || !matchesView) loadFailed = true;
    const stages = new Set((overview?.matches ?? []).map((item) => item.stageNumber));
    selectedDisciplineBackground = selectDisciplineBackground(overview?.disciplineImages);
    const matches = mapMatchesViewResponse(matchesView ?? { matches: [] }).matches;
    for (const item of matches) stages.add(item.stageNumber);
    for (const stage of stages) {
      for (const match of matches.filter((item) => item.stageNumber === stage)) {
        matchChoices.push({
          stage,
          match: match.matchNumber,
          label: `#${match.matchNumber} · ${match.homeName ?? 'TBD'} — ${match.awayName ?? 'TBD'}`,
        });
      }
    }
  } catch {
    loadFailed = true;
  }
}
const viewParam = params.get('view');
const view = ['dashboard', 'standings', 'matches', 'overlay'].includes(viewParam ?? '')
  ? viewParam!
  : 'dashboard';
const requestedBackground = params.get('bg') ?? params.get('background');
const background =
  TV_BACKGROUNDS.find((value) => value === requestedBackground && value !== 'transparent') ??
  'discipline';
const initialStage = Number(params.get('stage')) || matchChoices[0]?.stage;
const stageMatches = matchChoices.filter((item) => item.stage === initialStage);
const initialMatch = Number(params.get('match')) || stageMatches[0]?.match;
const backdropDiscipline = selectedTournament?.discipline.descriptorId ?? 'football';
---

<TvLayout title={t.title} background={background}>
  <main
    class="tv-launcher"
    data-tv-launcher
    data-background={background}
    data-discipline={backdropDiscipline}
    data-has-discipline={String(Boolean(selectedDisciplineBackground))}
  >
    {
      selectedDisciplineBackground && (
        <img
          class="tv-launcher__discipline"
          data-discipline-image
          data-active={background === 'discipline' ? 'true' : 'false'}
          src={selectedDisciplineBackground.url}
          alt=""
          aria-hidden="true"
          style={`opacity:${selectedDisciplineBackground.opacity}`}
        />
      )
    }
    <div class="tv-launcher__backdrop" aria-hidden="true"></div>
    <section class="tv-launcher__panel" aria-labelledby="tv-launcher-title">
      <h1 id="tv-launcher-title">{t.title}</h1>
      <p class="tv-launcher__intro">{t.intro}</p>
      {
        organizations.length === 0 ? (
          <p role="status">{loadFailed ? t.loadError : t.emptyOrganizations}</p>
        ) : (
          <form
            class="tv-launcher__form"
            data-match-options={encodeURIComponent(JSON.stringify(matchChoices))}
          >
            <label>
              {t.organization}
              <select name="organization" data-launcher-organization>
                {organizations.map((org) => (
                  <option value={org.alias} selected={org.alias === selectedOrganization?.alias}>
                    {org.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              {t.tournament}
              <select name="tournament" data-launcher-tournament>
                {tournaments.map((tournament) => (
                  <option
                    value={tournament.alias}
                    selected={tournament.alias === selectedTournament?.alias}
                  >
                    {tournament.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              {t.view}
              <select name="view" data-launcher-view>
                {(['dashboard', 'standings', 'matches', 'overlay'] as const).map((item) => (
                  <option value={item} selected={item === view}>
                    {t[item]}
                  </option>
                ))}
              </select>
            </label>
            <div
              class="tv-launcher__match-fields"
              data-match-fields
              hidden={!['matches'].includes(view)}
            >
              <label>
                {t.stage}
                <select data-launcher-stage>
                  {Array.from(new Set(matchChoices.map((item) => item.stage))).map((stage) => (
                    <option value={stage} selected={stage === initialStage}>
                      {stage}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                {t.match}
                <select data-launcher-match>
                  {stageMatches.map((item) => (
                    <option value={item.match} selected={item.match === initialMatch}>
                      {item.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>
            {view === 'matches' && matchChoices.length === 0 && (
              <p role="status" class="tv-launcher__notice">
                {t.noMatches}
              </p>
            )}
            <label>
              {t.background}
              <select name="bg" data-launcher-background>
                {(['discipline', 'neutral', 'chroma', 'football', 'court'] as const).map((item) => (
                  <option value={item} selected={item === background}>
                    {t[item]}
                  </option>
                ))}
              </select>
            </label>
            <label>
              {t.language}
              <select name="lang" data-launcher-language>
                {(['en', 'es', 'fr', 'pt', 'it', 'de', 'ru', 'zh'] as const).map((item) => (
                  <option value={item} selected={item === language}>
                    {item.toUpperCase()}
                  </option>
                ))}
              </select>
            </label>
            {loadFailed && (
              <p role="status" class="tv-launcher__notice">
                {t.loadError}
              </p>
            )}
            {selectedOrganization && tournaments.length === 0 && !loadFailed && (
              <p role="status" class="tv-launcher__notice">
                {t.unavailable}
              </p>
            )}
            <a class="tv-launcher__launch" data-launcher-link href="#">
              {t.launch}
              <span aria-hidden="true">↗</span>
            </a>
            {selectedOrganization && (
              <a
                class="tv-launcher__public"
                href={`/${encodeURIComponent(selectedOrganization.alias)}`}
              >
                {t.publicSite} ↗
              </a>
            )}
          </form>
        )
      }
    </section>
  </main>
</TvLayout>

<script>
  import { buildTvLauncherDestination, parseTvLauncherPreset } from '../../lib/tv-launcher.js';
  import type { TvBackground } from '../../lib/tv-background.js';

  const root = document.querySelector<HTMLElement>('[data-tv-launcher]');
  const form = root?.querySelector<HTMLFormElement>('.tv-launcher__form');
  if (root && form) {
    const organization = form.querySelector<HTMLSelectElement>('[data-launcher-organization]');
    const tournament = form.querySelector<HTMLSelectElement>('[data-launcher-tournament]');
    const view = form.querySelector<HTMLSelectElement>('[data-launcher-view]');
    const background = form.querySelector<HTMLSelectElement>('[data-launcher-background]');
    const language = form.querySelector<HTMLSelectElement>('[data-launcher-language]');
    const stage = form.querySelector<HTMLSelectElement>('[data-launcher-stage]');
    const match = form.querySelector<HTMLSelectElement>('[data-launcher-match]');
    const matchFields = form.querySelector<HTMLElement>('[data-match-fields]');
    const launch = form.querySelector<HTMLAnchorElement>('[data-launcher-link]');
    let matchChoices: { stage: number; match: number; label: string }[] = [];
    try {
      matchChoices = JSON.parse(decodeURIComponent(form.dataset.matchOptions ?? ''));
    } catch {
      matchChoices = [];
    }

    const readPreset = (): void => {
      if (
        !organization?.value ||
        !tournament?.value ||
        !view?.value ||
        !background?.value ||
        !language?.value
      )
        return;
      const preset = {
        organization: organization.value,
        tournament: tournament.value,
        view: view.value,
        background: background.value,
        language: language.value,
        stage: Number(stage?.value),
        match: Number(match?.value),
      };
      try {
        localStorage.setItem('copalibre.tv.launcher_preset', JSON.stringify(preset));
      } catch {
        /* Storage can be disabled by kiosk policy. */
      }
      root.dataset.background = background.value;
      document.documentElement.dataset.tvBackground = background.value as TvBackground;
      const disciplineImage = root.querySelector<HTMLElement>('[data-discipline-image]');
      disciplineImage?.setAttribute('data-active', String(background.value === 'discipline'));
      matchFields?.toggleAttribute('hidden', view.value !== 'matches');
      const href = buildTvLauncherDestination({
        ...preset,
        view: view.value as 'dashboard' | 'standings' | 'matches' | 'overlay',
        background: background.value as Exclude<TvBackground, 'transparent'>,
        language: language.value,
        ...(view.value === 'matches'
          ? { stage: Number(stage?.value), match: Number(match?.value) }
          : {}),
      });
      const matchUnavailable = view.value === 'matches' && (!stage?.value || !match?.value);
      if (launch) {
        launch.href = matchUnavailable ? '#' : href;
        launch.setAttribute('aria-disabled', String(matchUnavailable));
      }
      root.dataset.tvBackground = background.value;
    };
    const refreshMatches = (): void => {
      if (!stage || !match) return;
      const selectedStage = Number(stage.value);
      const options = matchChoices.filter((item) => item.stage === selectedStage);
      match.replaceChildren(
        ...options.map((item) => {
          const option = document.createElement('option');
          option.value = String(item.match);
          option.textContent = item.label;
          return option;
        }),
      );
      readPreset();
    };
    const restore = (): void => {
      try {
        const saved = parseTvLauncherPreset(
          JSON.parse(localStorage.getItem('copalibre.tv.launcher_preset') ?? 'null'),
        );
        if (!saved) return;
        const url = new URL(window.location.href);
        if (
          ['organization', 'tournament', 'view', 'bg', 'lang'].some((key) =>
            url.searchParams.has(key),
          )
        )
          return;
        if (
          !url.searchParams.has('organization') &&
          (organization?.value !== saved.organization || tournament?.value !== saved.tournament)
        ) {
          if (
            organization &&
            [...organization.options].some((option) => option.value === saved.organization)
          ) {
            const restored = new URLSearchParams({
              organization: saved.organization,
              tournament: saved.tournament,
              view: saved.view,
              bg: saved.background,
              lang: saved.language,
              ...(saved.stage === undefined ? {} : { stage: String(saved.stage) }),
              ...(saved.match === undefined ? {} : { match: String(saved.match) }),
            });
            window.location.replace(`/tv?${restored}`);
          }
          return;
        }
        if (view && [...view.options].some((option) => option.value === saved.view))
          view.value = saved.view;
        if (
          background &&
          [...background.options].some((option) => option.value === saved.background)
        )
          background.value = saved.background;
        if (language && [...language.options].some((option) => option.value === saved.language))
          language.value = saved.language;
        if (
          tournament &&
          [...tournament.options].some((option) => option.value === saved.tournament)
        )
          tournament.value = saved.tournament;
        if (stage && [...stage.options].some((option) => Number(option.value) === saved.stage))
          stage.value = String(saved.stage);
        refreshMatches();
        if (
          match &&
          saved.match !== undefined &&
          [...match.options].some((option) => Number(option.value) === saved.match)
        )
          match.value = String(saved.match);
      } catch {
        /* Invalid or unavailable local storage leaves server defaults in place. */
      }
    };
    organization?.addEventListener('change', () => form.requestSubmit());
    tournament?.addEventListener('change', () => form.requestSubmit());
    stage?.addEventListener('change', refreshMatches);
    form.addEventListener('change', readPreset);
    launch?.addEventListener('click', (event) => {
      if (launch.getAttribute('aria-disabled') === 'true') event.preventDefault();
    });
    restore();
    readPreset();
  }
</script>

<style>
  .tv-launcher {
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: clamp(1rem, 4vw, 3rem);
    isolation: isolate;
  }
  .tv-launcher__backdrop {
    position: fixed;
    z-index: -1;
    inset: 0;
    background: var(--cl-surface-base);
    transition: background 240ms ease;
  }
  .tv-launcher__discipline {
    position: fixed;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px);
    transform: scale(1.06);
  }
  .tv-launcher__discipline[data-active='false'] {
    display: none;
  }
  .tv-launcher[data-background='chroma'] .tv-launcher__backdrop {
    background: #00b140;
  }
  .tv-launcher[data-background='football'] .tv-launcher__backdrop {
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 12.4%,
        rgb(255 255 255 / 10%) 12.5% 12.6%,
        transparent 12.7% 25%
      ),
      radial-gradient(
        ellipse,
        transparent 0 24%,
        rgb(255 255 255 / 42%) 24.2% 24.5%,
        transparent 24.7%
      ),
      linear-gradient(135deg, #287a45, #164c31);
  }
  .tv-launcher[data-background='court'] .tv-launcher__backdrop {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 20%) 0 1px, transparent 1px 12.5%),
      radial-gradient(
        ellipse,
        transparent 0 20%,
        rgb(255 255 255 / 45%) 20.2% 20.5%,
        transparent 20.7%
      ),
      linear-gradient(110deg, #795032, #49301f);
  }
  .tv-launcher[data-background='discipline'] .tv-launcher__backdrop {
    background: linear-gradient(135deg, rgb(8 14 11 / 25%), rgb(8 14 11 / 65%));
  }
  .tv-launcher[data-background='discipline'][data-has-discipline='false'] .tv-launcher__backdrop {
    background: radial-gradient(
      ellipse at 25% 20%,
      color-mix(in srgb, var(--cl-state-positive) 48%, var(--cl-surface-base)),
      var(--cl-surface-base) 64%
    );
  }
  .tv-launcher__panel {
    width: min(100%, 38rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    box-sizing: border-box;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--cl-text-primary);
    background: var(--cl-surface-panel);
    border: 1px solid var(--cl-border-muted);
    border-radius: var(--cl-radius-md);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 55%);
  }
  .tv-launcher h1 {
    margin: 0;
    font-size: clamp(var(--cl-font-size-xl), 4vw, var(--cl-font-size-3xl));
  }
  .tv-launcher__intro {
    margin: 0.5rem 0 1.5rem;
    color: var(--cl-text-secondary);
  }
