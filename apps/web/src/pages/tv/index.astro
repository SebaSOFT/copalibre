    view: '视图',
    dashboard: '轮播面板',
    standings: '排名',
    matches: '固定比赛',
    overlay: '直播叠加层',
    stage: '阶段',
    match: '比赛',
    background: '背景',
    discipline: '项目',
    neutral: '中性',
    chroma: '色键绿',
    football: '足球场',
    court: '室内球场',
    language: '语言',
    launch: '启动电视屏幕',
    unavailable: '此组织没有已发布的赛事。',
    loadError: '赛事数据暂时不可用。',
    noMatches: '此赛事没有可固定的比赛。',
