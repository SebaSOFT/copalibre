---
import TvLayout from '../../layouts/TvLayout.astro';
import {
  fetchCompletion,
  fetchOrganizations,
  fetchOrganizationTournaments,
  fetchOverview,
  fetchMatchesView,
  mapMatchesViewResponse,
} from '../../lib/public-api-client.ts';
import { TV_BACKGROUNDS } from '../../lib/tv-background.ts';
import { selectDisciplineBackground } from '../../lib/discipline-background.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { TV_LAUNCHER_LABELS } from '../../lib/tv-launcher-labels.ts';
import {
  courtOptions,
  COURT_VALUE_PREFIX,
  matchOptionGroups,
  stageOptions,
  viewShowsMatch,
  type TvLauncherMatchChoice,
} from '../../lib/tv-launcher.ts';

export const prerender = false;

const VIEWS = ['dashboard', 'standings', 'matches', 'match', 'overlay'] as const;
/** The label key each view's option reads. */
const VIEW_LABEL = {
  dashboard: 'dashboard',
  standings: 'standings',
  matches: 'matchList',
  match: 'pinnedMatch',
  overlay: 'overlay',
} as const;

const params = Astro.url.searchParams;
const langParam = params.get('lang');
const language: SupportedLanguage = isSupportedLanguage(langParam) ? langParam : 'en';
const t = TV_LAUNCHER_LABELS[language];
let organizationsResponse;
try {
  organizationsResponse = await fetchOrganizations();
} catch {
  organizationsResponse = undefined;
}
const organizations = organizationsResponse ?? [];
const requestedOrganization = params.get('organization');
const selectedOrganization =
  organizations.find((item) => item.alias === requestedOrganization) ?? organizations[0];
let tournaments: NonNullable<
  Awaited<ReturnType<typeof fetchOrganizationTournaments>>
>['tournaments'] = [];
let loadFailed = false;
if (organizationsResponse === undefined) loadFailed = true;
if (selectedOrganization) {
  try {
    const response = await fetchOrganizationTournaments(selectedOrganization.alias);
    if (!response) loadFailed = true;
    tournaments = response?.tournaments ?? [];
  } catch {
    loadFailed = true;
  }
}
const requestedTournament = params.get('tournament');
const selectedTournament =
  tournaments.find((item) => item.alias === requestedTournament) ?? tournaments[0];

/*
  The matches the launcher can pin, each with its stage's name, its zone and group and its round.
  A match is named the way the public match route names it, by stage and ordinal in the stage,
  which the matches view already reports as `matchNumber`.
*/
let matchChoices: TvLauncherMatchChoice[] = [];
let selectedDisciplineBackground: ReturnType<typeof selectDisciplineBackground>;
if (selectedOrganization && selectedTournament) {
  try {
    const [overview, matchesView, completion] = await Promise.all([
      fetchOverview(selectedOrganization.alias, selectedTournament.alias),
      fetchMatchesView(selectedOrganization.alias, selectedTournament.alias),
      fetchCompletion(selectedOrganization.alias, selectedTournament.alias),
    ]);
    if (!overview || !matchesView) loadFailed = true;
    selectedDisciplineBackground = selectDisciplineBackground(overview?.disciplineImages);
    const stageNames = new Map(
      (completion?.stages ?? []).map((stage) => [stage.stageNumber, stage.stageName]),
    );
    matchChoices = mapMatchesViewResponse(matchesView ?? { matches: [] }).matches.map((match) => ({
      stage: match.stageNumber,
      stageName: stageNames.get(match.stageNumber) ?? '',
      match: match.matchNumber,
      ...(match.round === undefined ? {} : { round: match.round }),
      ...(match.zoneName === undefined ? {} : { zone: match.zoneName }),
      ...(match.groupName === undefined ? {} : { group: match.groupName }),
      home: match.homeName ?? 'TBD',
      away: match.awayName ?? 'TBD',
      ...(match.venueName === undefined ? {} : { venue: match.venueName }),
    }));
  } catch {
    loadFailed = true;
  }
}
const viewParam = params.get('view');
// An address made when `matches` meant the pinned match still means it.
const view: (typeof VIEWS)[number] =
  viewParam === 'matches' && params.has('stage') && params.has('match')
    ? 'match'
    : (VIEWS.find((item) => item === viewParam) ?? 'dashboard');
const requestedBackground = params.get('bg') ?? params.get('background');
const background =
  TV_BACKGROUNDS.find((value) => value === requestedBackground && value !== 'transparent') ??
  'discipline';
const stages = stageOptions(matchChoices);
const initialStage = Number(params.get('stage')) || stages[0]?.stage;
const initialMatch = Number(params.get('match')) || undefined;
const courts = courtOptions(matchChoices);
const initialCourt = params.get('court') ?? undefined;
const matchGroups =
  initialStage === undefined ? [] : matchOptionGroups(matchChoices, initialStage, t.round ?? '');
const matchFieldsShown = viewShowsMatch(view);
const noMatchesShown = matchFieldsShown && matchChoices.length === 0;
const backdropDiscipline = selectedTournament?.discipline.descriptorId ?? 'football';
---

<TvLayout title={t.title} background={background}>
  <main
    class="tv-launcher"
    data-tv-launcher
    data-background={background}
    data-discipline={backdropDiscipline}
    data-has-discipline={String(Boolean(selectedDisciplineBackground))}
  >
    {
      selectedDisciplineBackground && (
        <img
          class="tv-launcher__discipline"
          data-discipline-image
          data-active={background === 'discipline' ? 'true' : 'false'}
          src={selectedDisciplineBackground.url}
          alt=""
          aria-hidden="true"
          style={`opacity:${selectedDisciplineBackground.opacity}`}
        />
      )
    }
    <div class="tv-launcher__backdrop" aria-hidden="true"></div>
    <section class="tv-launcher__panel cl-chamfer" aria-labelledby="tv-launcher-title">
      <h1 id="tv-launcher-title" data-i18n="title">{t.title}</h1>
      <p class="tv-launcher__intro" data-i18n="intro">{t.intro}</p>
      {
        organizations.length === 0 ? (
          <p role="status" data-i18n={loadFailed ? 'loadError' : 'emptyOrganizations'}>
            {loadFailed ? t.loadError : t.emptyOrganizations}
          </p>
        ) : (
          <form
            class="tv-launcher__form"
            data-match-options={encodeURIComponent(JSON.stringify(matchChoices))}
          >
            <label>
              <span data-i18n="organization">{t.organization}</span>
              <select
                class="cl-chamfer cl-chamfer--control"
                name="organization"
                data-launcher-organization
              >
                {organizations.map((org) => (
                  <option value={org.alias} selected={org.alias === selectedOrganization?.alias}>
                    {org.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <span data-i18n="tournament">{t.tournament}</span>
              <select
                class="cl-chamfer cl-chamfer--control"
                name="tournament"
                data-launcher-tournament
              >
                {tournaments.map((tournament) => (
                  <option
                    value={tournament.alias}
                    selected={tournament.alias === selectedTournament?.alias}
                  >
                    {tournament.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <span data-i18n="view">{t.view}</span>
              <select class="cl-chamfer cl-chamfer--control" name="view" data-launcher-view>
                {VIEWS.map((item) => (
                  <option value={item} selected={item === view} data-i18n={VIEW_LABEL[item]}>
                    {t[VIEW_LABEL[item]]}
                  </option>
                ))}
              </select>
            </label>
            <div class="tv-launcher__match-fields" data-match-fields hidden={!matchFieldsShown}>
              <label>
                <span data-i18n="stage">{t.stage}</span>
                <select class="cl-chamfer cl-chamfer--control" data-launcher-stage>
                  {stages.map((item) => (
                    <option value={item.stage} selected={item.stage === initialStage}>
                      {item.label}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <span data-i18n="match">{t.match}</span>
                <select class="cl-chamfer cl-chamfer--control" data-launcher-match>
                  {view === 'overlay' && courts.length > 0 && (
                    <optgroup label={t.courtGroup} data-i18n="courtGroup">
                      {courts.map((venue) => (
                        <option
                          value={`${COURT_VALUE_PREFIX}${venue}`}
                          selected={venue === initialCourt && initialMatch === undefined}
                        >
                          {venue}
                        </option>
                      ))}
                    </optgroup>
                  )}
                  {matchGroups.map((group) => (
                    <optgroup label={group.heading}>
                      {group.options.map((item) => (
                        <option value={item.match} selected={item.match === initialMatch}>
                          {item.label}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </label>
            </div>
            <p
              role="status"
              class="tv-launcher__notice"
              data-i18n="noMatches"
              data-no-matches
              hidden={!noMatchesShown}
            >
              {t.noMatches}
            </p>
            <label>
              <span data-i18n="background">{t.background}</span>
              <select class="cl-chamfer cl-chamfer--control" name="bg" data-launcher-background>
                {(['discipline', 'neutral', 'chroma', 'football', 'court'] as const).map((item) => (
                  <option value={item} selected={item === background} data-i18n={item}>
                    {t[item]}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <span data-i18n="language">{t.language}</span>
              <select class="cl-chamfer cl-chamfer--control" name="lang" data-launcher-language>
                {(['en', 'es', 'fr', 'pt', 'it', 'de', 'ru', 'zh'] as const).map((item) => (
                  <option value={item} selected={item === language}>
                    {item.toUpperCase()}
                  </option>
                ))}
              </select>
            </label>
            {loadFailed && (
              <p role="status" class="tv-launcher__notice" data-i18n="loadError">
                {t.loadError}
              </p>
            )}
            {selectedOrganization && tournaments.length === 0 && !loadFailed && (
              <p role="status" class="tv-launcher__notice" data-i18n="unavailable">
                {t.unavailable}
              </p>
            )}
            <a
              class="tv-launcher__launch cl-chamfer cl-chamfer--control"
              data-launcher-link
              href="#"
            >
              <span data-i18n="launch">{t.launch}</span>
              <span aria-hidden="true">↗</span>
            </a>
            {selectedOrganization && (
              <a
                class="tv-launcher__public"
                href={`/${encodeURIComponent(selectedOrganization.alias)}`}
              >
                <span data-i18n="publicSite">{t.publicSite}</span> ↗
              </a>
            )}
          </form>
        )
      }
    </section>
  </main>
</TvLayout>

<script>
  import { TV_LAUNCHER_LABELS } from '../../lib/tv-launcher-labels.js';
  import {
    buildTvLauncherDestination,
    courtOptions,
    COURT_VALUE_PREFIX,
    matchOptionGroups,
    parseTvLauncherPreset,
    viewShowsMatch,
    type TvLauncherMatchChoice,
    type TvLauncherView,
  } from '../../lib/tv-launcher.js';
  import type { TvBackground } from '../../lib/tv-background.js';

  type Language = keyof typeof TV_LAUNCHER_LABELS;

  const root = document.querySelector<HTMLElement>('[data-tv-launcher]');
  const form = root?.querySelector<HTMLFormElement>('.tv-launcher__form');
  if (root && form) {
    const organization = form.querySelector<HTMLSelectElement>('[data-launcher-organization]');
    const tournament = form.querySelector<HTMLSelectElement>('[data-launcher-tournament]');
    const view = form.querySelector<HTMLSelectElement>('[data-launcher-view]');
    const background = form.querySelector<HTMLSelectElement>('[data-launcher-background]');
    const language = form.querySelector<HTMLSelectElement>('[data-launcher-language]');
    const stage = form.querySelector<HTMLSelectElement>('[data-launcher-stage]');
    const match = form.querySelector<HTMLSelectElement>('[data-launcher-match]');
    const matchFields = form.querySelector<HTMLElement>('[data-match-fields]');
    const noMatches = form.querySelector<HTMLElement>('[data-no-matches]');
    const launch = form.querySelector<HTMLAnchorElement>('[data-launcher-link]');
    let choices: TvLauncherMatchChoice[] = [];
    try {
      choices = JSON.parse(decodeURIComponent(form.dataset.matchOptions ?? ''));
    } catch {
      choices = [];
    }

    const labelsFor = (): Readonly<Record<string, string>> =>
      TV_LAUNCHER_LABELS[(language?.value ?? 'en') as Language] ?? TV_LAUNCHER_LABELS.en;

    // The match options of the chosen stage, grouped by zone and group, with the round's word in the
    // chosen language. The overlay alone may leave the match to the live one, so only it has that option.
    const renderMatches = (): void => {
      if (!stage || !match || !view) return;
      const labels = labelsFor();
      const previous = match.value;
      const overlay = view.value === 'overlay';
      const courtGroup = document.createElement('optgroup');
      courtGroup.dataset.i18n = 'courtGroup';
      courtGroup.label = labels.courtGroup ?? '';
      courtGroup.append(
        ...courtOptions(choices).map((venue) => {
          const option = document.createElement('option');
          option.value = `${COURT_VALUE_PREFIX}${venue}`;
          option.textContent = venue;
          return option;
        }),
      );
      const groups = matchOptionGroups(choices, Number(stage.value), labels.round ?? '').map(
        (group) => {
          const element = document.createElement('optgroup');
          element.label = group.heading;
          element.append(
            ...group.options.map((item) => {
              const option = document.createElement('option');
              option.value = String(item.match);
              option.textContent = item.label;
              return option;
            }),
          );
          return element;
        },
      );
      match.replaceChildren(
        ...(overlay && courtGroup.children.length > 0 ? [courtGroup] : []),
        ...groups,
      );
      const usable = [...match.options].filter((option) => !option.disabled);
      match.value = usable.some((option) => option.value === previous)
        ? previous
        : (usable[0]?.value ?? '');
    };

    // Every label the page rendered, again in the chosen language: no reload, so the other
    // selections stay as they are.
    const applyLabels = (): void => {
      const labels = labelsFor();
      for (const element of root.querySelectorAll<HTMLElement>('[data-i18n]')) {
        const text = labels[element.dataset.i18n ?? ''];
        if (text === undefined) continue;
        if (element instanceof HTMLOptGroupElement) element.label = text;
        else element.textContent = text;
      }
      document.documentElement.lang = language?.value ?? 'en';
      if (labels.title) document.title = labels.title;
      renderMatches();
    };

    const readPreset = (): void => {
      if (
        !organization?.value ||
        !tournament?.value ||
        !view?.value ||
        !background?.value ||
        !language?.value
      )
        return;
      const showsMatch = viewShowsMatch(view.value);
      const stageNumber = Number(stage?.value);
      const matchValue = match?.value ?? '';
      const court = matchValue.startsWith(COURT_VALUE_PREFIX)
        ? matchValue.slice(COURT_VALUE_PREFIX.length)
        : undefined;
      const matchNumber = court === undefined ? Number(matchValue) : Number.NaN;
      const preset = {
        organization: organization.value,
        tournament: tournament.value,
        view: view.value as TvLauncherView,
        background: background.value as Exclude<TvBackground, 'transparent'>,
        language: language.value,
        ...(showsMatch && stageNumber > 0 && matchNumber > 0
          ? { stage: stageNumber, match: matchNumber }
          : {}),
        ...(view.value === 'overlay' && court !== undefined ? { court } : {}),
      };
      try {
        localStorage.setItem('copalibre.tv.launcher_preset', JSON.stringify(preset));
      } catch {
        /* Storage can be disabled by kiosk policy. */
      }
      root.dataset.background = background.value;
      document.documentElement.dataset.tvBackground = background.value as TvBackground;
      const disciplineImage = root.querySelector<HTMLElement>('[data-discipline-image]');
      disciplineImage?.setAttribute('data-active', String(background.value === 'discipline'));
      matchFields?.toggleAttribute('hidden', !showsMatch);
      noMatches?.toggleAttribute('hidden', !(showsMatch && choices.length === 0));
      // The pinned view cannot launch without a match; the overlay may, and then shows the live one.
      const matchUnavailable = view.value === 'match' && !(stageNumber > 0 && matchNumber > 0);
      const href = buildTvLauncherDestination(preset);
      if (launch) {
        launch.href = matchUnavailable ? '#' : href;
        launch.setAttribute('aria-disabled', String(matchUnavailable));
      }
    };
    const restore = (): void => {
      try {
        const saved = parseTvLauncherPreset(
          JSON.parse(localStorage.getItem('copalibre.tv.launcher_preset') ?? 'null'),
        );
        if (!saved) return;
        const url = new URL(window.location.href);
        if (
          ['organization', 'tournament', 'view', 'bg', 'lang'].some((key) =>
            url.searchParams.has(key),
          )
        )
          return;
        if (organization?.value !== saved.organization || tournament?.value !== saved.tournament) {
          if (
            organization &&
            [...organization.options].some((option) => option.value === saved.organization)
          ) {
            const restored = new URLSearchParams({
              organization: saved.organization,
              tournament: saved.tournament,
              view: saved.view,
              bg: saved.background,
              lang: saved.language,
              ...(saved.stage === undefined ? {} : { stage: String(saved.stage) }),
              ...(saved.match === undefined ? {} : { match: String(saved.match) }),
              ...(saved.court === undefined ? {} : { court: saved.court }),
            });
            window.location.replace(`/tv?${restored}`);
          }
          return;
        }
        const choose = (select: HTMLSelectElement | null, value: string): void => {
          if (select && [...select.options].some((option) => option.value === value))
            select.value = value;
        };
        choose(view, saved.view);
        choose(background, saved.background);
        choose(language, saved.language);
        choose(tournament, saved.tournament);
        choose(stage, String(saved.stage));
        applyLabels();
        if (saved.match !== undefined) choose(match, String(saved.match));
        if (saved.court !== undefined) choose(match, `${COURT_VALUE_PREFIX}${saved.court}`);
      } catch {
        /* Invalid or unavailable local storage leaves server defaults in place. */
      }
    };
    organization?.addEventListener('change', () => form.requestSubmit());
    tournament?.addEventListener('change', () => form.requestSubmit());
    stage?.addEventListener('change', () => {
      renderMatches();
      readPreset();
    });
    let shownView = view?.value;
    view?.addEventListener('change', () => {
      renderMatches();
      // Arriving at the overlay starts it on its first choice: a court when there are any.
      if (match && view.value === 'overlay' && shownView !== 'overlay')
        match.value = [...match.options].find((option) => !option.disabled)?.value ?? '';
      shownView = view.value;
    });
    language?.addEventListener('change', () => {
      applyLabels();
      // The address keeps the language, so a reload or a shared link opens in it.
      const url = new URL(window.location.href);
      url.searchParams.set('lang', language.value);
      window.history.replaceState(null, '', url);
    });
    form.addEventListener('change', readPreset);
    launch?.addEventListener('click', (event) => {
      if (launch.getAttribute('aria-disabled') === 'true') event.preventDefault();
    });
    restore();
    readPreset();
  }
</script>

<style>
  /* The document sets no typeface of its own (the dashboard sets its own on its container), so
     everything here inherited the browser's default serif: the launcher names its faces. */
  .tv-launcher {
    font-family: var(--cl-font-body);
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: clamp(1rem, 4vw, 3rem);
    isolation: isolate;
  }
  .tv-launcher__backdrop {
    position: fixed;
    z-index: -1;
    inset: 0;
    background: var(--cl-surface-base);
    transition: background 240ms ease;
  }
  .tv-launcher__discipline {
    position: fixed;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px);
    transform: scale(1.06);
  }
  .tv-launcher__discipline[data-active='false'] {
    display: none;
  }
  .tv-launcher[data-background='chroma'] .tv-launcher__backdrop {
    background: var(--tv-chroma);
  }
  .tv-launcher[data-background='football'] .tv-launcher__backdrop {
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 12.4%,
        color-mix(in srgb, var(--cl-text-primary) 10%, transparent) 12.5% 12.6%,
        transparent 12.7% 25%
      ),
      radial-gradient(
        ellipse,
        transparent 0 24%,
        color-mix(in srgb, var(--cl-text-primary) 42%, transparent) 24.2% 24.5%,
        transparent 24.7%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--cl-state-positive) 70%, var(--cl-surface-base)),
        color-mix(in srgb, var(--cl-state-positive) 36%, var(--cl-surface-base))
      );
  }
  .tv-launcher[data-background='court'] .tv-launcher__backdrop {
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--cl-text-primary) 20%, transparent) 0 1px,
        transparent 1px 12.5%
      ),
      radial-gradient(
        ellipse,
        transparent 0 20%,
        color-mix(in srgb, var(--cl-text-primary) 45%, transparent) 20.2% 20.5%,
        transparent 20.7%
      ),
      linear-gradient(
        110deg,
        color-mix(in srgb, var(--cl-state-upcoming) 40%, var(--cl-surface-base)),
        color-mix(in srgb, var(--cl-state-upcoming) 22%, var(--cl-surface-base))
      );
  }
  .tv-launcher[data-background='discipline'] .tv-launcher__backdrop {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cl-surface-base) 25%, transparent),
      color-mix(in srgb, var(--cl-surface-base) 65%, transparent)
    );
  }
  .tv-launcher[data-background='discipline'][data-has-discipline='false'] .tv-launcher__backdrop {
    background: radial-gradient(
      ellipse at 25% 20%,
      color-mix(in srgb, var(--cl-state-positive) 48%, var(--cl-surface-base)),
      var(--cl-surface-base) 64%
    );
  }
  .tv-launcher__panel {
    width: min(100%, 38rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    box-sizing: border-box;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--cl-text-primary);
    background: var(--cl-surface-panel);
    border: 1px solid var(--cl-border-muted);
    box-shadow: 0 24px 48px -12px color-mix(in srgb, var(--cl-surface-base) 55%, transparent);
  }
  .tv-launcher h1 {
    margin: 0;
    font-family: var(--cl-font-display);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: clamp(var(--cl-font-size-xl), 4vw, var(--cl-font-size-3xl));
  }
  .tv-launcher__intro {
    margin: 0.5rem 0 1.5rem;
    color: var(--cl-text-secondary);
  }
  .tv-launcher__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .tv-launcher__form label {
    display: grid;
    gap: 0.4rem;
    color: var(--cl-text-secondary);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tv-launcher select {
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    color: var(--cl-text-primary);
    background: var(--cl-surface-base);
    border: 1px solid var(--cl-border-muted);
    font: inherit;
    font-family: var(--cl-font-body);
    font-size: var(--cl-font-size-base);
    letter-spacing: normal;
    text-transform: none;
  }
  .tv-launcher__match-fields {
    display: contents;
  }
  .tv-launcher__match-fields[hidden] {
    display: none;
  }
  .tv-launcher__launch {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    color: var(--cl-surface-base);
    background: var(--cl-primary);
    font-family: var(--cl-font-display);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
