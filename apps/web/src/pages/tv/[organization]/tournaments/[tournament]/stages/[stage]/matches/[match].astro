---
import TvLayout from '../../../../../../../../layouts/TvLayout.astro';
import { publicIntl, tvStatisticsLabels } from '../../../../../../../../lib/i18n/public-intl.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { TvDashboard } from '../../../../../../../../components/TvDashboard.tsx';
import { tvStreamPath } from '@copalibre/routing';
import { sampleDashboard } from '../../../../../../../../lib/live-sample.ts';
import {
  fetchLive,
  fetchOverview,
  mapLiveResponse,
  mapOverviewResponse,
  tournamentEmblemUrl,
} from '../../../../../../../../lib/public-api-client.ts';
import type { PublicObjectReference } from '../../../../../../../../lib/discipline-background.ts';
import type { LiveDashboard } from '../../../../../../../../lib/live-state.ts';
import type { ResultState } from '../../../../../../../../lib/result-state.ts';

export const prerender = false;

const { organization, tournament, match } = Astro.params;
const organizationAlias = organization ?? 'liga-mendocina';
const tournamentAlias = tournament ?? 'apertura-2026';
const matchNumber = Number(match ?? '1');
const streamPath = tvStreamPath({ organizationAlias, tournamentAlias });

let dashboard: LiveDashboard = {
  matches: [],
  standingsVersion: 0,
  usingLastKnown: true,
};
let tournamentName = tournamentAlias;
let organizationName = organizationAlias;
let tournamentEmblem: string | undefined;
let clubs: { name: string; emblemObjectId?: string }[] = [];
/* The kiosk carries the tournament's own discipline imagery, the same source the
 * public pages already render. An overlay never does — see TvLayout. */
let disciplineImages: PublicObjectReference[] | undefined;

try {
  const [live, overview] = await Promise.all([
    fetchLive(organizationAlias, tournamentAlias),
    fetchOverview(organizationAlias, tournamentAlias),
  ]);

  if (overview) {
    const mappedOverview = mapOverviewResponse(overview);
    disciplineImages = overview.disciplineImages;
    tournamentName = mappedOverview.tournamentName || tournamentAlias;
    organizationName = mappedOverview.organizationName || organizationAlias;
    if (mappedOverview.emblemObjectId) {
      tournamentEmblem = tournamentEmblemUrl(organizationAlias, tournamentAlias);
    }
    if (mappedOverview.clubs) {
      clubs = mappedOverview.clubs.map((c) => ({
        name: c.name,
        emblemObjectId: c.emblemObjectId,
      }));
    }

    if (live && live.matches.length > 0) {
      dashboard = mapLiveResponse(live);
    } else if (mappedOverview.matches.length > 0) {
      dashboard = {
        standingsVersion: 0,
        usingLastKnown: true,
        matches: mappedOverview.matches.map((m, idx) => ({
          matchId: `overview-${m.stageNumber}-${m.matchNumber ?? idx + 1}`,
          stageNumber: m.stageNumber,
          matchNumber: m.matchNumber ?? idx + 1,
          state: m.state as ResultState,
          projectionVersion: 0,
          sides: [
            {
              entrantId: `home-${idx}`,
              name: m.home.name,
              abbreviation: m.home.abbreviation,
              score: m.home.score ?? 0,
              state: m.state as ResultState,
            },
            {
              entrantId: `away-${idx}`,
              name: m.away.name,
              abbreviation: m.away.abbreviation,
              score: m.away.score ?? 0,
              state: m.state as ResultState,
            },
          ],
        })),
      };
    } else if (organizationAlias === 'liga-mendocina') {
      dashboard = sampleDashboard();
    }
  } else if (organizationAlias === 'liga-mendocina') {
    dashboard = sampleDashboard();
  }
} catch {
  dashboard = sampleDashboard();
}

/*
 * The presentation is a property of the request, resolved here so the very
 * first response already carries it. `overlay` stays valid as the name an
 * existing OBS browser source is already configured with.
 */
const modeParam = Astro.url.searchParams.get('mode');
const overlayMode =
  modeParam === 'overlay' || modeParam === 'overlay-lower'
    ? 'lower'
    : modeParam === 'overlay-full'
      ? 'full'
      : undefined;
const chromaKey = Astro.url.searchParams.get('chroma') ?? undefined;
const presentation = overlayMode ?? 'kiosk';

/* Same query-param language the tournament kiosk takes; TV routes carry no locale segment. */
const langParam = Astro.url.searchParams.get('lang');
const language: SupportedLanguage = isSupportedLanguage(langParam) ? langParam : 'en';
---

<TvLayout
  title={`TV — ${tournamentName} — Partido ${matchNumber}`}
  overlayMode={overlayMode}
  chromaKey={chromaKey}
  disciplineImages={disciplineImages}
>
  <TvDashboard
    labels={tvStatisticsLabels(publicIntl(language))}
    language={language}
    client:load
    presentation={presentation}
    initial={dashboard}
    streamPath={streamPath}
    branding={tournamentEmblem ? { logoUrl: tournamentEmblem } : undefined}
    pinnedMatchNumber={matchNumber}
    tournamentName={tournamentName}
    organizationName={organizationName}
    organizationAlias={organizationAlias}
    tournamentAlias={tournamentAlias}
    clubs={clubs}
  />
</TvLayout>
