---
import TvLayout from '../../../../../../../../layouts/TvLayout.astro';
import {
  publicIntl,
  tvDashboardLabels,
  tvStatisticsLabels,
} from '../../../../../../../../lib/i18n/public-intl.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { TvDashboard } from '../../../../../../../../components/tv/TvDashboard.tsx';
import { tvStreamPath } from '@copalibre/routing';
import { sampleDashboard } from '../../../../../../../../lib/live-sample.ts';
import {
  fetchLive,
  fetchMatchReport,
  fetchOverview,
  fetchBracket,
  mapLiveResponse,
  mapOverviewResponse,
  mapBracketResponse,
  clubEmblemUrl,
  tournamentEmblemUrl,
} from '../../../../../../../../lib/public-api-client.ts';
import {
  buildActorDirectory,
  buildTvMatchEvents,
  type TvMatchEvent,
} from '../../../../../../../../lib/tv-match-events.ts';
import type { PublicObjectReference } from '../../../../../../../../lib/discipline-background.ts';
import type { LiveDashboard } from '../../../../../../../../lib/live-state.ts';
import {
  dashboardFromOverview,
  lastMatchAt,
  overlayLive,
} from '../../../../../../../../lib/tv-dashboard-source.ts';
import type { StandingsRowView } from '../../../../../../../../lib/overview.ts';
import type { TvWinnerZone } from '../../../../../../../../components/tv/tv-types.ts';
import { winnerZonesOf } from '../../../../../../../../lib/tv-winners.ts';
import { bracketZonesOf } from '../../../../../../../../lib/bracket.ts';
import type { BracketZone } from '../../../../../../../../lib/bracket-projection.ts';
import { TV_BACKGROUNDS, type TvBackground } from '../../../../../../../../lib/tv-background.ts';

export const prerender = false;

const { organization, tournament, stage, match } = Astro.params;
const organizationAlias = organization ?? 'liga-mendocina';
const tournamentAlias = tournament ?? 'apertura-2026';
const stageNumber = Number(stage ?? '1');
// Named the way the public match route names it: by its ordinal within the stage.
const matchOrdinal = Number(match ?? '1');
const streamPath = tvStreamPath({ organizationAlias, tournamentAlias });

// Reuses the same fetch the public match report page makes (`fetchMatchReport`) — a second
// consumer of that data, not a new endpoint. Kept in its own guard, same
// reasoning as the ticker/standings fetch on the general kiosk route: a failure here must cost
// only the event ticker, never replace the whole live dashboard with sample data.
let matchEvents: readonly TvMatchEvent[] = [];
let rosterActors: Readonly<Record<string, string>> = {};
try {
  const report = await fetchMatchReport(
    organizationAlias,
    tournamentAlias,
    stageNumber,
    matchOrdinal,
  );
  if (report) {
    matchEvents = buildTvMatchEvents(report);
    // Resolves a *live* event's actor the same way the initial
    // timeline above already resolves one, for `BroadcastAlertBanner`.
    rosterActors = buildActorDirectory(report.rosters);
  }
} catch {
  matchEvents = [];
}

let dashboard: LiveDashboard = {
  matches: [],
  standingsVersion: 0,
  usingLastKnown: true,
};
let tournamentName = tournamentAlias;
let organizationName = organizationAlias;
let tournamentEmblem: string | undefined;
let clubs: { name: string; emblemUrl?: string }[] = [];
let winnerZones: readonly TvWinnerZone[] = [];
/* The kiosk carries the tournament's own discipline imagery, the same source the
 * public pages already render. An overlay never does — see TvLayout. */
let disciplineImages: PublicObjectReference[] | undefined;
let standings: StandingsRowView[] = [];
let organizationTimeZone: string | undefined;
let overviewLastMatchAt: string | undefined;

try {
  const [live, overview] = await Promise.all([
    fetchLive(organizationAlias, tournamentAlias),
    fetchOverview(organizationAlias, tournamentAlias),
  ]);

  if (overview) {
    const mappedOverview = mapOverviewResponse(overview);
    disciplineImages = overview.disciplineImages;
    tournamentName = mappedOverview.tournamentName || tournamentAlias;
    organizationName = mappedOverview.organizationName || organizationAlias;
    if (mappedOverview.emblemObjectId) {
      tournamentEmblem = tournamentEmblemUrl(organizationAlias, tournamentAlias);
    }
    winnerZones = winnerZonesOf(organizationAlias, mappedOverview.winners);
    if (mappedOverview.clubs) {
      clubs = mappedOverview.clubs.map((c) => ({
        name: c.name,
        ...(c.emblemObjectId ? { emblemUrl: clubEmblemUrl(organizationAlias, c.clubId) } : {}),
      }));
    }
    standings = mappedOverview.standings ? [...mappedOverview.standings] : [];
    organizationTimeZone = mappedOverview.organizationTimeZone;
    overviewLastMatchAt = lastMatchAt(mappedOverview.matches);

    // The pinned match need not be in progress, so the live projection is laid over every match
    // of the overview rather than standing in for them.
    const fromOverview = dashboardFromOverview(mappedOverview.matches);
    if (live && live.matches.length > 0) {
      dashboard = overlayLive(fromOverview, mapLiveResponse(live));
    } else if (mappedOverview.matches.length > 0) {
      dashboard = fromOverview;
    } else if (organizationAlias === 'liga-mendocina') {
      dashboard = sampleDashboard();
    }
  } else if (organizationAlias === 'liga-mendocina') {
    dashboard = sampleDashboard();
  }
} catch {
  dashboard = sampleDashboard();
}

/*
 * The presentation is a property of the request, resolved here so the very
 * first response already carries it. `overlay` stays valid as the name an
 * existing OBS browser source is already configured with.
 */
const modeParam = Astro.url.searchParams.get('mode');
const overlayMode =
  modeParam === 'overlay' || modeParam === 'overlay-lower'
    ? 'lower'
    : modeParam === 'overlay-full'
      ? 'full'
      : undefined;
const chromaKey = Astro.url.searchParams.get('chroma') ?? undefined;
const requestedBackground =
  Astro.url.searchParams.get('bg') ?? Astro.url.searchParams.get('background');
const background = TV_BACKGROUNDS.find((value) => value === requestedBackground) as
  TvBackground | undefined;
const presentation = overlayMode ?? 'kiosk';

let initialBracket: { stageNumber: number; zones: readonly BracketZone[] } | undefined;
if (presentation !== 'lower') {
  try {
    const rawBracket = await fetchBracket(organizationAlias, tournamentAlias, stageNumber);
    if (rawBracket) {
      const mapped = mapBracketResponse(rawBracket);
      const zones = bracketZonesOf(mapped);
      if (zones.length > 0) {
        initialBracket = { stageNumber, zones };
      }
    }
  } catch {
    // A bracket outage does not affect the pinned match or event ticker.
  }
}

/* Same query-param language the tournament kiosk takes; TV routes carry no locale segment. */
const langParam = Astro.url.searchParams.get('lang');
const language: SupportedLanguage = isSupportedLanguage(langParam) ? langParam : 'en';
---

<TvLayout
  title={`TV — ${tournamentName} — Partido ${matchOrdinal}`}
  overlayMode={overlayMode}
  chromaKey={chromaKey}
  background={background}
  disciplineImages={disciplineImages}
>
  <TvDashboard
    labels={tvStatisticsLabels(publicIntl(language))}
    dashboardLabels={tvDashboardLabels(publicIntl(language))}
    language={language}
    client:load
    presentation={presentation}
    initial={dashboard}
    initialBracket={initialBracket}
    streamPath={streamPath}
    branding={tournamentEmblem ? { logoUrl: tournamentEmblem } : undefined}
    pinnedMatch={{ stageNumber, ordinal: matchOrdinal }}
    timeZone={organizationTimeZone}
    lastMatchAt={overviewLastMatchAt}
    matchEvents={matchEvents}
    rosterActors={rosterActors}
    tournamentName={tournamentName}
    organizationName={organizationName}
    organizationAlias={organizationAlias}
    tournamentAlias={tournamentAlias}
    clubs={clubs}
    winners={winnerZones}
    standings={standings}
  />
</TvLayout>
