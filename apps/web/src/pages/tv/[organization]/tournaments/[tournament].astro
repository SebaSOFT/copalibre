---
import TvLayout from '../../../../layouts/TvLayout.astro';
import ScoreTicker from '../../../../components/ui/organisms/ScoreTicker.astro';
import { TvDashboard } from '../../../../components/tv/TvDashboard.tsx';
import { tvStreamPath } from '@copalibre/routing';
import { sampleDashboard } from '../../../../lib/live-sample.ts';
import {
  fetchLive,
  fetchOverview,
  mapLiveResponse,
  mapOverviewResponse,
  tournamentEmblemUrl,
} from '../../../../lib/public-api-client.ts';
import type { PublicObjectReference } from '../../../../lib/discipline-background.ts';
import type { LiveDashboard } from '../../../../lib/live-state.ts';
import type { ResultState } from '../../../../lib/result-state.ts';
import type { OverviewMatch, StandingsRowView } from '../../../../lib/overview.ts';
import type { TopPerformer } from '../../../../lib/tv-statistics.ts';
import { buildTickerItems } from '../../../../lib/ticker-items.ts';
import {
  publicIntl,
  tickerChromeLabels,
  tickerLabels,
  tvDashboardLabels,
  tvStatisticsLabels,
} from '../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import {
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
} from '../../../../lib/public-api-client.ts';
import type { TableProjectionResponse } from '@copalibre/api/src/dto/table-projections.dto.js';

export const prerender = false;

const { organization, tournament } = Astro.params;
const organizationAlias = organization ?? 'liga-mendocina';
const tournamentAlias = tournament ?? 'apertura-2026';
const streamPath = tvStreamPath({ organizationAlias, tournamentAlias });

/*
  A TV route carries no locale segment, so the language comes from the query the
  same way `mode` and `chroma` already do. English is the default a venue gets
  without asking, not a claim that TV is English-only.
*/
const langParam = Astro.url.searchParams.get('lang');
const language: SupportedLanguage = isSupportedLanguage(langParam) ? langParam : 'en';
const intl = publicIntl(language);

let dashboard: LiveDashboard = {
  matches: [],
  standingsVersion: 0,
  usingLastKnown: true,
};
let tournamentName = tournamentAlias;
let organizationName = organizationAlias;
let tournamentEmblem: string | undefined;
let clubs: { name: string; emblemObjectId?: string }[] = [];
/* The kiosk carries the tournament's own discipline imagery, the same source the
 * public pages already render. An overlay never does — see TvLayout. */
let disciplineImages: PublicObjectReference[] | undefined;

let standings: StandingsRowView[] = [];
let topPerformers: TopPerformer[] = [];
let performerProjection: TableProjectionResponse | undefined;
let leaderProjection: TableProjectionResponse | undefined;
let overviewMatches: readonly OverviewMatch[] = [];

try {
  const [live, overview] = await Promise.all([
    fetchLive(organizationAlias, tournamentAlias),
    fetchOverview(organizationAlias, tournamentAlias),
  ]);

  if (overview) {
    const mappedOverview = mapOverviewResponse(overview);
    disciplineImages = overview.disciplineImages;
    tournamentName = mappedOverview.tournamentName || tournamentAlias;
    organizationName = mappedOverview.organizationName || organizationAlias;
    if (mappedOverview.emblemObjectId) {
      tournamentEmblem = tournamentEmblemUrl(organizationAlias, tournamentAlias);
    }
    standings = mappedOverview.standings ? [...mappedOverview.standings] : [];
    overviewMatches = mappedOverview.matches;

    if (mappedOverview.clubs) {
      clubs = mappedOverview.clubs.map((c) => ({
        name: c.name,
        emblemObjectId: c.emblemObjectId,
      }));
    }

    if (live && live.matches.length > 0) {
      dashboard = mapLiveResponse(live);
    } else if (mappedOverview.matches.length > 0) {
      dashboard = {
        standingsVersion: 0,
        usingLastKnown: true,
        matches: mappedOverview.matches.map((m, idx) => ({
          matchId: `overview-${m.stageNumber}-${m.matchNumber ?? idx + 1}`,
          stageNumber: m.stageNumber,
          matchNumber: m.matchNumber ?? idx + 1,
          state: m.state as ResultState,
          projectionVersion: 0,
          sides: [
            {
              entrantId: `home-${idx}`,
              name: m.home.name,
              abbreviation: m.home.abbreviation,
              score: m.home.score ?? 0,
              state: m.state as ResultState,
            },
            {
              entrantId: `away-${idx}`,
              name: m.away.name,
              abbreviation: m.away.abbreviation,
              score: m.away.score ?? 0,
              state: m.state as ResultState,
            },
          ],
        })),
      };
    } else if (organizationAlias === 'liga-mendocina') {
      dashboard = sampleDashboard();
    }
  } else if (organizationAlias === 'liga-mendocina') {
    dashboard = sampleDashboard();
  }
} catch {
  dashboard = sampleDashboard();
}

/*
  The ticker's own projections, read in their own guard.
  Deliberately outside the block above: a failure here must cost the ticker its
  items and nothing else. Folded into that try, a table read that 404s would
  have been caught by its `catch` and replaced the whole live dashboard with
  sample data — a broadcast showing invented scores because a statistics table
  was missing.
*/
try {
  const layouts = await fetchPublicTableLayouts(organizationAlias, tournamentAlias);
  const declared = layouts?.layouts ?? [];
  const performerLayout = declared.find((one) => one.target === 'player-ranking');
  const groupLayout = declared.find((one) => one.target === 'group-phase');
  const earliestStage = overviewMatches.reduce(
    (earliest, match) => Math.min(earliest, match.stageNumber),
    Infinity,
  );
  [performerProjection, leaderProjection] = await Promise.all([
    performerLayout
      ? fetchPublicTableProjection(organizationAlias, tournamentAlias, performerLayout.code)
      : Promise.resolve(undefined),
    groupLayout && Number.isFinite(earliestStage)
      ? fetchPublicTableProjection(
          organizationAlias,
          tournamentAlias,
          groupLayout.code,
          earliestStage,
        )
      : Promise.resolve(undefined),
  ]);
} catch {
  performerProjection = undefined;
  leaderProjection = undefined;
}

/*
 * The presentation is a property of the request, resolved here so the very
 * first response already carries it. `overlay` stays valid as the name an
 * existing OBS browser source is already configured with.
 */
const modeParam = Astro.url.searchParams.get('mode');
const overlayMode =
  modeParam === 'overlay' || modeParam === 'overlay-lower'
    ? 'lower'
    : modeParam === 'overlay-full'
      ? 'full'
      : undefined;
const chromaKey = Astro.url.searchParams.get('chroma') ?? undefined;
const presentation = overlayMode ?? 'kiosk';

/*
  The overlay presentations exist to leave the frame clear for the footage they
  are composited over, so the rail is a kiosk-only fixture.
*/
const tickerChrome = tickerChromeLabels(intl);
const tickerItems =
  presentation === 'kiosk'
    ? buildTickerItems({
        matches: overviewMatches,
        ...(performerProjection === undefined ? {} : { performers: performerProjection }),
        ...(leaderProjection === undefined ? {} : { leaders: leaderProjection }),
        labels: tickerLabels(intl),
        language,
      })
    : [];
---

<TvLayout
  title={`TV — ${tournamentName}`}
  overlayMode={overlayMode}
  chromaKey={chromaKey}
  disciplineImages={disciplineImages}
>
  <ScoreTicker
    emptyLabel={tickerChrome.empty}
    items={tickerItems}
    label={intl.formatMessage(messages.tickerLabel)}
    pauseLabel={tickerChrome.pause}
    resumeLabel={tickerChrome.resume}
    scale="tv"
    staleLabel={tickerChrome.stale}
  />
  <TvDashboard
    client:load
    presentation={presentation}
    initial={dashboard}
    streamPath={streamPath}
    branding={tournamentEmblem ? { logoUrl: tournamentEmblem } : undefined}
    tournamentName={tournamentName}
    organizationName={organizationName}
    organizationAlias={organizationAlias}
    tournamentAlias={tournamentAlias}
    clubs={clubs}
    standings={standings}
    topPerformers={topPerformers}
    performerProjection={performerProjection}
    labels={tvStatisticsLabels(intl)}
    dashboardLabels={tvDashboardLabels(intl)}
    language={language}
  />
</TvLayout>
