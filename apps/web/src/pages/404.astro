---
import { ControlOrNotFound } from '../control/components/ControlOrNotFound.tsx';
import PublicLayout from '../layouts/PublicLayout.astro';
import Container from '../components/ui/atoms/layout/Container.astro';
import { Card } from '../components/ui/atoms/Card.tsx';
import Button from '../components/ui/atoms/Button.astro';
import { resolvePathLocale, getLocaleHomePath } from '../lib/locale.ts';
import { publicIntl } from '../lib/i18n/public-intl.ts';
import { messages } from '../lib/i18n/public-messages.en.ts';

export const prerender = false;

const locale = resolvePathLocale(Astro.url.searchParams.get('locale') ?? Astro.url.pathname);
const intl = publicIntl(locale);
const homeUrl = getLocaleHomePath(locale);
const liveMatchesUrl = `/tv?lang=${locale}&view=dashboard`;
---

<PublicLayout
  title={intl.formatMessage(messages.notFoundPageTitle)}
  canonicalPath="/404"
  noindex={true}
  intl={intl}
>
  <Container variant="reading">
    <div id="static-not-found" class="cl-not-found">
      <Card as="section" className="cl-not-found__card">
        <p class="cl-not-found__numeral" aria-hidden="true">
          404
        </p>
        <h1 class="cl-not-found__heading">{intl.formatMessage(messages.notFoundHeading)}</h1>
        <p class="cl-not-found__body">{intl.formatMessage(messages.notFoundBody)}</p>
        <div class="cl-not-found__actions">
          <Button href={homeUrl} variant="primary">
            {intl.formatMessage(messages.notFoundTournamentsLink)}
          </Button>
          <Button href={liveMatchesUrl} variant="secondary">
            {intl.formatMessage(messages.notFoundLiveMatchesLink)}
          </Button>
        </div>
      </Card>
    </div>
  </Container>
  <ControlOrNotFound client:only="react" />
</PublicLayout>

<style>
  .cl-not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--cl-space-6);
  }

  .cl-not-found__card {
    display: grid;
    justify-items: center;
    gap: var(--cl-space-3);
    padding: var(--cl-space-8);
    text-align: center;
  }

  .cl-not-found__numeral {
    margin: 0;
    font-family: var(--cl-font-display);
    font-size: var(--cl-font-size-3xl);
    font-weight: 700;
    line-height: 1;
    color: var(--cl-text-primary);
    letter-spacing: var(--cl-tracking-wide);
  }

  .cl-not-found__heading {
    margin: 0;
    font-family: var(--cl-font-display);
    font-size: var(--cl-font-size-2xl);
    color: var(--cl-text-primary);
  }

  .cl-not-found__body {
    margin: 0;
    color: var(--cl-text-muted);
  }

  .cl-not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--cl-space-2);
    margin-block-start: var(--cl-space-2);
  }

  @media (max-width: 375px) {
    .cl-not-found__card {
      padding: var(--cl-space-6) var(--cl-space-4);
    }

    .cl-not-found__actions,
    .cl-not-found__actions :global(.cl-btn) {
      width: 100%;
    }
  }
</style>
