---
import { ControlOrNotFound } from '../control/components/ControlOrNotFound.tsx';
import '@copalibre/design-tokens/generated/copalibre.css';
import { resolvePathLocale, getLocaleHomePath } from '../lib/locale.ts';
import { publicIntl } from '../lib/i18n/public-intl.ts';
import { messages } from '../lib/i18n/public-messages.en.ts';

export const prerender = false;

const rawPath = Astro.request?.url ? new URL(Astro.request.url).pathname : Astro.url.pathname;
const locale = resolvePathLocale(rawPath);
const intl = publicIntl(locale);
const homeUrl = getLocaleHomePath(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <title>{intl.formatMessage(messages.notFoundPageTitle)}</title>
  </head>
  <body>
    <main id="static-not-found">
      <h1>{intl.formatMessage(messages.notFoundHeading)}</h1>
      <p>{intl.formatMessage(messages.notFoundBody)}</p>
      <p><a href={homeUrl}>{intl.formatMessage(messages.notFoundHomeLink)}</a></p>
    </main>
    <ControlOrNotFound client:only="react" />
  </body>
</html>
