---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import TournamentCard from '../../../components/TournamentCard.astro';
import { fetchOrganizationTournaments } from '../../../lib/public-api-client.ts';
import { publicIntl } from '../../../lib/i18n/public-intl.ts';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

export const prerender = false;

const { locale, organization } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const listData = await fetchOrganizationTournaments(organization!);
if (!listData) {
  return Astro.rewrite('/404');
}

const localePrefix = resolvedLocale === 'en' ? '' : `/${resolvedLocale}`;
const canonicalPath = `${localePrefix}/${encodeURIComponent(organization!)}/tournaments`;

const liveTournaments = listData.tournaments.filter((t) => t.status === 'live');
const upcomingTournaments = listData.tournaments.filter((t) => t.status === 'upcoming');
const finishedTournaments = listData.tournaments.filter((t) => t.status === 'finished');

const pageTitle = `${listData.organizationName} — ${intl.formatMessage(messages.tournamentsPageTitle)}`;
---

<PublicLayout title={pageTitle} canonicalPath={canonicalPath} intl={intl}>
  <div class="cl-listing-container">
    <header class="cl-listing-header">
      <div class="cl-org-badge">{listData.organizationAlias}</div>
      <h1 class="cl-org-title">{listData.organizationName}</h1>
      <p class="cl-listing-subtitle">{intl.formatMessage(messages.tournamentsPageTitle)}</p>
    </header>

    {
      listData.tournaments.length === 0 && (
        <div class="cl-empty-state">
          <p>{intl.formatMessage(messages.tournamentsEmpty)}</p>
        </div>
      )
    }

    {
      liveTournaments.length > 0 && (
        <section class="cl-listing-section cl-section-live" aria-labelledby="heading-live">
          <div class="cl-section-header">
            <span class="cl-live-dot" aria-hidden="true" />
            <h2 id="heading-live" class="cl-section-title">
              {intl.formatMessage(messages.tournamentsLiveHeading)}
            </h2>
            <span class="cl-section-count">({liveTournaments.length})</span>
          </div>
          <div class="cl-tournaments-grid cl-grid-live">
            {liveTournaments.map((t) => (
              <TournamentCard
                tournament={t}
                organizationAlias={organization!}
                localePrefix={localePrefix}
                intl={intl}
                featured={true}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      upcomingTournaments.length > 0 && (
        <section class="cl-listing-section" aria-labelledby="heading-upcoming">
          <div class="cl-section-header">
            <h2 id="heading-upcoming" class="cl-section-title">
              {intl.formatMessage(messages.tournamentsUpcomingHeading)}
            </h2>
            <span class="cl-section-count">({upcomingTournaments.length})</span>
          </div>
          <div class="cl-tournaments-grid">
            {upcomingTournaments.map((t) => (
              <TournamentCard
                tournament={t}
                organizationAlias={organization!}
                localePrefix={localePrefix}
                intl={intl}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      finishedTournaments.length > 0 && (
        <section class="cl-listing-section" aria-labelledby="heading-finished">
          <div class="cl-section-header">
            <h2 id="heading-finished" class="cl-section-title">
              {intl.formatMessage(messages.tournamentsFinishedHeading)}
            </h2>
            <span class="cl-section-count">({finishedTournaments.length})</span>
          </div>
          <div class="cl-tournaments-grid">
            {finishedTournaments.map((t) => (
              <TournamentCard
                tournament={t}
                organizationAlias={organization!}
                localePrefix={localePrefix}
                intl={intl}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</PublicLayout>

<style>
  .cl-listing-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cl-listing-header {
    border-bottom: 1px solid var(--cl-border, #334155);
    padding-bottom: 1.5rem;
  }

  .cl-org-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cl-primary, #38bdf8);
    margin-bottom: 0.25rem;
  }

  .cl-org-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
    color: var(--cl-text, #f8fafc);
  }

  .cl-listing-subtitle {
    font-size: 1.1rem;
    color: var(--cl-text-muted, #94a3b8);
    margin: 0.5rem 0 0;
  }

  .cl-listing-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cl-section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cl-section-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    color: var(--cl-text, #f8fafc);
  }

  .cl-section-count {
    font-size: 0.95rem;
    color: var(--cl-text-muted, #94a3b8);
    font-weight: 600;
  }

  .cl-live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 10px #ef4444;
    animation: cl-pulse-live 1.5s infinite;
  }

  @keyframes cl-pulse-live {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.3);
    }
  }

  .cl-tournaments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .cl-tournaments-grid {
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
  }

  .cl-grid-live {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .cl-grid-live {
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    }
  }

  .cl-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    background-color: var(--cl-surface, #1e293b);
    border-radius: 12px;
    border: 1px dashed var(--cl-border, #334155);
    color: var(--cl-text-muted, #94a3b8);
  }
</style>
