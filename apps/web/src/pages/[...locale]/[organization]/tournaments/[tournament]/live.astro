---
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import ResultLegend from '../../../../../components/ui/molecules/ResultLegend.astro';
import StateBadge from '../../../../../components/ui/atoms/StateBadge.astro';
import { Card, CardDescription, CardTitle } from '../../../../../components/ui/atoms/Card.tsx';
import { ResponsiveTimestamp } from '../../../../../components/ui/atoms/ResponsiveTimestamp.tsx';
import { LiveMatchHero } from '../../../../../components/ui/organisms/LiveMatchHero.tsx';
import StandingsTable from '../../../../../components/ui/organisms/StandingsTable.astro';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import {
  fetchLive,
  fetchOverview,
  mapOverviewResponse,
  mapLiveResponse,
} from '../../../../../lib/public-api-client.ts';
import { publicIntl, resultStateLabels } from '../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B2, the live dashboard.
 *
 * Nothing here is discipline-specific: no minimap, no possession arrow, no
 * period clock that assumes halves. A shared template that knows one sport is a
 * template every other sport has to fight.
 *
 * `[[locale]]` mirrors the tournament overview page — see its comment.
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = resultStateLabels(intl);

const overviewData = await fetchOverview(organization!, tournament!);
const liveData = await fetchLive(organization!, tournament!);
const dashboard = liveData ? mapLiveResponse(liveData) : undefined;

if (!overviewData || !dashboard) {
  return Astro.rewrite('/404');
}

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));
const localePrefix = locale ? `/${locale}` : '';
const canonicalPath = `${localePrefix}${model.canonicalPath}/live`;
const tournamentPath = `${localePrefix}${model.canonicalPath}`;
const reportPath = (stageNumber: number, matchNumber: number) =>
  `${localePrefix}${model.canonicalPath}/stages/${stageNumber}/matches/${matchNumber}`;
const upcomingMatches = model.matches.filter((match) => match.state === 'upcoming');
const nextKickoffAt = upcomingMatches
  .map((match) => match.startsAt)
  .filter((startsAt) => !Number.isNaN(Date.parse(startsAt)))
  .sort((left, right) => Date.parse(left) - Date.parse(right))[0];
const referenceDate = Date.now();
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${intl.formatMessage(messages.livePageTitle)} — ${displayName(model)}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
};
---

<PublicLayout
  title={`${intl.formatMessage(messages.livePageTitle)} — ${displayName(model)}`}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <nav aria-label={intl.formatMessage(messages.livePageBreadcrumb)} class="cl-live-breadcrumb">
    <a href={tournamentPath}>{displayName(model)}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{intl.formatMessage(messages.livePageTitle)}</span>
  </nav>
  <h1>{intl.formatMessage(messages.livePageTitle)}</h1>
  {/* The island server-renders its initial state, including the zero-live state. */}
  <LiveMatchHero
    client:idle
    initial={dashboard}
    streamPath={model.streamPath}
    usingLastKnownText={intl.formatMessage(messages.liveUsingLastKnown)}
    noMatchesText={intl.formatMessage(messages.livePageNoMatches)}
    nextKickoffText={intl.formatMessage(messages.livePageNextKickoff)}
    nextKickoffAt={nextKickoffAt}
    locale={resolvedLocale}
    referenceDate={referenceDate}
    resultStateLabels={labels}
  />

  <h2>{intl.formatMessage(messages.livePageUpcomingHeading)}</h2>
  {upcomingMatches.length === 0 && <p>{intl.formatMessage(messages.livePageNoUpcoming)}</p>}
  <div class="cl-match-card-grid">
    {
      upcomingMatches.map((match) => {
        const Wrapper = match.matchNumber === undefined ? 'div' : 'a';
        return (
          <Wrapper
            href={
              match.matchNumber === undefined
                ? undefined
                : reportPath(match.stageNumber, match.matchNumber)
            }
          >
            <Card as="article">
              <StateBadge state="upcoming" intl={intl} />
              <CardTitle>
                {match.home.name} {intl.formatMessage(messages.tickerVersus)} {match.away.name}
              </CardTitle>
              {match.startsAt && !Number.isNaN(Date.parse(match.startsAt)) && (
                <CardDescription>
                  <ResponsiveTimestamp
                    locale={resolvedLocale}
                    referenceDate={referenceDate}
                    timestamp={match.startsAt}
                  />
                </CardDescription>
              )}
            </Card>
          </Wrapper>
        );
      })
    }
  </div>

  <StandingsTable
    headingText={intl.formatMessage(messages.livePageLeadersHeading)}
    intl={intl}
    previewGrain={model.standingsGrain}
    previewRows={model.standings}
  />

  <ResultLegend
    heading={intl.formatMessage(messages.legendHeading)}
    labels={resultStateLabels(intl)}
  />
</PublicLayout>

<style>
  .cl-live-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cl-space-2);
    margin-block-end: var(--cl-space-4);
    color: var(--cl-text-muted);
  }
  .cl-live-breadcrumb a {
    color: var(--cl-text-primary);
  }
</style>
