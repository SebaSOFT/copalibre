---
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import ResultLegend from '../../../../../components/ResultLegend.astro';
import StateBadge from '../../../../../components/StateBadge.astro';
import { LiveMatchHero } from '../../../../../components/LiveMatchHero.tsx';
import { EntrantName } from '../../../../../components/EntrantName.tsx';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import {
  fetchLive,
  fetchOverview,
  mapOverviewResponse,
  mapLiveResponse,
} from '../../../../../lib/public-api-client.ts';
import { publicIntl, resultStateLabels } from '../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B2, the live dashboard.
 *
 * Nothing here is discipline-specific: no minimap, no possession arrow, no
 * period clock that assumes halves. A shared template that knows one sport is a
 * template every other sport has to fight.
 *
 * `[[locale]]` mirrors the tournament overview page — see its comment.
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = resultStateLabels(intl);

const overviewData = await fetchOverview(organization!, tournament!);
const liveData = await fetchLive(organization!, tournament!);
const dashboard = liveData ? mapLiveResponse(liveData) : undefined;

if (!overviewData || !dashboard) {
  return Astro.rewrite('/404');
}

const model = buildOverview(mapOverviewResponse(overviewData));
const localePrefix = locale ? `/${locale}` : '';
const canonicalPath = `${localePrefix}${model.canonicalPath}/live`;
const reportPath = (stageNumber: number, matchNumber: number) =>
  `${localePrefix}${model.canonicalPath}/stages/${stageNumber}/matches/${matchNumber}`;
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${intl.formatMessage(messages.livePageTitle)} — ${displayName(model)}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
};
---

<PublicLayout
  title={`${intl.formatMessage(messages.livePageTitle)} — ${displayName(model)}`}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <h1>{intl.formatMessage(messages.livePageTitle)}</h1>
  {/* Server-rendered first, so the page is right before any script runs. */}
  <section>
    {
      dashboard.matches.map((match) => (
        <a href={reportPath(match.stageNumber, match.matchNumber)}>
          <article class="cl-card cl-chamfer">
            <StateBadge state={match.state} intl={intl} />
            {match.sides.map((side) => (
              <p>
                <EntrantName client:load fullName={side.name} abbreviation={side.abbreviation} />{' '}
                {side.score}
              </p>
            ))}
          </article>
        </a>
      ))
    }
  </section>

  <h2>{intl.formatMessage(messages.livePageUpcomingHeading)}</h2>
  <ul>
    {
      model.matches
        .filter((match) => match.state === 'upcoming')
        .map((match) => (
          <li>
            {match.matchNumber === undefined ? (
              <>
                {match.home.name} vs {match.away.name} —{' '}
                <time datetime={match.startsAt}>{match.startsAt}</time>
              </>
            ) : (
              <a href={reportPath(match.stageNumber, match.matchNumber)}>
                {match.home.name} vs {match.away.name} —{' '}
                <time datetime={match.startsAt}>{match.startsAt}</time>
              </a>
            )}
          </li>
        ))
    }
  </ul>

  <h2>{intl.formatMessage(messages.livePageLeadersHeading)}</h2>
  {
    model.standingsGrain !== undefined && (
      <p class="cl-standings-grain">
        {intl.formatMessage(
          model.standingsGrain === 'series'
            ? messages.standingsGrainSeries
            : messages.standingsGrainMatch,
        )}
      </p>
    )
  }
  <table>
    <thead
      ><tr
        ><th scope="col">#</th><th scope="col">{intl.formatMessage(messages.standingsTeam)}</th><th
          scope="col">{intl.formatMessage(messages.standingsPoints)}</th
        ></tr
      ></thead
    >
    <tbody>
      {
        model.standings.map((row) => (
          <tr>
            <>
              <td>{row.position}</td>
              <td>
                <EntrantName client:load fullName={row.name} abbreviation={row.abbreviation} />
              </td>
              <td>{row.points}</td>
            </>
          </tr>
        ))
      }
    </tbody>
  </table>

  <ResultLegend intl={intl} />

  {/* The island only patches what is already on the page. */}
  <LiveMatchHero
    client:idle
    initial={dashboard}
    streamPath={model.streamPath}
    usingLastKnownText={intl.formatMessage(messages.liveUsingLastKnown)}
    resultStateLabels={labels}
  />
</PublicLayout>
