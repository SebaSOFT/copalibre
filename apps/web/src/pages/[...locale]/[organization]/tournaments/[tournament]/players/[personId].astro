---
import PublicLayout from '../../../../../../layouts/PublicLayout.astro';
import PlayerProfileView from '../../../../../../components/ui/organisms/PlayerProfileView.astro';
import {
  fetchOverview,
  fetchPlayerProfile,
  fetchPlayerStatistics,
  fetchPublicTableLayouts,
  mapOverviewResponse,
} from '../../../../../../lib/public-api-client.ts';
import { buildOverview, displayName } from '../../../../../../lib/overview.ts';
import { publicIntl } from '../../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

export const prerender = false;

const { locale, organization, tournament, personId } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const [overviewData, profile, tableLayouts] = await Promise.all([
  fetchOverview(organization!, tournament!),
  fetchPlayerProfile(organization!, tournament!, personId!),
  fetchPublicTableLayouts(organization!, tournament!),
]);

if (!overviewData || !profile) {
  return Astro.rewrite('/404');
}

// Every effective layout a spectator could select the drilldown by — never
// hardcoded to a discipline, since any installed discipline that declares a
// person-granularity player-ranking layout gets this section for free.
const statisticsLayouts = (tableLayouts?.layouts ?? []).filter(
  (one) => one.entityGranularity === 'person' || one.entityGranularity === 'player',
);
const requestedLayoutCode = Astro.url.searchParams.get('layout');
const activeStatisticsLayout =
  (requestedLayoutCode
    ? statisticsLayouts.find((one) => one.code === requestedLayoutCode)
    : undefined) ?? statisticsLayouts[0];
const statistics = activeStatisticsLayout
  ? await fetchPlayerStatistics(organization!, tournament!, personId!, activeStatisticsLayout.code)
  : undefined;

const model = buildOverview(mapOverviewResponse(overviewData));
const title = `${profile.displayName} — ${displayName(model)}`;
const localePrefix = locale ? `/${locale}` : '';
const tournamentCanonicalPath = `${localePrefix}${model.canonicalPath}`;
const canonicalPath = `${tournamentCanonicalPath}/players/${personId}`;
---

<PublicLayout
  title={title}
  description={intl.formatMessage(messages.playerProfileHeading)}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
>
  <main class="cl-player-profile-page">
    <nav class="cl-player-profile-page__back">
      <a href={tournamentCanonicalPath}>
        ← Back to {displayName(model)}
      </a>
    </nav>
    <div class="cl-card">
      <PlayerProfileView
        organizationAlias={organization!}
        profile={profile}
        intl={intl}
        canonicalPath={tournamentCanonicalPath}
        statisticsLayouts={statisticsLayouts}
        activeStatisticsLayoutCode={activeStatisticsLayout?.code}
        statistics={statistics}
      />
    </div>
  </main>
</PublicLayout>

<style>
  .cl-player-profile-page {
    max-width: 800px;
    margin: 32px auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cl-player-profile-page__back a {
    color: var(--cl-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .cl-player-profile-page__back a:hover {
    color: var(--cl-primary-hover);
    text-decoration: underline;
  }
</style>
