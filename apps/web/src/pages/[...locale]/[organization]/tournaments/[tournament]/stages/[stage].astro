---
import Breadcrumb from '../../../../../../components/ui/organisms/Breadcrumb.astro';
import Container from '../../../../../../components/ui/atoms/layout/Container.astro';
import PageHeader from '../../../../../../components/ui/organisms/PageHeader.astro';
import { publicTrail, trailBaseOf } from '../../../../../../lib/breadcrumb.ts';
import PublicLayout from '../../../../../../layouts/PublicLayout.astro';
import BracketView from '../../../../../../components/ui/organisms/BracketView.astro';
import ResultLegend from '../../../../../../components/ui/molecules/ResultLegend.astro';
import TimeZoneNote from '../../../../../../components/ui/molecules/TimeZoneNote.astro';
import StandingsTable from '../../../../../../components/ui/organisms/StandingsTable.astro';
import { MatchCard } from '../../../../../../components/ui/organisms/MatchCard.tsx';
import MatchDayList from '../../../../../../components/ui/organisms/MatchDayList.astro';
import type { MatchCardData } from '../../../../../../lib/matches-view.ts';
import { buildOverview, displayName } from '../../../../../../lib/overview.ts';
import {
  resolveZoneLayouts,
  selectStageLayout,
  matchReportUrl,
} from '../../../../../../lib/bracket.ts';
import { resolveClubFilter, zoneAnchorSlug } from '../../../../../../lib/club-page.ts';
import {
  fetchBracket,
  fetchMatchesView,
  fetchOverview,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapOverviewResponse,
  mapBracketResponse,
  mapMatchesViewResponse,
  publicTableCsvUrl,
} from '../../../../../../lib/public-api-client.ts';
import {
  publicIntl,
  matchCardLabels,
  resultStateLabels,
  timeZoneNoteLabels,
} from '../../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { getLocalizedNotFoundPath, resolvePathLocale } from '../../../../../../lib/locale.ts';
import { isPublicLocaleSegment } from '../../../../../../lib/public-route-guards.ts';

/**
 * B3, the public bracket / stage matches view.
 * Double elimination is the shape it must survive for elimination brackets;
 * non-elimination formats (round-robin, league, etc.) render the compact by-round grid.
 *
 * `[[locale]]` mirrors the tournament overview page — see its comment.
 */
export const prerender = false;

const { locale, organization, tournament, stage } = Astro.params;
if (!isPublicLocaleSegment(locale)) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvePathLocale(Astro.url.pathname)));
}
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = matchCardLabels(intl);

const stageNumber = Number(stage ?? 1);
if (Number.isNaN(stageNumber)) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvedLocale));
}

const overviewData = await fetchOverview(organization!, tournament!);
const rawBracketData = await fetchBracket(organization!, tournament!, stageNumber);
const bracketData = rawBracketData
  ? mapBracketResponse(rawBracketData, intl.formatMessage(messages.resultStateTbd))
  : undefined;

if (!overviewData || !bracketData) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvedLocale));
}

// Each zone is drawn by the format it plays. A stage whose zones all draw the same way keeps its
// single bracket-or-grid page; only a stage mixing knockout and league zones is laid out zone by zone.
const { layouts: zoneLayouts, mixed: mixedZones } = resolveZoneLayouts(
  bracketData.zones,
  bracketData.format,
);
const layoutMode = mixedZones ? 'zones' : (zoneLayouts[0] ?? selectStageLayout(bracketData.format));
const stageMatches = await fetchMatchesView(organization!, tournament!, { stageNumber }).then(
  (res) =>
    res
      ? mapMatchesViewResponse(
          res,
          intl.formatMessage(messages.personHiddenAtRequest),
          resolvedLocale,
        ).matches
      : [],
);

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));
const clubResolution = resolveClubFilter(Astro.url.searchParams, model.clubs);
if ('redirectSearch' in clubResolution) {
  const location = clubResolution.redirectSearch
    ? `${Astro.url.pathname}?${clubResolution.redirectSearch}`
    : Astro.url.pathname;
  return new Response(null, { status: 301, headers: { Location: location } });
}
const referenceDate = Date.now();
const localePrefix = locale ? `/${locale}` : '';
const stagePath = `${localePrefix}${model.canonicalPath}/stages/${stageNumber}`;
const activeClubAlias = clubResolution.activeClubAlias;
const activeClubId = clubResolution.activeClubId;
const clubFilter = activeClubAlias
  ? { club: activeClubAlias }
  : activeClubId
    ? { clubId: activeClubId }
    : undefined;

// This stage's own group-phase table (e.g. a round-robin group's standings),
// when its discipline declares one — an elimination stage naturally has
// none, and the bracket above is its own ranking.
const needsStandingsTable =
  layoutMode !== 'bracket' && (layoutMode !== 'zones' || zoneLayouts.some((l) => l !== 'bracket'));
const layoutsResponse = needsStandingsTable
  ? await fetchPublicTableLayouts(organization!, tournament!)
  : undefined;
const groupPhaseLayout = layoutsResponse?.layouts.find((one) => one.target === 'group-phase');
const standingsCsvHref = groupPhaseLayout
  ? publicTableCsvUrl(organization!, tournament!, groupPhaseLayout.code, stageNumber, clubFilter)
  : undefined;
const standingsProjection = groupPhaseLayout
  ? await fetchPublicTableProjection(
      organization!,
      tournament!,
      groupPhaseLayout.code,
      stageNumber,
      clubFilter,
    )
  : undefined;

const stageName = stageMatches[0]?.stageName?.trim();
const stageHeading =
  stageName && stageName.length > 0
    ? stageName
    : intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber });
const pageTitle = `${displayName(model)} — ${stageHeading}`;

// A zone's own group segments, keeping each group as its own table rather than merging them.
const zoneSegmentsOf = (zoneName: string | undefined) => {
  if (!standingsProjection || zoneName === undefined) return [];
  return (standingsProjection.segments ?? []).filter((segment) => segment.zoneName === zoneName);
};
const stageSegments = standingsProjection?.segments ?? [];

const structuredData = {
  '@type': 'SportsEvent' as const,
  name: pageTitle,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${stagePath}`,
};
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: displayName(model),
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, [
  {
    label: intl.formatMessage(messages.matchesViewPageTitle),
    href: `${localePrefix}${model.canonicalPath}/matches?stageNumber=${stageNumber}`,
  },
  { label: stageHeading },
]);
const reportUrlOf = (match: MatchCardData): string =>
  matchReportUrl({
    organizationAlias: organization!,
    tournamentAlias: tournament!,
    stageNumber: match.stageNumber,
    matchNumber: match.matchNumber,
    localePrefix,
  });
const zoneHeading = (name: string | undefined, index: number): string =>
  name?.trim() || intl.formatMessage(messages.bracketZoneHeading, { zone: index + 1 });
---

<PublicLayout
  tournamentHasClubs={(model.clubs ?? []).length > 0}
  title={pageTitle}
  canonicalPath={stagePath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <Container variant="public">
    <PageHeader title={pageTitle} loadingLabel={intl.formatMessage(messages.pageHeaderLoading)}>
      <Breadcrumb
        slot="breadcrumb"
        items={trail}
        ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
        collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      />
    </PageHeader>
    <TimeZoneNote
      locale={resolvedLocale}
      referenceDate={referenceDate}
      timeZone={model.organizationTimeZone}
      {...timeZoneNoteLabels(intl)}
    />
    <p>
      <a href={`${localePrefix}${model.canonicalPath}/matches?stageNumber=${stageNumber}`}>
        {intl.formatMessage(messages.matchesViewSeeAll)}
      </a>
    </p>
    {layoutMode === 'zones' ? (
      <>
        <nav aria-label={intl.formatMessage(messages.bracketZoneJumpAriaLabel)}>
          <ul class="cl-bracket-zone-jump">
            {bracketData.zones.map((zone, index) => (
              <li>
                <a href={`#cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</a>
              </li>
            ))}
          </ul>
        </nav>
        {bracketData.zones.map((zone, index) => (
          <section
            id={zone.zoneName ? zoneAnchorSlug(zone.zoneName) : undefined}
            aria-labelledby={`cl-bracket-zone-${index}`}
          >
            <h2 id={`cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</h2>
            {zoneLayouts[index] === 'bracket' ? (
              <BracketView
                headingLevel={3}
                highlightClubId={activeClubId}
                intl={intl}
                localePrefix={localePrefix}
                matches={zone.matches}
                matchesView={
                  zone.zoneName === undefined
                    ? stageMatches
                    : stageMatches.filter((match) => match.zoneName === zone.zoneName)
                }
                organizationAlias={organization!}
                organizationTimeZone={model.organizationTimeZone}
                overallPlaceOffset={zone.overallPlaceOffset}
                stageNumber={stageNumber}
                tournamentAlias={tournament!}
                zoneName={zone.zoneName}
              />
            ) : (
              <>
                <MatchDayList
                  intl={intl}
                  matches={stageMatches.filter((match) => match.zoneName === zone.zoneName)}
                  organizationAlias={organization!}
                  organizationTimeZone={model.organizationTimeZone}
                  referenceDate={referenceDate}
                  reportUrlOf={reportUrlOf}
                />
                <div class="cl-matches-view__grid cl-match-days__wide">
                  {stageMatches
                    .filter((match) => match.zoneName === zone.zoneName)
                    .map((match) => (
                      <MatchCard
                        client:load
                        headingLevel={3}
                        inZoneSection={bracketData.zones.length > 1}
                        locale={intl.locale}
                        localePrefix={localePrefix}
                        match={match}
                        labels={labels}
                        organizationAlias={organization!}
                        referenceDate={referenceDate}
                        timeZone={model.organizationTimeZone}
                        tournamentAlias={tournament!}
                        reportUrl={matchReportUrl({
                          organizationAlias: organization!,
                          tournamentAlias: tournament!,
                          stageNumber: match.stageNumber,
                          matchNumber: match.matchNumber,
                          localePrefix,
                        })}
                      />
                    ))}
                </div>
                {(() => {
                  const zoneSegments = zoneSegmentsOf(zone.zoneName);
                  if (!standingsProjection || zoneSegments.length === 0) return null;
                  if (zoneSegments.length === 1) {
                    return (
                      <StandingsTable
                        activeClubAlias={activeClubAlias}
                        activeClubId={activeClubId}
                        canonicalPath={stagePath}
                        clubs={model.clubs}
                        intl={intl}
                        layout={groupPhaseLayout}
                        organizationAlias={organization}
                        projection={{ ...standingsProjection, rows: zoneSegments[0]!.rows }}
                        csvHref={standingsCsvHref}
                        sourceZoneName={zone.zoneName}
                        tournamentAlias={tournament}
                      />
                    );
                  }
                  return (
                    <section
                      class="cl-standings-section"
                      aria-label={zoneHeading(zone.zoneName, index)}
                    >
                      <StandingsTable
                        activeClubAlias={activeClubAlias}
                        activeClubId={activeClubId}
                        canonicalPath={stagePath}
                        clubs={model.clubs}
                        intl={intl}
                        layout={groupPhaseLayout}
                        organizationAlias={organization}
                        projection={standingsProjection}
                        renderPart="header"
                        sourceZoneName={zone.zoneName}
                        tournamentAlias={tournament}
                      />
                      <div class="cl-standings-groups">
                        {zoneSegments.map((segment) => (
                          <StandingsTable
                            activeClubAlias={activeClubAlias}
                            activeClubId={activeClubId}
                            canonicalPath={stagePath}
                            chrome="table-only"
                            clubs={model.clubs}
                            heading={segment.groupName}
                            intl={intl}
                            layout={groupPhaseLayout}
                            organizationAlias={organization}
                            projection={{ ...standingsProjection, rows: segment.rows }}
                            sourceZoneName={zone.zoneName}
                            tournamentAlias={tournament}
                          />
                        ))}
                      </div>
                      <StandingsTable
                        activeClubAlias={activeClubAlias}
                        activeClubId={activeClubId}
                        canonicalPath={stagePath}
                        clubs={model.clubs}
                        csvHref={standingsCsvHref}
                        intl={intl}
                        layout={groupPhaseLayout}
                        organizationAlias={organization}
                        projection={standingsProjection}
                        renderPart="footer"
                        sourceZoneName={zone.zoneName}
                        tournamentAlias={tournament}
                      />
                    </section>
                  );
                })()}
              </>
            )}
          </section>
        ))}
        {zoneLayouts.includes('bracket') && (
          <ResultLegend
            heading={intl.formatMessage(messages.legendHeading)}
            labels={resultStateLabels(intl)}
          />
        )}
      </>
    ) : layoutMode === 'bracket' ? (
      <>
        {bracketData.zones.length > 1 && (
          <nav aria-label={intl.formatMessage(messages.bracketZoneJumpAriaLabel)}>
            <ul class="cl-bracket-zone-jump">
              {bracketData.zones.map((zone, index) => (
                <li>
                  <a href={`#cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {bracketData.zones.map((zone, index) => (
          <section
            id={zone.zoneName ? zoneAnchorSlug(zone.zoneName) : undefined}
            aria-labelledby={`cl-bracket-zone-${index}`}
          >
            {bracketData.zones.length > 1 && (
              <h2 id={`cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</h2>
            )}
            <BracketView
              headingLevel={bracketData.zones.length > 1 ? 3 : 2}
              highlightClubId={activeClubId}
              intl={intl}
              localePrefix={localePrefix}
              matches={zone.matches}
              matchesView={
                zone.zoneName === undefined
                  ? stageMatches
                  : stageMatches.filter((match) => match.zoneName === zone.zoneName)
              }
              organizationAlias={organization!}
              organizationTimeZone={model.organizationTimeZone}
              overallPlaceOffset={zone.overallPlaceOffset}
              stageNumber={stageNumber}
              tournamentAlias={tournament!}
              zoneName={zone.zoneName}
            />
          </section>
        ))}
        <ResultLegend
          heading={intl.formatMessage(messages.legendHeading)}
          labels={resultStateLabels(intl)}
        />
      </>
    ) : (
      <section aria-labelledby="stage-match-list-heading">
        <h2 class="cl-visually-hidden" id="stage-match-list-heading">
          {intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber })}
        </h2>
        <MatchDayList
          intl={intl}
          matches={stageMatches}
          organizationAlias={organization!}
          organizationTimeZone={model.organizationTimeZone}
          referenceDate={referenceDate}
          reportUrlOf={reportUrlOf}
        />
        <div class="cl-matches-view__grid cl-match-days__wide">
          {stageMatches.map((match) => (
            <MatchCard
              client:load
              headingLevel={3}
              locale={intl.locale}
              localePrefix={localePrefix}
              match={match}
              labels={labels}
              organizationAlias={organization!}
              referenceDate={referenceDate}
              timeZone={model.organizationTimeZone}
              tournamentAlias={tournament!}
              reportUrl={matchReportUrl({
                organizationAlias: organization!,
                tournamentAlias: tournament!,
                stageNumber: match.stageNumber,
                matchNumber: match.matchNumber,
                localePrefix,
              })}
            />
          ))}
        </div>
      </section>
    )}
    {standingsProjection &&
      layoutMode !== 'zones' &&
      layoutMode !== 'bracket' &&
      (stageSegments.length > 1 ? (
        <section id="standings" aria-labelledby="standings-heading" class="cl-standings-section">
          <StandingsTable
            activeClubAlias={activeClubAlias}
            activeClubId={activeClubId}
            canonicalPath={stagePath}
            clubs={model.clubs}
            intl={intl}
            layout={groupPhaseLayout}
            organizationAlias={organization}
            projection={standingsProjection}
            renderPart="header"
            tournamentAlias={tournament}
          />
          <div class="cl-standings-groups">
            {stageSegments.map((segment) => (
              <StandingsTable
                activeClubAlias={activeClubAlias}
                activeClubId={activeClubId}
                canonicalPath={stagePath}
                chrome="table-only"
                clubs={model.clubs}
                heading={segment.groupName}
                intl={intl}
                layout={groupPhaseLayout}
                organizationAlias={organization}
                projection={{ ...standingsProjection, rows: segment.rows }}
                tournamentAlias={tournament}
              />
            ))}
          </div>
          <StandingsTable
            activeClubAlias={activeClubAlias}
            activeClubId={activeClubId}
            canonicalPath={stagePath}
            clubs={model.clubs}
            csvHref={standingsCsvHref}
            intl={intl}
            layout={groupPhaseLayout}
            organizationAlias={organization}
            projection={standingsProjection}
            renderPart="footer"
            tournamentAlias={tournament}
          />
        </section>
      ) : (
        <StandingsTable
          activeClubAlias={activeClubAlias}
          activeClubId={activeClubId}
          canonicalPath={stagePath}
          clubs={model.clubs}
          intl={intl}
          layout={groupPhaseLayout}
          organizationAlias={organization}
          projection={standingsProjection}
          csvHref={standingsCsvHref}
          tournamentAlias={tournament}
        />
      ))}
  </Container>
</PublicLayout>

<style>
  .cl-bracket-zone-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cl-space-2);
    list-style: none;
    margin: 0 0 var(--cl-space-4);
    padding: 0;
  }

  .cl-standings-groups {
    display: grid;
    gap: var(--cl-space-4);
    margin-block: var(--cl-space-3);
  }
</style>
