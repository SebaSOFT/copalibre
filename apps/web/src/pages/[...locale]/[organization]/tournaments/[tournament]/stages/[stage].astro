---
import Breadcrumb from '../../../../../../components/ui/organisms/Breadcrumb.astro';
import Container from '../../../../../../components/ui/atoms/layout/Container.astro';
import PageHeader from '../../../../../../components/ui/organisms/PageHeader.astro';
import { publicTrail, trailBaseOf } from '../../../../../../lib/breadcrumb.ts';
import PublicLayout from '../../../../../../layouts/PublicLayout.astro';
import BracketView from '../../../../../../components/ui/organisms/BracketView.astro';
import ResultLegend from '../../../../../../components/ui/molecules/ResultLegend.astro';
import StandingsTable from '../../../../../../components/ui/organisms/StandingsTable.astro';
import { MatchCard } from '../../../../../../components/ui/organisms/MatchCard.tsx';
import { buildOverview, displayName } from '../../../../../../lib/overview.ts';
import {
  resolveZoneLayouts,
  selectStageLayout,
  matchReportUrl,
} from '../../../../../../lib/bracket.ts';
import {
  fetchBracket,
  fetchMatchesView,
  fetchOverview,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapOverviewResponse,
  mapBracketResponse,
  mapMatchesViewResponse,
} from '../../../../../../lib/public-api-client.ts';
import {
  publicIntl,
  matchCardLabels,
  resultStateLabels,
} from '../../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B3, the public bracket / stage matches view.
 * Double elimination is the shape it must survive for elimination brackets;
 * non-elimination formats (round-robin, league, etc.) render the compact by-round grid.
 *
 * `[[locale]]` mirrors the tournament overview page — see its comment.
 */
export const prerender = false;

const { locale, organization, tournament, stage } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = matchCardLabels(intl);

const stageNumber = Number(stage ?? 1);
if (Number.isNaN(stageNumber)) {
  return Astro.rewrite('/404');
}

const overviewData = await fetchOverview(organization!, tournament!);
const rawBracketData = await fetchBracket(organization!, tournament!, stageNumber);
const bracketData = rawBracketData ? mapBracketResponse(rawBracketData) : undefined;

if (!overviewData || !bracketData) {
  return Astro.rewrite('/404');
}

// Each zone is drawn by the format it plays. A stage whose zones all draw the same way keeps its
// single bracket-or-grid page; only a stage mixing knockout and league zones is laid out zone by zone.
const { layouts: zoneLayouts, mixed: mixedZones } = resolveZoneLayouts(
  bracketData.zones,
  bracketData.format,
);
const layoutMode = mixedZones ? 'zones' : (zoneLayouts[0] ?? selectStageLayout(bracketData.format));
const stageMatches =
  layoutMode === 'grid' || layoutMode === 'zones'
    ? await fetchMatchesView(organization!, tournament!, { stageNumber }).then((res) =>
        res
          ? mapMatchesViewResponse(res, intl.formatMessage(messages.personHiddenAtRequest)).matches
          : [],
      )
    : [];

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));
const localePrefix = locale ? `/${locale}` : '';
const stagePath = `${localePrefix}${model.canonicalPath}/stages/${stageNumber}`;
const activeClubId = Astro.url.searchParams.get('clubId') ?? undefined;

// This stage's own group-phase table (e.g. a round-robin group's standings),
// when its discipline declares one — an elimination stage naturally has
// none, and the bracket above is its own ranking.
const layoutsResponse = await fetchPublicTableLayouts(organization!, tournament!);
const groupPhaseLayout = layoutsResponse?.layouts.find((one) => one.target === 'group-phase');
const standingsProjection = groupPhaseLayout
  ? await fetchPublicTableProjection(
      organization!,
      tournament!,
      groupPhaseLayout.code,
      stageNumber,
      activeClubId,
    )
  : undefined;

const stageHeading = intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber });
const pageTitle = `${displayName(model)} — ${stageHeading}`;

// A zone's own table: the ranked blocks of the groups it holds, which the API labels with the zone.
const zoneProjection = (zoneName: string | undefined) => {
  if (!standingsProjection || zoneName === undefined) return undefined;
  const segments = (standingsProjection.segments ?? []).filter(
    (segment) => segment.zoneName === zoneName,
  );
  return segments.length === 0
    ? undefined
    : { ...standingsProjection, rows: segments.flatMap((segment) => segment.rows) };
};

const structuredData = {
  '@type': 'SportsEvent' as const,
  name: pageTitle,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${stagePath}`,
};
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: displayName(model),
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, [
  {
    label: intl.formatMessage(messages.matchesViewPageTitle),
    href: `${localePrefix}${model.canonicalPath}/matches?stageNumber=${stageNumber}`,
  },
  { label: intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber }) },
]);
const zoneHeading = (name: string | undefined, index: number): string =>
  name?.trim() || intl.formatMessage(messages.bracketZoneHeading, { zone: index + 1 });
---

<PublicLayout
  title={pageTitle}
  canonicalPath={stagePath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <Container variant="public">
    <PageHeader title={pageTitle} loadingLabel={intl.formatMessage(messages.pageHeaderLoading)}>
      <Breadcrumb
        slot="breadcrumb"
        items={trail}
        ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
        collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      />
    </PageHeader>
    <p>
      <a href={`${localePrefix}${model.canonicalPath}/matches?stageNumber=${stageNumber}`}>
        {intl.formatMessage(messages.matchesViewSeeAll)}
      </a>
    </p>
    {layoutMode === 'zones' ? (
      <>
        <nav aria-label={intl.formatMessage(messages.bracketZoneJumpAriaLabel)}>
          <ul class="cl-bracket-zone-jump">
            {bracketData.zones.map((zone, index) => (
              <li>
                <a href={`#cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</a>
              </li>
            ))}
          </ul>
        </nav>
        {bracketData.zones.map((zone, index) => (
          <section aria-labelledby={`cl-bracket-zone-${index}`}>
            <h2 id={`cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</h2>
            {zoneLayouts[index] === 'bracket' ? (
              <BracketView
                headingLevel={3}
                intl={intl}
                localePrefix={localePrefix}
                matches={zone.matches}
                organizationAlias={organization!}
                stageNumber={stageNumber}
                tournamentAlias={tournament!}
              />
            ) : (
              <>
                <div class="cl-matches-view__grid">
                  {stageMatches
                    .filter((match) => match.zoneName === zone.zoneName)
                    .map((match) => (
                      <MatchCard
                        client:load
                        headingLevel={3}
                        locale={intl.locale}
                        match={match}
                        labels={labels}
                        reportUrl={matchReportUrl({
                          organizationAlias: organization!,
                          tournamentAlias: tournament!,
                          stageNumber: match.stageNumber,
                          matchNumber: match.matchNumber,
                          localePrefix,
                        })}
                      />
                    ))}
                </div>
                {zoneProjection(zone.zoneName) && (
                  <StandingsTable
                    activeClubId={activeClubId}
                    canonicalPath={stagePath}
                    clubs={model.clubs}
                    intl={intl}
                    layout={groupPhaseLayout}
                    organizationAlias={organization}
                    projection={zoneProjection(zone.zoneName)}
                    tournamentAlias={tournament}
                  />
                )}
              </>
            )}
          </section>
        ))}
        {zoneLayouts.includes('bracket') && (
          <ResultLegend
            heading={intl.formatMessage(messages.legendHeading)}
            labels={resultStateLabels(intl)}
          />
        )}
      </>
    ) : layoutMode === 'bracket' ? (
      <>
        {bracketData.zones.length > 1 && (
          <nav aria-label={intl.formatMessage(messages.bracketZoneJumpAriaLabel)}>
            <ul class="cl-bracket-zone-jump">
              {bracketData.zones.map((zone, index) => (
                <li>
                  <a href={`#cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {bracketData.zones.map((zone, index) => (
          <section aria-labelledby={`cl-bracket-zone-${index}`}>
            {bracketData.zones.length > 1 && (
              <h2 id={`cl-bracket-zone-${index}`}>{zoneHeading(zone.zoneName, index)}</h2>
            )}
            <BracketView
              headingLevel={bracketData.zones.length > 1 ? 3 : 2}
              intl={intl}
              localePrefix={localePrefix}
              matches={zone.matches}
              organizationAlias={organization!}
              stageNumber={stageNumber}
              tournamentAlias={tournament!}
            />
          </section>
        ))}
        <ResultLegend
          heading={intl.formatMessage(messages.legendHeading)}
          labels={resultStateLabels(intl)}
        />
      </>
    ) : (
      <section aria-labelledby="stage-match-list-heading">
        <h2 class="cl-visually-hidden" id="stage-match-list-heading">
          {intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber })}
        </h2>
        <div class="cl-matches-view__grid">
          {stageMatches.map((match) => (
            <MatchCard
              client:load
              headingLevel={3}
              locale={intl.locale}
              match={match}
              labels={labels}
              reportUrl={matchReportUrl({
                organizationAlias: organization!,
                tournamentAlias: tournament!,
                stageNumber: match.stageNumber,
                matchNumber: match.matchNumber,
                localePrefix,
              })}
            />
          ))}
        </div>
      </section>
    )}
    {standingsProjection && layoutMode !== 'zones' && (
      <StandingsTable
        activeClubId={activeClubId}
        canonicalPath={stagePath}
        clubs={model.clubs}
        intl={intl}
        layout={groupPhaseLayout}
        organizationAlias={organization}
        projection={standingsProjection}
        tournamentAlias={tournament}
      />
    )}
  </Container>
</PublicLayout>

<style>
  .cl-bracket-zone-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cl-space-2);
    list-style: none;
    margin: 0 0 var(--cl-space-4);
    padding: 0;
  }
</style>
