---
import PublicLayout from '../../../../../../layouts/PublicLayout.astro';
import BracketView from '../../../../../../components/BracketView.astro';
import ResultLegend from '../../../../../../components/ResultLegend.astro';
import StandingsPreview from '../../../../../../components/StandingsPreview.astro';
import { buildOverview, displayName } from '../../../../../../lib/overview.ts';
import {
  fetchBracket,
  fetchOverview,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapOverviewResponse,
  mapBracketResponse,
} from '../../../../../../lib/public-api-client.ts';
import { publicIntl } from '../../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B3, the public bracket. Double elimination is the shape it must survive.
 *
 * `[[locale]]` mirrors the tournament overview page — see its comment.
 */
export const prerender = false;

const { locale, organization, tournament, stage } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const stageNumber = Number(stage ?? 1);
if (Number.isNaN(stageNumber)) {
  return Astro.rewrite('/404');
}

const overviewData = await fetchOverview(organization!, tournament!);
const rawBracketData = await fetchBracket(organization!, tournament!, stageNumber);
const bracketData = rawBracketData ? mapBracketResponse(rawBracketData) : undefined;

if (!overviewData || !bracketData) {
  return Astro.rewrite('/404');
}

const model = buildOverview(mapOverviewResponse(overviewData));
const localePrefix = locale ? `/${locale}` : '';
const stagePath = `${localePrefix}${model.canonicalPath}/stages/${stageNumber}`;
const activeClubId = Astro.url.searchParams.get('clubId') ?? undefined;

// This stage's own group-phase table (e.g. a round-robin group's standings),
// when its discipline declares one — an elimination stage naturally has
// none, and the bracket above is its own ranking.
const layoutsResponse = await fetchPublicTableLayouts(organization!, tournament!);
const groupPhaseLayout = layoutsResponse?.layouts.find((one) => one.target === 'group-phase');
const standingsProjection = groupPhaseLayout
  ? await fetchPublicTableProjection(
      organization!,
      tournament!,
      groupPhaseLayout.code,
      stageNumber,
      activeClubId,
    )
  : undefined;

const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${intl.formatMessage(messages.bracketPageTitle)} — ${displayName(model)}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${stagePath}`,
};
---

<PublicLayout
  title={`${intl.formatMessage(messages.bracketPageTitle)} — ${displayName(model)}`}
  canonicalPath={stagePath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <h1>{intl.formatMessage(messages.bracketPageTitle)}</h1>
  <p>
    <a href={`${localePrefix}${model.canonicalPath}/matches?stageNumber=${stageNumber}`}>
      {intl.formatMessage(messages.matchesViewSeeAll)}
    </a>
  </p>
  <BracketView
    intl={intl}
    localePrefix={localePrefix}
    matches={bracketData.matches}
    organizationAlias={organization!}
    stageNumber={stageNumber}
    tournamentAlias={tournament!}
  />
  <ResultLegend intl={intl} />
  {
    standingsProjection && (
      <StandingsPreview
        activeClubId={activeClubId}
        canonicalPath={stagePath}
        clubs={model.clubs}
        intl={intl}
        layout={groupPhaseLayout}
        organizationAlias={organization}
        projection={standingsProjection}
        tournamentAlias={tournament}
      />
    )
  }
</PublicLayout>
