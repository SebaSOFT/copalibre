---
import PublicLayout from '../../../../../../../../layouts/PublicLayout.astro';
import Container from '../../../../../../../../components/ui/atoms/layout/Container.astro';
import Breadcrumb from '../../../../../../../../components/ui/organisms/Breadcrumb.astro';
import PageHeader from '../../../../../../../../components/ui/organisms/PageHeader.astro';
import { publicTrail, trailBaseOf } from '../../../../../../../../lib/breadcrumb.ts';
import MatchHero from '../../../../../../../../components/ui/organisms/MatchHero.astro';
import MatchOfficials from '../../../../../../../../components/ui/organisms/MatchOfficials.astro';
import MatchRosters from '../../../../../../../../components/ui/organisms/MatchRosters.astro';
import MatchTimeline from '../../../../../../../../components/ui/organisms/MatchTimeline.astro';
import MatchBracketContext from '../../../../../../../../components/ui/organisms/MatchBracketContext.astro';
import { buildMatchReport } from '../../../../../../../../lib/match-report.ts';
import {
  fetchBracket,
  fetchMatchReport,
  mapBracketResponse,
} from '../../../../../../../../lib/public-api-client.ts';
import { selectStageLayout } from '../../../../../../../../lib/bracket.ts';
import { humanizeCode } from '../../../../../../../../lib/descriptor-label.ts';
import { messages } from '../../../../../../../../lib/i18n/public-messages.en.ts';
import {
  publicIntl,
  resultStateLabels,
  sideSourceLabels,
  formatDateTime,
} from '../../../../../../../../lib/i18n/public-intl.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { getLocalizedNotFoundPath } from '../../../../../../../../lib/locale.ts';

export const prerender = false;

const { locale, organization, tournament, stage, match } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const notFoundPath = getLocalizedNotFoundPath(resolvedLocale);
const stageNumber = Number(stage);
const matchNumber = Number(match);

if (
  !Number.isSafeInteger(stageNumber) ||
  stageNumber < 1 ||
  !Number.isSafeInteger(matchNumber) ||
  matchNumber < 1
) {
  return Astro.rewrite(notFoundPath);
}

const response = await fetchMatchReport(organization!, tournament!, stageNumber, matchNumber);
if (!response) {
  return Astro.rewrite(notFoundPath);
}

const officialRoleMessages = {
  referee: messages.matchOfficialRoleReferee,
  assistant: messages.matchOfficialRoleAssistant,
  'table-official': messages.matchOfficialRoleTableOfficial,
  observer: messages.matchOfficialRoleObserver,
} as const;

// Gated on the stage's own format, already known from `response.stageFormat` — a round-robin/
// league/placement match report issues no second request at all (a report is requested far more often per stage than a bracket changes).
const localePrefix = locale ? `/${locale}` : '';
// The current match's own zone only — flattening every zone's matches back together would
// reintroduce the cross-zone matchNumber collision the zone-scoped bracket endpoint exists to
// avoid.
let bracketMatches: ReturnType<typeof mapBracketResponse>['zones'][number]['matches'] = [];
if (selectStageLayout(response.stageFormat) === 'bracket') {
  const rawBracket = await fetchBracket(organization!, tournament!, stageNumber);
  if (rawBracket) {
    const { zones } = mapBracketResponse(rawBracket);
    const ownZone = zones.find((zone) => zone.matches.some((m) => m.matchNumber === matchNumber));
    bracketMatches = ownZone?.matches ?? [];
  }
}

const model = buildMatchReport(response, {
  locale: resolvedLocale,
  hiddenPersonLabel: intl.formatMessage(messages.personHiddenAtRequest),
  sideSource: sideSourceLabels(intl),
  sourceFinalRound: bracketMatches[0]?.sourceFinalRound,
  officialRoleLabel: (code) =>
    code in officialRoleMessages
      ? intl.formatMessage(officialRoleMessages[code as keyof typeof officialRoleMessages])
      : humanizeCode(code),
});

const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: model.tournamentName,
  canonicalPath: `/${encodeURIComponent(organization!)}/tournaments/${encodeURIComponent(tournament!)}`,
  localePrefix,
});
const trail = publicTrail(trailBase, [
  {
    label: intl.formatMessage(messages.matchesViewPageTitle),
    href: `${trailBase.tournamentPath}/matches?stageNumber=${stageNumber}`,
  },
  {
    label: intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber }),
    href: `${trailBase.tournamentPath}/stages/${stageNumber}`,
  },
  {
    label: `${intl.formatMessage(messages.bracketRoundHeading, { round: model.round })} · ${intl.formatMessage(messages.breadcrumbMatch, { match: matchNumber })}`,
  },
]);
const statusLabels = resultStateLabels(intl);
const matchHeading = `${model.home.name} ${intl.formatMessage(messages.tickerVersus)} ${model.away.name}`;
const matchHeadingDescription = [
  intl.formatMessage(messages.breadcrumbStage, { stage: stageNumber }),
  intl.formatMessage(messages.bracketRoundHeading, { round: model.round }),
  intl.formatMessage(messages.breadcrumbMatch, { match: matchNumber }),
  model.scheduledAt
    ? formatDateTime(intl, model.scheduledAt, response.organizationTimeZone ?? 'UTC')
    : undefined,
]
  .filter((part): part is string => part !== undefined)
  .join(' · ');
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${model.home.name} vs ${model.away.name} — ${model.tournamentName}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${Astro.url.pathname}`,
  ...(model.scheduledAt ? { startDate: model.scheduledAt } : {}),
};
---

<PublicLayout
  title={`${model.home.name} vs ${model.away.name} — ${model.tournamentName}`}
  canonicalPath={Astro.url.pathname}
  intl={intl}
  disciplineImages={response.disciplineImages}
  structuredData={structuredData}
>
  <Container variant="reading">
    <PageHeader
      title={matchHeading}
      description={matchHeadingDescription}
      loadingLabel={intl.formatMessage(messages.pageHeaderLoading)}
    >
      <Breadcrumb
        slot="breadcrumb"
        items={trail}
        ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
        collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      />
    </PageHeader>
    <article class="cl-match-page">
      <MatchHero
        intl={intl}
        rescheduledLabel={intl.formatMessage(messages.matchRescheduled, {
          time: '{time}',
          venue: '{venue}',
        })}
        locale={intl.locale}
        timeZone={response.organizationTimeZone ?? 'UTC'}
        model={model}
        statusLabel={statusLabels[model.status]}
      />

      {bracketMatches.length > 0 && (
        <MatchBracketContext
          currentMatchNumber={matchNumber}
          intl={intl}
          localePrefix={localePrefix}
          matches={bracketMatches}
          organizationAlias={organization!}
          stageNumber={stageNumber}
          tournamentAlias={tournament!}
        />
      )}

      <div class="cl-match-details">
        <MatchOfficials model={model} intl={intl} />
        <MatchRosters
          model={model}
          intl={intl}
          locale={locale}
          organization={organization!}
          tournament={tournament!}
        />
        <MatchTimeline
          model={model}
          intl={intl}
          organizationTimeZone={response.organizationTimeZone}
        />
      </div>
    </article>
  </Container>
</PublicLayout>

<style>
  .cl-match-page {
    /* The shared public width: no page-specific column. */
    margin: 0 auto;
    padding-block: var(--cl-space-6);
    overflow-x: hidden;
  }

  .cl-match-details {
    display: flex;
    flex-direction: column;
    gap: var(--cl-space-6);
  }
</style>

<script>
  import { mountPublicSchedule } from '../../../../../../../../lib/public-schedule-live.ts';
  mountPublicSchedule();
</script>
