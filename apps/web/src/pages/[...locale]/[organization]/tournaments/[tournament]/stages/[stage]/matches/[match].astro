---
import PublicLayout from '../../../../../../../../layouts/PublicLayout.astro';
import Container from '../../../../../../../../components/ui/atoms/layout/Container.astro';
import Breadcrumb from '../../../../../../../../components/ui/organisms/Breadcrumb.astro';
import PageHeader from '../../../../../../../../components/ui/organisms/PageHeader.astro';
import { publicTrail, trailBaseOf } from '../../../../../../../../lib/breadcrumb.ts';
import MatchHero from '../../../../../../../../components/ui/organisms/MatchHero.astro';
import MatchOfficials from '../../../../../../../../components/ui/organisms/MatchOfficials.astro';
import MatchRosters from '../../../../../../../../components/ui/organisms/MatchRosters.astro';
import MatchTimeline from '../../../../../../../../components/ui/organisms/MatchTimeline.astro';
import MatchBracketContext from '../../../../../../../../components/ui/organisms/MatchBracketContext.astro';
import { buildMatchReport, matchStakeLines } from '../../../../../../../../lib/match-report.ts';
import { competitionContext } from '../../../../../../../../lib/competition-context.ts';
import type { MatchCardData } from '../../../../../../../../lib/matches-view.ts';
import {
  fetchBracket,
  fetchLive,
  fetchMatchReport,
  fetchMatchesView,
  mapBracketResponse,
  mapLiveResponse,
  mapMatchesViewResponse,
} from '../../../../../../../../lib/public-api-client.ts';
import { publicStreamPath } from '@copalibre/routing';
import { selectStageLayout } from '../../../../../../../../lib/bracket.ts';
import { humanizeCode } from '../../../../../../../../lib/descriptor-label.ts';
import { messages } from '../../../../../../../../lib/i18n/public-messages.en.ts';
import {
  competitionContextLabels,
  publicIntl,
  resultStateLabels,
  sideSourceLabels,
  formatDateTime,
} from '../../../../../../../../lib/i18n/public-intl.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { getLocalizedNotFoundPath, resolvePathLocale } from '../../../../../../../../lib/locale.ts';
import { isPublicLocaleSegment } from '../../../../../../../../lib/public-route-guards.ts';

export const prerender = false;

const { locale, organization, tournament, stage, match } = Astro.params;
if (!isPublicLocaleSegment(locale)) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvePathLocale(Astro.url.pathname)));
}
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const notFoundPath = getLocalizedNotFoundPath(resolvedLocale);
const stageNumber = Number(stage);
const matchNumber = Number(match);

if (
  !Number.isSafeInteger(stageNumber) ||
  stageNumber < 1 ||
  !Number.isSafeInteger(matchNumber) ||
  matchNumber < 1
) {
  return Astro.rewrite(notFoundPath);
}

const response = await fetchMatchReport(organization!, tournament!, stageNumber, matchNumber);
if (!response) {
  return Astro.rewrite(notFoundPath);
}

const officialRoleMessages = {
  referee: messages.matchOfficialRoleReferee,
  assistant: messages.matchOfficialRoleAssistant,
  'table-official': messages.matchOfficialRoleTableOfficial,
  observer: messages.matchOfficialRoleObserver,
} as const;

// Gated on the stage's own format, already known from `response.stageFormat` — a round-robin/
// league/placement match report issues no second request at all (a report is requested far more often per stage than a bracket changes).
const localePrefix = locale ? `/${locale}` : '';
// The current match's own zone only — flattening every zone's matches back together would
// reintroduce the cross-zone matchNumber collision the zone-scoped bracket endpoint exists to
// avoid.
let bracketMatches: ReturnType<typeof mapBracketResponse>['zones'][number]['matches'] = [];
let ownZoneName: string | undefined;
let ownZoneOffset: number | undefined;
let zoneMatchesView: readonly MatchCardData[] = [];
if (selectStageLayout(response.stageFormat) === 'bracket') {
  const [rawBracket, rawMatchesView] = await Promise.all([
    fetchBracket(organization!, tournament!, stageNumber),
    fetchMatchesView(organization!, tournament!, { stageNumber }),
  ]);
  if (rawBracket) {
    const { zones } = mapBracketResponse(rawBracket, intl.formatMessage(messages.resultStateTbd));
    const ownZone = zones.find((zone) => zone.matches.some((m) => m.matchNumber === matchNumber));
    bracketMatches = ownZone?.matches ?? [];
    ownZoneName = ownZone?.zoneName;
    ownZoneOffset = ownZone?.overallPlaceOffset;
  }
  if (rawMatchesView) {
    const mapped = mapMatchesViewResponse(
      rawMatchesView,
      intl.formatMessage(messages.personHiddenAtRequest),
      resolvedLocale,
    ).matches;
    const effectiveZone = ownZoneName ?? response.zoneName;
    zoneMatchesView =
      effectiveZone === undefined ? mapped : mapped.filter((m) => m.zoneName === effectiveZone);
  }
}

const zoneNodeKeys = bracketMatches.length > 0 ? bracketMatches.map((m) => m.nodeKey) : undefined;
const sourceFinalRound = bracketMatches[0]?.sourceFinalRound;
const model = buildMatchReport(response, {
  locale: resolvedLocale,
  hiddenPersonLabel: intl.formatMessage(messages.personHiddenAtRequest),
  sideSource: sideSourceLabels(intl),
  sourceFinalRound,
  zoneNodeKeys,
  officialRoleLabel: (code) =>
    code in officialRoleMessages
      ? intl.formatMessage(officialRoleMessages[code as keyof typeof officialRoleMessages])
      : humanizeCode(code),
});

const liveDashboard =
  model.status === 'live'
    ? await fetchLive(organization!, tournament!).then((data) =>
        data ? mapLiveResponse(data) : undefined,
      )
    : undefined;
const liveMatch = liveDashboard?.matches.find(
  (candidate) =>
    candidate.stageNumber === stageNumber &&
    (candidate.stageOrdinal ?? candidate.matchNumber) === matchNumber,
);
const liveStreamPath =
  model.status === 'live'
    ? publicStreamPath({ organizationAlias: organization!, tournamentAlias: tournament! })
    : undefined;
const liveMatchSeed = liveMatch
  ? {
      matchId: liveMatch.matchId,
      projectionVersion: liveMatch.projectionVersion,
      state: liveMatch.state,
      ...(liveMatch.clock === undefined ? {} : { clock: liveMatch.clock }),
      ...(liveMatch.segments === undefined ? {} : { segments: liveMatch.segments }),
      homeScore: liveMatch.sides[0]?.score,
      awayScore: liveMatch.sides[1]?.score,
      homeEntrantId: liveMatch.sides[0]?.entrantId,
      awayEntrantId: liveMatch.sides[1]?.entrantId,
    }
  : undefined;

const formatOverallPlace = (place: number): string =>
  intl.formatMessage(messages.bracketOverallPlace, { place });
const contextLabels = {
  ...competitionContextLabels(intl),
  formatOverallPlace,
};
const context = competitionContext(
  {
    stageNumber,
    stageName: response.stageName,
    zoneName: response.zoneName,
    groupName: response.groupName,
    round: model.round,
    matchNumber,
    nodeKey: response.nodeKey,
    sourceFinalRound,
    zoneNodeKeys,
    ...(ownZoneOffset === undefined ? {} : { overallPlaceOffset: ownZoneOffset }),
  },
  contextLabels,
);
const stakeLines =
  bracketMatches.length > 0
    ? matchStakeLines({
        currentMatch: {
          nodeKey: response.nodeKey,
          matchNumber,
          stageNumber,
          stageName: response.stageName,
          zoneName: response.zoneName ?? ownZoneName,
          round: model.round,
          sourceFinalRound,
          ...(ownZoneOffset === undefined ? {} : { overallPlaceOffset: ownZoneOffset }),
        },
        bracketMatches,
        stageMatches: zoneMatchesView,
        labels: {
          context: contextLabels,
          stakeWinner: intl.formatMessage(messages.matchReportStakeWinner, {
            match: '{match}',
            when: '{when}',
          }),
          stakeLoser: intl.formatMessage(messages.matchReportStakeLoser, {
            match: '{match}',
            when: '{when}',
          }),
          stakePlace: intl.formatMessage(messages.matchReportStakePlace, { place: '{place}' }),
          stakeChampion: intl.formatMessage(messages.matchReportStakeChampion, { zone: '{zone}' }),
          fallbackChampionScope: model.tournamentName,
          formatOverallPlace,
        },
        formatDate: (at) => formatDateTime(intl, at, response.organizationTimeZone ?? 'UTC'),
      })
    : [];
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: model.tournamentName,
  canonicalPath: `/${encodeURIComponent(organization!)}/tournaments/${encodeURIComponent(tournament!)}`,
  localePrefix,
});
const trail = publicTrail(trailBase, [
  {
    label: intl.formatMessage(messages.matchesViewPageTitle),
    href: `${trailBase.tournamentPath}/matches?stageNumber=${stageNumber}`,
  },
  {
    label: context.stage,
    href: `${trailBase.tournamentPath}/stages/${stageNumber}`,
  },
  {
    label:
      [context.zone, context.group, context.round, context.matchLabel]
        .filter(Boolean)
        .join(' · ') || context.line,
  },
]);
const statusLabels = resultStateLabels(intl);
const matchHeading = `${model.home.name} ${intl.formatMessage(messages.tickerVersus)} ${model.away.name}`;
const matchHeadingDescription = [
  context.line,
  context.matchLabel,
  model.scheduledAt
    ? formatDateTime(intl, model.scheduledAt, response.organizationTimeZone ?? 'UTC')
    : undefined,
]
  .filter((part): part is string => part !== undefined)
  .join(' · ');
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${model.home.name} vs ${model.away.name} — ${model.tournamentName} · ${context.line}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${Astro.url.pathname}`,
  ...(model.scheduledAt ? { startDate: model.scheduledAt } : {}),
};
---

<PublicLayout
  title={`${model.home.name} vs ${model.away.name} — ${model.tournamentName}`}
  canonicalPath={Astro.url.pathname}
  intl={intl}
  disciplineImages={response.disciplineImages}
  structuredData={structuredData}
>
  <Container variant="reading">
    <PageHeader
      title={matchHeading}
      description={matchHeadingDescription}
      loadingLabel={intl.formatMessage(messages.pageHeaderLoading)}
    >
      <Breadcrumb
        slot="breadcrumb"
        items={trail}
        ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
        collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      />
    </PageHeader>
    <article class="cl-match-page">
      {liveStreamPath && liveMatchSeed && (
        <div data-live-stream={liveStreamPath} hidden>
          <span data-live-match-seed={JSON.stringify(liveMatchSeed)} />
        </div>
      )}
      <MatchHero
        intl={intl}
        rescheduledLabel={intl.formatMessage(messages.matchRescheduled, {
          time: '{time}',
          venue: '{venue}',
        })}
        locale={intl.locale}
        timeZone={response.organizationTimeZone ?? 'UTC'}
        model={model}
        statusLabel={statusLabels[model.status]}
        liveMatchId={liveMatch?.matchId}
        homeEntrantId={liveMatch?.sides[0]?.entrantId}
        awayEntrantId={liveMatch?.sides[1]?.entrantId}
        liveClock={liveMatch?.clock}
        liveSegments={liveMatch?.segments}
        stakeLines={stakeLines}
      />

      {bracketMatches.length > 0 && (
        <MatchBracketContext
          currentMatchNumber={matchNumber}
          intl={intl}
          localePrefix={localePrefix}
          matches={bracketMatches}
          matchesView={zoneMatchesView}
          organizationAlias={organization!}
          organizationTimeZone={response.organizationTimeZone}
          stageNumber={stageNumber}
          tournamentAlias={tournament!}
          zoneName={ownZoneName ?? response.zoneName}
          overallPlaceOffset={ownZoneOffset}
        />
      )}

      <div class="cl-match-details">
        <MatchOfficials model={model} intl={intl} />
        <MatchRosters
          model={model}
          intl={intl}
          locale={locale}
          organization={organization!}
          tournament={tournament!}
        />
        <MatchTimeline
          model={model}
          intl={intl}
          organizationTimeZone={response.organizationTimeZone}
        />
      </div>
    </article>
  </Container>
</PublicLayout>

<style>
  .cl-match-page {
    /* The shared public width: no page-specific column. */
    margin: 0 auto;
    padding-block: var(--cl-space-6);
    overflow-x: hidden;
  }

  .cl-match-details {
    display: flex;
    flex-direction: column;
    gap: var(--cl-space-6);
  }
</style>

<script>
  import { mountPublicSchedule } from '../../../../../../../../lib/public-schedule-live.ts';

  mountPublicSchedule();
  if (document.querySelector('[data-live-stream]')) {
    void import('../../../../../../../../lib/public-live-scoreboards.ts').then(
      ({ mountPublicLiveScoreboards }) => {
        mountPublicLiveScoreboards();
      },
    );
  }
</script>
