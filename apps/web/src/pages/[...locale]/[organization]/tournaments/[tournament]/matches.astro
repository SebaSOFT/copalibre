---
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import { MatchCard } from '../../../../../components/ui/organisms/MatchCard.tsx';
import MatchScheduleFilters, {
  type MatchScheduleState,
} from '../../../../../components/ui/organisms/MatchScheduleFilters.astro';
import { matchReportUrl } from '../../../../../lib/bracket.ts';
import {
  fetchOverview,
  fetchCompletion,
  fetchMatchesView,
  mapOverviewResponse,
  mapMatchesViewResponse,
} from '../../../../../lib/public-api-client.ts';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import { publicIntl, matchCardLabels } from '../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import {
  distinctFacetValues,
  groupMatchesByRound,
  type MatchCardData,
} from '../../../../../lib/matches-view.ts';

/**
 * The matches view (openspec 0172, consolidated by openspec 0245): a
 * filterable card grid of a tournament's matches, grouped by round, with a
 * hierarchical stage/zone/group filter bar on top of the match-state
 * filter. Zone/group facets are derived from the active stage's own rows
 * (`zoneName`/`groupName`, already returned per match) rather than a new
 * backend filter — every selection is still a plain query-string link, so
 * every filtered view is server-rendered and works with scripting off.
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = matchCardLabels(intl);
const localePrefix = locale ? `/${locale}` : '';

const overviewData = await fetchOverview(organization!, tournament!);
if (!overviewData) {
  return Astro.rewrite('/404');
}
const model = buildOverview(mapOverviewResponse(overviewData));

const completionData = await fetchCompletion(organization!, tournament!);
const stageOptions = (completionData?.stages ?? []).map((stage) => ({
  stageNumber: stage.stageNumber,
  stageName: stage.stageName,
}));

const stateParam = Astro.url.searchParams.get('state');
const state: MatchScheduleState =
  stateParam === 'live' || stateParam === 'upcoming' || stateParam === 'final' ? stateParam : 'all';
const stageParam = Astro.url.searchParams.get('stageNumber');
const stageNumber = stageParam ? Number(stageParam) : undefined;
const zoneParam = Astro.url.searchParams.get('zone') ?? undefined;
const groupParam = Astro.url.searchParams.get('group') ?? undefined;

const matchesData = await fetchMatchesView(organization!, tournament!, {
  ...(stageNumber === undefined ? {} : { stageNumber }),
  state,
});
if (!matchesData) {
  return Astro.rewrite('/404');
}
const { matches: stageRows } = mapMatchesViewResponse(matchesData);

// Zone/group facets are derived from the rows the active stage(s) and state
// filter already returned, not a separate backend query — a stage the
// active filter narrows to zero rows for simply shows no zone/group pills.
const zones = distinctFacetValues(stageRows, 'zoneName');
const zoneFiltered =
  zoneParam === undefined ? stageRows : stageRows.filter((row) => row.zoneName === zoneParam);
const groups = distinctFacetValues(zoneFiltered, 'groupName');
const matches: readonly MatchCardData[] =
  groupParam === undefined
    ? zoneFiltered
    : zoneFiltered.filter((row) => row.groupName === groupParam);

const kickoffFormatter = new Intl.DateTimeFormat(resolvedLocale, {
  dateStyle: 'medium',
  timeStyle: 'short',
});
const matchesWithLabels: readonly MatchCardData[] = matches.map((match) => ({
  ...match,
  scheduledAtLabel: match.scheduledAt
    ? kickoffFormatter.format(new Date(match.scheduledAt))
    : undefined,
}));

const roundGroups = groupMatchesByRound(matchesWithLabels);

function buildUrl(
  overrides: Partial<{
    stageNumber: number | undefined;
    zone: string | undefined;
    group: string | undefined;
    state: MatchScheduleState;
  }>,
): string {
  const params = new URLSearchParams(Astro.url.search);
  const next = {
    stageNumber,
    zone: zoneParam,
    group: groupParam,
    state,
    ...overrides,
  };
  if (next.stageNumber === undefined) params.delete('stageNumber');
  else params.set('stageNumber', String(next.stageNumber));
  if (next.zone === undefined) params.delete('zone');
  else params.set('zone', next.zone);
  if (next.group === undefined) params.delete('group');
  else params.set('group', next.group);
  if (next.state === 'all') params.delete('state');
  else params.set('state', next.state);
  const query = params.toString();
  return `${localePrefix}${model.canonicalPath}/matches${query ? `?${query}` : ''}`;
}

const canonicalPath = `${localePrefix}${model.canonicalPath}/matches`;
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${intl.formatMessage(messages.matchesViewPageTitle)} — ${displayName(model)}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
};
---

<PublicLayout
  title={`${intl.formatMessage(messages.matchesViewPageTitle)} — ${displayName(model)}`}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <h1>{intl.formatMessage(messages.matchesViewPageTitle)}</h1>

  <MatchScheduleFilters
    stages={stageOptions}
    activeStageNumber={stageNumber}
    zones={zones}
    activeZone={zoneParam}
    groups={groups}
    activeGroup={groupParam}
    state={state}
    labels={{
      stageFilterAriaLabel: intl.formatMessage(messages.matchesViewStageFilterAriaLabel),
      zoneFilterAriaLabel: intl.formatMessage(messages.matchesViewZoneFilterAriaLabel),
      groupFilterAriaLabel: intl.formatMessage(messages.matchesViewGroupFilterAriaLabel),
      stateFilterAriaLabel: intl.formatMessage(messages.matchesViewStateFilterAriaLabel),
      filters: labels.filters,
    }}
    buildUrl={buildUrl}
  />

  {
    matchesWithLabels.length === 0 ? (
      <p>{labels.empty}</p>
    ) : (
      roundGroups.map((group) => (
        <section class="cl-matches-view__round">
          <h2 class="cl-matches-view__round-heading">
            {intl.formatMessage(messages.bracketRoundHeading, { round: group.round })}
          </h2>
          <div class="cl-matches-view__grid">
            {group.matches.map((match) => (
              <MatchCard
                client:load
                match={match}
                labels={labels}
                reportUrl={matchReportUrl({
                  organizationAlias: organization!,
                  tournamentAlias: tournament!,
                  stageNumber: match.stageNumber,
                  matchNumber: match.matchNumber,
                  localePrefix,
                })}
              />
            ))}
          </div>
        </section>
      ))
    )
  }
</PublicLayout>

<style>
  .cl-matches-view__round {
    margin-top: var(--cl-space-6);
  }
  .cl-matches-view__round-heading {
    font-size: var(--cl-font-size-md);
    font-weight: 600;
    color: var(--cl-text-primary);
    margin: 0 0 var(--cl-space-3) 0;
  }
</style>
