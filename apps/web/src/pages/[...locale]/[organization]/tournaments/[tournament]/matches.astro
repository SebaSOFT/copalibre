---
import Breadcrumb from '../../../../../components/ui/organisms/Breadcrumb.astro';
import { publicTrail, trailBaseOf } from '../../../../../lib/breadcrumb.ts';
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import MatchSchedule from '../../../../../components/ui/organisms/MatchSchedule.astro';
import MatchScheduleFilters, {
  type MatchScheduleState,
  type MatchScheduleView,
} from '../../../../../components/ui/organisms/MatchScheduleFilters.astro';
import { fetchOverview, mapOverviewResponse } from '../../../../../lib/public-api-client.ts';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import { publicIntl, matchCardLabels } from '../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import { distinctFacetValues } from '../../../../../lib/matches-view.ts';
import { offersViewChoice } from '../../../../../lib/match-schedule.ts';
import { loadSchedule } from '../../../../../lib/schedule-loader.ts';

/**
 * The matches view: a tournament's schedule as tables grouped by stage, zone or group and round,
 * with a knockout zone drawn as its bracket, under titled stage/zone/group/state/view filters.
 * Zone and group facets come from the active stage's own rows rather than a new backend filter,
 * and every selection is a plain query-string link, so every view is server-rendered and works
 * with scripting off.
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const labels = matchCardLabels(intl);
const localePrefix = locale ? `/${locale}` : '';

const overviewData = await fetchOverview(organization!, tournament!);
if (!overviewData) {
  return Astro.rewrite('/404');
}
const model = buildOverview(mapOverviewResponse(overviewData));

const stateParam = Astro.url.searchParams.get('state');
const state: MatchScheduleState =
  stateParam === 'live' || stateParam === 'upcoming' || stateParam === 'final' ? stateParam : 'all';
const stageParam = Astro.url.searchParams.get('stageNumber');
const stageNumber = stageParam ? Number(stageParam) : undefined;
const zoneParam = Astro.url.searchParams.get('zone') ?? undefined;
const groupParam = Astro.url.searchParams.get('group') ?? undefined;
const cardsRequested = Astro.url.searchParams.get('view') === 'cards';
const compact = Astro.url.searchParams.get('compact') === 'true';

const schedule = await loadSchedule({
  organization: organization!,
  tournament: tournament!,
  state,
  ...(stageNumber === undefined ? {} : { stageNumber }),
  ...(zoneParam === undefined ? {} : { zone: zoneParam }),
  ...(groupParam === undefined ? {} : { group: groupParam }),
});
if (!schedule) {
  return Astro.rewrite('/404');
}

// Zone/group facets are derived from the rows the active stage(s) and state filter already
// returned: a stage the filter narrows to zero rows simply shows no zone/group pills.
const zones = distinctFacetValues(schedule.stageRows, 'zoneName');
const zoneFiltered =
  zoneParam === undefined
    ? schedule.stageRows
    : schedule.stageRows.filter((row) => row.zoneName === zoneParam);
const groups = distinctFacetValues(zoneFiltered, 'groupName');

// A large scope is only ever a table; a short one may be shown as cards.
const offerView = offersViewChoice(schedule.rows.length);
const view: MatchScheduleView = offerView && cardsRequested ? 'cards' : 'rows';
const presentation = view === 'rows' ? 'rows' : compact ? 'compact-cards' : 'cards';

function buildUrl(
  overrides: Partial<{
    stageNumber: number | undefined;
    zone: string | undefined;
    group: string | undefined;
    state: MatchScheduleState;
    view: MatchScheduleView;
    compact: boolean;
  }>,
): string {
  const params = new URLSearchParams(Astro.url.search);
  const next = {
    stageNumber,
    zone: zoneParam,
    group: groupParam,
    state,
    view,
    compact,
    ...overrides,
  };
  if (next.stageNumber === undefined) params.delete('stageNumber');
  else params.set('stageNumber', String(next.stageNumber));
  if (next.zone === undefined) params.delete('zone');
  else params.set('zone', next.zone);
  if (next.group === undefined) params.delete('group');
  else params.set('group', next.group);
  if (next.state === 'all') params.delete('state');
  else params.set('state', next.state);
  if (next.view === 'cards') params.set('view', 'cards');
  else params.delete('view');
  if (next.compact) params.set('compact', 'true');
  else params.delete('compact');
  const query = params.toString();
  return `${localePrefix}${model.canonicalPath}/matches${query ? `?${query}` : ''}`;
}

const canonicalPath = `${localePrefix}${model.canonicalPath}/matches`;
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: `${intl.formatMessage(messages.matchesViewPageTitle)} — ${displayName(model)}`,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
};
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: displayName(model),
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, [
  { label: intl.formatMessage(messages.matchesViewPageTitle) },
]);
---

<PublicLayout
  title={`${intl.formatMessage(messages.matchesViewPageTitle)} — ${displayName(model)}`}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <Breadcrumb
    items={trail}
    ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
    collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
  />
  <h1>{intl.formatMessage(messages.matchesViewPageTitle)}</h1>

  <MatchScheduleFilters
    stages={schedule.stageOptions.map((one) => ({
      stageNumber: one.stageNumber,
      stageName:
        one.stageName || intl.formatMessage(messages.breadcrumbStage, { stage: one.stageNumber }),
    }))}
    activeStageNumber={stageNumber}
    zones={zones}
    activeZone={zoneParam}
    groups={groups}
    activeGroup={groupParam}
    state={state}
    view={view}
    offerView={offerView}
    labels={{
      stageFilterAriaLabel: intl.formatMessage(messages.matchesViewStageFilterAriaLabel),
      zoneFilterAriaLabel: intl.formatMessage(messages.matchesViewZoneFilterAriaLabel),
      groupFilterAriaLabel: intl.formatMessage(messages.matchesViewGroupFilterAriaLabel),
      stateFilterAriaLabel: intl.formatMessage(messages.matchesViewStateFilterAriaLabel),
      viewFilterAriaLabel: intl.formatMessage(messages.matchesViewViewFilterAriaLabel),
      titles: {
        stage: intl.formatMessage(messages.matchesViewStageFilterTitle),
        zone: intl.formatMessage(messages.matchesViewZoneFilterTitle),
        group: intl.formatMessage(messages.matchesViewGroupFilterTitle),
        state: intl.formatMessage(messages.matchesViewStateFilterTitle),
        view: intl.formatMessage(messages.matchesViewViewFilterTitle),
      },
      viewOptions: {
        rows: intl.formatMessage(messages.matchesViewViewRows),
        cards: intl.formatMessage(messages.matchesViewViewCards),
      },
      filters: labels.filters,
    }}
    buildUrl={buildUrl}
  />

  {
    view === 'cards' && (
      <nav
        class="cl-pill-group"
        aria-label={intl.formatMessage(messages.matchesViewDensityToggleAriaLabel)}
      >
        <a
          class="cl-pill cl-focusable"
          href={buildUrl({ compact: false })}
          aria-current={compact ? undefined : 'true'}
        >
          {intl.formatMessage(messages.matchesViewDetailedToggle)}
        </a>
        <a
          class="cl-pill cl-focusable"
          href={buildUrl({ compact: true })}
          aria-current={compact ? 'true' : undefined}
        >
          {intl.formatMessage(messages.matchesViewCompactToggle)}
        </a>
      </nav>
    )
  }

  <MatchSchedule
    emptyLabel={labels.empty}
    intl={intl}
    localePrefix={localePrefix}
    organizationAlias={organization!}
    presentation={presentation}
    stages={schedule.stages}
    tournamentAlias={tournament!}
  />
</PublicLayout>
