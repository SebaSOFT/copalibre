---
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';
import PublicLayout from '../../../../../layouts/PublicLayout.astro';
import Container from '../../../../../components/ui/atoms/layout/Container.astro';
import { Card } from '../../../../../components/ui/atoms/Card.tsx';
import { Badge } from '../../../../../components/ui/atoms/Badge.tsx';
import Breadcrumb from '../../../../../components/ui/organisms/Breadcrumb.astro';
import PageHeader from '../../../../../components/ui/organisms/PageHeader.astro';
import EmptyState from '../../../../../components/ui/molecules/EmptyState.astro';
import SectionHeader from '../../../../../components/ui/molecules/SectionHeader.astro';
import Stack from '../../../../../components/ui/atoms/layout/Stack.astro';
import ClubIdentity from '../../../../../components/ui/molecules/ClubIdentity.astro';
import { publicTrail, trailBaseOf } from '../../../../../lib/breadcrumb.ts';
import {
  clubIndexUrl,
  isValidClubAlias,
  optionalClubPageUrl,
} from '../../../../../lib/club-url.ts';
import { deriveClubStatus, groupClubIndexByBand } from '../../../../../lib/club-page.ts';
import { buildOverview, displayName } from '../../../../../lib/overview.ts';
import type { MatchCardData } from '../../../../../lib/matches-view.ts';
import {
  clubEmblemUrl,
  fetchMatchesView,
  fetchOverview,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapMatchesViewResponse,
  mapOverviewResponse,
} from '../../../../../lib/public-api-client.ts';
import { formatClubStatus, publicIntl } from '../../../../../lib/i18n/public-intl.ts';
import { messages } from '../../../../../lib/i18n/public-messages.en.ts';
import { getLocalizedNotFoundPath, resolvePathLocale } from '../../../../../lib/locale.ts';
import { isPublicLocaleSegment } from '../../../../../lib/public-route-guards.ts';

export const prerender = false;

const { locale, organization, tournament } = Astro.params;
if (!isPublicLocaleSegment(locale)) {
  Astro.response.status = 404;
  return Astro.rewrite(getLocalizedNotFoundPath(resolvePathLocale(Astro.url.pathname)));
}

const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);
const localePrefix = locale ? `/${locale}` : '';

let overviewData: Awaited<ReturnType<typeof fetchOverview>>;
try {
  overviewData = await fetchOverview(organization!, tournament!);
} catch {
  overviewData = undefined;
}
if (!overviewData) {
  Astro.response.status = 404;
  return Astro.rewrite(getLocalizedNotFoundPath(resolvedLocale));
}

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));
const clubs = model.clubs ?? [];

let matchesViewRaw: Awaited<ReturnType<typeof fetchMatchesView>>;
try {
  matchesViewRaw = await fetchMatchesView(organization!, tournament!, { state: 'all' });
} catch {
  matchesViewRaw = undefined;
}
const allMatches: readonly MatchCardData[] = matchesViewRaw
  ? mapMatchesViewResponse(
      matchesViewRaw,
      intl.formatMessage(messages.personHiddenAtRequest),
      resolvedLocale,
    ).matches
  : [];

let layoutsRaw: Awaited<ReturnType<typeof fetchPublicTableLayouts>>;
try {
  layoutsRaw = await fetchPublicTableLayouts(organization!, tournament!);
} catch {
  layoutsRaw = undefined;
}
const groupPhaseLayout = layoutsRaw?.layouts.find((one) => one.target === 'group-phase');
const earliestStageNumber = overviewData.matches.reduce(
  (earliest, match) => Math.min(earliest, match.stageNumber),
  Infinity,
);
const standingsStageNumber =
  model.standingsStageNumber ??
  (Number.isFinite(earliestStageNumber) ? earliestStageNumber : undefined);

let standingsProjection: Awaited<ReturnType<typeof fetchPublicTableProjection>>;
if (groupPhaseLayout) {
  try {
    standingsProjection = await fetchPublicTableProjection(
      organization!,
      tournament!,
      groupPhaseLayout.code,
      standingsStageNumber,
    );
  } catch {
    standingsProjection = undefined;
  }
}

const bandByClubKey = new Map<string, { readonly label: string; readonly index?: number }>();
for (const row of standingsProjection?.rows ?? []) {
  if (!row.promotionBandLabel) continue;
  const entry = {
    label: row.promotionBandLabel,
    ...(row.promotionBandIndex === undefined ? {} : { index: row.promotionBandIndex }),
  };
  if (row.clubAlias) bandByClubKey.set(`alias:${row.clubAlias}`, entry);
  if (row.clubId) bandByClubKey.set(`id:${row.clubId}`, entry);
}

const clubCards = clubs.map((club) => {
  const href = optionalClubPageUrl({
    organizationAlias: organization!,
    tournamentAlias: tournament!,
    clubAlias: club.alias,
    localePrefix,
  });
  const status = deriveClubStatus(
    allMatches,
    {
      ...(isValidClubAlias(club.alias) ? { alias: club.alias } : {}),
      clubId: club.clubId,
    },
    model.stages,
  );
  const band =
    (club.alias ? bandByClubKey.get(`alias:${club.alias}`) : undefined) ??
    bandByClubKey.get(`id:${club.clubId}`);
  // With a band badge beside the status, the status names only the round.
  const statusText = formatClubStatus(intl, status, { withBand: band !== undefined });

  return {
    club,
    href,
    statusText,
    band,
    emblemSrc: club.emblemObjectId ? clubEmblemUrl(organization!, club.clubId) : undefined,
  };
});

// The index follows the tournament's declared bands: each band a group in declared order, the clubs no
// band has taken yet last. Without a declared band it is one alphabetical list.
const clubGroups = groupClubIndexByBand(
  clubCards.map((card) => ({ ...card, name: card.club.name, bandLabel: card.band?.label })),
  (standingsProjection?.promotionBands ?? []).map((band) => band.label),
  new Intl.Collator(resolvedLocale),
);

const canonicalPath = clubIndexUrl({
  organizationAlias: organization!,
  tournamentAlias: tournament!,
  localePrefix,
});
const tournamentName = displayName(model);
const pageHeading = intl.formatMessage(messages.clubIndexTitle);
const pageTitle = `${pageHeading} — ${tournamentName}`;
const description = intl.formatMessage(messages.clubIndexDescription, {
  tournament: tournamentName,
});

const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName,
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, [{ label: pageHeading }]);

const structuredData = {
  '@type': 'SportsEvent' as const,
  name: pageTitle,
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
};
---

<PublicLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
  tournamentHasClubs={clubs.length > 0}
>
  <Container variant="public">
    <PageHeader
      title={`${tournamentName} — ${pageHeading}`}
      description={description}
      loadingLabel={intl.formatMessage(messages.pageHeaderLoading)}
    >
      <Breadcrumb
        slot="breadcrumb"
        items={trail}
        ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
        collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      />
    </PageHeader>

    {clubCards.length === 0 ? (
      <EmptyState
        icon="team"
        heading={pageHeading}
        description={intl.formatMessage(messages.clubIndexEmptyDescription)}
        actionLabel={intl.formatMessage(messages.interactionViewMatches)}
        href={`${localePrefix}${model.canonicalPath}/matches`}
      />
    ) : (
      <Stack>
        {clubGroups.map((group, groupIndex) => {
          const headed = group.bandLabel !== undefined || group.unassigned;
          const headingId = `club-band-${groupIndex}`;
          return (
            <section aria-labelledby={headed ? headingId : undefined}>
              {headed && (
                <SectionHeader
                  headingId={headingId}
                  heading={
                    group.unassigned
                      ? intl.formatMessage(messages.clubIndexBandUnassigned)
                      : (group.bandLabel ?? '')
                  }
                  count={group.clubs.length}
                />
              )}
              <ul class="cl-match-card-grid">
                {group.clubs.map(({ club, href, statusText, band, emblemSrc }) => (
                  <li>
                    <Card as="article" aria-label={club.name}>
                      <ClubIdentity
                        name={club.name}
                        abbreviation={club.abbreviation}
                        emblemSrc={emblemSrc}
                        placeholderAlt={intl.formatMessage(messages.orgPageEmblemPlaceholderAlt)}
                        href={href}
                      >
                        {band && (
                          <span slot="badges">
                            <Badge data-promotion-band-index={band.index}>{band.label}</Badge>
                          </span>
                        )}
                        {statusText && <span slot="status">{statusText}</span>}
                      </ClubIdentity>
                    </Card>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </Stack>
    )}
  </Container>
</PublicLayout>
