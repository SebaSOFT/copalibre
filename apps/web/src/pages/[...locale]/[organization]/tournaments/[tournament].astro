---
import EmptyState from '../../../../components/ui/molecules/EmptyState.astro';
import { CompletionFigure } from '../../../../components/ui/molecules/CompletionFigure.tsx';
import Container from '../../../../components/ui/atoms/layout/Container.astro';
import { MatchCard } from '../../../../components/ui/organisms/MatchCard.tsx';
import DataTable, {
  type DataTableColumn,
} from '../../../../components/ui/organisms/DataTable.astro';
import { publicTrail, trailBaseOf } from '../../../../lib/breadcrumb.ts';
import { publicTableLayoutLabel } from '../../../../lib/public-table-layout-label.ts';
import PublicLayout from '../../../../layouts/PublicLayout.astro';
import TournamentOverviewHero from '../../../../components/ui/organisms/TournamentOverviewHero.astro';
import TournamentNowStrip from '../../../../components/ui/organisms/TournamentNowStrip.astro';
import TournamentHonourBoard from '../../../../components/ui/organisms/TournamentHonourBoard.astro';
import FeaturedMatchCard from '../../../../components/ui/organisms/FeaturedMatchCard.astro';
import ScoreTicker from '../../../../components/ui/organisms/ScoreTicker.astro';
import StandingsTable from '../../../../components/ui/organisms/StandingsTable.astro';
import RulesetBriefing from '../../../../components/ui/molecules/RulesetBriefing.astro';
import TimeZoneNote from '../../../../components/ui/molecules/TimeZoneNote.astro';
import { withPodiumEmblems } from '../../../../lib/podium-emblems.ts';
import {
  buildOverview,
  displayName,
  groupOverviewMatchesByDay,
  overviewLeadFor,
  selectNowStripMatches,
  summarizeOverviewMatches,
  type OverviewMatch,
} from '../../../../lib/overview.ts';
import { resolveClubFilter } from '../../../../lib/club-page.ts';
import { isDelayed } from '../../../../lib/match-state.ts';
import { formatTimestamp } from '../../../../lib/format-timestamp.ts';
import { selectStageLayout } from '../../../../lib/bracket.ts';
import { mapBracketResponse } from '../../../../lib/bracket-projection.ts';
import {
  deriveOverallStandings,
  type OverallStandingsEntry,
} from '../../../../lib/overall-standings.ts';
import { ordinalOf } from '../../../../lib/side-source.ts';
import { buildTournamentStatusLine } from '../../../../lib/tournament-status-line.ts';
import { withSourceDepth, type MatchCardData } from '../../../../lib/matches-view.ts';
import {
  clubEmblemUrl,
  fetchBracket,
  fetchOverview,
  fetchCompletion,
  fetchLive,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapLiveResponse,
  mapOverviewResponse,
  publicTableCsvUrl,
} from '../../../../lib/public-api-client.ts';
import {
  publicIntl,
  tickerChromeLabels,
  matchCardLabels,
  tickerLabels,
  timeZoneNoteLabels,
  tournamentHeroLabels,
  tournamentStatusLineLabels,
  completionFigureLabels,
  resultStateLabels,
  rulesetBriefingRows,
  sideSourceLabels,
  standingsTiebreakLine,
} from '../../../../lib/i18n/public-intl.ts';
import { buildTickerItems } from '../../../../lib/ticker-items.ts';
import { getLocalizedNotFoundPath, resolvePathLocale } from '../../../../lib/locale.ts';
import { isPublicLocaleSegment } from '../../../../lib/public-route-guards.ts';
import { messages } from '../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B1, the tournament overview.
 *
 * Everything a spectator needs is server-rendered. The SSE stream is
 * an improvement on this page, never a requirement for it: a venue on hotel
 * Wi-Fi still gets the score.
 *
 * `[[locale]]` is an optional Astro route segment: English, the
 * primary locale, is generated with `locale: undefined` (no URL segment);
 * every other supported language is generated with its own locale code
 * (the remaining five locales ship alongside Spanish).
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
if (!isPublicLocaleSegment(locale)) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvePathLocale(Astro.url.pathname)));
}
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const overviewData = await fetchOverview(organization!, tournament!);
if (!overviewData) {
  return Astro.rewrite(getLocalizedNotFoundPath(resolvedLocale));
}

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));

const [completionData, liveData, layoutsResponse] = await Promise.all([
  fetchCompletion(organization!, tournament!),
  model.liveCount > 0 || model.status === 'live'
    ? fetchLive(organization!, tournament!)
    : Promise.resolve(undefined),
  fetchPublicTableLayouts(organization!, tournament!),
]);
const completion = completionData ?? {
  totalMatches: 0,
  resolvedMatches: 0,
  liveMatches: 0,
  scheduledMatches: 0,
  finalizedMatches: 0,
  forfeitedMatches: 0,
  stages: [],
};
const liveDashboard = liveData ? mapLiveResponse(liveData) : undefined;
const liveByMatchId = new Map((liveDashboard?.matches ?? []).map((m) => [m.matchId, m]));
const overlayedMatches: readonly OverviewMatch[] = model.matches.map((match) => {
  const live = match.matchId ? liveByMatchId.get(match.matchId) : undefined;
  if (!live) return match;
  const state =
    live.state === 'live' ||
    live.state === 'upcoming' ||
    live.state === 'final' ||
    live.state === 'disputed'
      ? live.state
      : match.state;
  return {
    ...match,
    state,
    home: {
      ...match.home,
      ...(live.sides[0]?.entrantId === undefined ? {} : { entrantId: live.sides[0].entrantId }),
      ...(live.sides[0]?.score === undefined ? {} : { score: live.sides[0].score }),
    },
    away: {
      ...match.away,
      ...(live.sides[1]?.entrantId === undefined ? {} : { entrantId: live.sides[1].entrantId }),
      ...(live.sides[1]?.score === undefined ? {} : { score: live.sides[1].score }),
    },
  };
});
const completionLabels = completionFigureLabels(intl, completion);
const stateLabels = resultStateLabels(intl);

// The default table shown on the tournament landing page — the earliest
// stage's own group-phase layout, matching what a spectator lands here
// expecting to see. A tournament whose discipline declares no group-phase
// layout (or that has not played a match yet) simply renders no table.
const declaredLayouts = layoutsResponse?.layouts ?? [];

const earliestStageNumber = overviewData.matches.reduce(
  (earliest, match) => Math.min(earliest, match.stageNumber),
  Infinity,
);
const standingsStageNumber =
  model.standingsStageNumber ??
  (Number.isFinite(earliestStageNumber) ? earliestStageNumber : undefined);

const requestedTab = Astro.url.searchParams.get('tab');
const clubResolution = resolveClubFilter(Astro.url.searchParams, model.clubs);
if ('redirectSearch' in clubResolution) {
  const location = clubResolution.redirectSearch
    ? `${Astro.url.pathname}?${clubResolution.redirectSearch}`
    : Astro.url.pathname;
  return new Response(null, { status: 301, headers: { Location: location } });
}
const activeClubAlias = clubResolution.activeClubAlias;
const activeClubId = clubResolution.activeClubId;
const clubFilter = activeClubAlias
  ? { club: activeClubAlias }
  : activeClubId
    ? { clubId: activeClubId }
    : undefined;
const isFilteredByClub = activeClubAlias !== undefined || activeClubId !== undefined;
const searchQuery = Astro.url.searchParams.get('q') ?? undefined;

const defaultLayout =
  declaredLayouts.find((one) => one.target === 'group-phase') ?? declaredLayouts[0];
const activeLayout =
  (requestedTab ? declaredLayouts.find((one) => one.code === requestedTab) : undefined) ??
  defaultLayout;
const isFullLayoutView = requestedTab !== null && activeLayout?.code === requestedTab;

const activeProjection = activeLayout
  ? await fetchPublicTableProjection(
      organization!,
      tournament!,
      activeLayout.code,
      activeLayout.target === 'group-phase' ? standingsStageNumber : undefined,
      clubFilter,
    )
  : undefined;
const activeSegments = activeProjection?.segments ?? [];
const visibleSegments = isFilteredByClub
  ? activeSegments.filter((segment) => segment.rows.length > 0)
  : activeSegments;
const isMultiGroupStandings = activeSegments.length > 1;
const overviewProjectionLimit = 8;
const overviewProjection = activeProjection
  ? isFullLayoutView || isMultiGroupStandings
    ? activeProjection
    : { ...activeProjection, rows: activeProjection.rows.slice(0, overviewProjectionLimit) }
  : undefined;

const finishedKnockoutStage = [...(model.stages ?? [])].reverse().find((stage) => {
  const isKnockout =
    selectStageLayout(stage.format) === 'bracket' ||
    (stage.zones ?? []).some((zone) => selectStageLayout(zone.format) === 'bracket');
  if (!isKnockout) return false;
  const stageCompletion = completion.stages.find(
    (entry) => entry.stageNumber === stage.stageNumber,
  );
  if (stageCompletion) {
    return (
      stageCompletion.totalMatches > 0 &&
      stageCompletion.resolvedMatches >= stageCompletion.totalMatches
    );
  }
  return model.status === 'finished';
});

/*
  The ticker's own reads, both optional: a discipline that declares no
  player-ranking layout contributes no performer items, and a stage projection
  always yields at least one segment, so every format produces a leader.
*/
const performerLayout = declaredLayouts.find((one) => one.target === 'player-ranking');
const [performerProjection, leaderProjection, finishedBracketRaw] = await Promise.all([
  performerLayout
    ? fetchPublicTableProjection(organization!, tournament!, performerLayout.code)
    : Promise.resolve(undefined),
  defaultLayout && defaultLayout.target === 'group-phase' && standingsStageNumber !== undefined
    ? fetchPublicTableProjection(
        organization!,
        tournament!,
        defaultLayout.code,
        standingsStageNumber,
      )
    : Promise.resolve(undefined),
  finishedKnockoutStage
    ? fetchBracket(organization!, tournament!, finishedKnockoutStage.stageNumber)
    : Promise.resolve(undefined),
]);

const finishedBracket = finishedBracketRaw
  ? mapBracketResponse(finishedBracketRaw, intl.formatMessage(messages.resultStateTbd))
  : undefined;
const overallStandings = finishedBracket ? deriveOverallStandings(finishedBracket.zones) : [];
const sideSources = sideSourceLabels(intl);
const formatOverallRank = (entry: OverallStandingsEntry): string =>
  entry.overallPlaceTo === undefined
    ? ordinalOf(entry.overallPlaceFrom, sideSources)
    : `${ordinalOf(entry.overallPlaceFrom, sideSources)}–${ordinalOf(entry.overallPlaceTo, sideSources)}`;
const hasMultipleOverallZones =
  new Set(overallStandings.map((entry) => entry.zoneName).filter(Boolean)).size > 1;
const overallStandingsColumns: readonly DataTableColumn[] = [
  {
    key: 'place',
    header: '#',
    render: (row) => formatOverallRank(row as OverallStandingsEntry),
  },
  {
    key: 'entrant',
    header: intl.formatMessage(messages.standingsTeam),
    name: true,
    render: (row) => (row as OverallStandingsEntry).name,
    renderContent: (row) => {
      const entry = row as OverallStandingsEntry;
      return {
        text: entry.name,
        emblem: {
          abbreviation: entry.abbreviation,
          alt: entry.name,
          src:
            entry.clubId && entry.emblemObjectId
              ? clubEmblemUrl(organization!, entry.clubId)
              : undefined,
        },
      };
    },
  },
  ...(hasMultipleOverallZones
    ? [
        {
          key: 'zone',
          header: intl.formatMessage(messages.matchesViewZoneFilterTitle),
          priority: 'low' as const,
          render: (row: unknown) => (row as OverallStandingsEntry).zoneName ?? '',
        },
      ]
    : []),
];

const tickerPerformerProjection =
  performerProjection === undefined
    ? undefined
    : {
        ...performerProjection,
        label: publicTableLayoutLabel(
          {
            code: performerProjection.layoutCode,
            target: performerProjection.target,
            label: performerProjection.label,
          },
          intl,
        ),
      };

const referenceDate = Date.now();
const tickerChrome = tickerChromeLabels(intl);
const tickerItems = buildTickerItems({
  matches: overlayedMatches,
  ...(tickerPerformerProjection === undefined ? {} : { performers: tickerPerformerProjection }),
  ...(leaderProjection === undefined ? {} : { leaders: leaderProjection }),
  labels: tickerLabels(intl),
  language: resolvedLocale,
  ...(model.organizationTimeZone === undefined ? {} : { timeZone: model.organizationTimeZone }),
  referenceDate,
});

const localePrefix = locale ? `/${locale}` : '';
function hasPersistedMatchId(
  match: OverviewMatch,
): match is OverviewMatch & { readonly matchId: string } {
  return match.matchId !== undefined;
}
const persistedMatches = overlayedMatches.filter(hasPersistedMatchId);
const fixtureSummary = summarizeOverviewMatches(persistedMatches, 4, referenceDate);
const liveMatches = fixtureSummary.live.filter(hasPersistedMatchId);
const delayedMatches = fixtureSummary.delayed.filter(hasPersistedMatchId);
const nextMatches = fixtureSummary.upcoming.filter(hasPersistedMatchId);
const latestResults = fixtureSummary.latestResults.filter(hasPersistedMatchId);
const compactMatchLabels = matchCardLabels(intl);
const overviewLead = overviewLeadFor(model.status);
const heroLabels = tournamentHeroLabels(intl, model);
const heroStatusLine = buildTournamentStatusLine(
  { status: model.status, stages: completion.stages },
  tournamentStatusLineLabels(intl),
);
const heroStateLabel =
  model.status === 'live'
    ? intl.formatMessage(messages.completionInProgress)
    : model.status === 'finished'
      ? stateLabels.final
      : model.status === 'upcoming'
        ? stateLabels.upcoming
        : undefined;
const heroFacts = [
  ...(model.disciplineName === undefined ? [] : [model.disciplineName]),
  ...(completion.totalMatches > 0 ? [completionLabels.summary] : []),
];
const heroVenues = (model.venues ?? []).map((venue) => ({
  name: venue.name,
  ...(venue.address === undefined ? {} : { address: venue.address }),
  courts: intl.formatMessage(messages.overviewVenueCourtCount, { count: venue.courtCount }),
}));
const heroVenueLabels = {
  heading: intl.formatMessage(messages.overviewVenuesHeading),
  address: intl.formatMessage(messages.overviewVenueAddress),
};
const isGroupPhaseStandings =
  activeLayout?.target === 'group-phase' ||
  (activeLayout === undefined && model.standings.length > 0);
const standingsEntrantCount = isGroupPhaseStandings
  ? activeSegments.length > 0 && !isFilteredByClub
    ? new Set(
        activeSegments
          .flatMap((segment) => segment.rows)
          .map((row) => row.entrantId ?? row.entrantName ?? row.actorName),
      ).size
    : new Set(model.standings.map((row) => row.entrantId ?? row.name)).size
  : 0;
const tiebreakLine = isGroupPhaseStandings ? standingsTiebreakLine(intl, model) : undefined;

function baseCardDataOf(match: OverviewMatch & { readonly matchId: string }): MatchCardData {
  const live = liveByMatchId.get(match.matchId);
  return {
    matchId: match.matchId,
    stageNumber: match.stageNumber,
    // The stage ordinal, the number the public match route uses: `matchNumber` here is a
    // per-fixture series index, 1 for every ordinary match.
    matchNumber: match.stageOrdinal ?? match.matchNumber ?? 0,
    ...(match.nodeKey === undefined ? {} : { nodeKey: match.nodeKey }),
    ...(match.round === undefined ? {} : { round: match.round }),
    ...(match.zoneName === undefined ? {} : { zoneName: match.zoneName }),
    ...(match.groupName === undefined ? {} : { groupName: match.groupName }),
    state: match.state,
    homeName: match.home.name,
    ...(match.home.abbreviation === undefined ? {} : { homeAbbreviation: match.home.abbreviation }),
    ...(match.home.clubId === undefined ? {} : { homeClubId: match.home.clubId }),
    ...(match.home.clubAlias === undefined ? {} : { homeClubAlias: match.home.clubAlias }),
    ...(match.home.emblemObjectId === undefined
      ? {}
      : { homeEmblemObjectId: match.home.emblemObjectId }),
    ...(match.state === 'upcoming' || match.home.score === undefined
      ? {}
      : { homeScore: match.home.score }),
    awayName: match.away.name,
    ...(match.away.abbreviation === undefined ? {} : { awayAbbreviation: match.away.abbreviation }),
    ...(match.away.clubId === undefined ? {} : { awayClubId: match.away.clubId }),
    ...(match.away.clubAlias === undefined ? {} : { awayClubAlias: match.away.clubAlias }),
    ...(match.away.emblemObjectId === undefined
      ? {}
      : { awayEmblemObjectId: match.away.emblemObjectId }),
    ...(match.state === 'upcoming' || match.away.score === undefined
      ? {}
      : { awayScore: match.away.score }),
    ...(live?.clock === undefined
      ? {}
      : { clock: live.clock, clockSeconds: live.clock.elapsedSeconds }),
    ...(live?.segments === undefined ? {} : { segments: live.segments }),
    ...(live?.projectionVersion === undefined ? {} : { projectionVersion: live.projectionVersion }),
    ...(match.home.entrantId === undefined ? {} : { homeEntrantId: match.home.entrantId }),
    ...(match.away.entrantId === undefined ? {} : { awayEntrantId: match.away.entrantId }),
    ...(match.startsAt === '' ? {} : { scheduledAt: match.startsAt }),
    ...(match.venueName === undefined ? {} : { venueName: match.venueName }),
  };
}

// Knockout depth and placements are read across the whole tournament, so a card names its round.
const cardDataById = new Map(
  withSourceDepth(overlayedMatches.filter(hasPersistedMatchId).map(baseCardDataOf)).map((card) => [
    card.matchId,
    card,
  ]),
);
const liveSeeds = (liveDashboard?.matches ?? []).map((live) => ({
  matchId: live.matchId,
  projectionVersion: live.projectionVersion,
  state: live.state,
  ...(live.clock === undefined ? {} : { clock: live.clock }),
  ...(live.segments === undefined ? {} : { segments: live.segments }),
  homeScore: live.sides[0]?.score,
  awayScore: live.sides[1]?.score,
  homeEntrantId: live.sides[0]?.entrantId,
  awayEntrantId: live.sides[1]?.entrantId,
}));
function matchCardDataOf(match: OverviewMatch & { readonly matchId: string }): MatchCardData {
  return cardDataById.get(match.matchId) ?? baseCardDataOf(match);
}

function matchPagePath(match: OverviewMatch): string {
  if (match.stageOrdinal === undefined) {
    return `${localePrefix}${model.canonicalPath}/matches?stageNumber=${match.stageNumber}`;
  }
  return `${localePrefix}${model.canonicalPath}/stages/${match.stageNumber}/matches/${match.stageOrdinal}`;
}

const nextFeaturedMatch = overviewLead === 'schedule-preview' ? nextMatches[0] : undefined;
const nowSelected =
  overviewLead === 'now-strip'
    ? selectNowStripMatches(fixtureSummary, 3).filter(hasPersistedMatchId)
    : [];
const nowEntries = nowSelected.map((match) => ({
  kind:
    match.state === 'live'
      ? ('live' as const)
      : isDelayed(match, referenceDate)
        ? ('delayed' as const)
        : ('upcoming' as const),
  match: matchCardDataOf(match),
  href: matchPagePath(match),
}));
const featuredMatchIds = new Set(
  (overviewLead === 'now-strip' ? nowSelected : [nextFeaturedMatch])
    .filter((match): match is OverviewMatch & { readonly matchId: string } => match !== undefined)
    .map((match) => match.matchId),
);
const remainingLiveMatches = liveMatches.filter((match) => !featuredMatchIds.has(match.matchId));
const remainingDelayedMatches = delayedMatches.filter(
  (match) => !featuredMatchIds.has(match.matchId),
);
const remainingNextMatches = nextMatches.filter((match) => !featuredMatchIds.has(match.matchId));
const remainingLatestResults = latestResults.filter(
  (match) => !featuredMatchIds.has(match.matchId),
);
const dayHeadingTemplate = intl.formatMessage(messages.scheduleDayHeading, {
  relative: '{relative}',
  date: '{date}',
});
const tbdLabel = intl.formatMessage(messages.resultStateTbd);
const nextMatchDayGroups = groupOverviewMatchesByDay(remainingNextMatches, {
  locale: resolvedLocale,
  timeZone: model.organizationTimeZone,
  referenceDate,
  dayHeadingTemplate,
  tbdLabel,
});
const latestResultDayGroups = groupOverviewMatchesByDay(remainingLatestResults, {
  locale: resolvedLocale,
  timeZone: model.organizationTimeZone,
  referenceDate,
  dayHeadingTemplate,
  tbdLabel,
});

const nextKickoff = model.matches
  .filter(
    (match) =>
      match.state === 'upcoming' &&
      !isDelayed(match, referenceDate) &&
      Number.isFinite(Date.parse(match.startsAt)),
  )
  .sort((a, b) => Date.parse(a.startsAt) - Date.parse(b.startsAt))[0];
const noLiveDescription = nextKickoff
  ? intl.formatMessage(messages.interactionNextKickoff, {
      time: formatTimestamp(nextKickoff.startsAt, {
        locale: resolvedLocale,
        format: 'full',
        timeZone: model.organizationTimeZone,
      }),
    })
  : intl.formatMessage(messages.interactionSeeSchedule);

const canonicalPath = `${localePrefix}${model.canonicalPath}`;
const fullLayoutHref = (layout: (typeof declaredLayouts)[number]): string =>
  `${canonicalPath}?tab=${encodeURIComponent(layout.code)}${activeClubAlias ? `&club=${encodeURIComponent(activeClubAlias)}` : ''}`;
const earliestStart = overviewData.matches
  .map((m) => m.scheduledAt)
  .filter(Boolean)
  .sort()[0];
const description = intl.formatMessage(messages.tournamentPageDescription, {
  tournament: displayName(model),
});
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: displayName(model),
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
  ...(earliestStart ? { startDate: earliestStart } : {}),
  description,
};
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: displayName(model),
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, []);
---

<PublicLayout
  title={`${displayName(model)} — ${model.organizationName}`}
  description={description}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <ScoreTicker
    slot="ticker"
    emptyLabel={tickerChrome.empty}
    items={tickerItems}
    label={intl.formatMessage(messages.tickerLabel)}
    liveBadgeLabels={tickerLabels(intl)}
    pauseLabel={tickerChrome.pause}
    resumeLabel={tickerChrome.resume}
    staleLabel={tickerChrome.stale}
    streamPath={model.streamPath}
  />
  <Container variant="public">
    {liveSeeds.length > 0 && (
      <div data-live-stream={model.streamPath} hidden>
        {liveSeeds.map((seed) => (
          <span data-live-match-seed={JSON.stringify(seed)} />
        ))}
      </div>
    )}
    <TournamentOverviewHero
      model={model}
      labels={heroLabels}
      trail={trail}
      breadcrumbLabel={intl.formatMessage(messages.livePageBreadcrumb)}
      collapsedBreadcrumbLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
      statusLine={heroStatusLine}
      stateLabel={heroStateLabel}
      facts={heroFacts}
      venues={heroVenues}
      venueLabels={heroVenueLabels}
    />
    {overviewLead === 'now-strip' && (
      <TournamentNowStrip
        heading={intl.formatMessage(messages.overviewNowStripHeading)}
        entries={nowEntries}
        labels={compactMatchLabels}
        locale={resolvedLocale}
        referenceDate={referenceDate}
        timeZone={model.organizationTimeZone}
      />
    )}
    <div class="cl-overview-completion">
      <CompletionFigure
        totalMatches={completion.totalMatches}
        resolvedMatches={completion.resolvedMatches}
        stages={completion.stages}
        labels={completionLabels}
      />
    </div>
    {overviewLead === 'honour-board' && model.winners && model.winners.length > 0 && (
      <TournamentHonourBoard
        heading={intl.formatMessage(messages.overviewHonourBoardHeading)}
        winners={withPodiumEmblems(organization!, model.winners)}
        intl={intl}
      />
    )}
    {overallStandings.length > 0 && (
      <section class="cl-overview-overall-standings" aria-labelledby="overall-standings-heading">
        <h2 id="overall-standings-heading">
          {intl.formatMessage(messages.overviewOverallStandingsHeading)}
        </h2>
        <DataTable
          ariaLabel={intl.formatMessage(messages.overviewOverallStandingsHeading)}
          columns={overallStandingsColumns}
          mobileMode="priority"
          moreColumnsLabel={intl.formatMessage(messages.standingsMoreColumns)}
          rows={overallStandings}
        />
      </section>
    )}
    {nextFeaturedMatch && (
      <FeaturedMatchCard
        heading={intl.formatMessage(messages.overviewFeaturedMatchHeading)}
        match={matchCardDataOf(nextFeaturedMatch)}
        href={matchPagePath(nextFeaturedMatch)}
        labels={compactMatchLabels}
        locale={resolvedLocale}
        localePrefix={localePrefix}
        referenceDate={referenceDate}
        timeZone={model.organizationTimeZone}
        organizationAlias={organization}
        tournamentAlias={tournament}
      />
    )}
    {overviewLead === 'schedule-preview' &&
      nextFeaturedMatch === undefined &&
      model.matches.length === 0 && (
        <Container variant="reading">
          <EmptyState
            icon="calendar"
            heading={intl.formatMessage(messages.interactionNoLive)}
            description={noLiveDescription}
            actionLabel={intl.formatMessage(messages.interactionViewMatches)}
            href={`${localePrefix}${model.canonicalPath}/matches`}
          />
        </Container>
      )}
  </Container>
  <Container variant="public">
    <section aria-labelledby="overview-matches-heading">
      <h2 id="overview-matches-heading">{intl.formatMessage(messages.matchGridHeading)}</h2>
      <TimeZoneNote
        locale={resolvedLocale}
        referenceDate={referenceDate}
        timeZone={model.organizationTimeZone}
        {...timeZoneNoteLabels(intl)}
      />
      {remainingLiveMatches.length > 0 && (
        <section aria-labelledby="overview-live-heading">
          <h3 id="overview-live-heading">{intl.formatMessage(messages.matchesViewFilterLive)}</h3>
          <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
            {remainingLiveMatches.map((match) => (
              <li>
                <MatchCard
                  compact
                  compactNames="full"
                  labels={compactMatchLabels}
                  locale={resolvedLocale}
                  match={matchCardDataOf(match)}
                  referenceDate={referenceDate}
                  reportUrl={matchPagePath(match)}
                  timeZone={model.organizationTimeZone}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
      {remainingDelayedMatches.length > 0 && (
        <section aria-labelledby="overview-delayed-heading">
          <h3 id="overview-delayed-heading">{intl.formatMessage(messages.resultStateDelayed)}</h3>
          <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
            {remainingDelayedMatches.map((match) => (
              <li>
                <MatchCard
                  compact
                  compactNames="full"
                  labels={compactMatchLabels}
                  locale={resolvedLocale}
                  match={matchCardDataOf(match)}
                  referenceDate={referenceDate}
                  reportUrl={matchPagePath(match)}
                  timeZone={model.organizationTimeZone}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
      {remainingNextMatches.length > 0 && (
        <section aria-labelledby="overview-next-heading">
          <h3 id="overview-next-heading">{intl.formatMessage(messages.overviewNextMatches)}</h3>
          {nextMatchDayGroups.map((group) => (
            <div class="cl-overview-day-group">
              <h4 class="cl-overview-day-heading">{group.heading}</h4>
              <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
                {group.matches.map((match) => (
                  <li>
                    <MatchCard
                      compact
                      compactNames="full"
                      labels={compactMatchLabels}
                      locale={resolvedLocale}
                      match={matchCardDataOf(match)}
                      referenceDate={referenceDate}
                      reportUrl={matchPagePath(match)}
                      timeZone={model.organizationTimeZone}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}
      {remainingLatestResults.length > 0 && (
        <section aria-labelledby="overview-results-heading">
          <h3 id="overview-results-heading">
            {intl.formatMessage(messages.overviewLatestResults)}
          </h3>
          {latestResultDayGroups.map((group) => (
            <div class="cl-overview-day-group">
              <h4 class="cl-overview-day-heading">{group.heading}</h4>
              <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
                {group.matches.map((match) => (
                  <li>
                    <MatchCard
                      compact
                      compactNames="full"
                      labels={compactMatchLabels}
                      locale={resolvedLocale}
                      match={matchCardDataOf(match)}
                      referenceDate={referenceDate}
                      reportUrl={matchPagePath(match)}
                      timeZone={model.organizationTimeZone}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}
      <p>
        <a class="cl-pill cl-focusable" href={`${localePrefix}${model.canonicalPath}/matches`}>
          {intl.formatMessage(messages.matchesViewSeeAll)}
        </a>
      </p>
    </section>
    {isMultiGroupStandings && overviewProjection ? (
      <section id="standings" aria-labelledby="standings-heading" class="cl-standings-section">
        <StandingsTable
          layouts={declaredLayouts}
          layout={activeLayout}
          projection={overviewProjection}
          showControls={isFullLayoutView}
          renderPart="header"
          entrantCount={standingsEntrantCount > 0 ? standingsEntrantCount : undefined}
          tiebreakLine={tiebreakLine}
          activeLayoutCode={activeLayout?.code}
          activeClubAlias={activeClubAlias}
          activeClubId={activeClubId}
          searchQuery={searchQuery}
          clubs={model.clubs}
          intl={intl}
          canonicalPath={canonicalPath}
          sectionId="standings"
          teamAnchorId="teams"
          organizationAlias={organization!}
          tournamentAlias={tournament}
        />
        <div id="teams" class="cl-standings-groups cl-standings-groups--grid">
          {visibleSegments.map((segment) => (
            <StandingsTable
              layout={activeLayout}
              projection={{ ...overviewProjection, rows: segment.rows }}
              heading={segment.groupName}
              chrome="table-only"
              showControls={isFullLayoutView}
              activeLayoutCode={activeLayout?.code}
              activeClubAlias={activeClubAlias}
              activeClubId={activeClubId}
              clubs={model.clubs}
              intl={intl}
              canonicalPath={canonicalPath}
              organizationAlias={organization!}
              tournamentAlias={tournament}
            />
          ))}
        </div>
        <StandingsTable
          layouts={declaredLayouts}
          layout={activeLayout}
          projection={overviewProjection}
          csvHref={
            isFullLayoutView && activeLayout
              ? publicTableCsvUrl(
                  organization!,
                  tournament!,
                  activeLayout.code,
                  activeLayout.target === 'group-phase' ? standingsStageNumber : undefined,
                  clubFilter,
                )
              : undefined
          }
          showControls={isFullLayoutView}
          renderPart="footer"
          activeLayoutCode={activeLayout?.code}
          activeClubAlias={activeClubAlias}
          activeClubId={activeClubId}
          searchQuery={searchQuery}
          clubs={model.clubs}
          intl={intl}
          canonicalPath={canonicalPath}
          sectionId="standings"
          organizationAlias={organization!}
          tournamentAlias={tournament}
        />
      </section>
    ) : (
      <StandingsTable
        layouts={declaredLayouts}
        layout={activeLayout}
        projection={overviewProjection}
        csvHref={
          isFullLayoutView && activeLayout
            ? publicTableCsvUrl(
                organization!,
                tournament!,
                activeLayout.code,
                activeLayout.target === 'group-phase' ? standingsStageNumber : undefined,
                clubFilter,
              )
            : undefined
        }
        showControls={isFullLayoutView}
        entrantCount={standingsEntrantCount > 0 ? standingsEntrantCount : undefined}
        tiebreakLine={tiebreakLine}
        activeLayoutCode={activeLayout?.code}
        activeClubAlias={activeClubAlias}
        activeClubId={activeClubId}
        searchQuery={searchQuery}
        clubs={model.clubs}
        intl={intl}
        canonicalPath={canonicalPath}
        sectionId="standings"
        teamAnchorId="teams"
        organizationAlias={organization!}
        tournamentAlias={tournament}
      />
    )}
    {!isFullLayoutView && declaredLayouts.length > 0 && (
      <nav
        aria-label={intl.formatMessage(messages.standingsTableLayouts)}
        class="cl-standings-summary-action"
      >
        <ul class="cl-pill-group">
          {declaredLayouts.map((one) => (
            <li>
              <a
                class="cl-pill cl-focusable"
                data-full-layout-code={one.code}
                href={fullLayoutHref(one)}
              >
                {intl.formatMessage(messages.standingsFullTable)} ·{' '}
                {publicTableLayoutLabel(one, intl)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <RulesetBriefing
      heading={intl.formatMessage(messages.rulesetHeading)}
      rows={rulesetBriefingRows(intl, model)}
    />
  </Container>
</PublicLayout>

<style>
  .cl-overview-day-group + .cl-overview-day-group {
    margin-block-start: var(--cl-space-3);
  }

  .cl-overview-day-heading {
    margin: 0 0 var(--cl-space-2);
    color: var(--cl-text-secondary);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    letter-spacing: var(--cl-tracking-wide);
    text-transform: uppercase;
  }
</style>

<script>
  // Page tier: the only place on this page allowed to own a
  // RealtimeClient subscription — see check-atomic-composition.mjs's
  // data-access-at-page-tier rule. Patches ScoreTicker's own rendered DOM;
  // never a requirement for the page's content, only an enhancement of it.
  import { mountLiveTicker } from '../../../../lib/ticker-live.ts';

  mountLiveTicker();
  if (document.querySelector('[data-live-stream]')) {
    void import('../../../../lib/public-live-scoreboards.ts').then(
      ({ mountPublicLiveScoreboards }) => {
        mountPublicLiveScoreboards();
      },
    );
  }
</script>

<style>
  .cl-overview-completion,
  .cl-overview-overall-standings {
    margin-block-end: var(--cl-space-5);
  }

  .cl-standings-groups {
    display: grid;
    gap: var(--cl-space-4);
    margin-block: var(--cl-space-3);
  }

  @media (min-width: 1024px) {
    .cl-standings-groups--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cl-standings-summary-action {
    margin-block: var(--cl-space-3) var(--cl-space-5);
  }
</style>
