---
import EmptyState from '../../../../components/ui/molecules/EmptyState.astro';
import Container from '../../../../components/ui/atoms/layout/Container.astro';
import Breadcrumb from '../../../../components/ui/organisms/Breadcrumb.astro';
import { MatchCard } from '../../../../components/ui/organisms/MatchCard.tsx';
import { publicTrail, trailBaseOf } from '../../../../lib/breadcrumb.ts';
import { localizedText } from '../../../../lib/localized-label.ts';
import PublicLayout from '../../../../layouts/PublicLayout.astro';
import TournamentHero from '../../../../components/ui/molecules/TournamentHero.astro';
import ChampionPodium from '../../../../components/ui/organisms/ChampionPodium.astro';
import ScoreTicker from '../../../../components/ui/organisms/ScoreTicker.astro';
import StandingsTable from '../../../../components/ui/organisms/StandingsTable.astro';
import BroadcastStatusPanel from '../../../../components/ui/molecules/BroadcastStatusPanel.astro';
import RulesetBriefing from '../../../../components/ui/molecules/RulesetBriefing.astro';
import { CompletionFigure } from '../../../../components/ui/molecules/CompletionFigure.tsx';
import { withPodiumEmblems } from '../../../../lib/podium-emblems.ts';
import {
  buildOverview,
  displayName,
  shouldShowChampionPodium,
  summarizeOverviewMatches,
  type OverviewMatch,
} from '../../../../lib/overview.ts';
import type { MatchCardData } from '../../../../lib/matches-view.ts';
import {
  fetchOverview,
  fetchCompletion,
  fetchPublicTableLayouts,
  fetchPublicTableProjection,
  mapOverviewResponse,
} from '../../../../lib/public-api-client.ts';
import {
  publicIntl,
  tickerChromeLabels,
  matchCardLabels,
  tickerLabels,
  tournamentHeroLabels,
  completionFigureLabels,
  rulesetBriefingRows,
} from '../../../../lib/i18n/public-intl.ts';
import { buildTickerItems } from '../../../../lib/ticker-items.ts';
import { messages } from '../../../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

/**
 * B1, the tournament overview.
 *
 * Everything a spectator needs is server-rendered. The SSE stream is
 * an improvement on this page, never a requirement for it: a venue on hotel
 * Wi-Fi still gets the score.
 *
 * `[[locale]]` is an optional Astro route segment: English, the
 * primary locale, is generated with `locale: undefined` (no URL segment);
 * every other supported language is generated with its own locale code
 * (the remaining five locales ship alongside Spanish).
 */
export const prerender = false;

const { locale, organization, tournament } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const overviewData = await fetchOverview(organization!, tournament!);
if (!overviewData) {
  return Astro.rewrite('/404');
}

const model = buildOverview(mapOverviewResponse(overviewData, resolvedLocale));

const completionData = await fetchCompletion(organization!, tournament!);
const completion = completionData ?? {
  totalMatches: 0,
  resolvedMatches: 0,
  liveMatches: 0,
  scheduledMatches: 0,
  finalizedMatches: 0,
  forfeitedMatches: 0,
  stages: [],
};
const completionLabels = completionFigureLabels(intl, completion);

// The default table shown on the tournament landing page — the earliest
// stage's own group-phase layout, matching what a spectator lands here
// expecting to see. A tournament whose discipline declares no group-phase
// layout (or that has not played a match yet) simply renders no table.
const layoutsResponse = await fetchPublicTableLayouts(organization!, tournament!);
const declaredLayouts = layoutsResponse?.layouts ?? [];

const earliestStageNumber = overviewData.matches.reduce(
  (earliest, match) => Math.min(earliest, match.stageNumber),
  Infinity,
);

const requestedTab = Astro.url.searchParams.get('tab');
const activeClubId = Astro.url.searchParams.get('clubId') ?? undefined;

const defaultLayout =
  declaredLayouts.find((one) => one.target === 'group-phase') ?? declaredLayouts[0];
const activeLayout =
  (requestedTab ? declaredLayouts.find((one) => one.code === requestedTab) : undefined) ??
  defaultLayout;
const isFullLayoutView = requestedTab !== null && activeLayout?.code === requestedTab;

const activeProjection = activeLayout
  ? await fetchPublicTableProjection(
      organization!,
      tournament!,
      activeLayout.code,
      activeLayout.target === 'group-phase' && Number.isFinite(earliestStageNumber)
        ? earliestStageNumber
        : undefined,
      activeClubId,
    )
  : undefined;
const overviewProjectionLimit = 8;
const overviewProjection = activeProjection
  ? isFullLayoutView
    ? activeProjection
    : { ...activeProjection, rows: activeProjection.rows.slice(0, overviewProjectionLimit) }
  : undefined;

/*
  The ticker's own reads, both optional: a discipline that declares no
  player-ranking layout contributes no performer items, and a stage projection
  always yields at least one segment, so every format produces a leader.
*/
const performerLayout = declaredLayouts.find((one) => one.target === 'player-ranking');
const [performerProjection, leaderProjection] = await Promise.all([
  performerLayout
    ? fetchPublicTableProjection(organization!, tournament!, performerLayout.code)
    : Promise.resolve(undefined),
  defaultLayout && defaultLayout.target === 'group-phase' && Number.isFinite(earliestStageNumber)
    ? fetchPublicTableProjection(
        organization!,
        tournament!,
        defaultLayout.code,
        earliestStageNumber,
      )
    : Promise.resolve(undefined),
]);

const tickerChrome = tickerChromeLabels(intl);
const tickerItems = buildTickerItems({
  matches: model.matches,
  ...(performerProjection === undefined ? {} : { performers: performerProjection }),
  ...(leaderProjection === undefined ? {} : { leaders: leaderProjection }),
  labels: tickerLabels(intl),
  language: resolvedLocale,
  ...(model.organizationTimeZone === undefined ? {} : { timeZone: model.organizationTimeZone }),
});

const localePrefix = locale ? `/${locale}` : '';
const fixtureSummary = summarizeOverviewMatches(model.matches);
function hasPersistedMatchId(
  match: OverviewMatch,
): match is OverviewMatch & { readonly matchId: string } {
  return match.matchId !== undefined;
}
const liveMatches = fixtureSummary.live.filter(hasPersistedMatchId);
const nextMatches = fixtureSummary.upcoming.filter(hasPersistedMatchId);
const latestResults = fixtureSummary.latestResults.filter(hasPersistedMatchId);
const compactMatchLabels = matchCardLabels(intl);

function matchCardDataOf(match: OverviewMatch & { readonly matchId: string }): MatchCardData {
  return {
    matchId: match.matchId,
    stageNumber: match.stageNumber,
    matchNumber: match.matchNumber ?? match.stageOrdinal ?? 0,
    state: match.state,
    homeName: match.home.name,
    ...(match.home.abbreviation === undefined ? {} : { homeAbbreviation: match.home.abbreviation }),
    ...(match.home.clubId === undefined ? {} : { homeClubId: match.home.clubId }),
    ...(match.home.emblemObjectId === undefined
      ? {}
      : { homeEmblemObjectId: match.home.emblemObjectId }),
    ...(match.state === 'upcoming' || match.home.score === undefined
      ? {}
      : { homeScore: match.home.score }),
    awayName: match.away.name,
    ...(match.away.abbreviation === undefined ? {} : { awayAbbreviation: match.away.abbreviation }),
    ...(match.away.clubId === undefined ? {} : { awayClubId: match.away.clubId }),
    ...(match.away.emblemObjectId === undefined
      ? {}
      : { awayEmblemObjectId: match.away.emblemObjectId }),
    ...(match.state === 'upcoming' || match.away.score === undefined
      ? {}
      : { awayScore: match.away.score }),
    ...(match.startsAt === '' ? {} : { scheduledAt: match.startsAt }),
    ...(match.venueName === undefined ? {} : { venueName: match.venueName }),
  };
}

function matchPagePath(match: OverviewMatch): string {
  if (match.stageOrdinal === undefined) {
    return `${localePrefix}${model.canonicalPath}/matches?stageNumber=${match.stageNumber}`;
  }
  return `${localePrefix}${model.canonicalPath}/stages/${match.stageNumber}/matches/${match.stageOrdinal}`;
}

const nextKickoff = model.matches
  .filter((match) => match.state === 'upcoming' && Date.parse(match.startsAt) >= Date.now())
  .sort((a, b) => Date.parse(a.startsAt) - Date.parse(b.startsAt))[0];
const noLiveDescription = nextKickoff
  ? intl.formatMessage(messages.interactionNextKickoff, {
      time: intl.formatDate(new Date(nextKickoff.startsAt), {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: model.organizationTimeZone,
      }),
    })
  : intl.formatMessage(messages.interactionSeeSchedule);

const canonicalPath = `${localePrefix}${model.canonicalPath}`;
const fullLayoutHref = (layout: (typeof declaredLayouts)[number]): string =>
  `${canonicalPath}?tab=${encodeURIComponent(layout.code)}`;
const earliestStart = overviewData.matches
  .map((m) => m.scheduledAt)
  .filter(Boolean)
  .sort()[0];
const description = intl.formatMessage(messages.tournamentPageDescription, {
  tournament: displayName(model),
});
const structuredData = {
  '@type': 'SportsEvent' as const,
  name: displayName(model),
  url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
  ...(earliestStart ? { startDate: earliestStart } : {}),
  description,
};
const trailBase = trailBaseOf({
  organizationAlias: organization!,
  organizationName: model.organizationName,
  tournamentName: displayName(model),
  canonicalPath: model.canonicalPath,
  localePrefix,
});
const trail = publicTrail(trailBase, []);
---

<PublicLayout
  title={`${displayName(model)} — ${model.organizationName}`}
  description={description}
  canonicalPath={canonicalPath}
  intl={intl}
  disciplineImages={overviewData.disciplineImages}
  structuredData={structuredData}
>
  <Container variant="public">
    <Breadcrumb
      items={trail}
      ariaLabel={intl.formatMessage(messages.livePageBreadcrumb)}
      collapsedLabel={intl.formatMessage(messages.breadcrumbCollapsed)}
    />
  </Container>
  <ScoreTicker
    emptyLabel={tickerChrome.empty}
    items={tickerItems}
    label={intl.formatMessage(messages.tickerLabel)}
    liveBadgeLabels={tickerLabels(intl)}
    pauseLabel={tickerChrome.pause}
    resumeLabel={tickerChrome.resume}
    staleLabel={tickerChrome.stale}
  />
  <Container variant="public">
    <TournamentHero labels={tournamentHeroLabels(intl, model)} model={model} />
    {model.liveCount === 0 && (
      <Container variant="reading">
        <EmptyState
          icon="calendar"
          heading={intl.formatMessage(messages.interactionNoLive)}
          description={noLiveDescription}
          actionLabel={intl.formatMessage(messages.interactionViewMatches)}
          href={`${localePrefix}${model.canonicalPath}/matches`}
        />
      </Container>
    )}
    <section aria-labelledby="overview-matches-heading">
      <h2 id="overview-matches-heading">{intl.formatMessage(messages.matchGridHeading)}</h2>
      {liveMatches.length > 0 && (
        <section aria-labelledby="overview-live-heading">
          <h3 id="overview-live-heading">{intl.formatMessage(messages.matchesViewFilterLive)}</h3>
          <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
            {liveMatches.map((match) => (
              <li>
                <MatchCard
                  compact
                  compactNames="full"
                  labels={compactMatchLabels}
                  locale={resolvedLocale}
                  match={matchCardDataOf(match)}
                  reportUrl={matchPagePath(match)}
                  timeZone={model.organizationTimeZone}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
      {nextMatches.length > 0 && (
        <section aria-labelledby="overview-next-heading">
          <h3 id="overview-next-heading">{intl.formatMessage(messages.overviewNextMatches)}</h3>
          <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
            {nextMatches.map((match) => (
              <li>
                <MatchCard
                  compact
                  compactNames="full"
                  labels={compactMatchLabels}
                  locale={resolvedLocale}
                  match={matchCardDataOf(match)}
                  reportUrl={matchPagePath(match)}
                  timeZone={model.organizationTimeZone}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
      {latestResults.length > 0 && (
        <section aria-labelledby="overview-results-heading">
          <h3 id="overview-results-heading">
            {intl.formatMessage(messages.overviewLatestResults)}
          </h3>
          <ul class="cl-match-card-grid cl-match-card-grid--compact-summary">
            {latestResults.map((match) => (
              <li>
                <MatchCard
                  compact
                  compactNames="full"
                  labels={compactMatchLabels}
                  locale={resolvedLocale}
                  match={matchCardDataOf(match)}
                  reportUrl={matchPagePath(match)}
                  timeZone={model.organizationTimeZone}
                />
              </li>
            ))}
          </ul>
        </section>
      )}
      <p>
        <a class="cl-pill cl-focusable" href={`${localePrefix}${model.canonicalPath}/matches`}>
          {intl.formatMessage(messages.matchesViewSeeAll)}
        </a>
      </p>
    </section>
    <CompletionFigure
      totalMatches={completion.totalMatches}
      resolvedMatches={completion.resolvedMatches}
      stages={completion.stages}
      labels={completionLabels}
    />
    {shouldShowChampionPodium(model) && model.winners && (
      <ChampionPodium
        winners={withPodiumEmblems(organization!, model.winners)}
        intl={intl}
        prominent={true}
      />
    )}
    <BroadcastStatusPanel
      model={model}
      statusText={intl.formatMessage(messages.broadcastStatusDisconnected)}
    />
    <StandingsTable
      layouts={declaredLayouts}
      layout={activeLayout}
      projection={overviewProjection}
      showControls={isFullLayoutView}
      activeLayoutCode={activeLayout?.code}
      activeClubId={activeClubId}
      clubs={model.clubs}
      intl={intl}
      canonicalPath={canonicalPath}
      organizationAlias={organization!}
      tournamentAlias={tournament}
    />
    {!isFullLayoutView && declaredLayouts.length > 0 && (
      <nav
        aria-label={intl.formatMessage(messages.standingsTableLayouts)}
        class="cl-standings-summary-action"
      >
        <ul class="cl-pill-group">
          {declaredLayouts.map((one) => (
            <li>
              <a
                class="cl-pill cl-focusable"
                data-full-layout-code={one.code}
                href={fullLayoutHref(one)}
              >
                {intl.formatMessage(messages.standingsFullTable)} ·{' '}
                {localizedText(one.label, resolvedLocale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <RulesetBriefing
      heading={intl.formatMessage(messages.rulesetHeading)}
      rows={rulesetBriefingRows(intl, model)}
    />
  </Container>
</PublicLayout>

<script>
  // Page tier: the only place on this page allowed to own a
  // RealtimeClient subscription — see check-atomic-composition.mjs's
  // data-access-at-page-tier rule. Patches ScoreTicker's own rendered DOM;
  // never a requirement for the page's content, only an enhancement of it.
  import { mountLiveTicker } from '../../../../lib/ticker-live.ts';

  mountLiveTicker();
</script>

<style>
  /* Guarantees clear separation from the hero banner above. */
  :global(.cl-completion-figure) {
    margin-top: var(--cl-space-6);
  }

  .cl-standings-summary-action {
    margin-block: var(--cl-space-3) var(--cl-space-5);
  }
</style>
