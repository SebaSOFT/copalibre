---
import PublicLayout from '../../layouts/PublicLayout.astro';
import OrganizationHeader from '../../components/ui/organisms/OrganizationHeader.astro';
import TournamentSection from '../../components/ui/organisms/TournamentSection.astro';
import OrganizationClubs from '../../components/ui/organisms/OrganizationClubs.astro';
import {
  fetchOrganizationTournaments,
  organizationEmblemUrl,
  clubEmblemUrl,
} from '../../lib/public-api-client.ts';
import { featuredTournaments } from '../../lib/organization-page.ts';
import { publicIntl } from '../../lib/i18n/public-intl.ts';
import { messages } from '../../lib/i18n/public-messages.en.ts';
import { resolvePathLocale } from '../../lib/locale.ts';
import type { SupportedLanguage } from '@copalibre/domain';

export const prerender = false;

const { organization } = Astro.params;
const rawPath = Astro.request?.url ? new URL(Astro.request.url).pathname : Astro.url.pathname;
const resolvedLocale: SupportedLanguage = resolvePathLocale(rawPath);
const intl = publicIntl(resolvedLocale);

const listData = await fetchOrganizationTournaments(organization!);
if (!listData) {
  // Astro.rewrite('/404') targets the site's static-host fallback page
  // (src/pages/404.astro, prerendered by design so any static host can
  // serve it with no server config) — an on-demand route can't rewrite
  // into a prerendered one, so an unknown organization renders its own
  // not-found content below instead, with the response status set to
  // match.
  Astro.response.status = 404;
}

const localePrefix = resolvedLocale === 'en' ? '' : `/${resolvedLocale}`;
const canonicalPath = `${localePrefix}/${encodeURIComponent(organization!)}`;

const liveTournaments = listData?.tournaments.filter((t) => t.status === 'live') ?? [];
const upcomingTournaments = listData?.tournaments.filter((t) => t.status === 'upcoming') ?? [];
const finishedTournaments = listData?.tournaments.filter((t) => t.status === 'finished') ?? [];
const orgClubs = (listData?.clubs ?? []).map((club) => ({
  ...club,
  emblemSrc: club.emblemObjectId ? clubEmblemUrl(organization!, club.clubId) : undefined,
}));
const organizationEmblemSrc = listData?.organizationEmblemObjectId
  ? organizationEmblemUrl(listData.organizationAlias)
  : undefined;
// Live first, featured second: live is urgent, featured is curated (0207).
const featured = listData ? featuredTournaments(listData.tournaments) : [];

const pageTitle = listData?.organizationName ?? intl.formatMessage(messages.orgPageNotFoundTitle);
const structuredData = listData
  ? {
      '@type': 'SportsOrganization' as const,
      name: listData.organizationName,
      url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
      ...(listData.organizationEmblemObjectId
        ? {
            logo: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${organizationEmblemUrl(organization!)}`,
          }
        : {}),
    }
  : undefined;
---

<PublicLayout
  title={pageTitle}
  canonicalPath={canonicalPath}
  intl={intl}
  noindex={!listData}
  structuredData={structuredData}
>
  {
    !listData && (
      <div class="cl-org-container">
        <div class="cl-empty-state">
          <p>{intl.formatMessage(messages.orgPageNotFoundBody)}</p>
        </div>
      </div>
    )
  }
  {
    listData && (
      <div class="cl-org-container">
        <OrganizationHeader
          organizationAlias={listData.organizationAlias}
          organizationName={listData.organizationName}
          emblemSrc={organizationEmblemSrc}
          intl={intl}
        />

        {listData.tournaments.length === 0 && (
          <div class="cl-empty-state">
            <p>{intl.formatMessage(messages.tournamentsEmpty)}</p>
          </div>
        )}

        {liveTournaments.length > 0 && (
          <TournamentSection
            headingId="heading-live"
            heading={intl.formatMessage(messages.tournamentsLiveHeading)}
            tournaments={liveTournaments}
            organizationAlias={organization!}
            localePrefix={localePrefix}
            intl={intl}
            showLiveDot={true}
            sectionClass="cl-section-live"
            gridClass="cl-grid-live"
          />
        )}

        {featured.length > 0 && (
          <TournamentSection
            headingId="heading-featured"
            heading={intl.formatMessage(messages.orgPageFeaturedHeading)}
            tournaments={featured}
            organizationAlias={organization!}
            localePrefix={localePrefix}
            intl={intl}
            showCount={false}
            featured={true}
            sectionClass="cl-section-featured"
            gridClass="cl-grid-featured"
          />
        )}

        {upcomingTournaments.length > 0 && (
          <TournamentSection
            headingId="heading-upcoming"
            heading={intl.formatMessage(messages.tournamentsUpcomingHeading)}
            tournaments={upcomingTournaments}
            organizationAlias={organization!}
            localePrefix={localePrefix}
            intl={intl}
          />
        )}

        {finishedTournaments.length > 0 && (
          <TournamentSection
            headingId="heading-finished"
            heading={intl.formatMessage(messages.tournamentsFinishedHeading)}
            tournaments={finishedTournaments}
            organizationAlias={organization!}
            localePrefix={localePrefix}
            intl={intl}
          />
        )}

        <OrganizationClubs clubs={orgClubs} intl={intl} />
      </div>
    )
  }
</PublicLayout>

<style>
  .cl-org-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cl-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    background-color: var(--cl-surface-panel);
    border-radius: 12px;
    border: 1px dashed var(--cl-border-muted);
    color: var(--cl-text-muted);
  }

  /* BREAKPOINTS.sm: retain readable padding at the 375px review width. */
  @media (max-width: 375px) {
    .cl-org-container {
      padding: 1rem 0.75rem 2rem;
    }
  }
</style>
