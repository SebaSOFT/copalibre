---
import PublicLayout from '../../layouts/PublicLayout.astro';
import TournamentCard from '../../components/TournamentCard.astro';
import EmblemImage from '../../components/EmblemImage.astro';
import {
  fetchOrganizationTournaments,
  organizationEmblemUrl,
  clubEmblemUrl,
} from '../../lib/public-api-client.ts';
import { pickFeaturedTournament } from '../../lib/organization-page.ts';
import { publicIntl } from '../../lib/i18n/public-intl.ts';
import { messages } from '../../lib/i18n/public-messages.en.ts';
import { isSupportedLanguage, type SupportedLanguage } from '@copalibre/domain';

export const prerender = false;

const { locale, organization } = Astro.params;
const resolvedLocale: SupportedLanguage = isSupportedLanguage(locale) ? locale : 'en';
const intl = publicIntl(resolvedLocale);

const listData = await fetchOrganizationTournaments(organization!);
if (!listData) {
  // Astro.rewrite('/404') targets the site's static-host fallback page
  // (src/pages/404.astro, prerendered by design so any static host can
  // serve it with no server config) — an on-demand route can't rewrite
  // into a prerendered one, so an unknown organization renders its own
  // not-found content below instead, with the response status set to
  // match.
  Astro.response.status = 404;
}

const localePrefix = resolvedLocale === 'en' ? '' : `/${resolvedLocale}`;
const canonicalPath = `${localePrefix}/${encodeURIComponent(organization!)}`;

const liveTournaments = listData?.tournaments.filter((t) => t.status === 'live') ?? [];
const upcomingTournaments = listData?.tournaments.filter((t) => t.status === 'upcoming') ?? [];
const finishedTournaments = listData?.tournaments.filter((t) => t.status === 'finished') ?? [];
const featured = listData ? pickFeaturedTournament(listData.tournaments) : undefined;

const pageTitle = listData?.organizationName ?? intl.formatMessage(messages.orgPageNotFoundTitle);
---

<PublicLayout title={pageTitle} canonicalPath={canonicalPath} intl={intl} noindex={!listData}>
  {
    !listData && (
      <div class="cl-org-container">
        <div class="cl-empty-state">
          <p>{intl.formatMessage(messages.orgPageNotFoundBody)}</p>
        </div>
      </div>
    )
  }
  {
    listData && (
      <div class="cl-org-container">
        <header class="cl-org-header">
          <EmblemImage
            alt={intl.formatMessage(messages.orgPageEmblemAlt, { name: listData.organizationName })}
            placeholderAlt={intl.formatMessage(messages.orgPageEmblemPlaceholderAlt)}
            size={64}
            src={
              listData.organizationEmblemObjectId
                ? organizationEmblemUrl(listData.organizationAlias)
                : undefined
            }
          />
          <div>
            <div class="cl-org-badge">{listData.organizationAlias}</div>
            <h1 class="cl-org-title">{listData.organizationName}</h1>
          </div>
        </header>

        {featured && (
          <section
            class="cl-listing-section cl-section-featured"
            aria-labelledby="heading-featured"
          >
            <div class="cl-section-header">
              <h2 id="heading-featured" class="cl-section-title">
                {intl.formatMessage(messages.orgPageFeaturedHeading)}
              </h2>
            </div>
            <div class="cl-tournaments-grid cl-grid-featured">
              <TournamentCard
                tournament={featured}
                organizationAlias={organization!}
                localePrefix={localePrefix}
                intl={intl}
                featured={true}
              />
            </div>
          </section>
        )}

        {listData.tournaments.length === 0 && (
          <div class="cl-empty-state">
            <p>{intl.formatMessage(messages.tournamentsEmpty)}</p>
          </div>
        )}

        {liveTournaments.length > 0 && (
          <section class="cl-listing-section cl-section-live" aria-labelledby="heading-live">
            <div class="cl-section-header">
              <span class="cl-live-dot" aria-hidden="true" />
              <h2 id="heading-live" class="cl-section-title">
                {intl.formatMessage(messages.tournamentsLiveHeading)}
              </h2>
              <span class="cl-section-count">({liveTournaments.length})</span>
            </div>
            <div class="cl-tournaments-grid cl-grid-live">
              {liveTournaments.map((t) => (
                <TournamentCard
                  tournament={t}
                  organizationAlias={organization!}
                  localePrefix={localePrefix}
                  intl={intl}
                />
              ))}
            </div>
          </section>
        )}

        {upcomingTournaments.length > 0 && (
          <section class="cl-listing-section" aria-labelledby="heading-upcoming">
            <div class="cl-section-header">
              <h2 id="heading-upcoming" class="cl-section-title">
                {intl.formatMessage(messages.tournamentsUpcomingHeading)}
              </h2>
              <span class="cl-section-count">({upcomingTournaments.length})</span>
            </div>
            <div class="cl-tournaments-grid">
              {upcomingTournaments.map((t) => (
                <TournamentCard
                  tournament={t}
                  organizationAlias={organization!}
                  localePrefix={localePrefix}
                  intl={intl}
                />
              ))}
            </div>
          </section>
        )}

        {finishedTournaments.length > 0 && (
          <section class="cl-listing-section" aria-labelledby="heading-finished">
            <div class="cl-section-header">
              <h2 id="heading-finished" class="cl-section-title">
                {intl.formatMessage(messages.tournamentsFinishedHeading)}
              </h2>
              <span class="cl-section-count">({finishedTournaments.length})</span>
            </div>
            <div class="cl-tournaments-grid">
              {finishedTournaments.map((t) => (
                <TournamentCard
                  tournament={t}
                  organizationAlias={organization!}
                  localePrefix={localePrefix}
                  intl={intl}
                />
              ))}
            </div>
          </section>
        )}

        <section class="cl-listing-section" aria-labelledby="heading-clubs">
          <div class="cl-section-header">
            <h2 id="heading-clubs" class="cl-section-title">
              {intl.formatMessage(messages.orgPageClubsHeading)}
            </h2>
            <span class="cl-section-count">({listData.clubs.length})</span>
          </div>
          {listData.clubs.length === 0 ? (
            <div class="cl-empty-state">
              <p>{intl.formatMessage(messages.orgPageNoClubs)}</p>
            </div>
          ) : (
            <div class="cl-club-grid">
              {listData.clubs.map((club) => (
                <div class="cl-club-card">
                  <EmblemImage
                    alt={intl.formatMessage(messages.orgPageEmblemAlt, { name: club.name })}
                    placeholderAlt={intl.formatMessage(messages.orgPageEmblemPlaceholderAlt)}
                    size={48}
                    src={
                      club.emblemObjectId ? clubEmblemUrl(organization!, club.clubId) : undefined
                    }
                  />
                  <div class="cl-club-info">
                    <span class="cl-club-name">{club.name}</span>
                    {club.alias && <span class="cl-club-abbr">{club.alias}</span>}
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>
    )
  }
</PublicLayout>

<style>
  .cl-org-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cl-org-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-bottom: 1px solid var(--cl-border, #334155);
    padding-bottom: 1.5rem;
  }

  .cl-org-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cl-primary, #38bdf8);
    margin-bottom: 0.25rem;
  }

  .cl-org-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
    color: var(--cl-text, #f8fafc);
  }

  .cl-listing-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cl-section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cl-section-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    color: var(--cl-text, #f8fafc);
  }

  .cl-section-count {
    font-size: 0.95rem;
    color: var(--cl-text-muted, #94a3b8);
    font-weight: 600;
  }

  .cl-live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 10px #ef4444;
    animation: cl-pulse-live 1.5s infinite;
  }

  @keyframes cl-pulse-live {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.3);
    }
  }

  .cl-tournaments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .cl-tournaments-grid {
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
  }

  .cl-grid-live,
  .cl-grid-featured {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .cl-grid-live,
    .cl-grid-featured {
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    }
  }

  .cl-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    background-color: var(--cl-surface, #1e293b);
    border-radius: 12px;
    border: 1px dashed var(--cl-border, #334155);
    color: var(--cl-text-muted, #94a3b8);
  }

  .cl-club-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .cl-club-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background-color: var(--cl-surface, #1e293b);
    border: 1px solid var(--cl-border, #334155);
    border-radius: 12px;
  }

  .cl-club-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cl-club-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cl-text, #f8fafc);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cl-club-abbr {
    font-size: 0.8rem;
    color: var(--cl-text-muted, #94a3b8);
  }
</style>
