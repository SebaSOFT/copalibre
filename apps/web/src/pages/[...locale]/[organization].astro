---
import EmptyState from '../../components/ui/molecules/EmptyState.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Container from '../../components/ui/atoms/layout/Container.astro';
import OrganizationHeader from '../../components/ui/organisms/OrganizationHeader.astro';
import TournamentSection from '../../components/ui/organisms/TournamentSection.astro';
import OrganizationClubs from '../../components/ui/organisms/OrganizationClubs.astro';
import {
  fetchOrganizationTournaments,
  organizationEmblemUrl,
  clubEmblemUrl,
  mapPublicWinnerZones,
} from '../../lib/public-api-client.ts';
import { withListingPodiumEmblems } from '../../lib/podium-emblems.ts';
import { featuredTournaments } from '../../lib/organization-page.ts';
import { publicIntl } from '../../lib/i18n/public-intl.ts';
import { messages } from '../../lib/i18n/public-messages.en.ts';
import { resolvePathLocale, getLocaleHomePath } from '../../lib/locale.ts';
import { isReservedOrganizationAlias } from '../../lib/public-route-guards.ts';
import type { SupportedLanguage } from '@copalibre/domain';
import type { PublicTournamentListingItemResponse } from '@copalibre/api/src/dto/public-tournament.dto.js';

export const prerender = false;

const { organization } = Astro.params;

if (!organization || isReservedOrganizationAlias(organization)) {
  return new Response(null, { status: 404 });
}

const rawPath = Astro.request?.url ? new URL(Astro.request.url).pathname : Astro.url.pathname;
const resolvedLocale: SupportedLanguage = resolvePathLocale(rawPath);
const intl = publicIntl(resolvedLocale);

const listData = await fetchOrganizationTournaments(organization!);
if (!listData) {
  // Astro.rewrite('/404') targets the site's static-host fallback page
  // (src/pages/404.astro, prerendered by design so any static host can
  // serve it with no server config) — an on-demand route can't rewrite
  // into a prerendered one, so an unknown organization renders its own
  // not-found content below instead, with the response status set to
  // match.
  Astro.response.status = 404;
}

const localePrefix = resolvedLocale === 'en' ? '' : `/${resolvedLocale}`;
const canonicalPath = `${localePrefix}/${encodeURIComponent(organization!)}`;

const withEmblems = (items: readonly PublicTournamentListingItemResponse[]) =>
  items.map((t) => {
    const winners = mapPublicWinnerZones(t.winners, resolvedLocale);
    return withListingPodiumEmblems(organization!, winners === undefined ? t : { ...t, winners });
  });
const featured = withEmblems(listData ? featuredTournaments(listData.tournaments) : []);
const featuredTournamentIds = new Set(featured.map((tournament) => tournament.tournamentId));
const liveTournaments = withEmblems(
  listData?.tournaments.filter((t) => t.status === 'live') ?? [],
).map((tournament) => ({
  ...tournament,
  featured: featuredTournamentIds.has(tournament.tournamentId),
}));
const upcomingTournaments = withEmblems(
  listData?.tournaments.filter(
    (t) => t.status === 'upcoming' && !featuredTournamentIds.has(t.tournamentId),
  ) ?? [],
);
const finishedTournaments = withEmblems(
  listData?.tournaments.filter(
    (t) => t.status === 'finished' && !featuredTournamentIds.has(t.tournamentId),
  ) ?? [],
);
const orgClubs = (listData?.clubs ?? []).map((club) => ({
  ...club,
  emblemSrc: club.emblemObjectId ? clubEmblemUrl(organization!, club.clubId) : undefined,
}));
const organizationEmblemSrc = listData?.organizationEmblemObjectId
  ? organizationEmblemUrl(listData.organizationAlias)
  : undefined;
// A tournament appears once. In-progress entries lead; featured entries that
// are not already there follow in the curated section.
const featuredOnly = featured.filter((tournament) => tournament.status !== 'live');

const pageTitle = listData?.organizationName ?? intl.formatMessage(messages.orgPageNotFoundTitle);
const structuredData = listData
  ? {
      '@type': 'SportsOrganization' as const,
      name: listData.organizationName,
      url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${canonicalPath}`,
      ...(listData.organizationEmblemObjectId
        ? {
            logo: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${organizationEmblemUrl(organization!)}`,
          }
        : {}),
    }
  : undefined;
---

<PublicLayout
  title={pageTitle}
  canonicalPath={canonicalPath}
  intl={intl}
  noindex={!listData}
  structuredData={structuredData}
>
  {!listData && (
    <Container class="cl-org-container" variant="public">
      <Container variant="reading">
        <EmptyState
          icon="team"
          headingLevel={1}
          heading={intl.formatMessage(messages.orgPageNotFoundTitle)}
          description={intl.formatMessage(messages.orgPageNotFoundBody)}
          actionLabel={intl.formatMessage(messages.interactionBrowseOrganizations)}
          href={getLocaleHomePath(resolvedLocale)}
          secondaryAction={{
            label: intl.formatMessage(messages.headerNavHelp),
            href: `${resolvedLocale === 'en' ? '' : `/${resolvedLocale}`}/help/`,
          }}
        />
      </Container>
    </Container>
  )}
  {listData && (
    <Container class="cl-org-container" variant="public">
      <OrganizationHeader
        organizationName={listData.organizationName}
        emblemSrc={organizationEmblemSrc}
        intl={intl}
      />

      {listData.tournaments.length === 0 && (
        <div class="cl-empty-state cl-chamfer">
          <p>{intl.formatMessage(messages.tournamentsEmpty)}</p>
        </div>
      )}

      {liveTournaments.length > 0 && (
        <TournamentSection
          headingId="heading-live"
          heading={intl.formatMessage(messages.completionInProgress)}
          tournaments={liveTournaments}
          organizationAlias={organization!}
          localePrefix={localePrefix}
          intl={intl}
          gridClass="cl-grid-priority"
        />
      )}

      {featuredOnly.length > 0 && (
        <TournamentSection
          headingId="heading-featured"
          heading={intl.formatMessage(messages.orgPageFeaturedHeading)}
          tournaments={featuredOnly}
          organizationAlias={organization!}
          localePrefix={localePrefix}
          intl={intl}
          showCount={false}
          featured={true}
          sectionClass="cl-section-featured"
          gridClass="cl-grid-featured"
        />
      )}

      {upcomingTournaments.length > 0 && (
        <TournamentSection
          headingId="heading-upcoming"
          heading={intl.formatMessage(messages.tournamentsUpcomingHeading)}
          tournaments={upcomingTournaments}
          organizationAlias={organization!}
          localePrefix={localePrefix}
          intl={intl}
        />
      )}

      {finishedTournaments.length > 0 && (
        <TournamentSection
          headingId="heading-finished"
          heading={intl.formatMessage(messages.tournamentsFinishedHeading)}
          tournaments={finishedTournaments}
          organizationAlias={organization!}
          localePrefix={localePrefix}
          intl={intl}
        />
      )}

      <OrganizationClubs clubs={orgClubs} intl={intl} />
    </Container>
  )}
</PublicLayout>

<style>
  .cl-org-container {
    padding-block: var(--cl-space-8) var(--cl-space-16);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cl-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    background-color: var(--cl-surface-panel);
    border: 1px dashed var(--cl-border-muted);
    color: var(--cl-text-muted);
  }

  /* BREAKPOINTS.sm: retain readable padding at the 375px review width. */
  @media (max-width: 375px) {
    .cl-org-container {
      padding-block: var(--cl-space-4) var(--cl-space-8);
    }
  }
</style>
