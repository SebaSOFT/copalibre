---
import '@copalibre/design-tokens/generated/copalibre.css';

interface Props {
  readonly title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      /**
       * No header, no nav, no footer, no skip link: this surface has no
       * pointer and no keyboard. Full-bleed body, safe-area padding
       * sized for a screen watched from 5-10m rather than an arm's length.
       */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--cl-surface-base);
        color: var(--cl-text-primary);
        overflow: hidden;
      }
      #tv-root {
        box-sizing: border-box;
        width: 100vw;
        height: 100vh;
        /* Title-safe margin: ~5% of the shorter viewport dimension. */
        padding: 5vmin;
      }
      .tv-overlay #tv-root {
        background: transparent;
      }
    </style>
    <style is:global>
      /**
       * Sized for a screen read from 5-10m rather than arm's length (0031
       * 2.3) — a fixed rem scale would be right for one panel size and wrong
       * for the next, so every measure here is vmin-relative instead.
       */
      .tv-dashboard {
        --tv-accent: var(--cl-focus-ring);
        display: flex;
        flex-direction: column;
        gap: 3vmin;
        height: 100%;
        font-family: var(--cl-font-body);
      }
      .tv-dashboard__logo {
        max-height: 6vmin;
        max-width: 20vmin;
        object-fit: contain;
        align-self: flex-end;
      }
      .tv-dashboard__matches {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(40vmin, 1fr));
        gap: 3vmin;
        flex: 1;
      }
      .tv-match {
        background: var(--cl-surface-panel);
        color: var(--cl-text-primary);
        border-inline-start: 1vmin solid var(--cl-border-muted);
        padding: 3vmin;
        display: flex;
        flex-direction: column;
        gap: 2vmin;
      }
      .tv-match__badge {
        display: flex;
        align-items: center;
        gap: 1vmin;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-semibold);
        text-transform: uppercase;
        font-size: clamp(var(--cl-font-size-lg), 3vmin, calc(var(--cl-font-size-lg) * 2));
        letter-spacing: 0.05em;
      }
      .tv-match__sides {
        display: flex;
        flex-direction: column;
        gap: 1.5vmin;
      }
      .tv-match__side {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 3vmin;
        min-width: 0;
      }
      .tv-match__name {
        min-width: 0;
        overflow: hidden;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-medium);
        font-size: clamp(var(--cl-font-size-xl), 5vmin, calc(var(--cl-font-size-3xl) * 2));
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .tv-match__score {
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-bold);
        font-size: clamp(var(--cl-font-size-2xl), 9vmin, calc(var(--cl-font-size-3xl) * 4));
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }

      /* BREAKPOINTS token md: keep a single scorecard column on tablet-sized panels. */
      @media (max-width: 768px) {
        .tv-dashboard__matches {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <div id="tv-root">
      <slot />
    </div>
  </body>
</html>
