---
import '@copalibre/design-tokens/generated/copalibre.css';
import '../styles/tv-broadcast.css';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../lib/discipline-background.ts';

export type TvOverlayMode = 'lower' | 'full';

interface Props {
  readonly title: string;
  /**
   * Decided on the server, never from `window`: a broadcast consumer reads the
   * first response (OBS/vMix capture the document, and a still capture may never
   * run hydration at all), so an overlay that only becomes transparent after
   * React mounts is an overlay that renders opaque exactly when it matters.
   */
  readonly overlayMode?: TvOverlayMode;
  /** Paints a solid key colour instead of alpha, for switchers that need one. */
  readonly chromaKey?: string;
  readonly disciplineImages?: readonly PublicObjectReference[];
}

const { title, overlayMode, chromaKey, disciplineImages } = Astro.props;
const rootClass = overlayMode ? `tv-overlay tv-overlay--${overlayMode}` : '';
/*
 * A venue display carries the tournament's own discipline imagery, the same
 * source and opacity the public pages use, blurred so it reads as ground rather
 * than as a picture behind the scores. A lower third never does: it is meant to
 * be keyed out, and imagery is exactly what must not survive the key.
 */
const backdrop = overlayMode === 'lower' ? undefined : selectDisciplineBackground(disciplineImages);
---

<!doctype html>
<html
  lang="en"
  class={rootClass}
  data-chroma={chromaKey ? '' : undefined}
  style={chromaKey ? `--tv-chroma: ${chromaKey};` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      /**
       * No header, no nav, no footer, no skip link: this surface has no
       * pointer and no keyboard. Full-bleed body, safe-area padding
       * sized for a screen watched from 5-10m rather than an arm's length.
       */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--cl-surface-base);
        color: var(--cl-text-primary);
        overflow: hidden;
      }
      #tv-root {
        box-sizing: border-box;
        width: 100vw;
        height: 100vh;
        /* Title-safe margin: ~5% of the shorter viewport dimension. */
        padding: 5vmin;
      }
      /*
       * Transparency has to reach the document, not just the root box: the
       * page's own html/body ground would otherwise keep the frame opaque and
       * no amount of transparency below it would show through.
       */
      .tv-overlay--lower,
      .tv-overlay--lower body,
      .tv-overlay--lower #tv-root {
        background: transparent;
      }

      /* A solid key colour for switchers that cannot take an alpha channel. */
      .tv-overlay--lower[data-chroma] body {
        background: var(--tv-chroma);
      }

      /*
       * A full-frame overlay is the whole picture for a stream with no camera
       * source, so it keeps its own ground rather than punching a hole.
       */
      .tv-overlay--full,
      .tv-overlay--full body {
        background: var(--cl-surface-base);
      }

      /*
       * A lower third occupies its own strip and leaves the rest of the frame
       * to the camera feed underneath it.
       */
      .tv-overlay--lower #tv-root {
        height: auto;
        min-height: 0;
        padding: 3vmin;
      }

      /*
       * Blurred, so it reads as ground rather than as a photograph competing
       * with the scores a room reads from ten metres away.
       */
      .tv-backdrop {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(12px);
        transform: scale(1.06); /* hides the blur's soft edge at the frame */
        pointer-events: none;
        user-select: none;
      }

      #tv-root {
        position: relative;
        z-index: 1;
      }
    </style>
    <style is:global>
      /**
       * Sized for a screen read from 5-10m rather than arm's length (0031
       * 2.3) — a fixed rem scale would be right for one panel size and wrong
       * for the next, so every measure here is vmin-relative instead.
       */
      .tv-dashboard {
        --tv-accent: var(--cl-focus-ring);
        display: flex;
        flex-direction: column;
        gap: 3vmin;
        height: 100%;
        font-family: var(--cl-font-body);
      }
      .tv-dashboard__logo {
        max-height: 6vmin;
        max-width: 20vmin;
        object-fit: contain;
        align-self: flex-end;
      }
      .tv-dashboard__matches {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(40vmin, 1fr));
        gap: 3vmin;
        flex: 1;
      }
      .tv-match {
        background: var(--cl-surface-panel);
        color: var(--cl-text-primary);
        border-inline-start: 1vmin solid var(--cl-border-muted);
        padding: 3vmin;
        display: flex;
        flex-direction: column;
        gap: 2vmin;
      }
      .tv-match__badge {
        display: flex;
        align-items: center;
        gap: 1vmin;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-semibold);
        text-transform: uppercase;
        font-size: clamp(var(--cl-font-size-lg), 3vmin, calc(var(--cl-font-size-lg) * 2));
        letter-spacing: 0.05em;
      }
      .tv-match__sides {
        display: flex;
        flex-direction: column;
        gap: 1.5vmin;
      }
      .tv-match__side {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 3vmin;
        min-width: 0;
      }
      .tv-match__name {
        min-width: 0;
        overflow: hidden;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-medium);
        font-size: clamp(var(--cl-font-size-xl), 5vmin, calc(var(--cl-font-size-3xl) * 2));
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .tv-match__score {
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-bold);
        font-size: clamp(var(--cl-font-size-2xl), 9vmin, calc(var(--cl-font-size-3xl) * 4));
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }

      /* BREAKPOINTS token md: keep a single scorecard column on tablet-sized panels. */
      @media (max-width: 768px) {
        .tv-dashboard__matches {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* Nearby Matches on Pinned Screen */
      .tv-nearby {
        margin-top: 2vmin;
        display: flex;
        flex-direction: column;
        gap: 1.5vmin;
      }

      .tv-nearby__title {
        font-family: var(--cl-font-mono);
        font-size: clamp(var(--cl-font-size-xs), 1.8vmin, var(--cl-font-size-sm));
        color: var(--cl-brand-cyan);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .tv-nearby__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(30vmin, 1fr));
        gap: 2vmin;
      }

      .tv-match--spotlight {
        border-inline-start-width: 1.5vmin;
        box-shadow: 0 8px 32px var(--cl-surface-base);
      }

      @keyframes tvPulseGlow {
        0%,
        100% {
          transform: scale(1);
          opacity: 0.15;
        }
        50% {
          transform: scale(1.15);
          opacity: 0.3;
        }
      }

      @keyframes tvPulseDot {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }
    </style>
  </head>
  <body>
    {
      backdrop && (
        <img
          class="tv-backdrop"
          src={backdrop.url}
          alt=""
          aria-hidden="true"
          decoding="async"
          style={`opacity: ${backdrop.opacity};`}
        />
      )
    }
    <div id="tv-root">
      <slot />
    </div>
  </body>
</html>
