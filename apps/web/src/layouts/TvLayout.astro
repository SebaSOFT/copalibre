---
import '@copalibre/design-tokens/generated/copalibre.css';
import '../styles/tv-broadcast.css';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../lib/discipline-background.ts';
import {
  resolveTvBackground,
  type TvBackground,
  type TvOverlayMode,
} from '../lib/tv-background.ts';

export type { TvOverlayMode } from '../lib/tv-background.ts';

interface Props {
  readonly title: string;
  /**
   * Decided on the server, never from `window`: a broadcast consumer reads the
   * first response (OBS/vMix capture the document, and a still capture may never
   * run hydration at all), so an overlay that only becomes transparent after
   * React mounts is an overlay that renders opaque exactly when it matters.
   */
  readonly overlayMode?: TvOverlayMode;
  /** Paints a solid key colour instead of alpha, for switchers that need one. */
  readonly chromaKey?: string;
  /** Explicit fallback; valid `bg`/`background` query values take precedence. */
  readonly background?: TvBackground;
  readonly disciplineImages?: readonly PublicObjectReference[];
}

const { title, overlayMode, chromaKey, background: backgroundProp, disciplineImages } = Astro.props;
const rootClass = overlayMode ? `tv-overlay tv-overlay--${overlayMode}` : '';
const { background, chromaKey: safeChromaKey } = resolveTvBackground({
  searchParams: Astro.url.searchParams,
  overlayMode,
  background: backgroundProp,
  chromaKey,
});
const disciplineBackdrop =
  background === 'discipline' ? selectDisciplineBackground(disciplineImages) : undefined;
---

<!doctype html>
<html
  lang="en"
  class={rootClass}
  data-tv-background={background}
  data-chroma={background === 'chroma' ? '' : undefined}
  style={background === 'chroma' ? `--tv-chroma: ${safeChromaKey};` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      /**
       * No header, no nav, no footer, no skip link: this surface has no
       * pointer and no keyboard. Full-bleed body, safe-area padding
       * sized for a screen watched from 5-10m rather than an arm's length.
       */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--cl-surface-base);
        color: var(--cl-text-primary);
        overflow: hidden;
      }
      html[data-tv-background='neutral'] body,
      html[data-tv-background='discipline'] body {
        background: var(--cl-surface-base);
      }
      html[data-tv-background='chroma'] body {
        background: var(--tv-chroma, #00b140);
      }
      html[data-tv-background='football'] body,
      html[data-tv-background='court'] body {
        background: var(--cl-surface-base);
      }
      html[data-tv-background='transparent'],
      html[data-tv-background='transparent'] body {
        background: transparent;
      }
      html[data-tv-background] #tv-root .tv-root-container {
        background-color: transparent;
      }
      #tv-root {
        box-sizing: border-box;
        width: 100vw;
        height: 100vh;
        /* Title-safe margin: ~5% of the shorter viewport dimension. */
        padding: 5vmin;
      }
      /*
       * Transparency has to reach the document, not just the root box: the
       * page's own html/body ground would otherwise keep the frame opaque and
       * no amount of transparency below it would show through.
       */
      .tv-overlay--lower,
      .tv-overlay--lower body,
      .tv-overlay--lower #tv-root {
        background: transparent;
      }

      /*
       * A full-frame overlay is the whole picture for a stream with no camera
       * source, so it keeps its own ground rather than punching a hole.
       */
      .tv-overlay--full,
      .tv-overlay--full body {
        background: var(--cl-surface-base);
      }

      /*
       * A lower third occupies its own strip and leaves the rest of the frame
       * to the camera feed underneath it.
       */
      .tv-overlay--lower #tv-root {
        height: auto;
        min-height: 0;
        padding: 3vmin;
      }

      /*
       * Blurred, so it reads as ground rather than as a photograph competing
       * with the scores a room reads from ten metres away.
       */
      .tv-backdrop {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(12px);
        transform: scale(1.06); /* hides the blur's soft edge at the frame */
        pointer-events: none;
        user-select: none;
      }

      .tv-backdrop--football {
        background-color: var(--cl-state-positive);
        background-image:
          linear-gradient(
            90deg,
            transparent calc(50% - 1px),
            color-mix(in srgb, var(--cl-text-primary) 45%, transparent) 50%,
            transparent calc(50% + 1px)
          ),
          radial-gradient(
            ellipse at center,
            transparent 0 24%,
            color-mix(in srgb, var(--cl-text-primary) 42%, transparent) 24.2% 24.5%,
            transparent 24.7%
          ),
          repeating-linear-gradient(
            90deg,
            transparent 0 12.4%,
            color-mix(in srgb, var(--cl-text-primary) 8%, transparent) 12.5% 12.6%,
            transparent 12.7% 25%
          );
      }

      .tv-backdrop--court {
        background-color: var(--cl-state-upcoming);
        background-image:
          linear-gradient(
            90deg,
            color-mix(in srgb, var(--cl-text-primary) 50%, transparent) 1px,
            transparent 1px
          ),
          radial-gradient(
            ellipse at center,
            transparent 0 20%,
            color-mix(in srgb, var(--cl-text-primary) 50%, transparent) 20.2% 20.5%,
            transparent 20.7%
          ),
          linear-gradient(
            90deg,
            transparent calc(50% - 1px),
            color-mix(in srgb, var(--cl-text-primary) 50%, transparent) 50%,
            transparent calc(50% + 1px)
          );
        background-size:
          12.5% 100%,
          100% 100%,
          100% 100%;
      }

      #tv-root {
        position: relative;
        z-index: 1;
      }
    </style>
  </head>
</html>
<body>
  {
    disciplineBackdrop && (
      <img
        class="tv-backdrop"
        src={disciplineBackdrop.url}
        alt=""
        aria-hidden="true"
        decoding="async"
        style={`opacity: ${disciplineBackdrop.opacity};`}
      />
    )
  }
  {
    background === 'football' && (
      <div aria-hidden="true" class="tv-backdrop tv-backdrop--football" />
    )
  }
  {background === 'court' && <div aria-hidden="true" class="tv-backdrop tv-backdrop--court" />}
  <div id="tv-root">
    <slot />
  </div>
</body>
