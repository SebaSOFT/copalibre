---
import '@copalibre/design-tokens/generated/copalibre.css';

interface Props {
  readonly title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      /**
       * No header, no nav, no footer, no skip link: this surface has no
       * pointer and no keyboard. Full-bleed body, safe-area padding
       * sized for a screen watched from 5-10m rather than an arm's length.
       */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--cl-surface-base);
        color: var(--cl-text-primary);
        overflow: hidden;
      }
      #tv-root {
        box-sizing: border-box;
        width: 100vw;
        height: 100vh;
        /* Title-safe margin: ~5% of the shorter viewport dimension. */
        padding: 5vmin;
      }
      .tv-overlay #tv-root {
        background: transparent;
      }
    </style>
    <style is:global>
      /**
       * Sized for a screen read from 5-10m rather than arm's length (0031
       * 2.3) — a fixed rem scale would be right for one panel size and wrong
       * for the next, so every measure here is vmin-relative instead.
       */
      .tv-dashboard {
        --tv-accent: var(--cl-focus-ring);
        display: flex;
        flex-direction: column;
        gap: 3vmin;
        height: 100%;
        font-family: var(--cl-font-body);
      }
      .tv-dashboard__logo {
        max-height: 6vmin;
        max-width: 20vmin;
        object-fit: contain;
        align-self: flex-end;
      }
      .tv-dashboard__matches {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(40vmin, 1fr));
        gap: 3vmin;
        flex: 1;
      }
      .tv-match {
        background: var(--cl-surface-panel);
        color: var(--cl-text-primary);
        border-inline-start: 1vmin solid var(--cl-border-muted);
        padding: 3vmin;
        display: flex;
        flex-direction: column;
        gap: 2vmin;
      }
      .tv-match__badge {
        display: flex;
        align-items: center;
        gap: 1vmin;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-semibold);
        text-transform: uppercase;
        font-size: clamp(var(--cl-font-size-lg), 3vmin, calc(var(--cl-font-size-lg) * 2));
        letter-spacing: 0.05em;
      }
      .tv-match__sides {
        display: flex;
        flex-direction: column;
        gap: 1.5vmin;
      }
      .tv-match__side {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 3vmin;
        min-width: 0;
      }
      .tv-match__name {
        min-width: 0;
        overflow: hidden;
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-medium);
        font-size: clamp(var(--cl-font-size-xl), 5vmin, calc(var(--cl-font-size-3xl) * 2));
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .tv-match__score {
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-bold);
        font-size: clamp(var(--cl-font-size-2xl), 9vmin, calc(var(--cl-font-size-3xl) * 4));
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }

      /* BREAKPOINTS token md: keep a single scorecard column on tablet-sized panels. */
      @media (max-width: 768px) {
        .tv-dashboard__matches {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* Animated Fallback & Standby Kiosk */
      .tv-standby {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .tv-standby__glow {
        position: absolute;
        width: 60vmin;
        height: 60vmin;
        border-radius: 50%;
        background: radial-gradient(circle, var(--cl-brand-cyan) 0%, transparent 70%);
        filter: blur(40px);
        opacity: 0.15;
        animation: tvPulseGlow 4s ease-in-out infinite;
        pointer-events: none;
      }

      .tv-standby__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3vmin;
        max-width: 80vw;
      }

      .tv-standby__badge {
        display: inline-flex;
        align-items: center;
        gap: 1vmin;
        padding: 0.8vmin 2vmin;
        border-radius: 9999px;
        background: var(--cl-surface-panel);
        border: 1px solid var(--cl-border-subtle);
        font-family: var(--cl-font-mono);
        font-size: clamp(var(--cl-font-size-sm), 2vmin, var(--cl-font-size-lg));
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cl-brand-cyan);
      }

      .tv-standby__dot {
        width: 1.2vmin;
        height: 1.2vmin;
        border-radius: 50%;
        background: var(--cl-brand-cyan);
        animation: tvPulseDot 1.5s ease-in-out infinite;
      }

      .tv-standby__brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5vmin;
      }

      .tv-standby__copalibre-emblem img,
      .tv-standby__org-logo {
        max-height: 16vmin;
        max-width: 30vmin;
        object-fit: contain;
        filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.3));
        animation: tvPulseGlow 6s ease-in-out infinite;
      }

      .tv-standby__tournament {
        margin: 0;
        font-family: var(--cl-font-display);
        font-size: clamp(var(--cl-font-size-2xl), 6vmin, calc(var(--cl-font-size-3xl) * 2));
        font-weight: var(--cl-weight-bold);
        letter-spacing: -0.02em;
        color: var(--cl-text-primary);
      }

      .tv-standby__organization {
        margin: 0;
        font-family: var(--cl-font-body);
        font-size: clamp(var(--cl-font-size-md), 3vmin, var(--cl-font-size-xl));
        color: var(--cl-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .tv-standby__carousel-wrap {
        margin-top: 2vmin;
        width: 100vw;
        max-width: 90vw;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5vmin;
      }

      .tv-standby__carousel-title {
        margin: 0;
        font-family: var(--cl-font-mono);
        font-size: clamp(var(--cl-font-size-xs), 1.6vmin, var(--cl-font-size-sm));
        color: var(--cl-text-muted);
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .tv-standby__carousel {
        width: 100%;
        overflow: hidden;
        mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
      }

      .tv-standby__track {
        display: flex;
        gap: 3vmin;
        width: max-content;
        animation: tvMarquee 25s linear infinite;
      }

      .tv-standby__club-pill {
        display: inline-flex;
        align-items: center;
        gap: 1.2vmin;
        padding: 1vmin 2.5vmin;
        background: var(--cl-surface-panel);
        border: 1px solid var(--cl-border-subtle);
        border-radius: 9999px;
        white-space: nowrap;
      }

      .tv-standby__club-img {
        width: 3.5vmin;
        height: 3.5vmin;
        object-fit: contain;
      }

      .tv-standby__club-avatar {
        width: 3.5vmin;
        height: 3.5vmin;
        border-radius: 50%;
        background: var(--cl-surface-subtle);
        color: var(--cl-brand-cyan);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--cl-font-mono);
        font-weight: 700;
        font-size: 1.6vmin;
      }

      .tv-standby__club-name {
        font-family: var(--cl-font-display);
        font-weight: var(--cl-weight-semibold);
        font-size: clamp(var(--cl-font-size-sm), 2.2vmin, var(--cl-font-size-md));
        color: var(--cl-text-primary);
      }

      /* Nearby Matches on Pinned Screen */
      .tv-nearby {
        margin-top: 2vmin;
        display: flex;
        flex-direction: column;
        gap: 1.5vmin;
      }

      .tv-nearby__title {
        font-family: var(--cl-font-mono);
        font-size: clamp(var(--cl-font-size-xs), 1.8vmin, var(--cl-font-size-sm));
        color: var(--cl-brand-cyan);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .tv-nearby__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(30vmin, 1fr));
        gap: 2vmin;
      }

      .tv-match--spotlight {
        border-inline-start-width: 1.5vmin;
        box-shadow: 0 8px 32px var(--cl-surface-base);
      }

      @keyframes tvPulseGlow {
        0%, 100% {
          transform: scale(1);
          opacity: 0.15;
        }
        50% {
          transform: scale(1.15);
          opacity: 0.3;
        }
      }

      @keyframes tvMarquee {
        0% {
          transform: translateX(0%);
        }
        100% {
          transform: translateX(-50%);
        }
      }

      @keyframes tvPulseDot {
        0%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }
    </style>
  </head>
  <body>
    <div id="tv-root">
      <slot />
    </div>
  </body>
</html>
