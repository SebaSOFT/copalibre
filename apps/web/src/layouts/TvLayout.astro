---
import '@copalibre/design-tokens/generated/copalibre.css';
import '../styles/tv-broadcast.css';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../lib/discipline-background.ts';

export type TvOverlayMode = 'lower' | 'full';

interface Props {
  readonly title: string;
  /**
   * Decided on the server, never from `window`: a broadcast consumer reads the
   * first response (OBS/vMix capture the document, and a still capture may never
   * run hydration at all), so an overlay that only becomes transparent after
   * React mounts is an overlay that renders opaque exactly when it matters.
   */
  readonly overlayMode?: TvOverlayMode;
  /** Paints a solid key colour instead of alpha, for switchers that need one. */
  readonly chromaKey?: string;
  readonly disciplineImages?: readonly PublicObjectReference[];
}

const { title, overlayMode, chromaKey, disciplineImages } = Astro.props;
const rootClass = overlayMode ? `tv-overlay tv-overlay--${overlayMode}` : '';
/*
 * A venue display carries the tournament's own discipline imagery, the same
 * source and opacity the public pages use, blurred so it reads as ground rather
 * than as a picture behind the scores. A lower third never does: it is meant to
 * be keyed out, and imagery is exactly what must not survive the key.
 */
const backdrop = overlayMode === 'lower' ? undefined : selectDisciplineBackground(disciplineImages);
---

<!doctype html>
<html
  lang="en"
  class={rootClass}
  data-chroma={chromaKey ? '' : undefined}
  style={chromaKey ? `--tv-chroma: ${chromaKey};` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      /**
       * No header, no nav, no footer, no skip link: this surface has no
       * pointer and no keyboard. Full-bleed body, safe-area padding
       * sized for a screen watched from 5-10m rather than an arm's length.
       */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--cl-surface-base);
        color: var(--cl-text-primary);
        overflow: hidden;
      }
      #tv-root {
        box-sizing: border-box;
        width: 100vw;
        height: 100vh;
        /* Title-safe margin: ~5% of the shorter viewport dimension. */
        padding: 5vmin;
      }
      /*
       * Transparency has to reach the document, not just the root box: the
       * page's own html/body ground would otherwise keep the frame opaque and
       * no amount of transparency below it would show through.
       */
      .tv-overlay--lower,
      .tv-overlay--lower body,
      .tv-overlay--lower #tv-root {
        background: transparent;
      }

      /* A solid key colour for switchers that cannot take an alpha channel. */
      .tv-overlay--lower[data-chroma] body {
        background: var(--tv-chroma);
      }

      /*
       * A full-frame overlay is the whole picture for a stream with no camera
       * source, so it keeps its own ground rather than punching a hole.
       */
      .tv-overlay--full,
      .tv-overlay--full body {
        background: var(--cl-surface-base);
      }

      /*
       * A lower third occupies its own strip and leaves the rest of the frame
       * to the camera feed underneath it.
       */
      .tv-overlay--lower #tv-root {
        height: auto;
        min-height: 0;
        padding: 3vmin;
      }

      /*
       * Blurred, so it reads as ground rather than as a photograph competing
       * with the scores a room reads from ten metres away.
       */
      .tv-backdrop {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(12px);
        transform: scale(1.06); /* hides the blur's soft edge at the frame */
        pointer-events: none;
        user-select: none;
      }

      #tv-root {
        position: relative;
        z-index: 1;
      }
    </style>
  </head>
</html>
<body>
  {
    backdrop && (
      <img
        class="tv-backdrop"
        src={backdrop.url}
        alt=""
        aria-hidden="true"
        decoding="async"
        style={`opacity: ${backdrop.opacity};`}
      />
    )
  }
  <div id="tv-root">
    <slot />
  </div>
</body>
