---
import type { IntlShape } from 'react-intl';
import '@copalibre/design-tokens/generated/copalibre.css';
import { messages } from '../lib/i18n/public-messages.en.ts';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../lib/discipline-background.ts';

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly canonicalPath: string;
  /** Set on anything that is not a public canonical route. */
  readonly noindex?: boolean;
  readonly intl: IntlShape;
  readonly disciplineImages?: readonly PublicObjectReference[];
}

const { title, description, canonicalPath, noindex = false, intl, disciplineImages } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const background = selectDisciplineBackground(disciplineImages);
---

<!doctype html>
<html lang={intl.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={`${site}${canonicalPath}`} />
    {/* Defence in depth: a non-public route that somehow renders says so itself. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {
      background && (
        <img
          class="cl-discipline-background"
          src={background.url}
          alt=""
          aria-hidden="true"
          decoding="async"
          style={`opacity: ${background.opacity};`}
        />
      )
    }
    <a class="cl-focusable" href="#main">{intl.formatMessage(messages.layoutSkipToContent)}</a>
    <header>
      <nav aria-label={intl.formatMessage(messages.layoutNavAriaLabel)}>
        <a href="/" class="cl-brand">
          <img src="/copalibre-logo.svg" alt="" width="28" height="28" />
          CopaLibre
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>{intl.formatMessage(messages.layoutFooter)}</p>
    </footer>
  </body>
</html>

<style>
  .cl-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cl-discipline-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }

  body > :not(.cl-discipline-background) {
    position: relative;
    z-index: 1;
  }
</style>
