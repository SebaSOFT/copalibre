---
import type { IntlShape } from 'react-intl';
import '@copalibre/design-tokens/generated/copalibre.css';
import { messages } from '../lib/i18n/public-messages.en.ts';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../lib/discipline-background.ts';
import { buildHreflangAlternates, serializeJsonLd, type JsonLdStructuredData } from '../lib/seo.ts';
import type { SupportedLanguage } from '@copalibre/domain';

import { getLocaleHomePath } from '../lib/locale.ts';

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly canonicalPath: string;
  /** Set on anything that is not a public canonical route. */
  readonly noindex?: boolean;
  readonly intl: IntlShape;
  readonly disciplineImages?: readonly PublicObjectReference[];
  readonly ogType?: string;
  readonly ogImage?: string;
  readonly structuredData?: JsonLdStructuredData;
  readonly localeVariants?: readonly SupportedLanguage[] | readonly string[];
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  intl,
  disciplineImages,
  ogType = 'website',
  ogImage,
  structuredData,
  localeVariants,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const background = selectDisciplineBackground(disciplineImages);
const resolvedOgImage =
  ogImage ??
  (background?.url
    ? background.url.startsWith('http')
      ? background.url
      : `${site}${background.url}`
    : undefined);
const alternates = buildHreflangAlternates(site, canonicalPath, intl.locale, localeVariants);
const canonicalUrl = `${site}${canonicalPath}`;
const homeUrl = getLocaleHomePath(intl.locale);
---

<!doctype html>
<html lang={intl.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/copalibre-logo.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
      )
    }
    {/* Defence in depth: a non-public route that somehow renders says so itself. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {
      background && (
        <img
          class="cl-discipline-background"
          src={background.url}
          alt=""
          aria-hidden="true"
          decoding="async"
          style={`opacity: ${background.opacity};`}
        />
      )
    }
    <a class="cl-skip-link cl-focusable" href="#main"
      >{intl.formatMessage(messages.layoutSkipToContent)}</a
    >
    <header>
      <nav aria-label={intl.formatMessage(messages.layoutNavAriaLabel)}>
        <a href={homeUrl} class="cl-brand">
          <img src="/copalibre-logo.svg" alt="" width="28" height="28" />
          CopaLibre
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>{intl.formatMessage(messages.layoutFooter)}</p>
    </footer>
  </body>
</html>

<style>
  .cl-skip-link {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 9999;
    padding: var(--cl-space-2) var(--cl-space-4);
    background: var(--cl-surface-panel);
    color: var(--cl-text-primary);
    border: 1px solid var(--cl-border-subtle);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
  }

  .cl-skip-link:focus {
    top: var(--cl-space-2);
    left: var(--cl-space-2);
  }
  :global(html),
  :global(body) {
    min-width: 0;
    max-width: 100%;
    background: var(--cl-surface-base);
    color: var(--cl-text-primary);
    font-family: var(--cl-font-body);
  }

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(main),
  :global(main > *) {
    min-width: 0;
    max-width: 100%;
  }

  :global(main table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-gutter: stable;
    border-bottom: 2px solid var(--cl-border-muted);
  }

  :global(a) {
    color: var(--cl-state-live);
  }

  :global(.cl-inline-alert p) {
    margin: 0;
  }

  .cl-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cl-discipline-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }

  body > :not(.cl-discipline-background) {
    position: relative;
    z-index: 1;
  }

  /* BREAKPOINTS.sm: long public content must wrap inside the phone viewport. */
  @media (max-width: 375px) {
    :global(main) {
      overflow-wrap: anywhere;
    }
  }
</style>
