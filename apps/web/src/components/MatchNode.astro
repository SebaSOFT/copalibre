---
import type { IntlShape } from 'react-intl';
import { EntrantName } from './EntrantName.tsx';
import StateBadge from './StateBadge.astro';
import { matchReportUrl, toNode, type BracketMatch } from '../lib/bracket.ts';
import { resultReasonLabels, resultStateLabels } from '../lib/i18n/public-intl.ts';

interface Props {
  readonly match: BracketMatch;
  readonly intl: IntlShape;
  readonly organizationAlias: string;
  readonly tournamentAlias: string;
  readonly stageNumber: number;
  readonly localePrefix?: string;
}
const { intl, organizationAlias, tournamentAlias, stageNumber, localePrefix = '' } = Astro.props;
const node = toNode(Astro.props.match, resultStateLabels(intl));
const reasonLabels = resultReasonLabels(intl);
// Every card links, resolved or not — 0102's report page already
// renders correctly for a not-yet-played match, so a winner-of/loser-of
// placeholder still points somewhere real, not a dead end.
const reportUrl = matchReportUrl({
  organizationAlias,
  tournamentAlias,
  stageNumber,
  matchNumber: node.matchNumber,
  localePrefix,
});
---

<a href={reportUrl}>
  <article class="cl-card cl-chamfer" data-match={node.matchNumber}>
    <StateBadge state={node.state} intl={intl} />
    <ol>
      {
        node.slots.map((slot) => (
          <li class={slot.pending ? 'cl-slot--pending' : 'cl-slot'}>
            {/* Named, never blank: a blank cell reads as a bug, "Ganador del 3"
                tells a spectator what has to happen first. */}
            {slot.fullName === undefined ? (
              <span>{slot.label}</span>
            ) : (
              <EntrantName abbreviation={slot.abbreviation} client:load fullName={slot.fullName} />
            )}
            {slot.resultReason && (
              // A walkover 0-10 must not read like an actual 10-goal win — the
              // reason a result looks the way it does is shown, not just the
              // number.
              <span class="cl-badge">{reasonLabels[slot.resultReason]}</span>
            )}
            <span class="cl-stat-tile__value">{slot.score ?? '—'}</span>
          </li>
        ))
      }
    </ol>
  </article>
</a>
