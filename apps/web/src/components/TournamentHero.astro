---
import type { IntlShape } from 'react-intl';
import { displayName, type OverviewModel } from '../lib/overview.ts';
import { messages } from '../lib/i18n/public-messages.en.ts';

interface Props {
  readonly model: OverviewModel;
  readonly intl: IntlShape;
}
const { model, intl } = Astro.props;
---

<section class="cl-card cl-card--live cl-chamfer">
  <p>{model.organizationName}</p>
  <h1>{displayName(model)}</h1>
  {/* The count is the label: "live" as a colour alone is not a state. */}
  <p class="cl-badge">
    {
      model.liveCount > 0
        ? intl.formatMessage(messages.heroLiveCount, { count: model.liveCount })
        : intl.formatMessage(messages.heroNoLiveMatches)
    }
  </p>
</section>
