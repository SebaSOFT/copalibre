---
import { shortLabel, type OverviewModel } from '../lib/overview.ts';

interface Props {
  readonly model: OverviewModel;
}
const { model } = Astro.props;
---

<section aria-labelledby="standings-heading">
  <h2 id="standings-heading">Posiciones</h2>
  {
    model.standings.length === 0 && (
      <p>Las posiciones aparecen cuando se juega el primer partido.</p>
    )
  }
  <table>
    <thead>
      <tr
        ><th scope="col">#</th><th scope="col">Equipo</th><th scope="col">PJ</th><th scope="col"
          >Pts</th
        ></tr
      >
    </thead>
    <tbody>
      {
        model.standings.map((row) => (
          <tr>
            <td>{row.position}</td>
            <td>{shortLabel(row)}</td>
            <td class="cl-stat-tile__value">{row.played}</td>
            <td class="cl-stat-tile__value">{row.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
