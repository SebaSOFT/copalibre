---
import type { OverviewModel } from '../lib/overview.ts';

interface Props {
  readonly model: OverviewModel;
}
const { model } = Astro.props;
---

<section aria-labelledby="ruleset-heading">
  <h2 id="ruleset-heading">Reglamento</h2>
  <dl>
    {
      model.ruleset.map((entry) => (
        <>
          <>
            <dt>{entry.label}</dt>
            <dd>{entry.value}</dd>
          </>
        </>
      ))
    }
  </dl>
</section>
