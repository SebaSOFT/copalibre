---
import Icon from './Icon.astro';

/**
 * A person's profile picture, or a placeholder silhouette when none has
 * been uploaded — the person-photo sibling of `EmblemImage.astro`.
 * Framed the same way (`.cl-image-frame`, `object-fit: cover`), with a
 * distinct placeholder icon since a person isn't an emblem.
 */
interface Props {
  readonly src?: string;
  readonly alt: string;
  readonly placeholderAlt: string;
  readonly size?: number;
}

const { src, alt, placeholderAlt, size = 96 } = Astro.props;
---

<div class="cl-image-frame cl-person-photo-frame" style={`width: ${size}px`}>
  {src && (
    <img
      src={src}
      alt={alt}
      onerror="this.style.display = 'none'; this.nextElementSibling.style.display = '';"
    />
  )}
  <span
    aria-label={placeholderAlt}
    class="cl-person-photo-placeholder"
    role="img"
    style={src ? 'display: none' : undefined}
  >
    <Icon name="user" size={24} />
  </span>
</div>

<style>
  .cl-person-photo-frame {
    box-sizing: border-box;
    flex-shrink: 0;
    max-height: none;
  }

  .cl-person-photo-frame img {
    box-sizing: border-box;
    object-fit: contain;
    padding: var(--cl-space-2);
  }

  .cl-person-photo-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cl-text-muted);
  }
</style>
