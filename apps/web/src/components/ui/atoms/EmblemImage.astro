---
import Icon from './Icon.astro';
import { emblemMonogramFit } from '../../../lib/entrant-emblem.ts';

/**
 * An organization's or club's emblem, the stored abbreviation tile, or a
 * placeholder shield when no abbreviation is available. A failed image swaps
 * to the same fallback without waiting for page hydration.
 *
 * `bare` drops the frame (background, border, chamfer and inset) and leaves only the 1:1 image:
 * the mode for an emblem that sits inline with a club's name, where a framed badge reads as a
 * second control beside the text.
 */
interface Props {
  readonly src?: string;
  readonly alt: string;
  readonly placeholderAlt: string;
  readonly abbreviation?: string;
  readonly size?: number;
  readonly bare?: boolean;
  readonly decorative?: boolean;
}

const {
  src,
  alt,
  placeholderAlt,
  abbreviation,
  size = 48,
  bare = false,
  decorative = false,
} = Astro.props;
const fit = emblemMonogramFit(abbreviation);
const abbreviationLength = Array.from(abbreviation ?? '').length;
const hiddenFromAssistiveTechnology = bare || decorative;
---

<div
  class:list={[
    'cl-image-frame',
    'cl-entrant-emblem',
    'cl-emblem-frame',
    size <= 32 && 'cl-entrant-emblem--small',
    size <= 24 && 'cl-entrant-emblem--micro',
    bare && 'cl-emblem-frame--bare',
  ]}
  aria-hidden={hiddenFromAssistiveTechnology ? 'true' : undefined}
  style={`width: ${size}px`}
>
  {src && (
    <img
      src={src}
      alt={hiddenFromAssistiveTechnology ? '' : alt}
      onerror="this.style.display = 'none'; this.nextElementSibling.style.display = '';"
    />
  )}
  <span
    aria-label={hiddenFromAssistiveTechnology ? undefined : alt || placeholderAlt}
    class="cl-emblem-placeholder cl-entrant-emblem__fallback"
    role={hiddenFromAssistiveTechnology ? undefined : 'img'}
    style={src ? 'display: none' : undefined}
  >
    {fit && abbreviation !== undefined ? (
      <span
        class:list={[
          'cl-entrant-emblem__monogram',
          fit === 'reduced' && 'cl-entrant-emblem__monogram--reduced',
          fit === 'figure' &&
            abbreviationLength === 4 &&
            size <= 32 &&
            'cl-entrant-emblem__monogram--small-tight',
        ]}
      >
        {abbreviation}
      </span>
    ) : (
      <Icon name="club" size={24} />
    )}
  </span>
</div>

<style>
  .cl-emblem-frame {
    box-sizing: border-box;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    max-height: none;
  }

  .cl-emblem-frame img {
    box-sizing: border-box;
    object-fit: contain;
    padding: var(--cl-space-2);
  }

  .cl-emblem-frame--bare {
    border: 0;
    background: none;
    border-radius: 0;
    corner-shape: round;
    overflow: visible;
  }

  .cl-emblem-frame--bare img {
    padding: 0;
  }

  .cl-emblem-frame--bare .cl-emblem-placeholder {
    width: 100%;
    height: 100%;
  }

  .cl-emblem-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--cl-text-on-emblem-frame);
  }

  .cl-emblem-frame--bare .cl-emblem-placeholder {
    color: var(--cl-text-primary);
  }
</style>
