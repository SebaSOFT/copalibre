---
/**
 * An organization's or club's emblem, or a placeholder shield outline when
 * none has been uploaded (the rule: never a broken image or an empty
 * gap) — the public-web sibling of control-web's `ClubEmblemPlaceholder`.
 *
 * `bare` drops the frame (background, border, chamfer and inset) and leaves only the 1:1 image:
 * the mode for an emblem that sits inline with a club's name, where a framed badge reads as a
 * second control beside the text.
 */
interface Props {
  readonly src?: string;
  readonly alt: string;
  readonly placeholderAlt: string;
  readonly size?: number;
  readonly bare?: boolean;
}

const { src, alt, placeholderAlt, size = 48, bare = false } = Astro.props;
---

<div
  class:list={['cl-image-frame', 'cl-emblem-frame', bare && 'cl-emblem-frame--bare']}
  style={`width: ${size}px`}
>
  {
    src && (
      <img
        src={src}
        alt={alt}
        onerror="this.style.display = 'none'; this.nextElementSibling.style.display = '';"
      />
    )
  }
  <svg
    class="cl-emblem-placeholder"
    role="img"
    viewBox="0 0 48 48"
    xmlns="http://www.w3.org/2000/svg"
    style={src ? 'display: none' : undefined}
  >
    <title>{placeholderAlt}</title>
    <path
      d="M8 6h32l-4 4v14c0 12-8 18-12 20-4-2-12-8-12-20V10z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"></path>
  </svg>
</div>

<style>
  .cl-emblem-frame {
    box-sizing: border-box;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    max-height: none;
  }

  .cl-emblem-frame img {
    box-sizing: border-box;
    object-fit: contain;
    padding: var(--cl-space-2);
  }

  .cl-emblem-frame--bare {
    border: 0;
    background: none;
    border-radius: 0;
    corner-shape: round;
    overflow: visible;
  }

  .cl-emblem-frame--bare img {
    padding: 0;
  }

  .cl-emblem-frame--bare svg {
    width: 100%;
    height: 100%;
  }

  .cl-emblem-placeholder {
    color: var(--cl-text-muted);
  }
</style>
