---
import type { IntlShape } from 'react-intl';
import { presentState, type ResultState } from '../../../lib/result-state.ts';
import { resultStateLabels } from '../../../lib/i18n/public-intl.ts';

interface Props {
  readonly state: ResultState;
  readonly intl: IntlShape;
}
const { state, intl } = Astro.props;
const presentation = presentState(state, resultStateLabels(intl));
---

{/* Colour, motion cue and word together — a template cannot ask for just the colour. */}
<span class={`cl-badge ${presentation.className}`}>
  {presentation.state === 'live' ? (
    <span aria-hidden="true" class="cl-badge__dot cl-live-dot" />
  ) : (
    <span aria-hidden="true">{presentation.icon}</span>
  )}
  <span>{presentation.label}</span>
</span>
