---
import { resultLegend } from '../../../lib/result-state.ts';
import type { ResultStateLabels } from '../../../lib/result-state.ts';

interface Props {
  readonly labels: ResultStateLabels;
  readonly heading: string;
}
const { labels, heading } = Astro.props;
const legend = resultLegend(labels);
---

{/* Shown once per page: the colours mean nothing on their own. */}
<section aria-labelledby="legend-heading">
  <h2 id="legend-heading">{heading}</h2>
  <ul>
    {
      legend.map((state) => (
        <li class={`cl-badge ${state.className}`}>
          <span aria-hidden="true">{state.icon}</span>
          <span>{state.label}</span>
        </li>
      ))
    }
  </ul>
</section>
