---
import type { SegmentState } from '../../../lib/series.ts';
import type { IconName } from '../../../lib/icon-registry.ts';
import Icon from '../atoms/Icon.astro';

export interface SeriesStateBarSegment {
  readonly state: SegmentState;
  readonly mark: IconName;
  readonly label: string;
  readonly href?: string;
  readonly linkLabel?: string;
}

interface Props {
  readonly homeScore: number;
  readonly awayScore: number;
  readonly segmentsAriaLabel: string;
  readonly segments: readonly SeriesStateBarSegment[];
  /** Which side the series settled on; absent while it is still undecided — picks the outcome's class only, the text itself already resolved. */
  readonly winner?: 'home' | 'away';
  readonly outcomeText: string;
  /** Present on an `aggregate` tie: the pre-resolved summed-score sentence. */
  readonly aggregateText?: string;
}
const { homeScore, awayScore, segmentsAriaLabel, segments, winner, outcomeText, aggregateText } =
  Astro.props;
---

<div class="cl-series">
  <ol class="cl-series__segments" aria-label={segmentsAriaLabel}>
    {segments.map((segment) => (
      <li
        aria-label={segment.label}
        class={`cl-series__segment cl-series__segment--${segment.state} cl-chamfer`}
        data-state={segment.state}
        title={segment.label}
      >
        {/* The mark carries the state where the words will not fit, so nothing here
              depends on a colour; the label carries the same fact in words. */}
        {segment.href !== undefined && segment.linkLabel !== undefined ? (
          <a
            aria-label={segment.linkLabel}
            class="cl-series__segment-link cl-focusable"
            href={segment.href}
          >
            <Icon name={segment.mark} size={16} />
          </a>
        ) : (
          <Icon name={segment.mark} size={16} />
        )}
      </li>
    ))}
  </ol>

  <p class="cl-series__score">
    {homeScore} — {awayScore}
  </p>

  {/*
      A cross standing at two games to one is not a cross nobody has started, and a bracket
      that showed neither a winner nor a reason would read as missing data. The score is what
      makes "pending" legible rather than alarming.
    */}
  {winner === undefined ? (
    <p class="cl-series__pending">{outcomeText}</p>
  ) : (
    <p class="cl-series__decided">{outcomeText}</p>
  )}

  {/*
      A two-legged tie has no notion of games won, so the aggregate is the whole answer and is
      shown alongside the individual legs rather than instead of them.
    */}
  {aggregateText !== undefined && <p class="cl-series__aggregate">{aggregateText}</p>}
</div>

<style>
  /* One compact row: a mark per game, the games won, then the series state in words. A bracket node has a
     fixed height, so the bar never grows into a list. Each mark carries its state as a shape, so colour
     only reinforces it. */
  .cl-series {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cl-space-1) var(--cl-space-2);
  }

  .cl-series__segments {
    display: flex;
    gap: var(--cl-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cl-series__segment {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cl-text-secondary);
  }

  .cl-series__segment--current {
    color: var(--cl-state-live);
  }

  .cl-series__segment--upcoming,
  .cl-series__segment--not-required {
    color: var(--cl-text-muted);
  }

  .cl-series__score {
    margin: 0;
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-sm);
  }

  .cl-series__pending,
  .cl-series__decided,
  .cl-series__aggregate {
    flex-basis: 100%;
    margin: 0;
    color: var(--cl-text-secondary);
    font-size: var(--cl-font-size-xs);
  }

  /* A played or in-progress game links to its page. Its target is the touch size the public site uses, and
     it sits above the card's own stretched link. */
  /* The hit area is the touch target, but the negative margin keeps the bar's own footprint at the icon's size,
     so a linked game does not push the card down into the next one. */
  .cl-series__segment-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cl-touch-target);
    height: var(--cl-touch-target);
    margin: calc((16px - var(--cl-touch-target)) / 2);
    color: inherit;
  }
</style>
