---
/**
 * A club's crest with its name and abbreviation: the one identity block every club surface shares.
 * With `href` the block is a link; without it, the same markup is plain content. With `headingLevel`
 * the name is that heading, so a page whose identity is its title states the name once. The `badges`
 * slot sits on its own row, and the `status` slot on a row below it. `size="lg"` is the page-title
 * scale: the name takes the `h1` type size, so a club page's identity outranks its section headings.
 */
import EmblemImage from '../atoms/EmblemImage.astro';

interface Props {
  readonly name: string;
  readonly abbreviation?: string;
  readonly emblemSrc?: string;
  readonly placeholderAlt: string;
  readonly href?: string;
  readonly size?: 'sm' | 'md' | 'lg';
  readonly headingLevel?: 1 | 2 | 3;
}

const {
  name,
  abbreviation,
  emblemSrc,
  placeholderAlt,
  href,
  size = 'md',
  headingLevel,
} = Astro.props;
const Tag = href ? 'a' : 'div';
const NameTag = headingLevel === undefined ? 'span' : (`h${headingLevel}` as 'h1' | 'h2' | 'h3');
---

<Tag
  class:list={['cl-club-identity', `cl-club-identity--${size}`, href && 'cl-focusable']}
  href={href}
>
  <EmblemImage
    size={size === 'sm' ? 32 : size === 'lg' ? 64 : 48}
    src={emblemSrc}
    abbreviation={abbreviation}
    alt={name}
    placeholderAlt={placeholderAlt}
    decorative
  />
  <span class="cl-club-identity__text">
    <NameTag class="cl-club-identity__name">{name}</NameTag>
    {abbreviation && <span class="cl-club-identity__abbr">{abbreviation}</span>}
    <span class="cl-club-identity__badges">
      <slot name="badges" />
    </span>
    <span class="cl-club-identity__status">
      <slot name="status" />
    </span>
  </span>
</Tag>

<style>
  .cl-club-identity {
    display: flex;
    align-items: center;
    gap: var(--cl-space-3);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  a.cl-club-identity:hover .cl-club-identity__name {
    color: var(--cl-text-accent);
    text-decoration: underline;
  }

  .cl-club-identity__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cl-space-1);
    min-width: 0;
  }

  .cl-club-identity__name {
    margin: 0;
    color: var(--cl-text-primary);
    font-family: var(--cl-font-display);
    font-size: var(--cl-font-size-lg);
    font-weight: inherit;
    line-height: var(--cl-line-height-title);
    overflow-wrap: anywhere;
  }

  .cl-club-identity--sm .cl-club-identity__name {
    font-size: var(--cl-font-size-base);
  }

  .cl-club-identity--lg {
    gap: var(--cl-space-4);
  }

  .cl-club-identity--lg .cl-club-identity__name {
    font-size: var(--cl-font-size-3xl);
    line-height: var(--cl-line-height-display);
    letter-spacing: var(--cl-tracking-wide);
  }

  .cl-club-identity__abbr {
    color: var(--cl-text-muted);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    letter-spacing: var(--cl-tracking-wide);
    text-transform: uppercase;
  }

  .cl-club-identity__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cl-space-2);
  }

  .cl-club-identity__status {
    display: block;
    margin: 0;
    color: var(--cl-text-secondary);
    font-size: var(--cl-font-size-base);
  }
</style>
