---
import { displayName, type OverviewModel } from '../../../lib/overview.ts';
import { tournamentEmblemUrl } from '../../../lib/public-api-client.ts';
import {
  selectDisciplineBackground,
  type PublicObjectReference,
} from '../../../lib/discipline-background.ts';
import type { TournamentHeroLabels } from '../../../lib/i18n/public-intl.ts';
import { Badge } from '../atoms/Badge.tsx';
import { Card } from '../atoms/Card.tsx';
import EmblemImage from '../atoms/EmblemImage.astro';

interface Props {
  readonly model: OverviewModel;
  readonly labels: TournamentHeroLabels;
  readonly disciplineImages?: readonly PublicObjectReference[];
}
const { model, labels, disciplineImages } = Astro.props;
const tournamentName = displayName(model);
const emblemSrc =
  model.emblemObjectId && model.organizationAlias && model.tournamentAlias
    ? tournamentEmblemUrl(model.organizationAlias, model.tournamentAlias)
    : undefined;
const backdrop = selectDisciplineBackground(disciplineImages);
---

<Card as="section" className="cl-card--live cl-tournament-hero">
  {
    backdrop && (
      <img
        class="cl-tournament-hero__backdrop"
        src={backdrop.url}
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    )
  }
  <div class="cl-tournament-hero__content">
    <div class="cl-tournament-hero__header">
      {
        emblemSrc && (
          <EmblemImage
            alt={labels.emblemAlt}
            placeholderAlt={labels.emblemPlaceholderAlt}
            size={56}
            src={emblemSrc}
          />
        )
      }
      <div class="cl-tournament-hero__titles">
        <p>{model.organizationName}</p>
        <h1>{tournamentName}</h1>
      </div>
    </div>
    {/* The count is the label: "live" as a colour alone is not a state. */}
    <Badge as="p">{labels.liveCountText}</Badge>
  </div>
</Card>

<style>
  .cl-tournament-hero {
    position: relative;
    overflow: hidden;
  }
  .cl-tournament-hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
    filter: blur(8px);
    background: #0a0f1d;
    pointer-events: none;
    user-select: none;
  }
  .cl-tournament-hero__content {
    position: relative;
    z-index: 1;
  }
  .cl-tournament-hero__header {
    display: flex;
    align-items: center;
    gap: var(--cl-space-3);
  }
  .cl-tournament-hero__titles {
    display: flex;
    flex-direction: column;
  }
</style>
