---
import type { RulesetBriefingRow } from '../../../lib/i18n/public-intl.ts';

interface Props {
  readonly rows: readonly RulesetBriefingRow[];
  readonly heading: string;
}
const { rows, heading } = Astro.props;
---

<section aria-labelledby="ruleset-heading" class="cl-ruleset-section">
  <h2 id="ruleset-heading">{heading}</h2>
  <dl class="cl-ruleset-grid">
    {
      rows.map((row) => (
        <div class="cl-rule-item">
          <dt class="cl-rule-label">{row.label}</dt>
          <dd class="cl-rule-value">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .cl-ruleset-grid {
    display: grid;
    /* `min(200px, 100%)`, not a bare `200px` floor (openspec 0225 task 7.4):
       a bare floor wider than the 188px zoom viewport forces the grid itself
       past the container, since no track may shrink below its minimum. */
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: var(--cl-space-3);
    margin: var(--cl-space-3) 0 0 0;
  }

  .cl-rule-item {
    background: var(--cl-surface-panel);
    border: 1px solid var(--cl-border-muted);
    border-radius: var(--cl-radius-md);
    padding: var(--cl-space-3);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cl-rule-label {
    font-size: var(--cl-font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cl-text-muted);
  }

  .cl-rule-value {
    font-size: var(--cl-font-size-md);
    font-weight: 700;
    color: var(--cl-text-primary);
    margin: 0;
  }
</style>
