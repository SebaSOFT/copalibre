---
import { MatchCard } from './MatchCard.tsx';
import type { MatchCardLabels } from '../../../lib/i18n/public-intl.ts';
import type { MatchCardData } from '../../../lib/matches-view.ts';

export interface TournamentNowStripEntry {
  readonly kind: 'live' | 'delayed' | 'upcoming' | 'final';
  readonly match: MatchCardData;
  readonly href: string;
}

interface Props {
  readonly heading: string;
  readonly entries: readonly TournamentNowStripEntry[];
  readonly labels: MatchCardLabels;
  readonly locale: string;
  readonly timeZone?: string;
  readonly referenceDate?: number;
}

const { heading, entries, labels, locale, timeZone, referenceDate } = Astro.props;
---

<section class="cl-overview-now" aria-labelledby="overview-now-heading">
  <h2 id="overview-now-heading">{heading}</h2>
  {entries.length > 0 ? (
    <ul class="cl-match-card-grid cl-overview-now__grid">
      {entries.map((entry) => (
        <li class:list={['cl-overview-now__item', `cl-overview-now__item--${entry.kind}`]}>
          {entry.match.state === 'live' ? (
            <MatchCard
              client:load
              labels={labels}
              locale={locale}
              match={entry.match}
              referenceDate={referenceDate}
              reportUrl={entry.href}
              timeZone={timeZone}
            />
          ) : (
            <MatchCard
              labels={labels}
              locale={locale}
              match={entry.match}
              referenceDate={referenceDate}
              reportUrl={entry.href}
              timeZone={timeZone}
            />
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p>{labels.empty}</p>
  )}
</section>

<style>
  .cl-overview-now {
    margin-block-end: var(--cl-space-5);
  }

  .cl-overview-now__grid {
    align-items: stretch;
  }

  .cl-overview-now__item {
    min-width: 0;
  }

  .cl-overview-now__item > :global(astro-island) {
    display: contents;
  }

  .cl-overview-now__item :global(.cl-match-card) {
    height: 100%;
    box-sizing: border-box;
  }

  .cl-overview-now__item--live :global(.cl-match-card) {
    border-inline-start-color: var(--cl-state-live);
  }

  .cl-overview-now__item--delayed :global(.cl-match-card) {
    border-inline-start-color: var(--cl-state-warning);
  }

  .cl-overview-now__item--upcoming :global(.cl-match-card) {
    border-inline-start-color: var(--cl-state-upcoming);
  }

  .cl-overview-now__item--final :global(.cl-match-card) {
    border-inline-start-color: var(--cl-state-positive);
  }
</style>
