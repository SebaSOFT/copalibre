---
import type { TickerItem } from '../../../lib/ticker-items.ts';

interface Props {
  readonly items: readonly TickerItem[];
  /** Accessible name for the rail; the caller holds the catalogue. */
  readonly label: string;
  /**
   * `tv` reads at distance and sizes itself in vmin, as the rest of that
   * surface does; `web` reads at arm's length.
   */
  readonly scale?: 'web' | 'tv';
  /**
   * True when the entries are the last known ones rather than current.
   *
   * A rail that keeps presenting an old score as a live one is the single worst
   * thing this component can do, so the condition is stated on the rail itself
   * rather than left for the reader to infer from a clock that stopped moving.
   */
  readonly stale?: boolean;
  readonly staleLabel?: string;
  /** Shown in place of the entries when the tournament has nothing to report. */
  readonly emptyLabel?: string;
  readonly pauseLabel?: string;
  readonly resumeLabel?: string;
}
const {
  items,
  label,
  scale = 'web',
  stale = false,
  staleLabel,
  emptyLabel,
  pauseLabel,
  resumeLabel,
} = Astro.props;

/*
  Items are duplicated once so the loop has no visible seam — the track
  translates to exactly -50% and snaps back onto an identical frame. The copy
  is `aria-hidden`, so a screen reader hears the rail once, and under reduced
  motion the stylesheet drops it entirely rather than showing every entry twice
  in a list nobody is scrolling past.
*/
---

<div
  class:list={['cl-ticker', `cl-ticker--${scale}`]}
  data-ticker
  data-stale={stale ? 'true' : undefined}
  aria-label={label}
  role="region"
>
  {
    items.length === 0 ? (
      <p class="cl-ticker__notice">{emptyLabel}</p>
    ) : (
      <>
        {stale && staleLabel && (
          <p class="cl-ticker__notice cl-ticker__notice--stale" role="status">
            {staleLabel}
          </p>
        )}
        <div class="cl-ticker__track" data-ticker-track>
          {[0, 1].map((copy) =>
            items.map((item) => (
              <div class="cl-ticker__item" aria-hidden={copy === 1 ? 'true' : undefined}>
                <span class:list={['cl-badge', `cl-badge--${item.tone}`]}>{item.badge}</span>
                <span class="cl-ticker__subject">{item.subject}</span>
                <span class="cl-ticker__figure">{item.figure}</span>
                {item.opponent && <span class="cl-ticker__subject">{item.opponent}</span>}
                {/* Only where the discipline declares one; nothing here derives it. */}
                {item.overtime && <span class="cl-ticker__overtime">{item.overtime}</span>}
                {item.meta && <span class="cl-ticker__meta">({item.meta})</span>}
                <span class="cl-ticker__sep" aria-hidden="true">
                  ///
                </span>
              </div>
            )),
          )}
        </div>
        {/*
          Hidden until the script that gives it meaning has run. A pause button
          that does nothing without JavaScript is a broken control on the one
          surface that has to keep working without it — so it arrives with the
          behaviour or it does not arrive.
        */}
        <button
          class="cl-ticker__pause cl-focusable"
          type="button"
          hidden
          data-ticker-pause
          data-pause-label={pauseLabel}
          data-resume-label={resumeLabel}
          aria-label={pauseLabel}
          aria-pressed="false"
        >
          <span aria-hidden="true">⏸</span>
        </button>
      </>
    )
  }
</div>

<script>
  /*
    Motion lives here rather than in a keyframe because it has to.
    `@copalibre/design-tokens` emits a global reduced-motion rule setting
    `animation-duration: 0.01ms !important` on every element, so that a
    component added later inherits the accommodation without remembering it.
    For a fade that is exactly right. For a transport it is not: a marquee
    collapsed to nothing freezes at 0% and hides every item past the fold —
    and `!important` defeats a substitute step-animation just as thoroughly.
    A transform written from script is neither an animation nor a transition,
    so it stays under this component's control in both directions.
  */
  const PIXELS_PER_SECOND = 40;

  function startTicker(rail: HTMLElement) {
    const track = rail.querySelector<HTMLElement>('[data-ticker-track]');
    if (!track) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pause = rail.querySelector<HTMLButtonElement>('[data-ticker-pause]');
    let stop: (() => void) | undefined;
    let paused = false;

    function scrollContinuously(track: HTMLElement) {
      let offset = 0;
      let last = performance.now();
      let frame = 0;
      const tick = (now: number) => {
        const span = track.scrollWidth / 2;
        const elapsed = now - last;
        last = now;
        if (!paused) {
          offset = span > 0 ? (offset + (elapsed / 1000) * PIXELS_PER_SECOND) % span : 0;
          track.style.transform = `translateX(${-offset}px)`;
        }
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
      return () => cancelAnimationFrame(frame);
    }

    /*
      Under reduced motion the rail is a static list and nothing here moves it:
      the stylesheet wraps the track, drops the duplicated copy and lets the
      rail scroll natively, so every entry stays reachable by keyboard and by
      scroll without a single animated pixel. Leaving the transform alone is the
      whole implementation — a "slower" or "stepped" substitute is still motion.
    */
    function holdStill(track: HTMLElement) {
      track.style.transform = '';
      return () => {};
    }

    const apply = () => {
      stop?.();
      if (!reduced.matches) track.style.transform = 'translateX(0px)';
      stop = reduced.matches ? holdStill(track) : scrollContinuously(track);
      // Nothing is moving, so there is nothing to pause.
      if (pause) pause.hidden = reduced.matches;
    };

    if (pause) {
      pause.hidden = false;
      pause.addEventListener('click', () => {
        paused = !paused;
        pause.setAttribute('aria-pressed', paused ? 'true' : 'false');
        const next = paused ? pause.dataset.resumeLabel : pause.dataset.pauseLabel;
        if (next) pause.setAttribute('aria-label', next);
      });
    }

    apply();
    reduced.addEventListener('change', apply);
  }

  for (const rail of document.querySelectorAll<HTMLElement>('[data-ticker]')) startTicker(rail);
</script>

<style>
  .cl-ticker {
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    z-index: 20;
    user-select: none;
    background: color-mix(in srgb, var(--cl-color-ink-950) 90%, transparent);
    border-block-end: 1px solid var(--cl-color-ink-700);
    backdrop-filter: blur(6px);
  }

  .cl-ticker--web {
    height: 44px;
    font-size: var(--cl-font-size-xs);
  }

  /* Distance reading: the rest of the TV sheet is vmin-relative, so this is too. */
  .cl-ticker--tv {
    height: 6vmin;
    font-size: clamp(var(--cl-font-size-sm), 2vmin, 2.5vmin);
  }

  .cl-ticker__track {
    display: flex;
    align-items: center;
    width: max-content;
    padding-inline: var(--cl-space-6);
    gap: var(--cl-space-8);
    font-family: var(--cl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cl-text-secondary);
    will-change: transform;
  }

  .cl-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: var(--cl-space-3);
    white-space: nowrap;
  }

  .cl-ticker__subject {
    font-family: var(--cl-font-display);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--cl-text-primary);
  }

  .cl-ticker__figure {
    font-family: var(--cl-font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding: 0.15em 0.4em;
    border-radius: var(--cl-radius-sm);
    background: var(--cl-color-ink-900);
    border: 1px solid var(--cl-color-ink-700);
    color: var(--cl-primary);
  }

  /* A period the discipline declared, not a clock that ran long. */
  .cl-ticker__overtime {
    font-weight: 700;
    color: var(--cl-state-upcoming);
  }

  .cl-ticker__meta {
    font-size: 0.85em;
    color: var(--cl-text-muted);
  }

  .cl-ticker__sep {
    font-weight: 700;
    color: var(--cl-color-ink-700);
    margin-inline: var(--cl-space-2);
  }

  /* The rail speaking about itself: empty, or showing what it last knew. */
  .cl-ticker__notice {
    margin: 0;
    padding-inline: var(--cl-space-6);
    font-family: var(--cl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cl-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cl-ticker__notice--stale {
    flex: 0 0 auto;
    color: var(--cl-state-upcoming);
    border-inline-end: 1px solid var(--cl-color-ink-700);
    margin-inline-end: var(--cl-space-4);
    padding-block: var(--cl-space-1);
  }

  .cl-ticker__pause {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    min-width: var(--cl-touch-target);
    padding-inline: var(--cl-space-3);
    border: 0;
    border-inline-start: 1px solid var(--cl-color-ink-700);
    background: var(--cl-color-ink-900);
    color: var(--cl-text-secondary);
    cursor: pointer;
  }

  .cl-ticker__pause[aria-pressed='true'] {
    color: var(--cl-primary);
  }

  /*
    Reduced motion: a static list, not a slower marquee.

    The rail keeps its declared height so nothing beneath it moves, the track
    wraps instead of running off the side, and the rail scrolls natively — every
    entry reachable, no pixel animated. The aria-hidden duplicate goes, because
    a list nobody is scrolling past has no seam to hide.
  */
  @media (prefers-reduced-motion: reduce) {
    .cl-ticker {
      overflow-y: auto;
      align-items: flex-start;
    }

    .cl-ticker__track {
      flex-wrap: wrap;
      width: 100%;
      transform: none !important;
      will-change: auto;
      column-gap: var(--cl-space-6);
      row-gap: var(--cl-space-2);
      padding-block: var(--cl-space-2);
    }

    .cl-ticker__item[aria-hidden='true'] {
      display: none;
    }

    .cl-ticker__pause {
      display: none;
    }
  }
</style>
