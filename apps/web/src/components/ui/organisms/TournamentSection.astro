---
/**
 * Extracted from the organization page (openspec 0225 task 7.2): the live,
 * featured, upcoming and finished tournament listings were four
 * near-identical copies of this same section shape — one organism,
 * parameterized by heading, count visibility, the live-dot marker, the
 * featured-grid sizing, and whether each card renders `featured`.
 */
import type { IntlShape } from 'react-intl';
import type { PublicTournamentListingItemResponse } from '@copalibre/api/src/dto/public-tournament.dto.js';
import TournamentCard from './TournamentCard.astro';

export interface Props {
  readonly headingId: string;
  readonly heading: string;
  readonly tournaments: readonly PublicTournamentListingItemResponse[];
  readonly organizationAlias: string;
  readonly localePrefix: string;
  readonly intl: IntlShape;
  readonly showCount?: boolean;
  readonly showLiveDot?: boolean;
  readonly featured?: boolean;
  readonly sectionClass?: string;
  readonly gridClass?: string;
}

const {
  headingId,
  heading,
  tournaments,
  organizationAlias,
  localePrefix,
  intl,
  showCount = true,
  showLiveDot = false,
  featured = false,
  sectionClass = '',
  gridClass = '',
} = Astro.props;
---

<section class={`cl-listing-section ${sectionClass}`.trim()} aria-labelledby={headingId}>
  <div class="cl-section-header">
    {showLiveDot && <span class="cl-live-dot" aria-hidden="true" />}
    <h2 id={headingId} class="cl-section-title">
      {heading}
    </h2>
    {showCount && <span class="cl-section-count">({tournaments.length})</span>}
  </div>
  <div class={`cl-tournaments-grid ${gridClass}`.trim()}>
    {
      tournaments.map((t) => (
        <TournamentCard
          tournament={t}
          organizationAlias={organizationAlias}
          localePrefix={localePrefix}
          intl={intl}
          featured={featured}
        />
      ))
    }
  </div>
</section>

<style>
  .cl-listing-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cl-section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cl-section-title {
    font-size: var(--cl-font-size-xl);
    font-weight: 700;
    margin: 0;
    color: var(--cl-text-primary);
  }

  .cl-section-count {
    font-size: var(--cl-font-size-sm);
    color: var(--cl-text-muted);
    font-weight: 600;
  }

  .cl-live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--cl-state-live);
    box-shadow: 0 0 10px var(--cl-state-live);
    animation: cl-pulse-live 1.5s infinite;
  }

  @keyframes cl-pulse-live {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.3);
    }
  }

  .cl-tournaments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .cl-tournaments-grid {
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
  }

  .cl-grid-live,
  .cl-grid-featured {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .cl-grid-live,
    .cl-grid-featured {
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-live-dot {
      animation: none;
    }
  }
</style>
