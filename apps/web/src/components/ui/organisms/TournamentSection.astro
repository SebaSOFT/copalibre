---
/**
 * Extracted from the organization page: the live,
 * featured, upcoming and finished tournament listings were four
 * near-identical copies of this same section shape — one organism,
 * parameterized by heading, count visibility, grid sizing, and whether each
 * card renders `featured`.
 */
import type { IntlShape } from 'react-intl';
import type { PodiumListingItem } from '../../../lib/podium-emblems.ts';
import TournamentCard from './TournamentCard.astro';

export interface Props {
  readonly headingId: string;
  readonly heading: string;
  readonly tournaments: readonly PodiumListingItem[];
  readonly organizationAlias: string;
  readonly localePrefix: string;
  readonly intl: IntlShape;
  readonly showCount?: boolean;
  readonly featured?: boolean;
  readonly sectionClass?: string;
  readonly gridClass?: string;
}

const {
  headingId,
  heading,
  tournaments,
  organizationAlias,
  localePrefix,
  intl,
  showCount = true,
  featured = false,
  sectionClass = '',
  gridClass = '',
} = Astro.props;
---

<section class={`cl-listing-section ${sectionClass}`.trim()} aria-labelledby={headingId}>
  <div class="cl-section-header">
    <h2 id={headingId} class="cl-section-title">
      {heading}
    </h2>
    {showCount && <span class="cl-section-count">({tournaments.length})</span>}
  </div>
  <div class={`cl-tournaments-grid ${gridClass}`.trim()}>
    {tournaments.map((t) => (
      <TournamentCard
        tournament={t}
        organizationAlias={organizationAlias}
        localePrefix={localePrefix}
        intl={intl}
        featured={featured || t.featured}
      />
    ))}
  </div>
</section>

<style>
  .cl-listing-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cl-section-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cl-section-title {
    font-size: var(--cl-font-size-xl);
    font-weight: 700;
    margin: 0;
    color: var(--cl-text-primary);
    /* Lets the row wrap instead of forcing the header wider than a narrow
       viewport — a flex child's minimum width
       otherwise defaults to its unbroken text width. */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cl-section-count {
    font-size: var(--cl-font-size-sm);
    color: var(--cl-text-muted);
    font-weight: 600;
  }

  .cl-tournaments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cl-tournaments-grid {
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }
  }

  .cl-grid-priority,
  .cl-grid-featured {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .cl-grid-priority,
    .cl-grid-featured {
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    }
  }
</style>
