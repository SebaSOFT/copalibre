---
import type { IntlShape } from 'react-intl';
import type {
  PlayerStatisticsDrilldownResponse,
  PlayerStatisticsMatchRowResponse,
  PublicPersonCompetitionHistoryResponse,
  PublicPersonProfileResponse,
} from '@copalibre/api/src/dto/public-tournament.dto.js';
import type {
  TableCellResponse,
  TableLayoutSummaryResponse,
} from '@copalibre/api/src/dto/table-projections.dto.js';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import { personPhotoUrl } from '../../../lib/public-api-client.ts';
import { localizedText } from '../../../lib/localized-label.ts';
import PersonPhotoImage from '../atoms/PersonPhotoImage.astro';
import DataTable from './DataTable.astro';

interface Props {
  readonly profile: PublicPersonProfileResponse;
  readonly intl: IntlShape;
  readonly organizationAlias: string;
  /** The tournament's own canonical path — used to build the layout-selector links. */
  readonly canonicalPath?: string;
  /** Every effective person-granularity player-ranking layout declared for the current tournament. */
  readonly statisticsLayouts?: readonly TableLayoutSummaryResponse[];
  readonly activeStatisticsLayoutCode?: string;
  readonly statistics?: PlayerStatisticsDrilldownResponse;
}

const {
  profile,
  intl,
  organizationAlias,
  canonicalPath = '',
  statisticsLayouts = [],
  activeStatisticsLayoutCode,
  statistics,
} = Astro.props;

/** Tournament-total row: cells keyed directly by column code (not nested under `.cells`). */
const totalColumns = (statistics?.columns ?? []).map((column) => ({
  key: column.code,
  header: localizedText(column.header, intl.locale),
  render: (row: unknown) =>
    (row as Record<string, TableCellResponse | undefined>)[column.code]?.formatted ?? '—',
}));

// Match rows only ever carry collector-kind cells (openspec 0244) — narrowed
// to the columns actually present on a match row, in the tournament-total's
// own declared order, so a composite/computed column never appears here.
const matchCellCodes = new Set(
  (statistics?.matches ?? []).flatMap((row) => Object.keys(row.cells)),
);
const matchStatColumns = (statistics?.columns ?? [])
  .filter((column) => matchCellCodes.has(column.code))
  .map((column) => ({
    key: column.code,
    header: localizedText(column.header, intl.locale),
    render: (row: unknown) =>
      (row as PlayerStatisticsMatchRowResponse).cells[column.code]?.formatted ?? '—',
  }));
const matchColumns = [
  {
    key: 'match',
    header: intl.formatMessage(messages.playerProfileMatchColumnHeading),
    render: (row: unknown) => {
      const match = row as PlayerStatisticsMatchRowResponse;
      return intl.formatMessage(messages.playerProfileMatchLabel, {
        stage: match.stageNumber,
        match: match.matchNumber,
      });
    },
  },
  ...matchStatColumns,
];

const hasStatistics =
  statistics !== undefined &&
  (statistics.tournamentTotal !== undefined || statistics.matches.length > 0);

// `DataTable`'s `render` returns a plain value per cell (its own docstring
// records why), so the bold tournament name and the muted abbreviation
// colour this table used to carry are dropped rather than preserved —
// this history has no per-cell link the way `MatchRosters`/`StandingsTable`
// do, so composing the owned table outweighs keeping either.
const historyColumns = [
  {
    key: 'tournament',
    header: 'Tournament',
    render: (row: unknown) => (row as PublicPersonCompetitionHistoryResponse).tournamentName,
  },
  {
    key: 'team',
    header: 'Team',
    render: (row: unknown) => {
      const item = row as PublicPersonCompetitionHistoryResponse;
      return item.entrantAbbreviation
        ? `${item.teamName} (${item.entrantAbbreviation})`
        : item.teamName;
    },
  },
  {
    key: 'role',
    header: 'Role',
    render: (row: unknown) => (row as PublicPersonCompetitionHistoryResponse).role,
  },
];
---

<article class="cl-player-profile">
  <header class="cl-player-profile__header">
    <PersonPhotoImage
      alt={intl.formatMessage(messages.playerProfilePhotoAlt, { name: profile.displayName })}
      placeholderAlt={intl.formatMessage(messages.playerProfilePhotoPlaceholderAlt)}
      src={profile.photoObjectId ? personPhotoUrl(organizationAlias, profile.personId) : undefined}
    />
    <div class="cl-player-profile__identity">
      <h2 class="cl-player-profile__name">{profile.displayName}</h2>
      {profile.alias && <span class="cl-player-profile__alias">@{profile.alias}</span>}
      <div class="cl-player-profile__meta">
        {
          profile.nationality && (
            <span class="cl-player-profile__tag">
              {intl.formatMessage(messages.playerProfileNationality, {
                country: profile.nationality,
              })}
            </span>
          )
        }
        {
          profile.age !== undefined && (
            <span class="cl-player-profile__tag">
              {intl.formatMessage(messages.playerProfileAge, { age: profile.age })}
            </span>
          )
        }
      </div>
    </div>
  </header>

  <section class="cl-player-profile__section" aria-labelledby="player-stats-heading">
    <h3 id="player-stats-heading" class="cl-player-profile__section-title">
      {intl.formatMessage(messages.playerProfileCareerStatsHeading)}
    </h3>
    {
      profile.careerStatistics.length === 0 && (
        <p class="cl-player-profile__empty">{intl.formatMessage(messages.playerProfileNoStats)}</p>
      )
    }
    {
      profile.careerStatistics.length > 0 && (
        <div class="cl-player-profile__stats-grid">
          {profile.careerStatistics.map((discipline) => (
            <div class="cl-player-profile__discipline-stats">
              {discipline.disciplineName && (
                <h4 class="cl-player-profile__discipline-title">{discipline.disciplineName}</h4>
              )}
              <dl class="cl-player-profile__stat-list">
                {discipline.statistics.map((stat) => (
                  <div class="cl-player-profile__stat-item">
                    <dt class="cl-player-profile__stat-label">{stat.label}</dt>
                    <dd class="cl-player-profile__stat-value">{stat.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      )
    }
  </section>

  {
    statisticsLayouts.length > 0 && (
      <section class="cl-player-profile__section" aria-labelledby="player-tournament-stats-heading">
        <h3 id="player-tournament-stats-heading" class="cl-player-profile__section-title">
          {intl.formatMessage(messages.playerProfileTournamentStatsHeading)}
        </h3>
        {statisticsLayouts.length > 1 && (
          <div class="cl-player-profile__layout-selector" role="tablist">
            {statisticsLayouts.map((layoutOption) => (
              <a
                href={`${canonicalPath}/players/${profile.personId}?layout=${encodeURIComponent(layoutOption.code)}`}
                class={
                  layoutOption.code === activeStatisticsLayoutCode
                    ? 'cl-player-profile__layout-tab cl-player-profile__layout-tab--active'
                    : 'cl-player-profile__layout-tab'
                }
                role="tab"
                aria-selected={layoutOption.code === activeStatisticsLayoutCode}
              >
                {localizedText(layoutOption.label, intl.locale)}
              </a>
            ))}
          </div>
        )}
        {!hasStatistics && (
          <p class="cl-player-profile__empty">
            {intl.formatMessage(messages.playerProfileNoTournamentStats)}
          </p>
        )}
        {hasStatistics && (
          <div class="cl-player-profile__stats-tables">
            {statistics?.tournamentTotal !== undefined && (
              <DataTable
                caption={intl.formatMessage(messages.playerProfileTournamentTotalHeading)}
                ariaLabel={intl.formatMessage(messages.playerProfileTournamentTotalHeading)}
                columns={totalColumns}
                rows={[statistics.tournamentTotal]}
              />
            )}
            {statistics && statistics.matches.length > 0 && (
              <DataTable
                caption={intl.formatMessage(messages.playerProfileMatchByMatchHeading)}
                ariaLabel={intl.formatMessage(messages.playerProfileMatchByMatchHeading)}
                columns={matchColumns}
                rows={statistics.matches}
              />
            )}
          </div>
        )}
      </section>
    )
  }

  <section class="cl-player-profile__section" aria-labelledby="player-history-heading">
    <h3 id="player-history-heading" class="cl-player-profile__section-title">
      {intl.formatMessage(messages.playerProfileHistoryHeading)}
    </h3>
    {
      profile.competitionHistory.length === 0 && (
        <p class="cl-player-profile__empty">
          {intl.formatMessage(messages.playerProfileNoHistory)}
        </p>
      )
    }
    {
      profile.competitionHistory.length > 0 && (
        <DataTable
          ariaLabel={intl.formatMessage(messages.playerProfileHistoryHeading)}
          columns={historyColumns}
          rows={profile.competitionHistory}
        />
      )
    }
  </section>
</article>

<style>
  .cl-player-profile {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .cl-player-profile__header {
    border-bottom: 1px solid var(--cl-border-muted);
    padding-bottom: 16px;
  }
  .cl-player-profile__name {
    margin: 0 0 4px 0;
    font-size: var(--cl-font-size-xl);
    font-weight: 700;
    color: var(--cl-text-primary);
    overflow-wrap: anywhere;
  }
  .cl-player-profile__alias {
    color: var(--cl-text-muted);
    font-size: var(--cl-font-size-sm);
  }
  .cl-player-profile__meta {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .cl-player-profile__tag {
    display: inline-block;
    background: var(--cl-surface-chrome);
    color: var(--cl-text-primary);
    border: 1px solid var(--cl-border-muted);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: var(--cl-font-size-sm);
    font-weight: 500;
  }
  .cl-player-profile__section-title {
    margin: 0 0 12px 0;
    font-size: var(--cl-font-size-md);
    font-weight: 600;
    color: var(--cl-text-primary);
  }
  .cl-player-profile__empty {
    color: var(--cl-text-muted);
    font-style: italic;
    margin: 0;
  }
  .cl-player-profile__stat-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    margin: 0;
  }
  .cl-player-profile__stat-item {
    background: var(--cl-surface-chrome);
    border: 1px solid var(--cl-border-muted);
    padding: 12px;
    border-radius: var(--cl-radius-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cl-player-profile__stat-label {
    font-size: var(--cl-font-size-xs);
    color: var(--cl-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cl-player-profile__stat-value {
    font-size: var(--cl-font-size-xl);
    font-weight: 700;
    color: var(--cl-text-primary);
    margin: 0;
  }
  /* BREAKPOINTS.sm: a single stats column remains usable at 200% zoom. */
  @media (max-width: 375px) {
    .cl-player-profile__stat-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cl-player-profile__stats-tables {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cl-player-profile__layout-selector {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--cl-border-muted);
  }
  .cl-player-profile__layout-tab {
    display: inline-block;
    padding: 8px 16px;
    text-decoration: none;
    color: inherit;
    font-weight: 500;
    font-size: var(--cl-font-size-sm);
    border-bottom: 2px solid transparent;
  }
  .cl-player-profile__layout-tab--active {
    border-bottom-color: var(--cl-primary);
    color: var(--cl-primary);
  }
</style>
