---
/**
 * The match timeline: one row per event with its side, its game time in the
 * segment, the running score where the event changed it and the wall-clock time
 * as secondary text. Each segment opens and, when completed, closes with a marker.
 */
import type { IntlShape } from 'react-intl';
import EmblemImage from '../atoms/EmblemImage.astro';
import { ResponsiveTimestamp } from '../atoms/ResponsiveTimestamp.tsx';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import {
  formatElapsed,
  type MatchReportModel,
  type MatchReportSide,
  type MatchReportTimelineEvent,
} from '../../../lib/match-report.ts';

export interface Props {
  readonly model: MatchReportModel;
  readonly intl: IntlShape;
  readonly organizationTimeZone?: string;
  readonly referenceDate?: number;
}

const { model, intl, organizationTimeZone, referenceDate } = Astro.props;

const sideOf = (side: MatchReportSide): MatchReportModel['home'] => model[side];

/** "Tiempo 1 · 08:00" when the event's time in its segment is known, the segment alone otherwise. */
const gameTimeOf = (event: MatchReportTimelineEvent): string | undefined => {
  if (event.segmentNumber === undefined) return undefined;
  const segment = event.segmentLabel ?? '';
  if (event.elapsedSeconds === undefined) {
    return intl.formatMessage(messages.matchTimelineSegmentStart, {
      segment,
      number: event.segmentNumber,
    });
  }
  return intl.formatMessage(messages.matchTimelineSegmentTime, {
    segment,
    number: event.segmentNumber,
    time: formatElapsed(event.elapsedSeconds),
  });
};

const scoreText = (score: readonly [number, number]): string =>
  intl.formatMessage(messages.matchTimelineScoreAfter, { home: score[0], away: score[1] });
---

<section class="cl-section-card cl-chamfer" aria-labelledby="timeline-heading">
  <h2 id="timeline-heading" class="cl-section-title">
    {intl.formatMessage(messages.matchTimelineHeading)}
  </h2>
  {model.timeline.length === 0 ? (
    <p class="cl-text-muted">{intl.formatMessage(messages.matchTimelineEmpty)}</p>
  ) : (
    <ol class="cl-timeline-list">
      {model.timeline.map((group) => {
        if (group.kind === 'segment-start' || group.kind === 'segment-end') {
          const segment = group.segment;
          const text =
            group.kind === 'segment-start'
              ? intl.formatMessage(messages.matchTimelineSegmentStart, {
                  segment: segment?.label ?? '',
                  number: segment?.number ?? '',
                })
              : intl.formatMessage(messages.matchTimelineSegmentEnd, {
                  segment: segment?.label ?? '',
                  number: segment?.number ?? '',
                  score: segment?.scores === undefined ? '' : scoreText(segment.scores),
                });
          return (
            <li
              class:list={[
                'cl-timeline-marker',
                group.kind === 'segment-start'
                  ? 'cl-timeline-marker--start'
                  : 'cl-timeline-marker--end',
              ]}
              data-segment-marker={group.kind}
            >
              <span class="cl-timeline-marker__text">{text}</span>
            </li>
          );
        }
        return (
          <li
            class="cl-timeline-item"
            data-workflow-group={group.kind === 'workflow' ? 'true' : undefined}
          >
            {group.events.map((event) => {
              const side = event.side;
              const sideModel = side === undefined ? undefined : sideOf(side);
              const gameTime = gameTimeOf(event);
              return (
                <div class="cl-timeline-entry" data-side={side}>
                  {sideModel && (
                    <span class="cl-timeline-side" title={sideModel.name}>
                      <EmblemImage
                        src={sideModel.crestSrc}
                        alt={sideModel.name}
                        placeholderAlt={sideModel.name}
                        abbreviation={sideModel.abbreviation}
                        size={24}
                        bare={sideModel.crestSrc === undefined}
                        decorative={true}
                      />
                      <span class="cl-timeline-side__name">
                        {sideModel.abbreviation ?? sideModel.name}
                      </span>
                    </span>
                  )}
                  {gameTime && <span class="cl-timeline-time">{gameTime}</span>}
                  <span class="cl-timeline-label">{event.label}</span>
                  {event.actor ? <span class="cl-timeline-actor">· {event.actor}</span> : null}
                  {event.scoreAfter && (
                    <span class="cl-timeline-score">{scoreText(event.scoreAfter)}</span>
                  )}
                  <ResponsiveTimestamp
                    client:load
                    timestamp={event.occurredAt}
                    locale={intl.locale}
                    referenceDate={referenceDate}
                    timeZone={organizationTimeZone}
                    className="cl-timeline-clock"
                  />
                </div>
              );
            })}
          </li>
        );
      })}
    </ol>
  )}
</section>

<style>
  .cl-section-card {
    background: var(--cl-surface-panel);
    border: 1px solid var(--cl-border-muted);
    padding: var(--cl-space-5);
  }

  .cl-section-title {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    border-bottom: 1px solid var(--cl-border-muted);
    padding-bottom: 0.5rem;
  }

  .cl-text-muted {
    color: var(--cl-text-muted);
    font-size: 0.875rem;
  }

  .cl-timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cl-timeline-entry {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.875rem;
    border-inline-start: 3px solid transparent;
    padding-inline-start: var(--cl-space-3);
  }

  .cl-timeline-entry[data-side='home'] {
    border-inline-start-color: var(--cl-text-accent);
  }

  .cl-timeline-entry[data-side='away'] {
    border-inline-start-color: var(--cl-border-strong);
  }

  .cl-timeline-side {
    display: inline-flex;
    align-items: center;
    gap: var(--cl-space-2);
    min-width: 0;
  }

  .cl-timeline-side__name {
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    color: var(--cl-text-secondary);
  }

  .cl-timeline-time {
    font-family: var(--cl-font-mono);
    color: var(--cl-text-accent);
    font-size: var(--cl-font-size-xs);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .cl-timeline-label {
    font-weight: 500;
  }

  .cl-timeline-actor {
    color: var(--cl-text-muted);
  }

  .cl-timeline-score {
    font-family: var(--cl-font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--cl-text-primary);
  }

  .cl-timeline-clock {
    margin-inline-start: auto;
    color: var(--cl-text-muted);
    font-size: var(--cl-font-size-xs);
    overflow-wrap: anywhere;
  }

  .cl-timeline-marker {
    display: flex;
    align-items: center;
    gap: var(--cl-space-3);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    letter-spacing: var(--cl-tracking-wide);
    color: var(--cl-text-secondary);
    text-transform: uppercase;
  }

  .cl-timeline-marker::before,
  .cl-timeline-marker::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: var(--cl-border-muted);
  }

  .cl-timeline-marker__text {
    flex: 0 1 auto;
    text-align: center;
    overflow-wrap: anywhere;
  }
</style>
