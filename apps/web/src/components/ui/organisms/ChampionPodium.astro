---
import type { IntlShape } from 'react-intl';
import EmblemImage from '../atoms/EmblemImage.astro';
import type { PodiumEntrant, PodiumZone } from '../../../lib/podium-emblems.ts';
import { messages } from '../../../lib/i18n/public-messages.en.ts';

interface Props {
  readonly winners: readonly PodiumZone[];
  readonly intl: IntlShape;
  readonly prominent?: boolean;
}

const { winners, intl, prominent = false } = Astro.props;

type Spot = {
  readonly key: 'champion' | 'runner' | 'third';
  readonly place: 1 | 2 | 3;
  readonly label: string;
  readonly entrant: PodiumEntrant;
};

const spotsOf = (zone: PodiumZone): readonly Spot[] => [
  ...(zone.champions?.length ? zone.champions : [zone.champion]).map((entrant): Spot => ({
    key: 'champion',
    place: 1,
    label: intl.formatMessage(messages.tournamentsChampion),
    entrant,
  })),
  ...(zone.runnerUp
    ? [
        {
          key: 'runner',
          place: 2,
          label: intl.formatMessage(messages.tournamentsRunnerUp),
          entrant: zone.runnerUp,
        } satisfies Spot,
      ]
    : []),
  ...(zone.thirdPlace
    ? [
        {
          key: 'third',
          place: 3,
          label: intl.formatMessage(messages.tournamentsThirdPlace),
          entrant: zone.thirdPlace,
        } satisfies Spot,
      ]
    : []),
];

const MEDAL_CLASS = {
  champion: 'cl-gold-medal',
  runner: 'cl-silver-medal',
  third: 'cl-bronze-medal',
};
---

{
  winners.length > 0 && (
    <section
      class:list={['cl-podium-container', { 'cl-podium-prominent': prominent }]}
      aria-label={intl.formatMessage(messages.tournamentsFinishedHeading)}
    >
      {winners.map((zone) => (
        <div class="cl-zone-podium cl-chamfer">
          {zone.zoneName && <div class="cl-zone-title">{zone.zoneName}</div>}
          <div class="cl-podium-grid">
            {spotsOf(zone).map((spot) => (
              <div
                class:list={['cl-podium-spot', `cl-${spot.key}-spot`]}
                data-entrant-id={spot.entrant.entrantId}
              >
                <div class={`cl-medal-badge ${MEDAL_CLASS[spot.key]}`} aria-hidden="true">
                  {spot.place}
                </div>
                <EmblemImage
                  alt={intl.formatMessage(messages.orgPageEmblemAlt, { name: spot.entrant.name })}
                  placeholderAlt={intl.formatMessage(messages.orgPageEmblemPlaceholderAlt)}
                  size={40}
                  src={spot.entrant.emblemSrc}
                />
                <div class="cl-entrant-info">
                  <span class="cl-podium-label">{spot.label}</span>
                  <span class="cl-entrant-name" title={spot.entrant.name}>
                    {spot.entrant.name}
                    {spot.entrant.abbreviation && (
                      <span class="cl-entrant-abbr" title={spot.entrant.name}>
                        {' '}
                        ({spot.entrant.abbreviation})
                      </span>
                    )}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>
  )
}

<style>
  .cl-podium-container {
    display: grid;
    gap: var(--cl-space-4);
  }

  .cl-podium-prominent {
    margin-block: var(--cl-space-4);
  }

  .cl-zone-title {
    font-family: var(--cl-font-display);
    font-size: var(--cl-font-size-md);
    font-weight: var(--cl-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--cl-tracking-wider);
    color: var(--cl-text-primary);
  }

  .cl-zone-podium {
    background: var(--cl-surface-base);
    border: 1px solid var(--cl-border-muted);
    padding: var(--cl-space-4);
    display: grid;
    gap: var(--cl-space-3);
    min-width: 0;
  }

  /* Columns by the room the podium is given, not by the viewport: the same component sits in a
     narrow listing card and in a full-width overview. A column is never narrower than 15rem, so a
     name is never broken inside a word; below that the placings stack. */
  .cl-podium-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--cl-space-2);
  }

  .cl-podium-spot {
    display: flex;
    align-items: center;
    gap: var(--cl-space-2);
    padding: var(--cl-space-3);
    border-top: 1px solid var(--cl-border-muted);
    min-width: 0;
  }

  @media (max-width: 240px) {
    .cl-podium-spot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .cl-medal-badge {
    width: var(--cl-space-8);
    height: var(--cl-space-8);
    display: grid;
    place-items: center;
    font-family: var(--cl-font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--cl-font-size-xs);
    font-weight: var(--cl-weight-bold);
    flex-shrink: 0;
  }

  .cl-gold-medal {
    background: var(--cl-state-upcoming);
    color: var(--cl-surface-base);
  }

  .cl-silver-medal {
    background: var(--cl-text-secondary);
    color: var(--cl-surface-base);
  }

  .cl-bronze-medal {
    background: var(--cl-surface-chrome);
    color: var(--cl-text-primary);
    border: 1px solid var(--cl-border-strong);
  }

  .cl-entrant-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cl-podium-label {
    font-size: var(--cl-font-size-xs);
    font-weight: var(--cl-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--cl-tracking-wider);
    color: var(--cl-text-muted);
    /* A longer translated label (German "Zweitplatzierter") can otherwise
       push this flex column past a narrow viewport. */
    overflow-wrap: anywhere;
  }

  .cl-entrant-name {
    font-size: var(--cl-font-size-sm);
    font-weight: var(--cl-weight-semibold);
    color: var(--cl-text-primary);
    overflow-wrap: anywhere;
  }

  .cl-entrant-abbr {
    color: var(--cl-text-muted);
    font-weight: normal;
    margin-inline-start: var(--cl-space-1);
  }
</style>
