---
import type { IntlShape } from 'react-intl';
import type { PublicTournamentWinnerZoneResponse } from '@copalibre/api/src/dto/public-tournament.dto.js';
import { messages } from '../../../lib/i18n/public-messages.en.ts';

interface Props {
  readonly winners: readonly PublicTournamentWinnerZoneResponse[];
  readonly intl: IntlShape;
  readonly prominent?: boolean;
}

const { winners, intl, prominent = false } = Astro.props;
---

{
  winners.length > 0 && (
    <section
      class:list={['cl-podium-container', { 'cl-podium-prominent': prominent }]}
      aria-label={intl.formatMessage(messages.tournamentsFinishedHeading)}
    >
      {winners.map((zone) => (
        <div class="cl-zone-podium cl-chamfer">
          {zone.zoneName && <div class="cl-zone-title">{zone.zoneName}</div>}
          <div class="cl-podium-grid">
            {(zone.champions?.length ? zone.champions : [zone.champion]).map((champion) => (
              <div class="cl-podium-spot cl-champion-spot" data-entrant-id={champion.entrantId}>
                <div class="cl-medal-badge cl-gold-medal" aria-hidden="true">
                  1
                </div>
                <div class="cl-entrant-info">
                  <span class="cl-podium-label">
                    {intl.formatMessage(messages.tournamentsChampion)}
                  </span>
                  <span class="cl-entrant-name" title={champion.name}>
                    {champion.name}
                    {champion.abbreviation && (
                      <span class="cl-entrant-abbr" title={champion.name}>
                        {' '}
                        ({champion.abbreviation})
                      </span>
                    )}
                  </span>
                </div>
              </div>
            ))}

            {/* Runner-Up */}
            {zone.runnerUp && (
              <div class="cl-podium-spot cl-runner-spot" data-entrant-id={zone.runnerUp.entrantId}>
                <div class="cl-medal-badge cl-silver-medal" aria-hidden="true">
                  2
                </div>
                <div class="cl-entrant-info">
                  <span class="cl-podium-label">
                    {intl.formatMessage(messages.tournamentsRunnerUp)}
                  </span>
                  <span class="cl-entrant-name" title={zone.runnerUp.name}>
                    {zone.runnerUp.name}
                    {zone.runnerUp.abbreviation && (
                      <span class="cl-entrant-abbr" title={zone.runnerUp.name}>
                        {' '}
                        ({zone.runnerUp.abbreviation})
                      </span>
                    )}
                  </span>
                </div>
              </div>
            )}
            {zone.thirdPlace && (
              <div class="cl-podium-spot" data-entrant-id={zone.thirdPlace.entrantId}>
                <div class="cl-medal-badge cl-bronze-medal" aria-hidden="true">
                  3
                </div>
                <div class="cl-entrant-info">
                  <span class="cl-podium-label">
                    {intl.formatMessage(messages.tournamentsThirdPlace)}
                  </span>
                  <span class="cl-entrant-name" title={zone.thirdPlace.name}>
                    {zone.thirdPlace.name}
                    {zone.thirdPlace.abbreviation && (
                      <span class="cl-entrant-abbr" title={zone.thirdPlace.name}>
                        {' '}
                        ({zone.thirdPlace.abbreviation})
                      </span>
                    )}
                  </span>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </section>
  )
}

<style>
  .cl-podium-container {
    display: grid;
    gap: var(--cl-space-4);
  }

  .cl-podium-prominent {
    margin-block: var(--cl-space-4);
  }

  .cl-zone-title {
    font-family: var(--cl-font-display);
    font-size: var(--cl-font-size-md);
    font-weight: var(--cl-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--cl-tracking-wider);
    color: var(--cl-text-primary);
  }

  .cl-zone-podium {
    background: var(--cl-surface-base);
    border: 1px solid var(--cl-border-muted);
    padding: var(--cl-space-4);
    display: grid;
    gap: var(--cl-space-3);
    min-width: 0;
  }

  .cl-podium-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cl-space-2);
  }

  @media (min-width: 768px) {
    .cl-podium-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cl-podium-spot {
    display: flex;
    align-items: center;
    gap: var(--cl-space-2);
    padding: var(--cl-space-3);
    border-top: 1px solid var(--cl-border-muted);
    min-width: 0;
  }

  @media (max-width: 240px) {
    .cl-podium-spot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .cl-medal-badge {
    width: var(--cl-space-8);
    height: var(--cl-space-8);
    display: grid;
    place-items: center;
    font-family: var(--cl-font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--cl-font-size-xs);
    font-weight: var(--cl-weight-bold);
    flex-shrink: 0;
  }

  .cl-gold-medal {
    background: var(--cl-state-upcoming);
    color: var(--cl-surface-base);
  }

  .cl-silver-medal {
    background: var(--cl-text-secondary);
    color: var(--cl-surface-base);
  }

  .cl-bronze-medal {
    background: var(--cl-surface-chrome);
    color: var(--cl-text-primary);
    border: 1px solid var(--cl-border-strong);
  }

  .cl-entrant-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cl-podium-label {
    font-size: var(--cl-font-size-xs);
    font-weight: var(--cl-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--cl-tracking-wider);
    color: var(--cl-text-muted);
    /* A longer translated label (German "Zweitplatzierter") can otherwise
       push this flex column past a narrow viewport (openspec 0225 task 7.4). */
    overflow-wrap: anywhere;
  }

  .cl-entrant-name {
    font-size: var(--cl-font-size-sm);
    font-weight: var(--cl-weight-semibold);
    color: var(--cl-text-primary);
    overflow-wrap: anywhere;
  }

  .cl-entrant-abbr {
    color: var(--cl-text-muted);
    font-weight: normal;
    margin-inline-start: var(--cl-space-1);
  }
</style>
