---
import type { IntlShape } from 'react-intl';
import MatchNode from './MatchNode.astro';
import Button from '../atoms/Button.astro';
import '../../../styles/entrant-path.css';
import { OutcomeLegend, type BracketOutcome } from '../molecules/OutcomeLegend.tsx';
import {
  championshipMatch,
  bracketMatchId,
  describeSlot,
  nodeOutcomes,
  stageOutcomes,
  toRounds,
  type BracketMatch,
} from '../../../lib/bracket.ts';
import PlacementGames from '../molecules/PlacementGames.astro';
import { layoutPublicBracket, placementGamesOf } from '../../../lib/public-bracket-layout.ts';
import { bracketBranchLabel, bracketRoleLabel } from '../../../lib/i18n/public-intl.ts';
import { messages } from '../../../lib/i18n/public-messages.en.ts';

interface Props {
  readonly matches: readonly BracketMatch[];
  readonly intl: IntlShape;
  readonly organizationAlias: string;
  readonly tournamentAlias: string;
  readonly stageNumber: number;
  readonly localePrefix?: string;
  /** The match a report page is about; drawn with a heavier edge and `aria-current`. */
  readonly highlightMatchNumber?: number;
}
const {
  intl,
  organizationAlias,
  tournamentAlias,
  stageNumber,
  localePrefix = '',
  highlightMatchNumber,
} = Astro.props;
const rounds = toRounds(Astro.props.matches);
const championship = championshipMatch(Astro.props.matches);
const layout = layoutPublicBracket(Astro.props.matches);
const placementGames = placementGamesOf(Astro.props.matches);
// Room above the first band for its column headings (and its name, when a zone draws several).
const HEAD = layout.bands.length > 1 ? 104 : 64;
const bandTop = new Map(layout.bands.map((band) => [band.branch, band.y]));
// A round is the matches of one branch and round number; its column is where the first of them sits.
const placedRounds = rounds
  .map((round) => {
    const nodes = layout.nodes.filter(
      (node) => node.match.branch === round.branch && node.match.roundNumber === round.roundNumber,
    );
    // A split bracket has the same round on both sides, so a round can have several columns.
    const heads = [...new Set(nodes.map((node) => node.x))].map((x) => ({
      x,
      width: nodes.find((node) => node.x === x)?.width ?? 0,
    }));
    return { round, nodes, heads };
  })
  .filter((entry) => entry.nodes.length > 0);
const captionOf = (match: (typeof layout.nodes)[number]['match']): string | undefined =>
  match.role !== undefined
    ? bracketRoleLabel(intl, match.role)
    : championship?.matchNumber === match.matchNumber && championship?.branch === match.branch
      ? intl.formatMessage(messages.bracketChampionshipTitle)
      : undefined;

const outcomeLabels: Readonly<Record<BracketOutcome, string>> = {
  advancing: intl.formatMessage(messages.bracketOutcomeAdvancing),
  eliminated: intl.formatMessage(messages.bracketOutcomeEliminated),
  pending: intl.formatMessage(messages.bracketOutcomePending),
};

/*
  The key lists what this stage actually contains. A bracket in which nothing
  has been settled yet has no advancement to explain, and a key that offered to
  explain it anyway would be describing a different tournament.
*/
const legend = stageOutcomes(Astro.props.matches).map((outcome) => ({
  outcome,
  label: outcomeLabels[outcome],
}));

const roundLabel = (round: (typeof rounds)[number]): string =>
  `${bracketBranchLabel(intl, round.branch)} · ${intl.formatMessage(messages.bracketRoundHeading, { round: round.roundNumber })}`;
---

{
  /*
  Rounds, not a tree. A tree only describes single elimination; the losers'
  bracket takes entrants from two places and the grand final may be replayed.

  Two presentations of the same rounds, and the second is not a degraded copy:
  the graph is the one that needs a viewport wide enough to hold its columns, so
  below that width the textual round-and-branch view carries the same seeds,
  sources and outcomes instead. The stylesheet decides which is showing, so the
  choice survives with JavaScript unavailable.
*/
}
<section aria-label={intl.formatMessage(messages.bracketStageAriaLabel)} class="cl-bracket-stage">
  <script
    is:inline
    type="application/json"
    data-journey-matches
    set:html={JSON.stringify(Astro.props.matches).replace(/</g, '\\u003c')}
  />
  <p hidden data-journey-hint>{intl.formatMessage(messages.bracketHighlightHint)}</p>
  {
    legend.length > 0 && (
      <OutcomeLegend entries={legend} label={intl.formatMessage(messages.bracketLegendLabel)} />
    )
  }

  <div
    aria-label={intl.formatMessage(messages.bracketScrollAriaLabel)}
    class="cl-bracket-stage__scroll"
    role="group"
    tabindex="0"
  >
    <div
      class="cl-bracket-stage__canvas cl-bracket"
      style={`width: ${layout.width}px; height: ${layout.height + HEAD}px;`}
    >
      {
        /*
        Nodes and links on two layers of one fixed-size box, the links as polylines from the right
        edge of a match to the left edge of the one it feeds. A solid line carries a winner, a dashed
        one a loser, so nothing leans on colour, and it all prints as drawn.
      */
      }
      <svg
        aria-hidden="true"
        class="cl-bracket-stage__links"
        height={layout.height + HEAD}
        viewBox={`0 0 ${layout.width} ${layout.height + HEAD}`}
        width={layout.width}
      >
        <g transform={`translate(0 ${HEAD})`}>
          {
            layout.connectors.map((connector) => (
              <polyline
                class:list={[
                  'cl-bracket-link',
                  connector.kind === 'loser-of' && 'cl-bracket-link--loser',
                ]}
                data-link-from={connector.fromMatchId}
                data-link-to={connector.toMatchId}
                points={connector.points.map((point) => `${point.x},${point.y}`).join(' ')}
              />
            ))
          }
        </g>
      </svg>
      {
        layout.bands.length > 1 &&
          layout.bands.map((band) => (
            <h3 class="cl-bracket-stage__band" style={`left: ${band.x}px; top: ${HEAD - 100}px;`}>
              {bracketBranchLabel(intl, band.branch)}
            </h3>
          ))
      }
      {
        placedRounds.map(({ round, nodes, heads }) => (
          <section
            aria-label={intl.formatMessage(messages.bracketRoundAriaLabel, {
              branch: round.branch,
              round: round.roundNumber,
            })}
            class="cl-bracket-stage__round"
          >
            {heads.map((head) => (
              <h3
                class="cl-bracket-stage__round-label"
                style={`left: ${head.x}px; top: ${(bandTop.get(round.branch) ?? 0) + HEAD - 56}px; width: ${head.width}px;`}
              >
                {intl.formatMessage(messages.bracketRoundHeading, { round: round.roundNumber })}
              </h3>
            ))}
            {nodes.map((node) => {
              const caption = captionOf(node.match);
              const focused = highlightMatchNumber === node.match.matchNumber;
              return (
                <div
                  aria-current={focused ? 'true' : undefined}
                  data-journey-match={bracketMatchId(node.match)}
                  class:list={[
                    'cl-bracket-stage__node',
                    championship?.matchNumber === node.match.matchNumber &&
                      championship?.branch === node.match.branch &&
                      'cl-bracket-stage__node--championship',
                    focused && 'cl-bracket-stage__node--focused',
                  ]}
                  style={`left: ${node.x}px; top: ${node.y + HEAD}px; width: ${node.width}px; height: ${node.height}px;`}
                >
                  {caption !== undefined && <p class="cl-bracket-stage__caption">{caption}</p>}
                  <MatchNode
                    highlightEntrants
                    intl={intl}
                    localePrefix={localePrefix}
                    match={node.match}
                    organizationAlias={organizationAlias}
                    stageNumber={stageNumber}
                    tournamentAlias={tournamentAlias}
                  />
                </div>
              );
            })}
          </section>
        ))
      }
    </div>
  </div>

  <PlacementGames
    games={placementGames}
    highlightMatchNumber={highlightMatchNumber}
    intl={intl}
    localePrefix={localePrefix}
    organizationAlias={organizationAlias}
    stageNumber={stageNumber}
    tournamentAlias={tournamentAlias}
  />

  {
    /*
    The same stage in words. Every slot names where it comes from — an entrant,
    a seed, or the match it is waiting on — so nothing is lost by reading this
    instead of the graph.
  */
  }
  <div class="cl-bracket-stage__outline">
    <h3>{intl.formatMessage(messages.bracketOutlineHeading)}</h3>
    {
      rounds.map((round) => (
        <section class="cl-bracket-stage__outline-branch">
          <h4>{roundLabel(round)}</h4>
          <ol class="cl-bracket-stage__outline-list">
            {round.matches.map((match) => {
              const outcomes = nodeOutcomes(match);
              return (
                <li data-journey-match={bracketMatchId(match)}>
                  {match.role !== undefined && (
                    <strong>{bracketRoleLabel(intl, match.role)}: </strong>
                  )}
                  {match.slots.map((slot, index) => (
                    <>
                      {index > 0 && ' — '}
                      {slot.kind === 'entrant' && slot.entrantId !== undefined ? (
                        <>
                          <span data-journey-fallback>{describeSlot(slot)}</span>
                          <Button
                            hidden
                            aria-label={intl.formatMessage(messages.bracketHighlightEntrant, {
                              entrant: slot.name,
                            })}
                            aria-pressed="false"
                            class="cl-journey-name"
                            data-entrant-id={slot.entrantId}
                            variant="secondary"
                          >
                            {slot.name}
                          </Button>
                        </>
                      ) : (
                        <span>{describeSlot(slot)}</span>
                      )}
                      {match.scores?.[index] !== undefined && (
                        <span class="cl-row__figure cl-tabular-nums"> {match.scores[index]}</span>
                      )}
                      {outcomes[index] !== undefined && (
                        <span> ({outcomeLabels[outcomes[index]!]})</span>
                      )}
                    </>
                  ))}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</section>

<script>
  import { initializeEntrantHighlight } from '../../../lib/entrant-highlight';
  const initialize = (): void => {
    document.querySelectorAll<HTMLElement>('.cl-bracket-stage').forEach(initializeEntrantHighlight);
  };
  initialize();
  document.addEventListener('astro:page-load', initialize);
</script>

<style>
  /*
    The championship node reads as the stage's last cross: a heavier edge, not a
    different card. Emphasis only — `championshipMatch` marks it from the
    structure the projection produced, and declines to mark anything where the
    last round holds more than one match.
  */
  .cl-bracket-stage__node--championship :global(.cl-card) {
    border-width: 2px;
    border-color: var(--cl-primary);
  }
  /* The match a report page is about: a heavier edge and an outline, so it reads without colour. */
  .cl-bracket-stage__node--focused :global(.cl-card) {
    border-width: 3px;
    border-color: var(--cl-primary);
    outline: 2px dashed var(--cl-primary);
    outline-offset: 3px;
  }
  .cl-bracket-stage__node :global(article),
  .cl-bracket-stage__node > :global(a) {
    display: block;
    box-sizing: border-box;
    height: 100%;
    overflow: hidden;
  }
</style>
