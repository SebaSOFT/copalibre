---
import type { IntlShape } from 'react-intl';
import BracketView from './BracketView.astro';
import { stagePath, type BracketMatch } from '../../../lib/bracket.ts';
import { messages } from '../../../lib/i18n/public-messages.en.ts';

/**
 * The whole bracket of the zone a match report is about, with that match marked — orientation,
 * drawn by the same `BracketView` the stage page uses, so the two can never disagree about how a
 * bracket looks. It has no height of its own: the bracket is shown in full, and scrolls sideways
 * only when it is wider than the page.
 */
interface Props {
  readonly matches: readonly BracketMatch[];
  readonly currentMatchNumber: number;
  readonly intl: IntlShape;
  readonly organizationAlias: string;
  readonly tournamentAlias: string;
  readonly stageNumber: number;
  readonly localePrefix?: string;
}
const {
  matches,
  currentMatchNumber,
  intl,
  organizationAlias,
  tournamentAlias,
  stageNumber,
  localePrefix = '',
} = Astro.props;
---

<section
  aria-label={intl.formatMessage(messages.bracketContextAriaLabel)}
  class="cl-bracket-context"
>
  <BracketView
    highlightMatchNumber={currentMatchNumber}
    intl={intl}
    localePrefix={localePrefix}
    matches={matches}
    organizationAlias={organizationAlias}
    stageNumber={stageNumber}
    tournamentAlias={tournamentAlias}
  />
  <a
    class="cl-bracket-context__view-full"
    href={stagePath({ organizationAlias, tournamentAlias, stageNumber, localePrefix })}
  >
    {intl.formatMessage(messages.bracketContextViewFullLink)}
  </a>
</section>

<style>
  .cl-bracket-context {
    display: grid;
    gap: var(--cl-space-3);
    min-width: 0;
  }
  .cl-bracket-context__view-full {
    justify-self: start;
  }
</style>
