---
import EmblemImage from '../atoms/EmblemImage.astro';

/**
 * A server-renderable table owner: the public and
 * broadcast surfaces' `<table>` had "no server-renderable owner" recorded
 * against it in `check-ui-ownership.mjs`'s `KNOWN_RAW_ELEMENTS` register —
 * this is that owner.
 *
 * Mirrors `control/components/ui/organisms/data-table.tsx`'s class scheme
 * and prop shape — `cl-data-table`/`cl-data-table__table`/
 * `cl-data-table__caption`/`cl-data-table__empty` are already declared and
 * styled; a second, differently-named table owner would fork the visual
 * system this design explicitly keeps as one vocabulary per shape. The
 * React organism's `renderRowDetail` is not carried here: nothing on the
 * public or broadcast surface needs an expandable detail row today, and
 * adding the option ahead of a consumer would be a primitive built for a
 * screen that does not exist yet. `rowKey` is not carried either: it exists
 * in the React organism for reconciliation across re-renders, which an
 * Astro component — fully re-rendered server-side on every request — never
 * does. Not generic over the row type (Astro's compiler errors on a
 * generic type parameter in a component's frontmatter): `unknown`, narrowed
 * by the caller inside `render`.
 */
export interface DataTableColumn {
  readonly key: string;
  readonly header: unknown;
  /** Full wording behind a compact header, exposed to assistive technology and hover. */
  readonly headerHint?: string;
  readonly render: (row: unknown) => unknown;
  /** Optional server-rendered text with a leading emblem for identity cells. */
  readonly renderContent?: (row: unknown) => DataTableCellContent | undefined;
  /** Set only by a caller driving its own re-sort script; absent leaves the header a plain label. */
  readonly ariaSort?: 'none' | 'ascending' | 'descending';
  /** Wraps the cell's text in a link when it returns an address: a score that opens its match. */
  readonly href?: (row: unknown) => string | undefined;
  /** Gives a linked cell the full human-readable label when its visible text is abbreviated. */
  readonly linkAriaLabel?: (row: unknown) => string;
  /**
   * A short form of the cell's text, shown in its place on a narrow screen (the full text stays
   * in the tooltip), so a wide table scrolls less. Absent or empty leaves the text as it is.
   */
  readonly abbreviation?: (row: unknown) => string | undefined;
  /** Wraps the cell's text in `<time datetime>` when it returns an ISO instant. */
  readonly datetime?: (row: unknown) => string | undefined;
  /** Plain-text name of the column for a stacked card and a row's disclosure; defaults to the header. */
  readonly label?: string;
  /** `low` columns hide below the medium breakpoint in `priority` mode. Defaults to `high`. */
  readonly priority?: 'high' | 'low';
  /** Marks the row's name column: it truncates with an ellipsis rather than breaking mid-word. */
  readonly name?: boolean;
}

export type DataTableMobileMode = 'scroll' | 'priority' | 'stacked';

export interface DataTableCellContent {
  readonly text: string;
  readonly emblem?: {
    readonly abbreviation?: string;
    readonly alt: string;
    readonly src?: string;
  };
}

/** Rows under a sub-heading, rendered as a row group of the same table. */
export interface DataTableSection {
  readonly heading?: string;
  readonly rows: readonly unknown[];
}

export interface Props {
  readonly columns: readonly DataTableColumn[];
  readonly rows: readonly unknown[];
  /** When given, replaces `rows`: each section is a `<tbody>` headed by one spanning row. */
  readonly sections?: readonly DataTableSection[];
  readonly caption?: string;
  readonly emptyMessage?: string;
  readonly ariaLabel?: string;
  /** Opt-in denser row padding (~44px rows) for a screen that wants more rows on screen. */
  readonly compact?: boolean;
  /** Opt-in `position: sticky` header, anchored while a tall table scrolls past it. */
  readonly stickyHeader?: boolean;
  /** How the table behaves below the medium breakpoint. Defaults to `scroll`. */
  readonly mobileMode?: DataTableMobileMode;
  /** The row disclosure's accessible name; wording a `priority` table needs. */
  readonly moreColumnsLabel?: string;
}

const {
  columns,
  rows,
  sections,
  caption,
  emptyMessage,
  ariaLabel,
  compact,
  stickyHeader,
  mobileMode = 'scroll',
  moreColumnsLabel = '',
} = Astro.props;
const stacked = mobileMode === 'stacked';
const lowColumns = mobileMode === 'priority' ? columns.filter((c) => c.priority === 'low') : [];
const nameIndex = columns.findIndex((column) => column.name === true);
const hostIndex = nameIndex >= 0 ? nameIndex : 0;
const labelOf = (column: DataTableColumn): string =>
  column.label ?? (typeof column.header === 'string' ? column.header : '');
const bodies: readonly DataTableSection[] = sections ?? [{ rows }];
const rowCount = bodies.reduce((total, body) => total + body.rows.length, 0);
const modifiers = [
  compact ? 'cl-data-table--compact' : '',
  stickyHeader ? 'cl-data-table--sticky' : '',
  `cl-data-table--${mobileMode}`,
]
  .filter(Boolean)
  .join(' ');
---

<div
  aria-label={ariaLabel}
  class={`cl-data-table cl-card cl-chamfer cl-chamfer--control ${modifiers}`.trim()}
  role="region"
  tabindex="0"
>
  <table class="cl-data-table__table" role={stacked ? 'table' : undefined}>
    {caption ? <caption class="cl-data-table__caption">{caption}</caption> : null}
    <thead role={stacked ? 'rowgroup' : undefined}>
      <tr role={stacked ? 'row' : undefined}>
        {columns.map((column: DataTableColumn) => (
          <th
            aria-label={column.headerHint}
            aria-sort={column.ariaSort}
            data-column={column.key}
            data-priority={column.priority}
            role={stacked ? 'columnheader' : undefined}
            scope="col"
            title={column.headerHint}
          >
            {column.header}
          </th>
        ))}
      </tr>
    </thead>
    {bodies.map((body) => (
      <tbody role={stacked ? 'rowgroup' : undefined}>
        {body.heading ? (
          <tr class="cl-data-table__section" role={stacked ? 'row' : undefined}>
            <th colspan={columns.length} scope="rowgroup">
              {body.heading}
            </th>
          </tr>
        ) : null}
        {body.rows.map((row) => (
          <tr role={stacked ? 'row' : undefined}>
            {columns.map((column: DataTableColumn, columnIndex: number) => {
              const text = column.render(row) as string;
              const address = column.href?.(row);
              const linkAriaLabel = column.linkAriaLabel?.(row);
              const instant = column.datetime?.(row);
              const short = column.abbreviation?.(row);
              const richContent = column.renderContent?.(row);
              const body = richContent ? (
                <span class="cl-data-table__cell-content">
                  {richContent.emblem && (
                    <EmblemImage
                      abbreviation={richContent.emblem.abbreviation}
                      alt={richContent.emblem.alt}
                      bare
                      decorative
                      placeholderAlt={richContent.emblem.alt}
                      size={24}
                      src={richContent.emblem.src}
                    />
                  )}
                  <span>{richContent.text}</span>
                </span>
              ) : instant ? (
                <time datetime={instant}>{text}</time>
              ) : (
                text
              );
              const content =
                short && richContent === undefined ? (
                  <>
                    <span class="cl-data-table__full">{body}</span>
                    <abbr class="cl-data-table__short" title={text}>
                      {short}
                    </abbr>
                  </>
                ) : (
                  body
                );
              const linked = address ? (
                <a aria-label={linkAriaLabel} href={address}>
                  {content}
                </a>
              ) : (
                content
              );
              const nameOfRow = richContent?.text ?? text;
              return (
                <td
                  class={column.name ? 'cl-cell-name' : undefined}
                  data-column={column.key}
                  data-label={labelOf(column)}
                  data-priority={column.priority}
                  role={stacked ? 'cell' : undefined}
                >
                  {column.name ? (
                    <span class="cl-cell-name__row">
                      <span class="cl-cell-name__text" title={nameOfRow}>
                        {linked}
                      </span>
                    </span>
                  ) : (
                    linked
                  )}
                  {columnIndex === hostIndex && lowColumns.length > 0 ? (
                    <details class="cl-more">
                      <summary>
                        <span class="cl-visually-hidden">
                          {nameOfRow ? `${moreColumnsLabel}: ${nameOfRow}` : moreColumnsLabel}
                        </span>
                      </summary>
                      <dl class="cl-more__list">
                        {lowColumns.map((low: DataTableColumn) => (
                          <>
                            <dt>{labelOf(low)}</dt>
                            <dd>{(low.renderContent?.(row)?.text ?? low.render(row)) as string}</dd>
                          </>
                        ))}
                      </dl>
                    </details>
                  ) : null}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
  {rowCount === 0 && emptyMessage ? <p class="cl-data-table__empty">{emptyMessage}</p> : null}
</div>

<style>
  .cl-data-table__cell-content {
    display: inline-flex;
    align-items: center;
    gap: var(--cl-space-2);
    min-width: 0;
  }
  .cl-data-table__cell-content > span:last-child {
    min-width: 0;
  }
  .cl-data-table__short {
    display: none;
    text-decoration: none;
  }
  .cl-cell-name .cl-data-table__cell-content {
    max-inline-size: 100%;
  }
  .cl-cell-name .cl-data-table__cell-content > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (width < 768px) {
    .cl-data-table__full:has(+ .cl-data-table__short) {
      display: none;
    }
    .cl-data-table__short {
      display: inline;
    }
    /* A stacked card has the room: it shows the whole text, not the short form. */
    .cl-data-table--stacked .cl-data-table__full:has(+ .cl-data-table__short) {
      display: inline;
    }
    .cl-data-table--stacked .cl-data-table__short {
      display: none;
    }
  }
</style>
