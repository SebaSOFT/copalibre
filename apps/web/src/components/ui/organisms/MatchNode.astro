---
import type { IntlShape } from 'react-intl';
import { AdvancingBadge } from '../atoms/AdvancingBadge.tsx';
import { Badge } from '../atoms/Badge.tsx';
import { Card } from '../atoms/Card.tsx';
import { EntrantName } from '../atoms/EntrantName.tsx';
import { ResponsiveTimestamp } from '../atoms/ResponsiveTimestamp.tsx';
import EmblemImage from '../atoms/EmblemImage.astro';
import StateBadge from '../atoms/StateBadge.astro';
import Button from '../atoms/Button.astro';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import SeriesStateBar from '../molecules/SeriesStateBar.astro';
import { matchReportUrl, toNode, type BracketMatch } from '../../../lib/bracket.ts';
import { clubEmblemUrl } from '../../../lib/public-api-client.ts';
import { toSeriesInput } from '../../../lib/series.ts';
import { displayedScore } from '../../../lib/matches-view.ts';
import {
  resultReasonLabels,
  resultStateLabels,
  sideSourceLabels,
  seriesStateBarLabels,
} from '../../../lib/i18n/public-intl.ts';

interface Props {
  readonly match: BracketMatch;
  readonly intl: IntlShape;
  readonly organizationAlias: string;
  readonly tournamentAlias: string;
  readonly stageNumber: number;
  readonly localePrefix?: string;
  readonly highlightEntrants?: boolean;
  readonly highlightedEntrantId?: string;
  readonly scheduledAt?: string;
  readonly venueName?: string;
  readonly organizationTimeZone?: string;
}
const {
  intl,
  organizationAlias,
  tournamentAlias,
  stageNumber,
  localePrefix = '',
  scheduledAt,
  venueName,
  organizationTimeZone,
} = Astro.props;
const node = toNode(Astro.props.match, resultStateLabels(intl), sideSourceLabels(intl));
const pendingSyncGroup =
  node.slots.length === 2 && node.slots.every((slot) => slot.pending)
    ? `match-node-${stageNumber}-${Astro.props.match.matchId ?? node.matchNumber}`
    : undefined;
const highlight = Astro.props.highlightEntrants === true;
const Wrapper = highlight ? 'div' : 'a';
const reasonLabels = resultReasonLabels(intl);
const advancesLabel = intl.formatMessage(messages.bracketAdvances);
// Every card links, resolved or not — the match report page already
// renders correctly for a not-yet-played match, so a winner-of/loser-of
// placeholder still points somewhere real, not a dead end.
const reportUrl = matchReportUrl({
  organizationAlias,
  tournamentAlias,
  stageNumber,
  matchNumber: node.matchNumber,
  localePrefix,
});

// Absent on every cross settled by a single match, which is what keeps those rendering
// exactly as they did before series existed — no bar, no aggregate, no indication at all.
const series = Astro.props.match.series;
const seriesInput = series === undefined ? undefined : toSeriesInput(series);
const legScores =
  series === undefined
    ? []
    : series.games.filter((game) => game.scores !== undefined && game.status === 'finalized');
---

<Wrapper href={highlight ? undefined : reportUrl}>
  <Card as="article" data-match={node.matchNumber}>
    {highlight ? (
      <a href={reportUrl}>
        <StateBadge state={node.state} intl={intl} />
      </a>
    ) : (
      <StateBadge state={node.state} intl={intl} />
    )}
    <ol>
      {node.slots.map((slot) => (
        <li
          class:list={[
            slot.pending ? 'cl-slot--pending' : 'cl-slot',
            slot.winner && 'cl-slot--winner',
            slot.eliminated && 'cl-slot--eliminated',
          ]}
        >
          {/* Named, never blank: a blank cell reads as a bug, "Ganador del 3"
                tells a spectator what has to happen first. */}
          {slot.fullName === undefined ? (
            <EntrantName
              client:load
              pending
              syncGroup={pendingSyncGroup}
              fullName={slot.label}
              abbreviation={slot.abbreviation}
            />
          ) : (
            <>
              {organizationAlias && (
                <EmblemImage
                  alt={intl.formatMessage(messages.orgPageEmblemAlt, { name: slot.fullName })}
                  placeholderAlt={intl.formatMessage(messages.orgPageEmblemPlaceholderAlt)}
                  abbreviation={slot.abbreviation}
                  bare
                  decorative
                  size={20}
                  src={
                    slot.clubId && slot.emblemObjectId
                      ? clubEmblemUrl(organizationAlias, slot.clubId)
                      : undefined
                  }
                />
              )}
              <div class="cl-slot__identity">
                {highlight && slot.entrantId !== undefined ? (
                  <>
                    <span data-journey-fallback>
                      <EntrantName client:load fullName={slot.fullName} />
                    </span>
                    <Button
                      hidden
                      aria-label={intl.formatMessage(messages.bracketHighlightEntrant, {
                        entrant: slot.fullName,
                      })}
                      aria-pressed={
                        slot.entrantId === Astro.props.highlightedEntrantId ? 'true' : 'false'
                      }
                      class="cl-journey-name cl-focusable"
                      data-entrant-id={slot.entrantId}
                      title={slot.fullName}
                      variant="secondary"
                    >
                      {slot.fullName}
                    </Button>
                  </>
                ) : (
                  <EntrantName client:load fullName={slot.fullName} />
                )}
                {slot.originLabel !== undefined && (
                  <span class="cl-slot__origin">{slot.originLabel}</span>
                )}
                {slot.advancing && <AdvancingBadge label={advancesLabel} />}
              </div>
            </>
          )}
          {slot.resultReason && (
            // A walkover 0-10 must not read like an actual 10-goal win — the
            // reason a result looks the way it does is shown, not just the
            // number.
            <Badge>{reasonLabels[slot.resultReason]}</Badge>
          )}
          <span class="cl-stat-tile__value">{displayedScore(node.state, slot.score) ?? '—'}</span>
        </li>
      ))}
    </ol>
    {node.state === 'upcoming' && (scheduledAt !== undefined || venueName !== undefined) && (
      <p class="cl-match-node__schedule">
        {scheduledAt !== undefined && (
          <ResponsiveTimestamp
            locale={intl.locale}
            timestamp={scheduledAt}
            timeZone={organizationTimeZone}
          />
        )}
        {scheduledAt !== undefined && venueName !== undefined && ' · '}
        {venueName !== undefined && <span>{venueName}</span>}
      </p>
    )}
    {series !== undefined && seriesInput !== undefined && (
      <SeriesStateBar
        {...seriesStateBarLabels(intl, seriesInput, {
          aggregateScores:
            series.resolutionClass === 'aggregate' ? series.aggregateScores : undefined,
          awayName: node.slots[1]?.fullName ?? node.slots[1]?.label,
          homeName: node.slots[0]?.fullName ?? node.slots[0]?.label,
          winner: series.winner,
        })}
      />
    )}
    {
      /* Each leg's own score alongside the aggregate: a 1-0 and a 1-2 that sums to 2-2 is a
         different story from a 0-0 and a 2-2, and the aggregate alone hides which it was. */
      series?.resolutionClass === 'aggregate' && legScores.length > 0 && (
        <ol class="cl-series__legs">
          {legScores.map((game) => (
            <li>
              {game.scores?.[0] ?? 0} — {game.scores?.[1] ?? 0}
            </li>
          ))}
        </ol>
      )
    }
  </Card>
</Wrapper>

<style>
  .cl-slot,
  .cl-slot--pending {
    display: flex;
    align-items: center;
    gap: var(--cl-space-2);
  }
  /* The name takes the row's slack and reads from the left, next to its emblem. */
  .cl-slot__identity {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  .cl-slot__origin {
    color: var(--cl-text-muted);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cl-slot__identity :global(.cl-advancing-badge) {
    align-self: flex-start;
    margin-top: var(--cl-space-1);
  }
  .cl-slot :global(.cl-entrant-name),
  .cl-slot--pending :global(.cl-entrant-name),
  .cl-slot :global(.cl-journey-name) {
    flex: 1;
    min-width: 0;
    text-align: left;
    /* One line, always: a long club name is cut with an ellipsis and read in full on hover. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cl-slot--winner,
  .cl-slot--winner :global(.cl-entrant-name),
  .cl-slot--winner :global(.cl-stat-tile__value) {
    font-weight: var(--cl-weight-bold);
  }
  .cl-slot--eliminated,
  .cl-slot--eliminated :global(.cl-entrant-name),
  .cl-slot--eliminated :global(.cl-stat-tile__value) {
    color: var(--cl-text-muted);
  }
  .cl-match-node__schedule {
    margin: var(--cl-space-1) 0 0;
    color: var(--cl-text-muted);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
