---
/**
 * The public header.
 *
 * Both navigation landmarks, expanded by default. That ordering is deliberate:
 * the markup a browser with no JavaScript receives already has every link in
 * it, and the script's first act is to *close* the menu and reveal the control
 * that reopens it. Building it the other way round — hidden markup that script
 * has to reveal — leaves a public results page with no navigation at all
 * behind a proxy that strips scripts, which is the one place these pages have
 * to keep working.
 *
 * Closing after first paint would shift the whole page up, so when scripting
 * runs the compact menu is painted closed from the start: the classic script
 * that runs before paint marks `<html>` with `data-scripting`, and the design
 * system's styles hide the panels until this script marks the header
 * `data-nav-ready`. Without scripting none of that applies.
 *
 * The operator surface's modal drawer is untouched. A dense task surface wants
 * the page held still behind its menu; a public page wants the page to move.
 */
import type { IntlShape } from 'react-intl';
import Container from '../atoms/layout/Container.astro';
import Logo from '../atoms/Logo.astro';
import Icon from '../atoms/Icon.astro';
import Button from '../atoms/Button.astro';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import { getLocaleHomePath } from '../../../lib/locale.ts';
import { swapLocale } from '../../../lib/locale-routing.ts';
import type {
  PublicTournamentNavigation,
  PublicTournamentSection,
} from '../../../lib/public-tournament-navigation.js';

export interface LocaleOption {
  readonly locale: string;
}

interface Props {
  readonly intl: IntlShape;
  /**
   * The same path under each language the page actually publishes. Built by the
   * layout from the alternates it already computes, so the control never offers
   * a locale the page does not exist in.
   */
  readonly localeOptions?: readonly LocaleOption[];
  readonly tournamentNavigation?: PublicTournamentNavigation;
}
const { intl, localeOptions = [], tournamentNavigation } = Astro.props;

const locale = intl.locale;
const currentPathname = Astro.url.pathname;
const homeUrl = getLocaleHomePath(locale);

/*
  This is spectator navigation. Operator documentation lives in the Control
  Panel and its own help surface, so it does not belong in the public header.
*/
const links = [
  { href: homeUrl, label: intl.formatMessage(messages.headerNavHome) },
  // The TV display launcher: it has no locale segment, so the language travels as its query.
  { href: `/tv?lang=${locale}`, label: intl.formatMessage(messages.headerNavTv) },
];
const tournamentLinks: readonly {
  readonly section: PublicTournamentSection;
  readonly href: string;
  readonly label: string;
}[] =
  tournamentNavigation === undefined
    ? []
    : [
        {
          section: 'overview',
          href: tournamentNavigation.tournamentPath,
          label: intl.formatMessage(messages.headerTournamentOverview),
        },
        {
          section: 'matches',
          href: tournamentNavigation.tournamentPath + '/matches',
          label: intl.formatMessage(messages.headerTournamentMatches),
        },
        {
          section: 'standings',
          href: tournamentNavigation.tournamentPath + '#standings',
          label: intl.formatMessage(messages.headerTournamentStandings),
        },
        {
          section: 'brackets',
          href: tournamentNavigation.tournamentPath + '/stages/' + tournamentNavigation.stageNumber,
          label: intl.formatMessage(messages.headerTournamentBrackets),
        },
        {
          section: 'teams',
          href: tournamentNavigation.tournamentPath + '#teams',
          label: intl.formatMessage(messages.headerTournamentTeams),
        },
      ];

const controlLabel = intl.formatMessage(messages.headerControlPanel);
const navLabel = intl.formatMessage(messages.layoutNavAriaLabel);
const globalSectionLabel = intl.formatMessage(messages.headerGlobalSection);
const tournamentSectionLabel = intl.formatMessage(messages.headerTournamentSection);
const openLabel = intl.formatMessage(messages.headerOpenMenu);
const closeLabel = intl.formatMessage(messages.headerCloseMenu);
const controlledNavigationIds =
  tournamentLinks.length > 0 ? 'cl-public-nav cl-public-tournament-nav' : 'cl-public-nav';

/** Endonyms, so a reader looking for their own language finds it written in it. */
const languageName = (code: string): string => {
  try {
    return new Intl.DisplayNames([code], { type: 'language' }).of(code) ?? code.toUpperCase();
  } catch {
    return code.toUpperCase();
  }
};
---

<header class="cl-public-header">
  <Container class="cl-public-header__row" variant="public">
    <div class="cl-public-header__brand">
      <Logo href={homeUrl} />
    </div>

    <nav aria-label={navLabel} class="cl-public-header__nav" id="cl-public-nav">
      <span aria-hidden="true" class="cl-public-header__global-label">
        {globalSectionLabel}
      </span>
      <ul class="cl-public-header__links">
        {links.map((link) => (
          <li>
            <a class="cl-public-header__link cl-focusable" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="cl-public-header__theme" data-public-theme-picker hidden>
          <details>
            <summary>
              <span>{intl.formatMessage(messages.headerTheme)}</span>
              <span aria-hidden="true">·</span>
              <span data-theme-current>{intl.formatMessage(messages.headerThemeSystem)}</span>
              <Icon class="cl-public-header__caret" name="chevron-down" size={16} />
            </summary>
            <ul class="cl-public-header__theme-list">
              <li>
                <Button aria-pressed="false" data-theme-choice="system" variant="secondary">
                  {intl.formatMessage(messages.headerThemeSystem)}
                </Button>
              </li>
              <li>
                <Button aria-pressed="false" data-theme-choice="light" variant="secondary">
                  {intl.formatMessage(messages.headerThemeLight)}
                </Button>
              </li>
              <li>
                <Button aria-pressed="false" data-theme-choice="dark" variant="secondary">
                  {intl.formatMessage(messages.headerThemeDark)}
                </Button>
              </li>
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="cl-public-header__actions">
      {localeOptions.length > 1 && (
        <div class="cl-public-header__locale-item">
          <details class="cl-public-header__locale">
            <summary class="cl-chamfer cl-chamfer--control cl-focusable">
              <Icon name="language" size={16} />
              <span class="cl-visually-hidden">{intl.formatMessage(messages.headerLanguage)}</span>
              <span>{locale.toUpperCase()}</span>
              <Icon class="cl-public-header__caret" name="chevron-down" size={16} />
            </summary>
            <ul class="cl-public-header__locale-list cl-chamfer cl-chamfer--control">
              {localeOptions.map((option) => (
                <li>
                  <a
                    aria-current={option.locale === locale ? 'true' : undefined}
                    class="cl-public-header__link cl-focusable"
                    href={swapLocale(currentPathname, option.locale)}
                    hreflang={option.locale}
                    lang={option.locale}
                  >
                    {languageName(option.locale)}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      )}
      <a
        class="cl-public-header__cta cl-btn cl-btn--primary cl-chamfer cl-chamfer--control cl-focusable"
        href="/control/"
      >
        {controlLabel}
      </a>
      {/*
        Hidden until the script that gives it meaning has run — see the note at
        the top of this file. `hidden` rather than a class, so a browser that
        never runs the script leaves it out of the tab order too.
      */}
      <button
        aria-controls={controlledNavigationIds}
        aria-expanded="true"
        aria-label={closeLabel}
        class="cl-public-header__toggle cl-focusable"
        data-close-label={closeLabel}
        data-open-label={openLabel}
        data-public-nav-toggle
        hidden
        type="button"
      >
        <Icon name="menu" size={20} class="cl-public-header__toggle-closed" />
        <Icon name="close" size={20} class="cl-public-header__toggle-open" />
      </button>
    </div>
  </Container>
  {tournamentLinks.length > 0 && (
    <div class="cl-public-header__context-band" id="cl-public-tournament-nav">
      <Container class="cl-public-header__context-row" variant="public">
        <nav aria-label={tournamentSectionLabel} class="cl-public-header__tournament-nav">
          <span aria-hidden="true" class="cl-public-header__context-label">
            {tournamentSectionLabel}
          </span>
          <ul class="cl-public-header__tournament-links">
            {tournamentLinks.map((link) => (
              <li>
                <a
                  aria-current={link.section === tournamentNavigation?.current ? 'page' : undefined}
                  class="cl-public-header__link cl-public-header__tournament-link cl-focusable"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Container>
    </div>
  )}
</header>

<script>
  import {
    applyThemePreference,
    isThemePreference,
    readThemePreference,
  } from '../../../lib/theme-preference.js';

  /*
    Enhancement only. Everything below starts from a page whose navigation is
    already there and already reachable; this closes it, reveals the control
    that reopens it, and keeps the two in step.
  */
  const COMPACT = '(max-width: 768px)';

  function enhanceHeader(toggle: HTMLButtonElement) {
    // Hands the compact menu's state from the pre-paint styles to this script.
    const markReady = () => toggle.closest('.cl-public-header')?.setAttribute('data-nav-ready', '');
    const panels = (toggle.getAttribute('aria-controls') ?? '')
      .split(/\s+/)
      .map((id) => document.getElementById(id))
      .filter((panel): panel is HTMLElement => panel !== null);
    if (panels.length === 0) {
      markReady();
      return;
    }

    const compact = window.matchMedia(COMPACT);

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      const label = expanded ? toggle.dataset.closeLabel : toggle.dataset.openLabel;
      if (label) toggle.setAttribute('aria-label', label);
      for (const panel of panels) panel.hidden = !expanded;
    };

    /*
      Above the breakpoint the links live in the row and there is nothing to
      disclose, so the menu is open and the control is gone. Re-applied on every
      change rather than once, or a phone rotated to landscape keeps a closed
      menu it can no longer open.
    */
    const apply = () => {
      toggle.hidden = !compact.matches;
      setExpanded(!compact.matches || toggle.getAttribute('aria-expanded') === 'true');
    };

    toggle.addEventListener('click', () => {
      setExpanded(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes it and puts the focus back on the control that opened it,
    // rather than leaving the reader at the top of a page they did not move to.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !compact.matches) return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setExpanded(false);
      toggle.focus();
    });

    compact.addEventListener('change', apply);
    // The pre-paint styles already show this closed state, so taking over changes nothing on screen.
    setExpanded(false);
    apply();
    markReady();
  }

  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-public-nav-toggle]')) {
    enhanceHeader(toggle);
  }

  const themePicker = document.querySelector<HTMLElement>('[data-public-theme-picker]');
  const themeDetails = themePicker?.querySelector('details');
  const currentThemeLabel = themePicker?.querySelector<HTMLElement>('[data-theme-current]');
  const themeChoices = Array.from(
    themePicker?.querySelectorAll<HTMLButtonElement>('[data-theme-choice]') ?? [],
  );
  if (themePicker && themeDetails && currentThemeLabel && themeChoices.length > 0) {
    const updateThemePicker = () => {
      const preference = readThemePreference();
      for (const choice of themeChoices) {
        const selected = choice.dataset.themeChoice === preference;
        choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
        if (selected) currentThemeLabel.textContent = choice.textContent?.trim() ?? '';
      }
    };

    themePicker.hidden = false;
    updateThemePicker();
    for (const choice of themeChoices) {
      choice.addEventListener('click', () => {
        const preference = choice.dataset.themeChoice;
        if (!isThemePreference(preference)) return;
        applyThemePreference(preference);
        updateThemePicker();
        themeDetails.open = false;
      });
    }
  }
</script>

<style></style>
