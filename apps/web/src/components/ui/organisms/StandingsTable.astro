---
import { publicTableLayoutLabel } from '../../../lib/public-table-layout-label.ts';
import { messages } from '../../../lib/i18n/public-messages.en.ts';
import { API_PATH_PREFIX } from '../../../lib/api-path.ts';
import { optionalClubPageUrl } from '../../../lib/club-url.ts';
import { clubEmblemUrl } from '../../../lib/public-api-client.ts';
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import SearchInput from '../atoms/SearchInput.astro';
import SortIndicator from '../atoms/SortIndicator.astro';
import ClubFilterChip from '../molecules/ClubFilterChip.astro';
import { EntrantName } from '../atoms/EntrantName.tsx';
import EmblemImage from '../atoms/EmblemImage.astro';
import { Popover } from '../atoms/Popover.tsx';
import { ResponsivePlayerName } from '../atoms/ResponsivePlayerName.tsx';
import { deriveStandingsView, type StandingsTableProps } from './standings-table-model.ts';

type Props = StandingsTableProps;

const {
  layouts = [],
  previewRows,
  showControls = true,
  renderPart = 'all',
  entrantCount,
  tiebreakLine,
  omitHeading = false,
  activeClubAlias,
  activeClubId,
  highlightClubAlias,
  clubs = [],
  intl,
  canonicalPath = '',
  sectionId,
  teamAnchorId,
  organizationAlias,
  tournamentAlias,
  csvHref,
} = Astro.props;

const {
  isTableOnly,
  showHeader,
  showTable,
  showFooter,
  groupHeading,
  idPrefix,
  effectiveLayoutCode,
  heading,
  localePrefix,
  activeClubQuery,
  resolveRowClubAlias,
  isPlayerRanking,
  showSearch,
  effectiveSearchQuery,
  rows,
  tieBreaks,
  rowClassNames,
  grain,
  promotionBands,
  promotionOrderHint,
  displayColumns,
  isSortableColumn,
  initialSortColumnCode,
  hints,
  moreColumnsLabel,
  priorityOf,
  lowColumnIndexes,
  hostColumnIndex,
  fillColumnIndex,
  legend,
  playerDialogLabels,
  Wrapper,
} = deriveStandingsView(Astro.props);
---

<Wrapper
  id={Wrapper === 'section' ? sectionId : undefined}
  aria-labelledby={Wrapper === 'section' && !omitHeading ? 'standings-heading' : undefined}
  class={
    Wrapper === 'section' ? 'cl-standings-section' : isTableOnly ? 'cl-standings-group' : undefined
  }
>
  {showHeader && (
    <>
      <div class="cl-standings-header">
        {!omitHeading && <h2 id="standings-heading">{heading}</h2>}
        {renderPart === 'all' && showControls && csvHref && (
          <Button href={csvHref} variant="secondary">
            {intl.formatMessage(messages.standingsCsvExport)}
          </Button>
        )}
      </div>

      {(entrantCount !== undefined || tiebreakLine !== undefined) && (
        <p class="cl-standings-meta">
          {entrantCount !== undefined && (
            <span>
              {intl.formatMessage(messages.standingsEntrantCount, { count: entrantCount })}
            </span>
          )}
          {tiebreakLine !== undefined && <span>{tiebreakLine}</span>}
        </p>
      )}

      {grain !== undefined && (
        <p class="cl-standings-grain">
          {intl.formatMessage(
            grain === 'series' ? messages.standingsGrainSeries : messages.standingsGrainMatch,
          )}
        </p>
      )}

      {showControls && layouts.length > 1 && (
        <nav class="cl-table-tabs" aria-label={intl.formatMessage(messages.standingsTableLayouts)}>
          <ul role="tablist">
            {layouts.map((l) => {
              const isActive = l.code === effectiveLayoutCode;
              const tabUrl = `${canonicalPath}?tab=${encodeURIComponent(l.code)}${activeClubQuery ? `&${activeClubQuery}` : ''}`;
              return (
                <li role="presentation">
                  <a
                    role="tab"
                    aria-selected={isActive ? 'true' : 'false'}
                    class={`cl-table-tab ${isActive ? 'cl-table-tab--active' : ''}`}
                    href={tabUrl}
                    data-layout-code={l.code}
                  >
                    {publicTableLayoutLabel(l, intl)}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
    </>
  )}

  {!isTableOnly && renderPart === 'all' && showControls && clubs.length > 0 && (
    <div
      class="cl-club-filter"
      role="group"
      aria-label={intl.formatMessage(messages.standingsFilterByClub)}
    >
      <span class="cl-club-filter__label">
        {intl.formatMessage(messages.standingsFilterClubLabel)}
      </span>
      <ClubFilterChip
        href={`${canonicalPath}${effectiveLayoutCode ? `?tab=${encodeURIComponent(effectiveLayoutCode)}` : ''}`}
        label={intl.formatMessage(messages.matchesViewFilterAll)}
        active={!activeClubAlias && !activeClubId}
        filter="all"
      />
      {clubs.map((club) => (
        <ClubFilterChip
          href={`${canonicalPath}?${effectiveLayoutCode ? `tab=${encodeURIComponent(effectiveLayoutCode)}&` : ''}club=${encodeURIComponent(club.alias)}`}
          label={club.name}
          abbreviation={club.abbreviation}
          active={club.alias === activeClubAlias || club.clubId === activeClubId}
          filter={club.alias}
          club
          emblemSrc={
            organizationAlias && club.emblemObjectId
              ? clubEmblemUrl(organizationAlias, club.clubId)
              : undefined
          }
        />
      ))}
    </div>
  )}

  {showTable && (
    <>
      {groupHeading !== undefined && <h3 class="cl-standings-group-heading">{groupHeading}</h3>}
      {showSearch && (
        <div class="cl-standings-search">
          <SearchInput
            action={canonicalPath}
            id={`${idPrefix}-player-search`}
            value={effectiveSearchQuery}
            label={intl.formatMessage(messages.standingsTableSearchLabel)}
            placeholder={intl.formatMessage(messages.standingsTableSearchPlaceholder)}
            hiddenParams={[
              ...(effectiveLayoutCode ? [{ name: 'tab', value: effectiveLayoutCode }] : []),
              ...(activeClubAlias
                ? [{ name: 'club', value: activeClubAlias }]
                : activeClubId
                  ? [{ name: 'clubId', value: activeClubId }]
                  : []),
            ]}
            inputDataAttr="data-table-search-input"
            formDataAttr="data-table-search-form"
            serverFiltered={effectiveSearchQuery.trim().length > 0}
          />
        </div>
      )}
      <div id={isTableOnly ? undefined : teamAnchorId} class="cl-table-container cl-table-scroll">
        {rows.length === 0 && (
          <p data-standings-empty>{intl.formatMessage(messages.standingsEmpty)}</p>
        )}
        {rows.length > 0 && (
          <>
            {showControls && previewRows === undefined && (
              <div class="cl-visually-hidden" aria-live="polite" data-table-sort-announcement />
            )}
            <table
              class:list={[
                'cl-table cl-table--priority',
                { 'cl-table--fill': fillColumnIndex >= 0 },
              ]}
              data-sortable-table={showControls && previewRows === undefined ? true : undefined}
              data-sorted-asc-label={intl.formatMessage(messages.standingsTableSortedAscending)}
              data-sorted-desc-label={intl.formatMessage(messages.standingsTableSortedDescending)}
            >
              <thead>
                <tr>
                  {displayColumns.map((column, columnIndex) => {
                    const { label, hint } = hints[columnIndex] ?? { label: '' };
                    const bubbleId = `column-hint-${idPrefix}-${column.code}`;
                    const columnAriaSort = isSortableColumn(column.code)
                      ? column.code === initialSortColumnCode
                        ? 'ascending'
                        : 'none'
                      : undefined;
                    const sortIndicatorDirection =
                      column.code === initialSortColumnCode ? 'ascending' : 'none';
                    return (
                      <th
                        scope="col"
                        aria-sort={columnAriaSort}
                        class={columnIndex === fillColumnIndex ? 'cl-table__fill' : undefined}
                        data-priority={priorityOf(column.code)}
                        title={column.code === '__promotionOrder' ? hint : undefined}
                      >
                        {column.code === '__promotion' ||
                        previewRows !== undefined ||
                        !showControls ? (
                          label
                        ) : hint === undefined ? (
                          <Button
                            type="button"
                            class="cl-table__sort"
                            data-table-sort-button
                            data-column-code={column.code}
                          >
                            <span>{label}</span>
                            <SortIndicator direction={sortIndicatorDirection} />
                          </Button>
                        ) : (
                          <span class="cl-column-header-tooltip">
                            <Button
                              type="button"
                              class="cl-table__sort"
                              data-table-sort-button
                              data-column-code={column.code}
                              aria-describedby={bubbleId}
                            >
                              <span>{label}</span>
                              <SortIndicator direction={sortIndicatorDirection} />
                            </Button>
                            <span class="cl-visually-hidden" id={bubbleId}>
                              {hint}
                            </span>
                            <Popover
                              client:after-paint
                              openOnHover
                              triggerLabel={intl.formatMessage(messages.standingsColumnInfo, {
                                column: label,
                              })}
                            >
                              {hint}
                            </Popover>
                          </span>
                        )}
                      </th>
                    );
                  })}
                </tr>
              </thead>
              <tbody>
                {rows.map((row, index) => {
                  const rowClubAlias = resolveRowClubAlias(row);
                  const isHighlighted =
                    highlightClubAlias !== undefined && rowClubAlias === highlightClubAlias;
                  const clubHref = optionalClubPageUrl({
                    organizationAlias,
                    tournamentAlias,
                    clubAlias: rowClubAlias,
                    localePrefix,
                  });
                  const emblemFilterHref =
                    showControls && rowClubAlias !== undefined && canonicalPath
                      ? `${canonicalPath}?${effectiveLayoutCode ? `tab=${encodeURIComponent(effectiveLayoutCode)}&` : ''}club=${encodeURIComponent(rowClubAlias)}`
                      : undefined;
                  return (
                    <tr
                      class={rowClassNames[index]}
                      data-promotion-band-index={row.promotionBandIndex}
                      data-player-name={isPlayerRanking ? row.actorName : undefined}
                      data-club-highlighted={isHighlighted ? 'true' : undefined}
                    >
                      {displayColumns.map((column, columnIndex) => {
                        if (column.code === '__promotion') {
                          return (
                            <td class="cl-standings-qualification-cell" data-priority="low">
                              <span
                                class="cl-standings-qualification-tag"
                                data-promotion-band-index={row.promotionBandIndex}
                              >
                                {row.promotionBandLabel}
                              </span>
                              {row.promotionSeed !== undefined && (
                                <span
                                  class="cl-standings-qualification-seed"
                                  title={promotionOrderHint}
                                >
                                  {intl.formatMessage(messages.standingsSeedTag, {
                                    seed: row.promotionSeed,
                                  })}
                                </span>
                              )}
                            </td>
                          );
                        }
                        const isOrderColumn = column.code === '__promotionOrder';
                        const isNumberColumn = column.code === '__shirtNumber';
                        const isPlayerNameCell =
                          isPlayerRanking &&
                          (column.code === 'person' ||
                            column.code === 'player' ||
                            column.code === 'entrant' ||
                            column.code === 'name');
                        const isNameCell =
                          column.code === 'name' ||
                          column.code === 'entrant' ||
                          column.code === 'team';
                        const cellFormatted = isOrderColumn
                          ? row.promotionSeed !== undefined
                            ? String(row.promotionSeed)
                            : ''
                          : isNumberColumn
                            ? row.shirtNumber !== undefined
                              ? String(row.shirtNumber)
                              : ''
                            : (row.cells[column.code]?.formatted ?? '—');
                        const cellRaw = isOrderColumn
                          ? row.promotionSeed
                          : isNumberColumn
                            ? row.shirtNumber
                            : row.cells[column.code]?.raw;
                        const cellMissing = cellRaw === undefined;
                        const isNumericSort =
                          typeof cellRaw === 'number' ||
                          (isNumberColumn &&
                            cellRaw !== undefined &&
                            /^\d+$/.test(String(cellRaw)));
                        const playerPageUrl = `${canonicalPath}/players/${row.actorId}${
                          isPlayerRanking && effectiveLayoutCode
                            ? `?layout=${encodeURIComponent(effectiveLayoutCode)}`
                            : ''
                        }`;
                        const apiProfileUrl =
                          organizationAlias && tournamentAlias && row.actorId
                            ? `${API_PATH_PREFIX}/organizations/${encodeURIComponent(organizationAlias)}/tournaments/${encodeURIComponent(tournamentAlias)}/persons/${encodeURIComponent(row.actorId)}/public/profile`
                            : playerPageUrl;
                        const apiStatisticsUrl =
                          organizationAlias && tournamentAlias && row.actorId && effectiveLayoutCode
                            ? `${API_PATH_PREFIX}/organizations/${encodeURIComponent(organizationAlias)}/tournaments/${encodeURIComponent(tournamentAlias)}/persons/${encodeURIComponent(row.actorId)}/public/statistics?layout=${encodeURIComponent(effectiveLayoutCode)}`
                            : undefined;

                        const cellBody = (
                          <>
                            {isPlayerNameCell && row.hiddenAtRequest ? (
                              intl.formatMessage(messages.personHiddenAtRequest)
                            ) : isPlayerNameCell &&
                              row.actorId &&
                              row.publicProfileAvailable !== false ? (
                              <a
                                href={playerPageUrl}
                                class="cl-player-link"
                                data-player-id={row.actorId}
                                data-profile-url={apiProfileUrl}
                                data-profile-href={playerPageUrl}
                                data-statistics-url={apiStatisticsUrl}
                                data-tournament-alias={tournamentAlias}
                              >
                                <ResponsivePlayerName
                                  client:after-paint
                                  fullName={row.actorName ?? cellFormatted}
                                  nationalityCode={row.nationality}
                                />
                              </a>
                            ) : isPlayerNameCell ? (
                              <ResponsivePlayerName
                                client:after-paint
                                fullName={row.actorName ?? cellFormatted}
                                nationalityCode={row.nationality}
                              />
                            ) : column.code === 'name' ||
                              column.code === 'entrant' ||
                              column.code === 'team' ? (
                              <span class="cl-standings-entrant">
                                {(previewRows !== undefined || row.entrantId !== undefined) &&
                                  (emblemFilterHref ? (
                                    <a
                                      href={emblemFilterHref}
                                      data-club-filter={rowClubAlias}
                                      class="cl-standings-entrant__emblem-link cl-focusable"
                                      aria-label={`${intl.formatMessage(messages.standingsFilterByClub)}: ${row.entrantName ?? cellFormatted}`}
                                    >
                                      <EmblemImage
                                        abbreviation={row.entrantAbbreviation}
                                        alt={row.entrantName ?? cellFormatted}
                                        decorative
                                        placeholderAlt={intl.formatMessage(
                                          messages.orgPageEmblemPlaceholderAlt,
                                        )}
                                        size={32}
                                        src={
                                          organizationAlias && row.clubId && row.emblemObjectId
                                            ? clubEmblemUrl(organizationAlias, row.clubId)
                                            : undefined
                                        }
                                      />
                                    </a>
                                  ) : (
                                    <EmblemImage
                                      abbreviation={row.entrantAbbreviation}
                                      alt={row.entrantName ?? cellFormatted}
                                      decorative
                                      placeholderAlt={intl.formatMessage(
                                        messages.orgPageEmblemPlaceholderAlt,
                                      )}
                                      size={32}
                                      src={
                                        organizationAlias && row.clubId && row.emblemObjectId
                                          ? clubEmblemUrl(organizationAlias, row.clubId)
                                          : undefined
                                      }
                                    />
                                  ))}
                                {clubHref ? (
                                  <a
                                    href={clubHref}
                                    class="cl-standings-entrant__link cl-focusable"
                                  >
                                    <EntrantName
                                      abbreviation={row.entrantAbbreviation}
                                      client:after-paint
                                      fullName={row.entrantName ?? cellFormatted}
                                    />
                                  </a>
                                ) : (
                                  <EntrantName
                                    abbreviation={row.entrantAbbreviation}
                                    client:after-paint
                                    fullName={row.entrantName ?? cellFormatted}
                                  />
                                )}
                              </span>
                            ) : (
                              cellFormatted
                            )}
                          </>
                        );
                        return (
                          <td
                            class={
                              isPlayerNameCell || isNameCell
                                ? 'cl-cell-name'
                                : column.format === 'text'
                                  ? 'cl-table__num'
                                  : 'cl-table__num cl-tabular-nums'
                            }
                            data-priority={priorityOf(column.code)}
                            data-sort-value={cellMissing ? undefined : String(cellRaw)}
                            data-sort-type={isNumericSort ? 'number' : 'text'}
                            data-sort-missing={cellMissing ? 'true' : undefined}
                          >
                            {isPlayerNameCell || isNameCell ? (
                              <span class="cl-cell-name__row">
                                <span class="cl-cell-name__text">{cellBody}</span>
                              </span>
                            ) : (
                              cellBody
                            )}
                            {columnIndex === hostColumnIndex && lowColumnIndexes.length > 0 && (
                              <details class="cl-more">
                                <summary>
                                  <span class="cl-visually-hidden">
                                    {`${moreColumnsLabel}: ${row.entrantName ?? row.actorName ?? cellFormatted}`}
                                  </span>
                                </summary>
                                <dl class="cl-more__list">
                                  {lowColumnIndexes.map((index) => (
                                    <>
                                      <dt>{hints[index]?.label}</dt>
                                      <dd>
                                        {displayColumns[index]?.code === '__promotion'
                                          ? (row.promotionBandLabel ?? '—')
                                          : displayColumns[index]?.code === '__promotionOrder'
                                            ? row.promotionSeed !== undefined
                                              ? String(row.promotionSeed)
                                              : ''
                                            : displayColumns[index]?.code === '__shirtNumber'
                                              ? row.shirtNumber !== undefined
                                                ? String(row.shirtNumber)
                                                : ''
                                              : (row.cells[displayColumns[index]?.code ?? '']
                                                  ?.formatted ?? '—')}
                                      </dd>
                                    </>
                                  ))}
                                </dl>
                              </details>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <p class="cl-standings-empty" data-standings-empty hidden>
              {intl.formatMessage(messages.standingsEmpty)}
            </p>
            {tieBreaks.length > 0 && (
              <div
                class="cl-standings-tie-breaks"
                role="group"
                aria-label={intl.formatMessage(messages.standingsTieBreaksHeading)}
              >
                <p class="cl-standings-tie-breaks__heading">
                  {intl.formatMessage(messages.standingsTieBreaksHeading)}
                </p>
                <ul class="cl-standings-tie-breaks__list">
                  {tieBreaks.map((tieBreak) => (
                    <li>{intl.formatMessage(messages.standingsTieBreakLine, { ...tieBreak })}</li>
                  ))}
                </ul>
              </div>
            )}
          </>
        )}
      </div>
    </>
  )}

  {showFooter && (
    <>
      {renderPart === 'footer' && showControls && csvHref && (
        <div class="cl-standings-footer-actions">
          <Button href={csvHref} variant="secondary">
            {intl.formatMessage(messages.standingsCsvExport)}
          </Button>
        </div>
      )}

      {renderPart === 'footer' && showControls && clubs.length > 0 && (
        <div
          class="cl-club-filter"
          role="group"
          aria-label={intl.formatMessage(messages.standingsFilterByClub)}
        >
          <span class="cl-club-filter__label">
            {intl.formatMessage(messages.standingsFilterClubLabel)}
          </span>
          <ClubFilterChip
            href={`${canonicalPath}${effectiveLayoutCode ? `?tab=${encodeURIComponent(effectiveLayoutCode)}` : ''}`}
            label={intl.formatMessage(messages.matchesViewFilterAll)}
            active={!activeClubAlias && !activeClubId}
            filter="all"
          />
          {clubs.map((club) => (
            <ClubFilterChip
              href={`${canonicalPath}?${effectiveLayoutCode ? `tab=${encodeURIComponent(effectiveLayoutCode)}&` : ''}club=${encodeURIComponent(club.alias)}`}
              label={club.name}
              abbreviation={club.abbreviation}
              active={club.alias === activeClubAlias || club.clubId === activeClubId}
              filter={club.alias}
              club
              emblemSrc={
                organizationAlias && club.emblemObjectId
                  ? clubEmblemUrl(organizationAlias, club.clubId)
                  : undefined
              }
            />
          ))}
        </div>
      )}

      {promotionBands.length > 0 && (
        <div role="group" aria-label={intl.formatMessage(messages.standingsPromotionLegend)}>
          <dl class="cl-standings-promotion-legend">
            {promotionBands.map((band) => (
              <div class="cl-standings-promotion-legend__item">
                <dt>
                  <span
                    class="cl-standings-promotion-legend__rail"
                    data-promotion-band-index={band.index}
                    aria-hidden="true"
                  />
                  {band.label}
                </dt>
                <dd>
                  {intl.formatMessage(messages.standingsPromotionBandOrderRange, {
                    first: band.firstSeed,
                    last: band.lastSeed,
                  })}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {legend.length > 0 && (
        <div role="group" aria-label={intl.formatMessage(messages.standingsColumnLegend)}>
          <dl class="cl-table-legend">
            {legend.map((one) => (
              <div class="cl-table-legend__item">
                <dt>{one.label}</dt>
                <dd>{one.hint}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      <dialog
        id="cl-player-dialog"
        class="cl-player-dialog"
        aria-labelledby="cl-player-dialog-title"
      >
        <div class="cl-player-dialog__content">
          <div class="cl-player-dialog__header">
            <h3 id="cl-player-dialog-title" class="cl-player-dialog__title">
              {intl.formatMessage(messages.playerProfileHeading)}
            </h3>
            <Button
              type="button"
              variant="secondary"
              class="cl-player-dialog__close"
              aria-label={intl.formatMessage(messages.standingsCloseDialog)}
              data-close-dialog
            >
              <Icon name="close" size={16} />
            </Button>
          </div>
          <div id="cl-player-dialog-body" class="cl-player-dialog__body" aria-live="polite">
            <p class="cl-player-dialog__loading">
              {intl.formatMessage(messages.standingsPlayerDialogLoadingPlaceholder)}
            </p>
          </div>
        </div>
      </dialog>
      <script
        is:inline
        type="application/json"
        data-player-dialog-labels
        set:html={JSON.stringify(playerDialogLabels).replace(/</g, '\\u003c')}
      />
    </>
  )}
</Wrapper>

<script>
  import './standings-table-client.ts';
</script>

<style>
  .cl-standings-entrant {
    display: inline-flex;
    align-items: center;
    gap: var(--cl-space-2);
    min-width: 0;
    max-width: 100%;
  }
  .cl-standings-entrant__link {
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }
  .cl-standings-entrant__link:hover {
    color: var(--cl-text-accent);
    text-decoration: underline;
  }
  .cl-standings-entrant__emblem-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .cl-standings-row--highlighted > td {
    background: color-mix(in srgb, var(--cl-text-accent) 10%, transparent);
    font-weight: var(--cl-weight-semibold);
  }
  .cl-table-tabs ul {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
    border-bottom: 1px solid var(--cl-border-muted);
    overflow-x: auto;
  }
  .cl-table-tab {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: var(--cl-touch-target);
    padding: 8px 16px;
    text-decoration: none;
    color: inherit;
    font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  .cl-table-tab--active {
    border-bottom-color: var(--cl-border-accent);
    color: var(--cl-text-accent);
  }
  /*
   * Every column but the name is as narrow as its content, so the space the table has beyond
   * its figures goes to the name. A fixed width, not a percentage: a percentage column makes a
   * max-content table ask for unbounded width.
   */
  .cl-table--fill th:not(.cl-table__fill) {
    width: 1px;
  }
  .cl-table--fill :is(th, td) {
    white-space: nowrap;
  }
  .cl-standings-meta {
    display: flex;
    flex-direction: column;
    gap: var(--cl-space-1);
    margin: var(--cl-space-1) 0 var(--cl-space-3);
    font-family: var(--cl-font-mono);
    font-size: var(--cl-font-size-xs);
    color: var(--cl-text-secondary);
  }
  /* One line with a separator where it fits; stacked on phones, so no line starts with the dot. */
  @media (min-width: 768px) {
    .cl-standings-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--cl-space-1) var(--cl-space-3);
