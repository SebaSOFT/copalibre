---
import type { IntlShape } from 'react-intl';
import { EntrantName } from './EntrantName.tsx';
import type { OverviewModel } from '../lib/overview.ts';
import { messages } from '../lib/i18n/public-messages.en.ts';
import { resultStateLabels } from '../lib/i18n/public-intl.ts';

interface Props {
  readonly model: OverviewModel;
  readonly intl: IntlShape;
  /** Optional non-default locale segment from the enclosing public route. */
  readonly localePrefix?: string;
}
const { model, intl, localePrefix = '' } = Astro.props;
const labels = resultStateLabels(intl);
---

{
  /*
  Rendered server-side and complete. A ticker that needs JavaScript to say the
  score is a ticker that says nothing on a venue TV behind a hotel proxy.
*/
}
<section aria-labelledby="ticker-heading">
  <h2 id="ticker-heading">{intl.formatMessage(messages.tickerHeading)}</h2>
  {model.matches.length === 0 && <p>{intl.formatMessage(messages.tickerEmpty)}</p>}
  <ul>
    {
      model.matches.map((match) => (
        <li
          class={`cl-card cl-card--${match.state === 'final' ? 'positive' : match.state === 'disputed' ? 'destructive' : match.state}`}
        >
          {match.matchNumber === undefined ? (
            <>
              <span class="cl-badge">{labels[match.state]}</span>
              <EntrantName
                abbreviation={match.home.abbreviation}
                client:load
                fullName={match.home.name}
              />
              <span class="cl-stat-tile__value">{match.home.score ?? '—'}</span>
              <EntrantName
                abbreviation={match.away.abbreviation}
                client:load
                fullName={match.away.name}
              />
              <span class="cl-stat-tile__value">{match.away.score ?? '—'}</span>
              <time datetime={match.startsAt}>{match.startsAt}</time>
            </>
          ) : (
            <a
              href={`${localePrefix}${model.canonicalPath}/stages/${match.stageNumber}/matches/${match.matchNumber}`}
            >
              <span class="cl-badge">{labels[match.state]}</span>
              <EntrantName
                abbreviation={match.home.abbreviation}
                client:load
                fullName={match.home.name}
              />
              <span class="cl-stat-tile__value">{match.home.score ?? '—'}</span>
              <EntrantName
                abbreviation={match.away.abbreviation}
                client:load
                fullName={match.away.name}
              />
              <span class="cl-stat-tile__value">{match.away.score ?? '—'}</span>
              <time datetime={match.startsAt}>{match.startsAt}</time>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--cl-space-3, 0.75rem);
    list-style: none;
    padding: 0;
    margin: var(--cl-space-3, 0.75rem) 0 0 0;
  }

  li.cl-card {
    background: var(--cl-surface-panel, #121828);
    border: 1px solid var(--cl-border-subtle, rgba(255, 255, 255, 0.1));
    border-radius: var(--cl-radius-md, 8px);
    padding: var(--cl-space-3, 0.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.15s ease;
  }

  li.cl-card:hover {
    border-color: var(--cl-brand-cyan, #00d4ff);
  }

  li.cl-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cl-badge {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    background: var(--cl-surface-subtle, rgba(255, 255, 255, 0.1));
    color: var(--cl-text-primary, #f2f6fb);
  }

  .cl-stat-tile__value {
    font-family: var(--cl-font-display, inherit);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--cl-text-primary, #f2f6fb);
  }
</style>
