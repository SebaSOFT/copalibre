{
  "alias": "basketball",
  "version": "1.0.0",
  "name": { "en": "Basketball" },
  "description": {
    "en": "Team discipline with timed quarters, two- and three-point field goals, free throws, and personal fouls."
  },
  "attribution": {
    "author": "CopaLibre",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre"
  },
  "participantTypes": ["team"],
  "rosterConstraints": { "minPlayers": 5, "maxPlayers": 5, "maxSubstitutes": 7 },
  "segmentTypes": [
    {
      "name": "quarter",
      "label": { "en": "Quarter" },
      "timed": true,
      "defaultDurationSeconds": 600
    },
    {
      "name": "overtime",
      "label": { "en": "Overtime" },
      "timed": true,
      "defaultDurationSeconds": 300
    }
  ],
  "eventDefinitions": [
    {
      "code": "field-goal-2pt",
      "label": { "en": "2-point field goal" },
      "description": { "en": "Scores two points for the shooting side." },
      "category": "positive",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": { "assistedBy": { "type": "string" } } },
      "effects": [
        { "kind": "score", "awardTo": "actor", "delta": 2 },
        { "kind": "statistic", "statisticCode": "points", "delta": 2 },
        {
          "kind": "statistic",
          "statisticCode": "assists",
          "delta": 1,
          "awardTo": { "payloadField": "assistedBy" }
        }
      ]
    },
    {
      "code": "field-goal-3pt",
      "label": { "en": "3-point field goal" },
      "description": { "en": "Scores three points for the shooting side." },
      "category": "positive",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": { "assistedBy": { "type": "string" } } },
      "effects": [
        { "kind": "score", "awardTo": "actor", "delta": 3 },
        { "kind": "statistic", "statisticCode": "points", "delta": 3 },
        { "kind": "statistic", "statisticCode": "three-pointers-made", "delta": 1 },
        {
          "kind": "statistic",
          "statisticCode": "assists",
          "delta": 1,
          "awardTo": { "payloadField": "assistedBy" }
        }
      ]
    },
    {
      "code": "free-throw-made",
      "label": { "en": "Free throw made" },
      "description": { "en": "Scores one point for the shooting side." },
      "category": "positive",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": {} },
      "effects": [
        { "kind": "score", "awardTo": "actor", "delta": 1 },
        { "kind": "statistic", "statisticCode": "points", "delta": 1 }
      ]
    },
    {
      "code": "free-throw-missed",
      "label": { "en": "Free throw missed" },
      "category": "neutral",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": {} }
    },
    {
      "code": "rebound",
      "label": { "en": "Rebound" },
      "description": {
        "en": "Credits a rebound to the recovering player; does not by itself change the score."
      },
      "category": "neutral",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": { "kind": { "type": "string", "enum": ["offensive", "defensive"] } }
      },
      "effects": [{ "kind": "statistic", "statisticCode": "rebounds", "delta": 1 }]
    },
    {
      "code": "steal",
      "label": { "en": "Steal" },
      "category": "positive",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": {} },
      "effects": [{ "kind": "statistic", "statisticCode": "steals", "delta": 1 }]
    },
    {
      "code": "turnover",
      "label": { "en": "Turnover" },
      "category": "negative",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": {} },
      "effects": [{ "kind": "statistic", "statisticCode": "turnovers", "delta": 1 }]
    },
    {
      "code": "personal-foul",
      "label": { "en": "Personal foul" },
      "description": {
        "en": "Charges a personal foul; a fifth in one match disqualifies the player from the rest of it, tracked outside this descriptor by the audited-correction workflow, not enforced here."
      },
      "category": "negative",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person",
      "payloadSchema": { "type": "object", "properties": {} },
      "effects": [{ "kind": "statistic", "statisticCode": "personal-fouls", "delta": 1 }]
    },
    {
      "code": "technical-foul",
      "label": { "en": "Technical foul" },
      "category": "negative",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "person-or-staff",
      "payloadSchema": { "type": "object", "properties": {} }
    },
    {
      "code": "substitution",
      "label": { "en": "Substitution" },
      "category": "neutral",
      "permittedSegmentTypes": ["quarter", "overtime"],
      "actorRequirement": "side",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "playerOutId": { "type": "string" },
          "playerInId": { "type": "string" }
        },
        "required": ["playerOutId", "playerInId"]
      },
      "personPayloadFields": ["playerOutId", "playerInId"]
    }
  ],
  "statistics": [
    { "code": "points", "label": { "en": "Points" }, "aggregation": "sum" },
    { "code": "rebounds", "label": { "en": "Rebounds" }, "aggregation": "sum" },
    { "code": "assists", "label": { "en": "Assists" }, "aggregation": "sum" },
    { "code": "steals", "label": { "en": "Steals" }, "aggregation": "sum" },
    { "code": "turnovers", "label": { "en": "Turnovers" }, "aggregation": "sum" },
    { "code": "personal-fouls", "label": { "en": "Personal fouls" }, "aggregation": "sum" },
    {
      "code": "three-pointers-made",
      "label": { "en": "Three-pointers made" },
      "aggregation": "sum"
    },
    { "code": "wins", "label": { "en": "Wins" }, "aggregation": "sum" },
    { "code": "losses", "label": { "en": "Losses" }, "aggregation": "sum" },
    { "code": "played", "label": { "en": "Played" }, "aggregation": "count" }
  ],
  "rosterRoles": [{ "code": "captain", "label": { "en": "Captain" }, "badge": "C" }],
  "scoringInputs": [{ "code": "points", "label": { "en": "Points" }, "source": "event-derived" }],
  "availableFormats": ["single-elimination", "double-elimination", "round-robin", "league"],
  "notificationRuleCapabilities": ["threshold-count"],
  "winCondition": {
    "id": "basketball-win-condition",
    "rules": [
      {
        "id": "close-match-rule",
        "type": "simple_rule",
        "options": {},
        "conditions": [],
        "actions": [
          {
            "id": "close-match",
            "type": "winMatch",
            "options": {},
            "params": [
              {
                "id": "unit",
                "name": "unit",
                "type": "simple_string",
                "value": "points",
                "options": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "format": "league",
    "registration": {
      "publicOpen": false,
      "requiresCheckIn": false,
      "region": null,
      "capacity": null
    },
    "scoring": { "pointsPerWin": 2, "pointsPerDraw": 0, "pointsPerLoss": 0 },
    "tiebreakers": ["points", "points-for"],
    "segments": { "regulationCount": 4, "overtimeEnabled": true }
  },
  "fieldPolicies": {
    "format": { "permission": { "kind": "replaced" }, "mutationClass": "blocked_after_results" },
    "registration.publicOpen": { "permission": { "kind": "replaced" }, "mutationClass": "safe" },
    "registration.requiresCheckIn": {
      "permission": { "kind": "replaced" },
      "mutationClass": "requires_rebuild"
    },
    "registration.checkInClosesAt": {
      "permission": { "kind": "replaced" },
      "mutationClass": "requires_rebuild"
    },
    "registration.region": { "permission": { "kind": "replaced" }, "mutationClass": "safe" },
    "registration.capacity": {
      "permission": { "kind": "replaced" },
      "mutationClass": "requires_rebuild"
    },
    "scoring.pointsPerWin": {
      "permission": { "kind": "replaced" },
      "mutationClass": "blocked_after_results"
    },
    "tiebreakers": {
      "permission": { "kind": "merged", "strategy": "union-list" },
      "mutationClass": "requires_rebuild"
    },
    "segments": {
      "permission": { "kind": "forbidden" },
      "mutationClass": "safe"
    }
  }
}
