{
  "name": "@copalibre/web",
  "version": "1.2.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "yarn workspace @copalibre/design-tokens build:tokens && node scripts/copy-background-removal-assets.mjs && astro dev",
    "build": "NODE_ENV=production yarn workspace @copalibre/design-tokens build:tokens && node scripts/copy-openapi-artifact.mjs && node scripts/copy-background-removal-assets.mjs && node scripts/generate-authoring-docs.mjs && NODE_ENV=production astro build",
    "preview": "astro preview",
    "storybook": "yarn workspace @copalibre/design-tokens build:tokens && storybook dev -p 6006",
    "check": "astro check",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs --coverage",
    "test:integration": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.integration.config.cjs --runInBand",
    "inspect:build": "node scripts/verify-build.mjs",
    "inspect:docs": "node scripts/verify-help-build.mjs",
    "verify:build": "node -e 'if (![\"1\",\"true\"].includes(process.env.WEB_EXISTING_BUILD)) { const { execSync } = require(\"node:child_process\"); execSync(\"yarn run build\", { stdio: \"inherit\" }); }' && node scripts/verify-build.mjs",
    "verify:docs": "node -e 'if (![\"1\",\"true\"].includes(process.env.WEB_EXISTING_BUILD)) { const { execSync } = require(\"node:child_process\"); execSync(\"yarn run build\", { stdio: \"inherit\" }); }' && node scripts/verify-help-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "0.42.6",
    "@copalibre/contracts": "workspace:^",
    "@copalibre/design-tokens": "workspace:^",
    "@copalibre/realtime": "workspace:^",
    "@copalibre/routing": "workspace:^",
    "@copalibre/tournament-engine": "workspace:^",
    "@imgly/background-removal": "1.7.0",
    "@pagefind/default-ui": "1.5.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tabler/icons": "3.49.0",
    "@tabler/icons-react": "3.49.0",
    "ajv": "^8.20.0",
    "astro": "^7.4.1",
    "idb": "^8.0.4",
    "lucide-react": "1.59.0",
    "lucide-static": "1.59.0",
    "onnxruntime-web": "1.30.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-intl": "^12.1.4",
    "starlight-llms-txt": "^0.12.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@copalibre/domain": "workspace:^",
    "@copalibre/rules": "workspace:^",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "storybook": "10.6.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "undici": "8.11.2",
    "vite": "^8.3.4"
  },
  "type": "module"
}
