{
  "name": "@copalibre/web",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-openapi-artifact.mjs && node scripts/copy-scalar-assets.mjs && node scripts/generate-authoring-docs.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs --coverage",
    "test:integration": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.integration.config.cjs --runInBand",
    "test:e2e": "yarn --cwd ../../ playwright test apps/web/tests/",
    "verify:build": "node scripts/copy-openapi-artifact.mjs && node scripts/copy-scalar-assets.mjs && node scripts/generate-authoring-docs.mjs && astro build && node scripts/verify-build.mjs",
    "verify:docs": "node scripts/copy-openapi-artifact.mjs && node scripts/copy-scalar-assets.mjs && node scripts/generate-authoring-docs.mjs && astro build && node scripts/verify-help-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.1",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "0.41.7",
    "@copalibre/contracts": "workspace:^",
    "@copalibre/design-tokens": "workspace:^",
    "@copalibre/realtime": "workspace:^",
    "@copalibre/routing": "workspace:^",
    "@pagefind/default-ui": "1.5.2",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@scalar/api-reference": "1.64.0",
    "ajv": "^8.20.0",
    "astro": "^7.2.1",
    "idb": "^8.0.3",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-intl": "^10.1.20",
    "starlight-llms-txt": "^0.11.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@copalibre/domain": "workspace:^",
    "@copalibre/rules": "workspace:^",
    "@copalibre/tournament-engine": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5",
    "undici": "^8.9.0"
  },
  "type": "module"
}
