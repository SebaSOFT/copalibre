{
  "name": "@copalibre/copalibre",
  "version": "1.2.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc --build && node scripts/build-assets.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs --coverage",
    "test:integration": "node --env-file-if-exists=../../.env.test --experimental-vm-modules ../../node_modules/.bin/jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@copalibre/auth": "workspace:^",
    "@copalibre/domain": "workspace:^",
    "@copalibre/module-catalogue": "workspace:^",
    "@copalibre/module-distribution": "workspace:^",
    "@copalibre/object-storage": "workspace:^",
    "@copalibre/persistence": "workspace:^",
    "@copalibre/statistics-refold": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "clipanion": "^3.2.1",
    "jose": "^6",
    "kysely": "^0.29.7",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "postject": "^1.0.0-alpha.6",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "yauzl": "^3.4.0"
  },
  "type": "module"
}
