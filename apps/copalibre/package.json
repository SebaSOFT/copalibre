    "@copalibre/persistence": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "ajv": "^8.20.0",
    "jose": "^6",
    "kysely": "^0.29",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "type": "module"
}
