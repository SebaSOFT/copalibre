    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "type": "module",
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
