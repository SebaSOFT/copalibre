  "scripts": {
    "build": "tsc --build",
    "dev": "../../node_modules/.bin/tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.cjs",
