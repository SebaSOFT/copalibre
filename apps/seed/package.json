{
  "name": "@copalibre/seed",
  "version": "1.0.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "start": "tsc --build && node dist/main.js",
    "test:integration": "node --env-file-if-exists=../../.env.test --experimental-vm-modules ../../node_modules/.bin/jest --config jest.integration.config.cjs --runInBand",
    "test:sqlite": "COPALIBRE_TEST_DIALECT=sqlite node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@copalibre/module-catalogue": "workspace:^",
    "@copalibre/object-storage": "workspace:^",
    "@copalibre/persistence": "workspace:^",
    "kysely": "^0.29"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
