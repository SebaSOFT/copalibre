{
  "alias": "rink-hockey",
  "version": "1.1.0",
  "name": {
    "en": "Rink Hockey",
    "es": "Hockey sobre patines"
  },
  "description": {
    "en": "5-a-side rink hockey discipline with 2 timed halves (25m), direct free hits, team fouls, cards, and penalty shootouts."
  },
  "images": [
    {
      "key": "modules/rink-hockey/1.1.0/rink-hockey-01.jpg"
    }
  ],
  "attribution": {
    "author": "CopaLibre Community",
    "licence": "AGPL-3.0-only",
    "sourceUrl": "https://github.com/SebaSOFT/copalibre-modules"
  },
  "participantTypes": ["team"],
  "rosterConstraints": {
    "minPlayers": 5,
    "maxPlayers": 5,
    "maxSubstitutes": 15
  },
