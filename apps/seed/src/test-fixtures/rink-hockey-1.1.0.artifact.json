  "eventDefinitions": [
    {
      "code": "goal",
      "label": {
        "en": "Goal",
        "es": "Gol"
      },
      "category": "positive",
      "permittedSegmentTypes": ["half", "extra-time"],
      "actorRequirement": "person",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "assistedBy": {
            "type": "string"
          }
        }
      },
      "effects": [
        {
          "kind": "score",
          "awardTo": "actor",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-for",
          "delta": 1
        },
        {
          "kind": "statistic",
          "statisticCode": "goals-against",
          "delta": 1,
          "awardTo": "every-other-side"
