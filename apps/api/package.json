{
  "name": "@copalibre/api",
  "version": "1.2.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc --build",
    "dev": "../../node_modules/.bin/tsx watch src/main.ts",
    "start": "node dist/main.js",
    "openapi:generate": "tsc --build && node dist/openapi/generate.js",
    "test": "../../node_modules/.bin/vitest --config vitest.config.ts run",
    "test:coverage": "../../node_modules/.bin/vitest --config vitest.config.ts run --coverage",
    "test:integration": "node --env-file-if-exists=../../.env.test ../../node_modules/.bin/vitest --config vitest.integration.config.ts run",
    "test:sqlite": "COPALIBRE_TEST_DIALECT=sqlite node --env-file-if-exists=../../.env.test ../../node_modules/.bin/vitest --config vitest.integration.config.ts run src/auth/shared-throttler-storage.integration.test.ts"
  },
  "dependencies": {
    "@copalibre/auth": "workspace:^",
    "@copalibre/domain": "workspace:^",
    "@copalibre/module-distribution": "workspace:^",
    "@copalibre/object-storage": "workspace:^",
    "@copalibre/persistence": "workspace:^",
    "@copalibre/rules": "workspace:^",
    "@copalibre/statistics-refold": "workspace:^",
    "@copalibre/tournament-engine": "workspace:^",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@copalibre/module-catalogue": "workspace:^",
    "@nestjs/testing": "^12.1.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "supertest": "^7.2.2",
    "typescript": "^5",
    "vite": "8.1.5",
    "vitest": "5.0.3"
  },
  "type": "module"
}
